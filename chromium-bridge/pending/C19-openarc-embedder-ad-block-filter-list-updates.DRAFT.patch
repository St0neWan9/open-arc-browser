 }  // namespace
 
-bool AdBlocker::LoadRuleset(const base::FilePath& directory) {
+void AdBlocker::LoadBundledRuleset() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(kRulesetDirectorySwitch)) {
+    LoadRuleset(command_line.GetSwitchValuePath(kRulesetDirectorySwitch));
+    return;
+  }
+  // Both rulesets must be compared at every start: the RulesetService indexes
+  // any version that differs from the last one it indexed, so loading the
+  // older bundled ruleset would undo a download. A framework built without
+  // the lists (build-adblock-ruleset.sh not run) has no Resources/AdBlock: the
+  // filter then uses a downloaded ruleset, or an earlier one still indexed in
+  // the user data directory, or matches nothing.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ChooseStartupRuleset, BundledRulesetDirectory(),
+                     DownloadedRulesetStore()),
+      base::BindOnce([](const base::FilePath& directory) {
+        AdBlocker::Get().LoadRuleset(directory);
+      }));
+}
+
+// static
+base::FilePath AdBlocker::DownloadedRulesetStore() {
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return base::FilePath();
+  }
+  return user_data.Append(kDownloadedRulesetDirectory);
+}
+
+// static
+bool AdBlocker::PrefersDownloaded(const std::string& bundled,
+                                  const std::string& downloaded) {
+  if (!IsWellFormedVersion(downloaded)) {
+    return false;
+  }
+  if (!IsWellFormedVersion(bundled)) {
+    return true;
+  }
+  // The first 8 characters are the build day; their string order is the date
+  // order.
+  return downloaded.compare(0, 8, bundled, 0, 8) >= 0;
+}
