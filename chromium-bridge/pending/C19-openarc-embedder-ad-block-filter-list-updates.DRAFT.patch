diff --git a/openarc/bridge/oac_application.mm b/openarc/bridge/oac_application.mm
index 2c7169e6687c..e0a97e86462e 100644
--- a/openarc/bridge/oac_application.mm
+++ b/openarc/bridge/oac_application.mm
@@ -629,6 +629,44 @@ - (NSString*)adBlockingRulesetVersion {
   return version.empty() ? nil : base::SysUTF8ToNSString(version);
 }
 
+- (void)loadAdBlockingRulesetFromDirectory:(NSURL*)directory
+                         completionHandler:
+                             (void (^)(NSString* _Nullable version,
+                                       NSError* _Nullable error))completionHandler {
+  CHECK(NSThread.isMainThread);
+  completionHandler = [completionHandler copy];
+  auto fail = ^(OACErrorCode code, NSString* description) {
+    NSError* error = OACMakeError(code, description);
+    OACPostToMainThread(^{
+      completionHandler(nil, error);
+    });
+  };
+  if (_state != OACApplicationStateRunning) {
+    fail(OACErrorNotStarted, @"The engine is not running.");
+    return;
+  }
+  if (!directory.isFileURL) {
+    fail(OACErrorInvalidArgument, @"The ruleset directory must be a file URL.");
+    return;
+  }
+  const bool started = openarc::AdBlocker::Get().LoadRuleset(
+      base::apple::NSURLToFilePath(directory),
+      base::BindOnce(^(const std::string& version) {
+        // Runs on the UI thread from a posted task (LoadRuleset's reply), so
+        // the handler is never called re-entrantly.
+        if (version.empty()) {
+          completionHandler(
+              nil, OACMakeError(OACErrorInvalidArgument,
+                                @"The directory holds no ad blocking ruleset."));
+        } else {
+          completionHandler(base::SysUTF8ToNSString(version), nil);
+        }
+      }));
+  if (!started) {
+    fail(OACErrorNotStarted, @"The ad blocker's ruleset service is not running.");
+  }
+}
