+// "<yyyymmdd>-<6..64 lowercase hex digits>", as build-adblock-ruleset.sh
+// writes it (AdBlockRulesetVersion.isValid on the Swift side).
+bool IsWellFormedVersion(const std::string& version) {
+  if (version.size() < 15 || version.size() > 73 || version[8] != '-') {
+    return false;
+  }
+  for (size_t i = 0; i < version.size(); ++i) {
+    const char c = version[i];
+    if (i < 8 && !base::IsAsciiDigit(c)) {
+      return false;
+    }
+    if (i > 8 && !base::IsAsciiDigit(c) && !(c >= 'a' && c <= 'f')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The ruleset to load at startup (blocking): the downloaded one that the
+// store's Current link names, when it is complete, lies inside the store and
+// PrefersDownloaded() picks it; else the bundled one.
+base::FilePath ChooseStartupRuleset(const base::FilePath& bundled,
+                                    const base::FilePath& store) {
+  if (store.empty()) {
+    return bundled;
+  }
+  // realpath(3): empty when the link or its target is missing.
+  const base::FilePath downloaded = base::MakeAbsoluteFilePath(
+      store.Append(AdBlocker::kCurrentRulesetLink));
+  const base::FilePath real_store = base::MakeAbsoluteFilePath(store);
+  if (downloaded.empty() || real_store.empty() ||
+      !real_store.IsParent(downloaded)) {
+    return bundled;
+  }
+  const std::string downloaded_version = ReadRulesetVersion(downloaded);
+  if (downloaded_version.empty() ||
+      !AdBlocker::PrefersDownloaded(ReadRulesetVersion(bundled),
+                                    downloaded_version)) {
+    return bundled;
+  }
+  return downloaded;
+}
