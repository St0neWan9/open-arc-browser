+
+// Docks the front end's `view` under the page; nil undocks it, and the page
+// fills the view again.
+- (void)setDevToolsView:(nullable NSView*)view;
+// Where the page goes while DevTools is docked (Chrome's strategy: the front
+// end's bounds for the page, kept clear of DevTools' minimum size).
+- (void)setResizingStrategy:(const DevToolsContentsResizingStrategy&)strategy;
+
+// The container holding `contents`' view, if any.
++ (nullable OpenArcTabContainerView*)containerOf:
+    (content::WebContents*)contents;
+
+@end
+
+NS_ASSUME_NONNULL_END
+
+#endif  // OPENARC_BROWSER_OPENARC_TAB_CONTAINER_VIEW_H_
