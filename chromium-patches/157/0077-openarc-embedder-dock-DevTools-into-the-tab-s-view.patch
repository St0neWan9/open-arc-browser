+
+#import "openarc/browser/openarc_tab_container_view.h"
+
+#include <memory>
+
+#include "chrome/browser/devtools/devtools_contents_resizing_strategy.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/rect.h"
+
+@implementation OpenArcTabContainerView {
+  NSView* __strong _pageView;
+  NSView* __strong _devToolsView;
+  std::unique_ptr<DevToolsContentsResizingStrategy> _strategy;
+}
+
+- (instancetype)initWithPageView:(NSView*)pageView {
+  if ((self = [super initWithFrame:pageView.frame])) {
+    _pageView = pageView;
+    _strategy = std::make_unique<DevToolsContentsResizingStrategy>();
+    pageView.autoresizingMask = NSViewNotSizable;
+    pageView.frame = self.bounds;
+    [self addSubview:pageView];
+  }
+  return self;
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (NSView*)pageView {
+  return _pageView;
+}
+
+- (NSView*)devToolsView {
+  return _devToolsView;
+}
+
+- (void)setDevToolsView:(NSView*)view {
+  if (view == _devToolsView) {
+    return;
+  }
+  [_devToolsView removeFromSuperview];
+  _devToolsView = view;
+  _strategy = std::make_unique<DevToolsContentsResizingStrategy>();
+  if (view) {
+    [view removeFromSuperview];
+    view.autoresizingMask = NSViewNotSizable;
+    [self addSubview:view positioned:NSWindowBelow relativeTo:_pageView];
+  }
+  [self layoutContents];
+}
+
+- (void)setResizingStrategy:(const DevToolsContentsResizingStrategy&)strategy {
+  if (_strategy->Equals(strategy)) {
+    return;
+  }
+  _strategy->CopyFrom(strategy);
+  [self layoutContents];
+}
+
+- (void)setFrameSize:(NSSize)newSize {
+  [super setFrameSize:newSize];
+  [self layoutContents];
+}
+
+- (void)resizeSubviewsWithOldSize:(NSSize)oldSize {
+  [self layoutContents];
+}
+
+// The page fills the view; with DevTools docked, the front end does and the
+// page goes where the strategy puts it (hidden when it asks for no room).
+- (void)layoutContents {
+  NSRect bounds = self.bounds;
+  if (!_devToolsView) {
+    _pageView.frame = bounds;
+    return;
+  }
+  gfx::Rect devtools_bounds;
+  gfx::Rect contents_bounds;
+  ApplyDevToolsContentsResizingStrategy(
+      *_strategy,
+      gfx::Rect(0, 0, NSWidth(bounds), NSHeight(bounds)),
+      &devtools_bounds, &contents_bounds);
+  // Flipped view: gfx rects map one to one.
+  _devToolsView.frame = devtools_bounds.ToCGRect();
+  _pageView.frame = contents_bounds.ToCGRect();
+}
+
++ (OpenArcTabContainerView*)containerOf:(content::WebContents*)contents {
+  if (!contents) {
+    return nil;
+  }
+  NSView* superview = contents->GetNativeView().GetNativeNSView().superview;
+  return [superview isKindOfClass:[OpenArcTabContainerView class]]
+             ? (OpenArcTabContainerView*)superview
+             : nil;
+}
+
+@end
