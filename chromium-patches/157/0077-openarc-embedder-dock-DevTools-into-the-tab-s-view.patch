+void DevToolsHost::SetIsDocked(bool docked) {
+  if (closing_) {
+    return;
+  }
+  // Docking needs the tab's view; a tab hosted elsewhere stays undocked.
+  if (!container_) {
+    docked = false;
+  }
+  const bool changed = !dock_set_ || docked != docked_;
+  dock_set_ = true;
+  docked_ = docked;
+  if (!presented_) {
+    MaybePresent();
+  } else if (changed) {
+    Present();
+  }
+}
+
+void DevToolsHost::SetInspectedPageBounds(const gfx::Rect& rect) {
+  // As DevToolsWindow::SetInspectedPageBounds: the dock side keeps
+  // DevTools' minimum room when the tab's view shrinks.
+  content::WebContents* inspected = inspected_.get();
+  devtools::DockSide side = devtools::DockSide::kNone;
+  if (docked_ && inspected) {
+    side = DevToolsSettings::GetDockSide(
+        Profile::FromBrowserContext(inspected->GetBrowserContext()));
+  }
+  [container_ setResizingStrategy:DevToolsContentsResizingStrategy(side, rect)];
+}
+
+NSView* DevToolsHost::FrontendView() {
+  return frontend_ ? frontend_->GetNativeView().GetNativeNSView() : nil;
+}
+
+void DevToolsHost::MaybePresent() {
+  if (presented_ || closing_ || !dock_set_ || !document_loaded_) {
+    return;
+  }
+  presented_ = true;
+  Present();
+}
+
+void DevToolsHost::Present() {
+  NSView* view = FrontendView();
+  if (!view) {
+    return;
+  }
+  if (docked_) {
+    // Into the tab's view, under the page; the window, if any, goes away.
+    [window_controller_.window orderOut:nil];
+    [container_ setDevToolsView:view];
+  } else {
+    if (container_.devToolsView == view) {
+      [container_ setDevToolsView:nil];
+    }
+    if (!window_controller_) {
+      window_controller_ =
+          [[OpenArcDevToolsWindowController alloc] initWithHost:this];
+    }
+    [window_controller_ holdView:view];
+    UpdateTitle();
+    [window_controller_.window makeKeyAndOrderFront:nil];
+  }
+  frontend_->Focus();
+}
+
 void DevToolsHost::ConnectionReady() {
   connection_ready_ = true;
   MaybeBecomeReady();
