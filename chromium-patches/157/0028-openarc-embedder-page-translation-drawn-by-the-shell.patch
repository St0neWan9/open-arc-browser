diff --git a/openarc/bridge/oac_translation.mm b/openarc/bridge/oac_translation.mm
new file mode 100644
index 000000000000..293500064342
--- /dev/null
+++ b/openarc/bridge/oac_translation.mm
@@ -0,0 +1,270 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Page translation (plan B47, OACTranslation.h): the bridge side of
+// openarc/browser/openarc_translate.h. The tab's TranslateTabHelper keeps the
+// state; this file turns it into OACTranslationState snapshots, tells the tab
+// delegate about changes and runs the shell's commands.
+
+#import <OpenArcCore/OACTranslation.h>
+
+#import "openarc/bridge/oac_translation_internal.h"
+
+#include <string>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+
+#import <OpenArcCore/OACTabDelegate.h>
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_profile_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+#include "openarc/browser/openarc_translate.h"
+
+// MARK: - Values
+
+@implementation OACTranslationLanguage {
+  NSString* _code;
+  NSString* _name;
+}
+
+- (instancetype)initWithCode:(NSString*)code name:(NSString*)name {
+  if ((self = [super init])) {
+    _code = [code copy];
+    _name = [name copy];
+  }
+  return self;
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  return self;  // Immutable.
+}
+
+- (NSString*)code {
+  return _code;
+}
+
+- (NSString*)name {
+  return _name;
+}
+
+- (BOOL)isEqual:(id)other {
+  if (![other isKindOfClass:[OACTranslationLanguage class]]) {
+    return NO;
+  }
+  OACTranslationLanguage* language = other;
+  return [_code isEqualToString:language.code];
+}
+
+- (NSUInteger)hash {
+  return _code.hash;
+}
+
+@end
+
+namespace {
+
+OACTranslationLanguage* MakeLanguage(const std::string& code) {
+  if (code.empty()) {
+    return nil;
+  }
+  return [[OACTranslationLanguage alloc]
+      initWithCode:base::SysUTF8ToNSString(code)
+              name:base::SysUTF16ToNSString(
+                       openarc::TranslationLanguageName(code))];
+}
+
+OACTranslationStatus ToStatus(openarc::TranslationStatus status) {
+  switch (status) {
+    case openarc::TranslationStatus::kNone:
+      return OACTranslationStatusNone;
+    case openarc::TranslationStatus::kAvailable:
+      return OACTranslationStatusAvailable;
+    case openarc::TranslationStatus::kTranslating:
+      return OACTranslationStatusTranslating;
+    case openarc::TranslationStatus::kTranslated:
+      return OACTranslationStatusTranslated;
+    case openarc::TranslationStatus::kFailed:
+      return OACTranslationStatusFailed;
+  }
+  return OACTranslationStatusNone;
+}
+
+OACTranslationError ToError(translate::TranslateErrors error) {
+  switch (error) {
+    case translate::TranslateErrors::NONE:
+      return OACTranslationErrorNone;
+    case translate::TranslateErrors::NETWORK:
+    case translate::TranslateErrors::SCRIPT_LOAD_ERROR:
+      return OACTranslationErrorNetwork;
+    case translate::TranslateErrors::INITIALIZATION_ERROR:
+    case translate::TranslateErrors::BAD_ORIGIN:
+      return OACTranslationErrorInitialization;
+    case translate::TranslateErrors::UNKNOWN_LANGUAGE:
+      return OACTranslationErrorUnknownLanguage;
+    case translate::TranslateErrors::UNSUPPORTED_LANGUAGE:
+      return OACTranslationErrorUnsupportedLanguage;
+    case translate::TranslateErrors::IDENTICAL_LANGUAGES:
+      return OACTranslationErrorIdenticalLanguages;
+    case translate::TranslateErrors::TRANSLATION_ERROR:
+      return OACTranslationErrorTranslation;
+    case translate::TranslateErrors::TRANSLATION_TIMEOUT:
+      return OACTranslationErrorTimeout;
+    default:
+      return OACTranslationErrorScript;
+  }
+}
+
+openarc::TranslateTabHelper* HelperOf(OACTab* tab) {
+  content::WebContents* contents = tab.isClosed ? nullptr : tab.webContents;
+  return contents ? openarc::TranslateTabHelper::FromWebContents(contents)
+                  : nullptr;
+}
+
+}  // namespace
+
+@implementation OACTranslationState {
+  OACTranslationStatus _status;
+  OACTranslationError _error;
+  OACTranslationLanguage* _sourceLanguage;
+  OACTranslationLanguage* _targetLanguage;
+}
+
+- (instancetype)initWithStatus:(OACTranslationStatus)status
+                         error:(OACTranslationError)error
+                sourceLanguage:(OACTranslationLanguage*)sourceLanguage
+                targetLanguage:(OACTranslationLanguage*)targetLanguage {
+  if ((self = [super init])) {
+    _status = status;
+    _error = error;
+    _sourceLanguage = sourceLanguage;
+    _targetLanguage = targetLanguage;
+  }
+  return self;
+}
+
++ (OACTranslationState*)none {
+  return [[OACTranslationState alloc] initWithStatus:OACTranslationStatusNone
+                                               error:OACTranslationErrorNone
+                                      sourceLanguage:nil
+                                      targetLanguage:nil];
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  return self;  // Immutable.
+}
+
+- (OACTranslationStatus)status {
+  return _status;
+}
+
+- (OACTranslationError)error {
+  return _error;
+}
+
+- (OACTranslationLanguage*)sourceLanguage {
+  return _sourceLanguage;
+}
+
+- (OACTranslationLanguage*)targetLanguage {
+  return _targetLanguage;
+}
+
+@end
+
+// MARK: - Tab
+
+void OACAttachTranslation(OACTab* tab) {
+  content::WebContents* contents = tab.webContents;
+  if (!contents) {
+    return;
+  }
+  openarc::TranslateTabHelper::CreateForWebContents(contents);
+  __weak OACTab* weak_tab = tab;
+  openarc::TranslateTabHelper::FromWebContents(contents)->SetChangeCallback(
+      base::BindRepeating(^{
+        // Posted like every delegate call (OACDefines.h threading contract);
+        // the delegate reads the new value from `translationState`.
+        OACPostToMainThread(^{
+          OACTab* strong_tab = weak_tab;
+          id<OACTabDelegate> delegate = strong_tab.delegate;
+          if (strong_tab && !strong_tab.isClosed &&
+              [delegate
+                  respondsToSelector:@selector(tabDidChangeTranslationState:)]) {
+            [delegate tabDidChangeTranslationState:strong_tab];
+          }
+        });
+      }));
+}
+
+@implementation OACTab (OACTranslation)
+
+- (OACTranslationState*)translationState {
+  openarc::TranslateTabHelper* helper = HelperOf(self);
+  if (!helper) {
+    return [OACTranslationState none];
+  }
+  const openarc::TranslationSnapshot& snapshot = helper->snapshot();
+  return [[OACTranslationState alloc]
+      initWithStatus:ToStatus(snapshot.status)
+               error:ToError(snapshot.error)
+      sourceLanguage:MakeLanguage(snapshot.source_language)
+      targetLanguage:MakeLanguage(snapshot.target_language)];
+}
+
+- (void)translateToLanguage:(NSString*)languageCode {
+  if (openarc::TranslateTabHelper* helper = HelperOf(self)) {
+    helper->Translate(languageCode.length ? base::SysNSStringToUTF8(languageCode)
+                                          : std::string());
+  }
+}
+
+- (void)revertTranslation {
+  if (openarc::TranslateTabHelper* helper = HelperOf(self)) {
+    helper->Revert();
+  }
+}
+
+- (void)neverTranslateSite {
+  if (openarc::TranslateTabHelper* helper = HelperOf(self)) {
+    helper->NeverTranslateSite();
+  }
+}
+
+@end
+
+// MARK: - Profile and application
+
+@implementation OACProfile (OACTranslation)
+
+- (void)resetTranslationSettings {
+  CHECK(NSThread.isMainThread);
+  if (Profile* profile = self.chromeProfile) {
+    openarc::ResetTranslationSettings(profile);
+  }
+}
+
+@end
+
+@implementation OACApplication (OACTranslation)
+
+- (NSArray<OACTranslationLanguage*>*)translationTargetLanguages {
+  CHECK(NSThread.isMainThread);
+  if (self.state != OACApplicationStateRunning) {
+    return @[];
+  }
+  NSMutableArray<OACTranslationLanguage*>* languages = [NSMutableArray array];
+  for (const auto& [code, name] : openarc::TranslationTargetLanguages()) {
+    [languages addObject:[[OACTranslationLanguage alloc]
+                             initWithCode:base::SysUTF8ToNSString(code)
+                                     name:base::SysUTF16ToNSString(name)]];
+  }
+  return languages;
+}
+
+@end
