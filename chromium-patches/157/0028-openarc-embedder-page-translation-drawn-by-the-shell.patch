--- /dev/null
+++ b/openarc/browser/openarc_translate.cc
@@ -0,0 +1,297 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_translate.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/translate/chrome_translate_client.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/translate/translate_bubble_factory.h"
+#include "components/language_detection/core/constants.h"
+#include "components/translate/core/browser/language_state.h"
+#include "components/translate/core/browser/translate_download_manager.h"
+#include "components/translate/core/browser/translate_manager.h"
+#include "components/translate/core/browser/translate_prefs.h"
+#include "components/translate/core/browser/translate_ui_delegate.h"
+#include "components/translate/core/browser/translate_ui_languages_manager.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace openarc {
+
+namespace {
+
+// Chrome's translate bubble, replaced: every step goes to the tab's helper.
+// Chrome uses the factory whenever no Browser window holds the tab
+// (ChromeTranslateClient::ShowBubble), which is always the case for the
+// bridge's tabs.
+class ShellTranslateBubbleFactory : public TranslateBubbleFactory {
+ protected:
+  ShowTranslateBubbleResult ShowImplementation(
+      BrowserWindow* window,
+      content::WebContents* web_contents,
+      translate::TranslateStep step,
+      const std::string& source_language,
+      const std::string& target_language,
+      translate::TranslateErrors error_type) override {
+    if (auto* helper = TranslateTabHelper::FromWebContents(web_contents)) {
+      helper->OnTranslateStep(step, error_type);
+    }
+    return ShowTranslateBubbleResult::kSuccess;
+  }
+};
+
+translate::TranslateManager* ManagerFor(content::WebContents* web_contents) {
+  return web_contents
+             ? ChromeTranslateClient::GetManagerFromWebContents(web_contents)
+             : nullptr;
+}
+
+// A detected language as a translate code; empty when unknown.
+std::string KnownLanguage(const std::string& language) {
+  if (language.empty() || language == language_detection::kUnknownLanguageCode) {
+    return std::string();
+  }
+  return translate::TranslateDownloadManager::GetLanguageCode(language);
+}
+
+}  // namespace
+
+void InstallTranslateHooks() {
+  static base::NoDestructor<ShellTranslateBubbleFactory> factory;
+  TranslateBubbleFactory::SetFactory(factory.get());
+  // TranslateManager offers translation only with Google API keys. The
+  // translation runs through the Translate Element library Google serves to
+  // websites, which carries its own key; nothing here needs one of ours
+  // (verified in plan B47). The setter is named for tests; it is the only
+  // switch.
+  translate::TranslateManager::SetIgnoreMissingKeyForTesting(true);
+}
+
+std::vector<std::pair<std::string, std::u16string>>
+TranslationTargetLanguages() {
+  std::vector<std::string> codes;
+  translate::TranslateDownloadManager::GetSupportedLanguages(
+      /*translate_allowed=*/true, &codes);
+  // Chrome's language list model: names in the UI language, sorted with the
+  // UI locale's collation, "Detected language" at index 0 (skipped).
+  translate::TranslateUILanguagesManager manager(
+      codes, language_detection::kUnknownLanguageCode, std::string());
+  std::vector<std::pair<std::string, std::u16string>> languages;
+  for (size_t i = 1; i < manager.GetNumberOfLanguages(); ++i) {
+    languages.emplace_back(manager.GetLanguageCodeAt(i),
+                           manager.GetLanguageNameAt(i));
+  }
+  return languages;
+}
+
+std::u16string TranslationLanguageName(std::string_view code) {
+  return l10n_util::GetDisplayNameForLocale(
+      code, g_browser_process->GetApplicationLocale(), /*is_for_ui=*/true);
+}
+
+void ResetTranslationSettings(content::BrowserContext* context) {
+  Profile* profile = Profile::FromBrowserContext(context);
+  if (!profile) {
+    return;
+  }
+  ChromeTranslateClient::CreateTranslatePrefs(profile->GetPrefs())
+      ->ResetToDefaults();
+}
+
+// MARK: - TranslateTabHelper
+
+TranslateTabHelper::TranslateTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TranslateTabHelper>(*web_contents) {
+  if (auto* client = ChromeTranslateClient::FromWebContents(web_contents)) {
+    driver_observation_.Observe(client->translate_driver());
+  }
+}
+
+TranslateTabHelper::~TranslateTabHelper() = default;
+
+void TranslateTabHelper::SetChangeCallback(base::RepeatingClosure callback) {
+  callback_ = std::move(callback);
+}
+
+void TranslateTabHelper::Translate(const std::string& target_language) {
+  translate::TranslateManager* manager = ManagerFor(web_contents());
+  auto* client = ChromeTranslateClient::FromWebContents(web_contents());
+  if (!manager || !client) {
+    return;
+  }
+  std::string source;
+  std::string target;
+  client->GetTranslateLanguages(web_contents(), &source, &target,
+                                /*for_display=*/false);
+  if (KnownLanguage(manager->GetLanguageState()->source_language()).empty()) {
+    return;  // Detection has not finished.
+  }
+  if (!target_language.empty()) {
+    target = target_language;
+  }
+  // As Chrome's manual translation does: the same language on both sides
+  // lets the service detect the source itself.
+  if (source == target) {
+    source = language_detection::kUnknownLanguageCode;
+  }
+  error_ = translate::TranslateErrors::NONE;
+  suppressed_ = false;
+  requested_ = true;
+  // Chrome's bubble path: counts the acceptance (the always-translate
+  // shortcut heuristics), remembers the target, then TranslatePage().
+  translate::TranslateUIDelegate delegate(manager->GetWeakPtr(), source,
+                                          target);
+  delegate.UpdateAndRecordTargetLanguage(target);
+  delegate.Translate();
+  Update();
+}
+
+void TranslateTabHelper::Revert() {
+  translate::TranslateManager* manager = ManagerFor(web_contents());
+  if (!manager) {
+    return;
+  }
+  requested_ = false;
+  error_ = translate::TranslateErrors::NONE;
+  manager->RevertTranslation();
+  Update();
+}
+
+void TranslateTabHelper::NeverTranslateSite() {
+  translate::TranslateManager* manager = ManagerFor(web_contents());
+  if (!manager) {
+    return;
+  }
+  const translate::LanguageState* state = manager->GetLanguageState();
+  translate::TranslateUIDelegate delegate(
+      manager->GetWeakPtr(), KnownLanguage(state->source_language()),
+      KnownLanguage(state->current_language()));
+  if (delegate.CanAddSiteToNeverPromptList()) {
+    delegate.SetNeverPromptSite(true);
+  }
+  if (state->IsPageTranslated()) {
+    manager->RevertTranslation();
+  }
+  requested_ = false;
+  error_ = translate::TranslateErrors::NONE;
+  suppressed_ = true;
+  Update();
+}
+
+void TranslateTabHelper::OnTranslateStep(translate::TranslateStep step,
+                                         translate::TranslateErrors error) {
+  switch (step) {
+    case translate::TRANSLATE_STEP_TRANSLATING:
+      // Also automatic translations (always-translate languages, links from
+      // a translated page), which the shell did not request.
+      requested_ = true;
+      error_ = translate::TranslateErrors::NONE;
+      break;
+    case translate::TRANSLATE_STEP_AFTER_TRANSLATE:
+      requested_ = false;
+      error_ = error;
+      break;
+    case translate::TRANSLATE_STEP_TRANSLATE_ERROR:
+      requested_ = false;
+      error_ = error == translate::TranslateErrors::NONE
+                   ? translate::TranslateErrors::TRANSLATION_ERROR
+                   : error;
+      break;
+    default:
+      break;
+  }
+  Update();
+}
+
+void TranslateTabHelper::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      handle->IsSameDocument()) {
+    return;
+  }
+  requested_ = false;
+  error_ = translate::TranslateErrors::NONE;
+  suppressed_ = false;
+  Update();
+}
+
+void TranslateTabHelper::WebContentsDestroyed() {
+  driver_observation_.Reset();
+  callback_.Reset();
+}
+
+void TranslateTabHelper::OnIsPageTranslatedChanged(
+    content::WebContents* source) {
+  Update();
+}
+
+void TranslateTabHelper::OnTranslateEnabledChanged(
+    content::WebContents* source) {
+  Update();
+}
+
+void TranslateTabHelper::OnPageTranslated(
+    std::string_view source_lang,
+    std::string_view translated_lang,
+    translate::TranslateErrors error_type) {
+  requested_ = false;
+  error_ = error_type;
+  Update();
+}
+
+void TranslateTabHelper::Update() {
+  TranslationSnapshot next;
+  translate::TranslateManager* manager = ManagerFor(web_contents());
+  auto* client = web_contents()
+                     ? ChromeTranslateClient::FromWebContents(web_contents())
+                     : nullptr;
+  if (manager && client) {
+    const translate::LanguageState* state = manager->GetLanguageState();
+    next.source_language = KnownLanguage(state->source_language());
+    if (state->translation_pending() ||
+        (requested_ && error_ == translate::TranslateErrors::NONE)) {
+      next.status = TranslationStatus::kTranslating;
+    } else if (state->IsPageTranslated()) {
+      next.status = TranslationStatus::kTranslated;
+      next.target_language = KnownLanguage(state->current_language());
+    } else if (error_ != translate::TranslateErrors::NONE) {
+      next.status = TranslationStatus::kFailed;
+      next.error = error_;
+    } else if (state->translate_enabled() && !suppressed_ &&
+               !next.source_language.empty()) {
+      // TranslateManager found translation possible for this page (Chrome
+      // shows its omnibox icon then): the page language is not one the user
+      // reads, and no never-translate list holds the site or the language.
+      next.status = TranslationStatus::kAvailable;
+    }
+    if (next.status != TranslationStatus::kNone &&
+        next.target_language.empty()) {
+      std::string source;
+      client->GetTranslateLanguages(web_contents(), &source,
+                                    &next.target_language,
+                                    /*for_display=*/true);
+      next.target_language = KnownLanguage(next.target_language);
+    }
+  }
+  if (next == snapshot_) {
+    return;
+  }
+  snapshot_ = std::move(next);
+  if (callback_) {
+    callback_.Run();
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TranslateTabHelper);
+
+}  // namespace openarc
