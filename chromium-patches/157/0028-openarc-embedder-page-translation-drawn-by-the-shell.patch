+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_TRANSLATE_H_
+#define OPENARC_BROWSER_OPENARC_TRANSLATE_H_
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/scoped_observation.h"
+#include "components/translate/content/browser/content_translate_driver.h"
+#include "components/translate/core/browser/translate_step.h"
+#include "components/translate/core/common/translate_errors.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class BrowserContext;
+}
+
+namespace openarc {
+
+// Page translation for the bridge's tabs (plan B47).
+//
+// //chrome's translate component runs unchanged on every tab (TabHelpers
+// attaches ChromeTranslateClient): the renderer detects the page language,
+// TranslateManager decides whether translation can be offered and translates
+// with Google's Translate Element script. Chrome draws its offer / progress /
+// "translated" bubble with Views; without a Browser it hands every step to
+// TranslateBubbleFactory, which the embedder sets here, so the steps reach
+// this helper instead of a bubble. The helper folds them and Chrome's
+// LanguageState into one TranslationSnapshot per tab for the shell, and runs
+// the shell's commands the way Chrome's bubble does.
+//
+// Keys: TranslateManager offers translation only when Google API keys are
+// configured. The Translate Element library Google serves to websites works
+// without a key of ours (it carries its own), so InstallTranslateHooks() lifts
+// the gate (chromium-bridge/README.md §Translation).
+
+// What the shell shows for a tab. Mirrors OACTranslationStatus.
+enum class TranslationStatus {
+  kNone,
+  kAvailable,
+  kTranslating,
+  kTranslated,
+  kFailed,
+};
+
+struct TranslationSnapshot {
+  TranslationStatus status = TranslationStatus::kNone;
+  translate::TranslateErrors error = translate::TranslateErrors::NONE;
+  // Translate language codes ("de", "zh-CN"); empty while unknown.
+  std::string source_language;
+  std::string target_language;
+
+  bool operator==(const TranslationSnapshot&) const = default;
+};
+
+// Installs the bubble factory and lifts the API key gate. Idempotent; call on
+// the UI thread before tabs exist.
+void InstallTranslateHooks();
+
+// Every language the service translates into: (code, name in the UI
+// language), sorted by name.
+std::vector<std::pair<std::string, std::u16string>> TranslationTargetLanguages();
+
+// The display name of a translate language code in the UI language.
+std::u16string TranslationLanguageName(std::string_view code);
+
+// Forgets the profile's translate decisions (never-translate sites and
+// languages, always-translate pairs, accept / decline counts).
+void ResetTranslationSettings(content::BrowserContext* context);
+
+class TranslateTabHelper
+    : public content::WebContentsObserver,
+      public translate::ContentTranslateDriver::TranslationObserver,
+      public content::WebContentsUserData<TranslateTabHelper> {
+ public:
+  TranslateTabHelper(const TranslateTabHelper&) = delete;
+  TranslateTabHelper& operator=(const TranslateTabHelper&) = delete;
+  ~TranslateTabHelper() override;
+
+  // Called (synchronously, on the UI thread) whenever snapshot() changed.
+  void SetChangeCallback(base::RepeatingClosure callback);
+
+  const TranslationSnapshot& snapshot() const { return snapshot_; }
+
+  // The shell's commands.
+  // Translates into |target_language| (empty: Chrome's target language).
+  void Translate(const std::string& target_language);
+  void Revert();
+  void NeverTranslateSite();
+
+  // A step of Chrome's translate UI (from the bubble factory).
+  void OnTranslateStep(translate::TranslateStep step,
+                       translate::TranslateErrors error);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void WebContentsDestroyed() override;
+
+  // translate::ContentTranslateDriver::TranslationObserver:
+  void OnIsPageTranslatedChanged(content::WebContents* source) override;
+  void OnTranslateEnabledChanged(content::WebContents* source) override;
+  void OnPageTranslated(std::string_view source_lang,
+                        std::string_view translated_lang,
+                        translate::TranslateErrors error_type) override;
+
+ private:
+  friend class content::WebContentsUserData<TranslateTabHelper>;
+  explicit TranslateTabHelper(content::WebContents* web_contents);
+
+  // Recomputes the snapshot and runs the callback when it changed.
+  void Update();
+
+  base::RepeatingClosure callback_;
+  TranslationSnapshot snapshot_;
+  // A translation was requested and its result has not arrived.
+  bool requested_ = false;
+  // The last translation's error (Chrome's LanguageState does not keep script
+  // download failures).
+  translate::TranslateErrors error_ = translate::TranslateErrors::NONE;
+  // "Never translate this site" on the current page: no offer until the next
+  // navigation (Chrome's own trigger then sees the list).
+  bool suppressed_ = false;
+  base::ScopedObservation<translate::ContentTranslateDriver,
+                          translate::ContentTranslateDriver::TranslationObserver>
+      driver_observation_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_TRANSLATE_H_
