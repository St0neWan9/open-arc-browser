 std::optional<int> OpenArcMainDelegate::BasicStartupComplete() {
-  const base::CommandLine& command_line =
-      *base::CommandLine::ForCurrentProcess();
-  logging::LoggingSettings settings;
-  // stderr by default during bring-up; --enable-logging=... still overrides.
-  settings.logging_dest =
-      command_line.HasSwitch(switches::kEnableLogging)
-          ? logging::LOG_DEFAULT
-          : (logging::LOG_TO_SYSTEM_DEBUG_LOG | logging::LOG_TO_STDERR);
-  logging::InitLogging(settings);
-  logging::SetLogItems(/*enable_process_id=*/true, /*enable_thread_id=*/true,
-                       /*enable_timestamp=*/true, /*enable_tickcount=*/false);
-  return std::nullopt;
+  // Chrome's hang watcher treats a long task on the browser's main thread as a
+  // hang worth a crash report. Here that thread is the shell app's main thread
+  // and runs the app's own work too, and the UI pump is attached to the app's
+  // run loop (patch 0001), not run by Chrome. Off in every process, before
+  // ChromeMainDelegate reads the feature list.
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  std::string disabled =
+      command_line->GetSwitchValueASCII(switches::kDisableFeatures);
+  if (disabled.find("EnableHangWatcher") == std::string::npos) {
+    disabled += disabled.empty() ? "EnableHangWatcher" : ",EnableHangWatcher";
+    command_line->AppendSwitchASCII(switches::kDisableFeatures, disabled);
+  }
+
+  std::optional<int> exit_code = ChromeMainDelegate::BasicStartupComplete();
+  // Chrome keeps freed Objective-C objects as zombies to diagnose crashes.
+  // Here the browser process is the shell app; its own objects are none of
+  // Chromium's business.
+  ObjcEvilDoers::ZombieDisable();
+  return exit_code;
 }
 
 void OpenArcMainDelegate::PreSandboxStartup() {
-  ui::ResourceBundle::InitSharedInstanceWithPakPath(GetResourcesPakPath());
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(switches::kProcessType) &&
+      !user_data_directory_.empty()) {
+    // Crash reports go below our user data directory (plan D8), not to
+    // Chromium's default ~/Library/Application Support/Chromium/Crashpad.
+    // Chrome's crash reporter starts in ChromeMainDelegate::PreSandboxStartup.
+    base::PathService::OverrideAndCreateIfNeeded(
+        chrome::DIR_CRASH_DUMPS, user_data_directory_.Append("Crashpad"),
+        /*is_absolute=*/true, /*create=*/true);
+  }
+  ChromeMainDelegate::PreSandboxStartup();
 }
 
