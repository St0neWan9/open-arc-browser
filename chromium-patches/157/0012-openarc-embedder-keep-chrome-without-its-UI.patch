+++ b/openarc/browser/openarc_browser_main_extra_parts.mm
@@ -0,0 +1,77 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_browser_main_extra_parts.h"
+
+#include "base/check.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/os_crypt/common/keychain_password_mac.h"
+#include "components/prefs/pref_service.h"
+#include "components/safe_browsing/core/common/safe_browsing_prefs.h"
+#include "components/signin/public/base/signin_pref_names.h"
+
+namespace openarc {
+
+namespace {
+
+OpenArcBrowserMainExtraParts* g_extra_parts = nullptr;
+
+// The keychain item holding the os_crypt key (OACApplication.h, decision Q5:
+// placeholder product name). Shared by the release and development apps,
+// which keep their data in different directories anyway.
+constexpr char kKeychainServiceName[] = "Open Arc Safe Storage";
+constexpr char kKeychainAccountName[] = "Open Arc";
+
+}  // namespace
+
+OpenArcBrowserMainExtraParts::OpenArcBrowserMainExtraParts() {
+  CHECK(!g_extra_parts);
+  g_extra_parts = this;
+}
+
+OpenArcBrowserMainExtraParts::~OpenArcBrowserMainExtraParts() {
+  CHECK_EQ(g_extra_parts, this);
+  g_extra_parts = nullptr;
+}
+
+// static
+OpenArcBrowserMainExtraParts* OpenArcBrowserMainExtraParts::Get() {
+  return g_extra_parts;
+}
+
+void OpenArcBrowserMainExtraParts::SetWillDestroyProfilesCallback(
+    base::OnceClosure callback) {
+  will_destroy_profiles_ = std::move(callback);
+}
+
+void OpenArcBrowserMainExtraParts::PostEarlyInitialization() {
+  // Before any profile (and its cookie store) asks for the key.
+  KeychainPassword::GetServiceName() = kKeychainServiceName;
+  KeychainPassword::GetAccountName() = kKeychainAccountName;
+
+  // No Chrome background mode: the app's own lifetime decides.
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    local_state->SetDefaultPrefValue(prefs::kBackgroundModeEnabled,
+                                     base::Value(false));
+  }
+}
+
+void OpenArcBrowserMainExtraParts::PostProfileInit(Profile* profile,
+                                                   bool is_initial_profile) {
+  // Defaults, not user values: a later settings UI (or policy) still wins.
+  PrefService* prefs = profile->GetPrefs();
+  prefs->SetDefaultPrefValue(prefs::kSafeBrowsingEnabled, base::Value(false));
+  prefs->SetDefaultPrefValue(prefs::kSigninAllowed, base::Value(false));
+}
+
+void OpenArcBrowserMainExtraParts::PostMainMessageLoopRun() {
+  if (will_destroy_profiles_) {
+    std::move(will_destroy_profiles_).Run();
+  }
+}
+
+}  // namespace openarc
