+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_TAB_HELPERS_H_
+#define OPENARC_BROWSER_OPENARC_TAB_HELPERS_H_
+
+namespace content {
+class WebContents;
+}
+
+namespace openarc {
+
+// Makes a WebContents a full //chrome tab without a Browser: Chrome's tab
+// helpers (favicon driver, find, zoom, content settings, permissions, history,
+// password manager and autofill drivers, extensions tab helper, ...) are
+// attached by TabHelpers::AttachTabHelpers() (an Open Arc patch makes this
+// class its friend). The permission prompt is replaced: Chrome's bubbles need
+// a Browser window, so until plan C12 routes prompts to the shell every
+// request is dismissed (the page sees "denied", nothing is stored).
+class TabHelpersAccess {
+ public:
+  TabHelpersAccess() = delete;
+
+  // Safe to call more than once.
+  static void AttachTabHelpers(content::WebContents* web_contents);
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_TAB_HELPERS_H_
