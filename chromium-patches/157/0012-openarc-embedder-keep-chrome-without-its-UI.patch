+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_BROWSER_MAIN_EXTRA_PARTS_H_
+#define OPENARC_BROWSER_OPENARC_BROWSER_MAIN_EXTRA_PARTS_H_
+
+#include "base/functional/callback.h"
+#include "chrome/browser/chrome_browser_main_extra_parts.h"
+
+class Profile;
+
+namespace openarc {
+
+// Open Arc's stage hooks inside //chrome's browser main parts:
+// - names the Mac keychain item that protects cookies and passwords, so it is
+//   never Chromium's own "Chromium Safe Storage";
+// - Open Arc's defaults for every profile: Safe Browsing off (no Google API
+//   keys), browser sign-in off (sync is our own CloudKit sync of the
+//   workspace; Chrome sync is never set up), background mode off;
+// - runs the bridge's callback before Chrome tears profiles down, so every
+//   OACTab closes its WebContents while its profile is still alive.
+class OpenArcBrowserMainExtraParts : public ChromeBrowserMainExtraParts {
+ public:
+  OpenArcBrowserMainExtraParts();
+  OpenArcBrowserMainExtraParts(const OpenArcBrowserMainExtraParts&) = delete;
+  OpenArcBrowserMainExtraParts& operator=(const OpenArcBrowserMainExtraParts&) =
+      delete;
+  ~OpenArcBrowserMainExtraParts() override;
+
+  // The instance while the browser process runs, else nullptr.
+  static OpenArcBrowserMainExtraParts* Get();
+
+  // Runs once, at the start of PostMainMessageLoopRun, before Chrome destroys
+  // its profiles.
+  void SetWillDestroyProfilesCallback(base::OnceClosure callback);
+
+  // ChromeBrowserMainExtraParts:
+  void PostEarlyInitialization() override;
+  void PostProfileInit(Profile* profile, bool is_initial_profile) override;
+  void PostMainMessageLoopRun() override;
+
+ private:
+  base::OnceClosure will_destroy_profiles_;
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_BROWSER_MAIN_EXTRA_PARTS_H_
