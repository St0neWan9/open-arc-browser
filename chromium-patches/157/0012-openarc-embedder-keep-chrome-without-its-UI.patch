@@ -0,0 +1,88 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_tab_helpers.h"
+
+#include <memory>
+#include <optional>
+#include <variant>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/tab_helpers.h"
+#include "components/permissions/permission_prompt.h"
+#include "components/permissions/permission_request_manager.h"
+#include "components/permissions/permission_uma_constants.h"
+#include "content/public/browser/web_contents.h"
+
+namespace openarc {
+
+namespace {
+
+// A permission prompt nobody sees: it dismisses the request as soon as it is
+// shown. Dismissing (not denying) stores no decision for the site.
+// TODO(C12): ask the shell through OACDialogDelegate instead.
+class DismissingPermissionPrompt : public permissions::PermissionPrompt {
+ public:
+  explicit DismissingPermissionPrompt(Delegate* delegate) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<Delegate> delegate) {
+                         if (delegate && !delegate->Requests().empty()) {
+                           delegate->Dismiss(std::monostate());
+                         }
+                       },
+                       delegate->GetWeakPtr()));
+  }
+  DismissingPermissionPrompt(const DismissingPermissionPrompt&) = delete;
+  DismissingPermissionPrompt& operator=(const DismissingPermissionPrompt&) =
+      delete;
+  ~DismissingPermissionPrompt() override = default;
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    return TabSwitchingBehavior::kKeepPromptAlive;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::NONE_VISIBLE;
+  }
+  bool IsAskPrompt() const override { return false; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override {
+    return {};
+  }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+};
+
+std::unique_ptr<permissions::PermissionPrompt> CreateDismissingPrompt(
+    content::WebContents* web_contents,
+    permissions::PermissionPrompt::Delegate* delegate) {
+  return std::make_unique<DismissingPermissionPrompt>(delegate);
+}
+
+}  // namespace
+
+// static
+void TabHelpersAccess::AttachTabHelpers(content::WebContents* web_contents) {
+  TabHelpers::AttachTabHelpers(web_contents);
+  if (auto* manager = permissions::PermissionRequestManager::FromWebContents(
+          web_contents)) {
+    // The setter is named for tests; it is the only way to choose the prompt
+    // view without a Browser.
+    manager->set_view_factory_for_testing(
+        base::BindRepeating(&CreateDismissingPrompt));
+  }
+}
+
+}  // namespace openarc
