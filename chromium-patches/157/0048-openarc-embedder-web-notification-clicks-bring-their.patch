       base::BindRepeating([](content::WebContents* contents) {
diff --git a/openarc/bridge/oac_notifications.mm b/openarc/bridge/oac_notifications.mm
new file mode 100644
index 000000000000..109179b2e30b
--- /dev/null
+++ b/openarc/bridge/oac_notifications.mm
@@ -0,0 +1,87 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/bridge/oac_notifications_internal.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/notifications/non_persistent_notification_handler.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "net/base/apple/url_conversions.h"
+#include "url/gurl.h"
+
+#import <OpenArcCore/OACApplication.h>
+#import <OpenArcCore/OACProfile.h>
+#import <OpenArcCore/OACTabDelegate.h>
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_profile_internal.h"
+#import "openarc/bridge/oac_requests_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+
+namespace {
+
+// The bridge profile wrapping |profile| (or its off-the-record variant).
+OACProfile* BridgeProfileFor(Profile* profile) {
+  if (!profile) {
+    return nil;
+  }
+  for (OACProfile* candidate in OACApplication.sharedApplication
+           .loadedProfiles) {
+    if (!candidate.valid ||
+        candidate.chromeProfile != profile->GetOriginalProfile()) {
+      continue;
+    }
+    return profile->IsOffTheRecord() ? candidate.offTheRecordProfile
+                                     : candidate;
+  }
+  return nil;
+}
+
+void NotificationClicked(Profile* profile,
+                         const GURL& origin,
+                         content::WebContents* web_contents) {
+  // The user clicked in Notification Center: the app comes forward, as
+  // Chrome's notification clicks bring Chrome forward.
+  [NSApp activateIgnoringOtherApps:YES];
+  // The tab's own contents (the document may sit in an inner one, a PDF).
+  content::WebContents* tab_contents =
+      OACTabForWebContents(web_contents).webContents;
+  if (tab_contents && tab_contents->GetDelegate()) {
+    // The shell selects the tab and brings its window forward, as for
+    // window.focus() (tabDidRequestActivation:).
+    tab_contents->GetDelegate()->ActivateContents(tab_contents);
+    return;
+  }
+  // The page that showed it is gone: open its origin in a new tab, as
+  // Chrome does. Requests from outside a tab go to the app delegate.
+  OACProfile* bridge_profile = BridgeProfileFor(profile);
+  if (!bridge_profile || !origin.is_valid()) {
+    return;
+  }
+  OACNewTabRequest* request = [[OACNewTabRequest alloc]
+      initWithOpener:nil
+             profile:bridge_profile
+                 URL:net::NSURLWithGURL(origin)
+         disposition:OACNewTabDispositionForegroundTab
+      hasUserGesture:YES
+      requestedFrame:CGRectNull];
+  OACPostToMainThread(^{
+    OACApplication* application = OACApplication.sharedApplication;
+    id<OACApplicationDelegate> delegate = application.delegate;
+    if ([delegate respondsToSelector:@selector(application:didRequestNewTab:)]) {
+      [delegate application:application didRequestNewTab:request];
+    }
+  });
+}
+
+}  // namespace
+
+void OACInstallNotificationHooks() {
+  NonPersistentNotificationHandler::SetEmbedderClickCallback(
+      base::BindRepeating(&NotificationClicked));
+}
diff --git a/openarc/bridge/oac_notifications_internal.h b/openarc/bridge/oac_notifications_internal.h
new file mode 100644
index 000000000000..f7ad9864b9c5
--- /dev/null
+++ b/openarc/bridge/oac_notifications_internal.h
@@ -0,0 +1,18 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BRIDGE_OAC_NOTIFICATIONS_INTERNAL_H_
+#define OPENARC_BRIDGE_OAC_NOTIFICATIONS_INTERNAL_H_
+
+// Plan C24: web notifications. Chrome's Mac notification bridge already shows
+// them in Notification Center (banners from the app, alerts from the Alerts
+// helper). A click goes through //chrome's non-persistent handler; this hook
+// brings the tab that showed the notification forward
+// (-[OACTabDelegate tabDidRequestActivation:]) and, when that page is gone,
+// asks the app delegate for a new tab on the notification's origin
+// (-[OACApplicationDelegate application:didRequestNewTab:]) instead of
+// Chrome's Browser-window fallback. Called once when the engine starts.
+void OACInstallNotificationHooks();
+
+#endif  // OPENARC_BRIDGE_OAC_NOTIFICATIONS_INTERNAL_H_
