From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Open Arc Authors <dev@openarc.invalid>
Date: Mon, 16 Nov 2026 06:24:38 +0700
Subject: [PATCH] openarc: components: let the embedder supply the password
 leak check

LeakDetectionDelegate always builds Google's leak check
(LeakDetectionCheckFactoryImpl), which needs a signed-in account or a
Google API key. Open Arc has neither and checks passwords against Have I
Been Pwned's k-anonymity range API instead (plan B235).

LeakDetectionDelegate::SetEmbedderFactoryCreator() installs a function
that makes the factory every later delegate uses. Without it the
upstream behaviour is unchanged.
---
 .../core/browser/leak_detection_delegate.cc        | 14 +++++++++++++-
 .../core/browser/leak_detection_delegate.h         |  7 +++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/components/password_manager/core/browser/leak_detection_delegate.cc b/components/password_manager/core/browser/leak_detection_delegate.cc
index 76e46020813a..d7e594e219f0 100644
--- a/components/password_manager/core/browser/leak_detection_delegate.cc
+++ b/components/password_manager/core/browser/leak_detection_delegate.cc
@@ -101,9 +101,21 @@ LeakDetectionUrlType GetLeakDetectionUrlType(const GURL& url) {
 
 }  // namespace
 
+// Open Arc: see LeakDetectionDelegate::SetEmbedderFactoryCreator().
+LeakDetectionDelegate::EmbedderFactoryCreator g_embedder_factory_creator =
+    nullptr;
+
+// static
+void LeakDetectionDelegate::SetEmbedderFactoryCreator(
+    EmbedderFactoryCreator creator) {
+  g_embedder_factory_creator = creator;
+}
+
 LeakDetectionDelegate::LeakDetectionDelegate(PasswordManagerClient* client)
     : client_(client),
-      leak_factory_(std::make_unique<LeakDetectionCheckFactoryImpl>()) {}
+      leak_factory_(g_embedder_factory_creator
+                        ? g_embedder_factory_creator()
+                        : std::make_unique<LeakDetectionCheckFactoryImpl>()) {}
 
 LeakDetectionDelegate::~LeakDetectionDelegate() = default;
 
diff --git a/components/password_manager/core/browser/leak_detection_delegate.h b/components/password_manager/core/browser/leak_detection_delegate.h
index 537bb0e08bb7..ec3ba61d1574 100644
--- a/components/password_manager/core/browser/leak_detection_delegate.h
+++ b/components/password_manager/core/browser/leak_detection_delegate.h
@@ -42,6 +42,13 @@ class LeakDetectionDelegate {
   }
 #endif  // defined(UNIT_TEST)
 
+  // Open Arc: an embedder without Google's leak check API supplies its own
+  // check (plan B235); every delegate made afterwards uses a factory from
+  // `creator` instead of LeakDetectionCheckFactoryImpl. nullptr clears it. UI
+  // thread only.
+  using EmbedderFactoryCreator = std::unique_ptr<LeakDetectionCheckFactory> (*)();
+  static void SetEmbedderFactoryCreator(EmbedderFactoryCreator creator);
+
   void StartLeakCheck(LeakDetectionInitiator initiator,
                       const PasswordForm& credentials,
                       const GURL& form_url,
