+// MARK: Chromium-family profiles
+
+ReadResult<HistoryPage> ReadChromiumHistory(const base::FilePath& profile_dir,
+                                            const base::FilePath& temp,
+                                            base::Time cutoff) {
+  ReadResult<HistoryPage> result;
+  base::expected<base::FilePath, ImportStatus> copy =
+      CopySource(profile_dir.Append("History"), temp);
+  if (!copy.has_value()) {
+    result.status = copy.error();
+    return result;
+  }
+  std::unique_ptr<sql::Database> db = OpenDatabase(*copy);
+  if (!db || !db->DoesTableExist("urls")) {
+    result.status = ImportStatus::kUnreadable;
+    return result;
+  }
+  sql::Statement statement(db->GetUniqueStatement(
+      "SELECT url, title, visit_count, typed_count, last_visit_time FROM urls "
+      "WHERE hidden = 0"));
+  while (statement.Step()) {
+    HistoryPage page;
+    page.url = GURL(statement.ColumnStringView(0));
+    page.title = statement.ColumnString16(1);
+    page.visit_count = std::max(1, statement.ColumnInt(2));
+    page.typed_count = std::max(0, statement.ColumnInt(3));
+    page.last_visit = statement.ColumnTime(4);
+    if (KeepPage(page.url, page.last_visit, cutoff)) {
+      result.items.push_back(std::move(page));
+    }
+  }
+  result.status = statement.Succeeded() ? ImportStatus::kSuccess
+                                        : ImportStatus::kUnreadable;
+  return result;
+}
+
+// The browser's "Safe Storage" password, as Chromium's keychain key provider
+// reads its own: from the real keychain (macOS asks the user before handing
+// another app's item to Open Arc; the read blocks this background sequence
+// until answered). Under --use-mock-keychain (tests, the development build) a
+// missing item falls back to Chromium's mock keychain password, so profiles
+// written by such builds import too.
+std::optional<std::string> ReadSafeStoragePassword(const std::string& service,
+                                                   const std::string& account) {
+  base::expected<std::vector<uint8_t>, OSStatus> password =
+      crypto::apple::KeychainV2::GetInstance().FindGenericPassword(service,
+                                                                   account);
+  if ((!password.has_value() || password->empty()) &&
+      password.error_or(errSecItemNotFound) == errSecItemNotFound &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          os_crypt::switches::kUseMockKeychain)) {
+    crypto::apple::FakeKeychainV2 mock("openarc-import");
+    password = mock.FindGenericPassword(service, account);
+  }
+  if (!password.has_value() || password->empty()) {
+    return std::nullopt;
+  }
+  return std::string(password->begin(), password->end());
+}
+
+std::optional<std::string> DecryptPassword(base::span<const uint8_t> key,
+                                           base::span<const uint8_t> blob) {
+  static constexpr std::array<uint8_t, 3> kPrefix = {'v', '1', '0'};
+  if (blob.size() <= kPrefix.size() ||
+      !std::ranges::equal(blob.first(kPrefix.size()), kPrefix)) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, crypto::aes_cbc::kBlockSize> iv;
+  iv.fill(' ');
+  std::optional<std::vector<uint8_t>> plain =
+      crypto::aes_cbc::Decrypt(key, iv, blob.subspan(kPrefix.size()));
+  if (!plain) {
+    return std::nullopt;
+  }
+  return std::string(plain->begin(), plain->end());
+}
+
+ReadResult<Login> ReadChromiumLogins(const base::FilePath& profile_dir,
+                                     const base::FilePath& temp,
+                                     const std::string& keychain_service,
+                                     const std::string& keychain_account) {
+  ReadResult<Login> result;
+  std::vector<base::FilePath> copies;
+  ImportStatus first_error = ImportStatus::kNotFound;
+  for (const char* name : {"Login Data", "Login Data For Account"}) {
+    base::expected<base::FilePath, ImportStatus> copy =
+        CopySource(profile_dir.Append(name), temp);
+    if (copy.has_value()) {
+      copies.push_back(*copy);
+    } else if (first_error == ImportStatus::kNotFound) {
+      first_error = copy.error();
+    }
+  }
+  if (copies.empty()) {
+    result.status = first_error;
+    return result;
+  }
+
+  // Rows first: the keychain is only asked when there is something to decrypt.
+  struct Row {
+    GURL url;
+    std::string username;
+    std::vector<uint8_t> blob;
+  };
+  std::vector<Row> rows;
+  for (const base::FilePath& copy : copies) {
+    std::unique_ptr<sql::Database> db = OpenDatabase(copy);
+    if (!db || !db->DoesTableExist("logins")) {
+      continue;
+    }
+    sql::Statement statement(db->GetUniqueStatement(
+        "SELECT origin_url, username_value, password_value FROM logins "
+        "WHERE blacklisted_by_user = 0"));
+    while (statement.Step()) {
+      Row row;
+      row.url = GURL(statement.ColumnStringView(0));
+      row.username = statement.ColumnString(1);
+      row.blob = statement.ColumnBlobAsVector(2);
+      if (row.url.is_valid() && !row.blob.empty()) {
+        rows.push_back(std::move(row));
+      }
+    }
+  }
+  if (rows.empty()) {
+    result.status = ImportStatus::kSuccess;
+    return result;
+  }
+
+  std::optional<std::string> password =
+      ReadSafeStoragePassword(keychain_service, keychain_account);
+  if (!password) {
+    result.status = ImportStatus::kKeychainDenied;
+    return result;
+  }
+  static constexpr std::array<uint8_t, 9> kSalt = {'s', 'a', 'l', 't', 'y',
+                                                   's', 'a', 'l', 't'};
+  std::array<uint8_t, 16> key;
+  CHECK(PKCS5_PBKDF2_HMAC_SHA1(password->data(), password->size(), kSalt.data(),
+                               kSalt.size(), /*iterations=*/1003, key.size(),
+                               key.data()));
+  for (Row& row : rows) {
+    std::optional<std::string> plain = DecryptPassword(key, row.blob);
+    if (!plain || plain->empty()) {
+      ++result.failures;
+      continue;
+    }
+    result.items.push_back({std::move(row.url), std::move(row.username),
+                            std::move(*plain)});
+  }
+  result.status = result.items.empty() ? ImportStatus::kDecryptionFailed
+                                       : ImportStatus::kSuccess;
+  return result;
+}
+
+// MARK: Safari
+
+ReadResult<HistoryPage> ReadSafariHistoryDatabase(
+    const base::FilePath& library_dir,
+    const base::FilePath& temp,
+    base::Time cutoff) {
+  ReadResult<HistoryPage> result;
+  base::expected<base::FilePath, ImportStatus> copy =
+      CopySource(library_dir.Append("History.db"), temp);
+  if (!copy.has_value()) {
+    result.status = copy.error();
+    return result;
+  }
+  std::unique_ptr<sql::Database> db = OpenDatabase(*copy);
+  if (!db || !db->DoesTableExist("history_items") ||
+      !db->DoesTableExist("history_visits")) {
+    result.status = ImportStatus::kUnreadable;
+    return result;
+  }
+  // The newest successful, non-redirecting visit of each item gives the title
+  // and the last visit time.
+  sql::Statement statement(db->GetUniqueStatement(
+      "SELECT i.url, v.title, i.visit_count, MAX(v.visit_time) "
+      "FROM history_items i JOIN history_visits v ON v.history_item = i.id "
+      "WHERE v.load_successful = 1 AND v.redirect_destination IS NULL "
+      "GROUP BY i.id"));
+  while (statement.Step()) {
+    HistoryPage page;
+    page.url = GURL(statement.ColumnStringView(0));
+    page.title = statement.ColumnString16(1);
+    page.visit_count = std::max(1, statement.ColumnInt(2));
+    page.last_visit = base::Time::FromCFAbsoluteTime(statement.ColumnDouble(3));
+    if (KeepPage(page.url, page.last_visit, cutoff)) {
+      result.items.push_back(std::move(page));
+    }
+  }
+  result.status = statement.Succeeded() ? ImportStatus::kSuccess
+                                        : ImportStatus::kUnreadable;
+  return result;
+}
+
+// Appends the pages of one Safari history JSON export. Returns false when the
+// text is not such a file.
+bool ParseSafariHistoryJSON(std::string_view json,
+                            base::Time cutoff,
+                            std::vector<HistoryPage>& pages) {
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    return false;
+  }
+  const std::string* type = root->FindStringByDottedPath("metadata.data_type");
+  const base::ListValue* items = root->FindList("history");
+  if (!type || *type != "history" || !items) {
+    return false;
+  }
+  for (const base::Value& value : *items) {
+    const base::DictValue* item = value.GetIfDict();
+    if (!item) {
+      continue;
+    }
+    const std::string* url = item->FindString("url");
+    std::optional<double> time_usec = item->FindDouble("time_usec");
+    if (!url || !time_usec) {
+      continue;
+    }
+    // Redirect sources (an entry that led on to another URL) are left out,
+    // as Chrome's own Safari export importer does.
+    const std::string* destination = item->FindString("destination_url");
+    if (destination && !destination->empty() && *destination != *url) {
+      continue;
+    }
+    HistoryPage page;
+    page.url = GURL(*url);
+    if (const std::string* title = item->FindString("title")) {
+      page.title = base::UTF8ToUTF16(*title);
+    }
+    page.visit_count =
+        std::max(1, static_cast<int>(item->FindDouble("visit_count").value_or(1)));
+    page.last_visit =
+        base::Time::UnixEpoch() + base::Microseconds(static_cast<int64_t>(*time_usec));
+    if (KeepPage(page.url, page.last_visit, cutoff)) {
+      pages.push_back(std::move(page));
+    }
+  }
+  return true;
+}
+
+bool LooksLikePasswordsCSV(std::string_view text) {
+  std::string_view header = text.substr(0, text.find('\n'));
+  std::string lower = base::ToLowerASCII(header);
+  return lower.find("password") != std::string::npos &&
+         (lower.find("url") != std::string::npos ||
+          lower.find("website") != std::string::npos ||
+          lower.find("origin") != std::string::npos);
+}
+
+// Safari's export ZIP, a CSV or a single history JSON.
+SourceData ReadExportFile(const base::FilePath& path,
+                          bool want_history,
+                          bool want_passwords,
+                          base::Time cutoff) {
+  SourceData data;
+  auto set_both = [&](ImportStatus status) {
+    if (want_history) {
+      data.history.status = status;
+    }
+    if (want_passwords) {
+      data.passwords.status = status;
+    }
+  };
+  base::File probe(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!probe.IsValid()) {
+    set_both(probe.error_details() == base::File::FILE_ERROR_ACCESS_DENIED
+                 ? ImportStatus::kPermissionDenied
+                 : probe.error_details() == base::File::FILE_ERROR_NOT_FOUND
+                       ? ImportStatus::kNotFound
+                       : ImportStatus::kUnreadable);
+    return data;
+  }
+  probe.Close();
+  if (want_history) {
+    data.history.status = ImportStatus::kNotFound;
+  }
+  if (want_passwords) {
+    data.passwords.status = ImportStatus::kNotFound;
+  }
+
+  zip::ZipReader reader;
+  if (reader.Open(path)) {
+    bool any_history = false;
+    while (const zip::ZipReader::Entry* entry = reader.Next()) {
+      if (entry->is_directory || entry->is_unsafe) {
+        continue;
+      }
+      const std::string name = entry->path.BaseName().AsUTF8Unsafe();
+      if (name.empty() || name[0] == '.') {
+        continue;
+      }
+      const bool is_csv = entry->path.MatchesExtension(".csv");
+      const bool is_json = entry->path.MatchesExtension(".json");
+      if (!(is_csv && want_passwords) && !(is_json && want_history)) {
+        continue;
+      }
+      std::string contents;
+      if (!reader.ExtractCurrentEntryToString(kMaxFileBytes, &contents)) {
+        continue;
+      }
+      if (is_csv && data.passwords.csv.empty() &&
+          LooksLikePasswordsCSV(contents)) {
+        data.passwords.csv = std::move(contents);
+        data.passwords.status = ImportStatus::kSuccess;
+      } else if (is_json &&
+                 ParseSafariHistoryJSON(contents, cutoff, data.history.items)) {
+        any_history = true;
+      }
+    }
+    if (any_history) {
+      data.history.status = ImportStatus::kSuccess;
+    }
+    return data;
+  }
+
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, kMaxFileBytes)) {
+    set_both(ImportStatus::kUnreadable);
+    return data;
+  }
+  if (want_history && path.MatchesExtension(".json")) {
+    data.history.status =
+        ParseSafariHistoryJSON(contents, cutoff, data.history.items)
+            ? ImportStatus::kSuccess
+            : ImportStatus::kUnreadable;
+  }
+  if (want_passwords && path.MatchesExtension(".csv")) {
+    if (LooksLikePasswordsCSV(contents)) {
+      data.passwords.csv = std::move(contents);
+      data.passwords.status = ImportStatus::kSuccess;
+    } else {
+      data.passwords.status = ImportStatus::kUnreadable;
+    }
+  }
+  return data;
+}
+
+SourceData ReadSource(const ImportRequest& request) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  const base::Time cutoff = base::Time::Now() - kHistoryWindow;
+  if (request.kind == ImportSourceKind::kExportFile) {
+    return ReadExportFile(request.path, request.history, request.passwords,
+                          cutoff);
+  }
+  SourceData data;
+  base::ScopedTempDir temp;
+  if (!temp.CreateUniqueTempDir()) {
+    if (request.history) {
+      data.history.status = ImportStatus::kUnreadable;
+    }
+    if (request.passwords) {
+      data.passwords.status = ImportStatus::kUnreadable;
+    }
+    return data;
+  }
+  if (request.kind == ImportSourceKind::kChromiumProfile) {
+    if (request.history) {
+      data.history = ReadChromiumHistory(request.path, temp.GetPath(), cutoff);
+    }
+    if (request.passwords) {
+      data.passwords =
+          ReadChromiumLogins(request.path, temp.GetPath(),
+                             request.keychain_service, request.keychain_account);
+    }
+  } else {
+    if (request.history) {
+      data.history =
+          ReadSafariHistoryDatabase(request.path, temp.GetPath(), cutoff);
+    }
+    // Safari keeps its passwords in the system keychain, out of reach: they
+    // come from Safari's export file.
+    if (request.passwords) {
+      data.passwords.status = ImportStatus::kNotFound;
+    }
+  }
+  return data;
+}
+
+// MARK: Writing
+
+// Owns itself from the read until |done| ran: a profile keep-alive, the
+// password presenter and importer.
+class ImportJob {
+ public:
+  ImportJob(Profile* profile, ImportCallback done)
+      : profile_(profile->GetWeakPtr()),
+        keep_alive_(std::make_unique<ScopedProfileKeepAlive>(
+            profile,
+            ProfileKeepAliveOrigin::kProfileStatistics)),
+        done_(std::move(done)) {}
+
+  void Start(const ImportRequest& request) {
+    outcome_.history_status = request.history ? ImportStatus::kUnavailable
+                                              : ImportStatus::kNotRequested;
+    outcome_.password_status = request.passwords ? ImportStatus::kUnavailable
+                                                 : ImportStatus::kNotRequested;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&ReadSource, request),
+        base::BindOnce(&ImportJob::OnRead, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnRead(SourceData data) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    Profile* profile = profile_.get();
+    if (!profile) {
+      Finish();
+      return;
+    }
+    WriteHistory(profile, std::move(data.history));
+    WritePasswords(profile, std::move(data.passwords));
+  }
+
+  void WriteHistory(Profile* profile, ReadResult<HistoryPage> history) {
+    if (history.status == ImportStatus::kNotRequested) {
+      return;
+    }
+    outcome_.history_status = history.status;
+    if (history.status != ImportStatus::kSuccess) {
+      return;
+    }
+    history::URLRows rows;
+    rows.reserve(history.items.size());
+    for (HistoryPage& page : history.items) {
+      history::URLRow row(page.url);
+      row.set_title(page.title);
+      row.set_visit_count(page.visit_count);
+      row.set_typed_count(page.typed_count);
+      row.set_last_visit(page.last_visit);
+      rows.push_back(std::move(row));
+    }
+    if (!rows.empty()) {
+      // //chrome's import writer; the visits carry an imported source, so they
+      // count as history but not as local browsing.
+      base::MakeRefCounted<ProfileWriter>(profile)->AddHistoryPage(
+          rows, history::SOURCE_SAFARI_IMPORTED);
+    }
+    outcome_.history_count = static_cast<int>(rows.size());
+  }
+
+  void WritePasswords(Profile* profile, ReadResult<Login> passwords) {
+    if (passwords.status == ImportStatus::kNotRequested) {
+      Finish();
+      return;
+    }
+    outcome_.password_status = passwords.status;
+    outcome_.password_failures = passwords.failures;
+    if (passwords.status != ImportStatus::kSuccess ||
+        (passwords.items.empty() && passwords.csv.empty())) {
+      Finish();
+      return;
+    }
+    scoped_refptr<password_manager::PasswordStoreInterface> store =
+        ProfilePasswordStoreFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS);
+    if (!store) {
+      outcome_.password_status = ImportStatus::kUnavailable;
+      Finish();
+      return;
+    }
+    // Only the profile store: Open Arc has no account store (no Google sign-in).
+    presenter_ = std::make_unique<password_manager::SavedPasswordsPresenter>(
+        AffiliationServiceFactory::GetForProfile(profile), store,
+        /*account_store=*/nullptr);
+    importer_ =
+        std::make_unique<password_manager::PasswordImporter>(*presenter_);
+    // The importer compares against the saved logins, so the presenter must
+    // have read them first.
+    presenter_->Init(base::BindOnce(&ImportJob::RunPasswordImport,
+                                    weak_factory_.GetWeakPtr(),
+                                    std::move(passwords)));
+  }
+
+  void RunPasswordImport(ReadResult<Login> passwords) {
+    auto done = base::BindOnce(&ImportJob::OnPasswordsImported,
+                               weak_factory_.GetWeakPtr());
+    const auto store = password_manager::PasswordForm::Store::kProfileStore;
+    if (!passwords.csv.empty()) {
+      importer_->Import(std::move(passwords.csv), store, std::move(done));
+      return;
+    }
+    std::vector<password_manager::CSVPassword> rows;
+    rows.reserve(passwords.items.size());
+    for (Login& login : passwords.items) {
+      rows.emplace_back(std::move(login.url), std::move(login.username),
+                        std::move(login.password), /*note=*/std::string(),
+                        password_manager::CSVPassword::Status::kOK);
+    }
+    importer_->Import(rows, store, std::move(done));
+  }
+
+  void OnPasswordsImported(const password_manager::ImportResults& results) {
+    using Results = password_manager::ImportResults;
+    if (results.status == Results::CONFLICTS) {
+      // Conflicting logins keep the saved password: continue with none of
+      // them selected for replacement.
+      outcome_.password_conflicts =
+          static_cast<int>(results.displayed_entries.size());
+      importer_->ContinueImport(
+          /*selected_ids=*/{}, base::BindOnce(&ImportJob::OnPasswordsImported,
+                                              weak_factory_.GetWeakPtr()));
+      return;
+    }
+    switch (results.status) {
+      case Results::SUCCESS:
+        outcome_.password_status = ImportStatus::kSuccess;
+        outcome_.password_count = static_cast<int>(results.number_imported);
+        // Rows the importer refused (no URL, too long, …).
+        outcome_.password_failures +=
+            static_cast<int>(results.displayed_entries.size());
+        break;
+      default:
+        outcome_.password_status = ImportStatus::kUnreadable;
+        break;
+    }
+    Finish();
+  }
+
+  void Finish() {
+    ImportCallback done = std::move(done_);
+    ImportOutcome outcome = outcome_;
+    delete this;
+    std::move(done).Run(outcome);
+  }
+
+  base::WeakPtr<Profile> profile_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  ImportCallback done_;
+  ImportOutcome outcome_;
+  std::unique_ptr<password_manager::SavedPasswordsPresenter> presenter_;
+  std::unique_ptr<password_manager::PasswordImporter> importer_;
+  base::WeakPtrFactory<ImportJob> weak_factory_{this};
+};
+
+}  // namespace
+
+void ImportIntoProfile(Profile* profile,
+                       const ImportRequest& request,
+                       ImportCallback done) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(profile);
+  (new ImportJob(profile, std::move(done)))->Start(request);
+}
+
+}  // namespace openarc
