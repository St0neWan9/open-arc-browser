+// sql::Database's metrics tag; "Test" is a registered tag that records into a
+// histogram nobody reads (Open Arc never uploads metrics anyway).
+inline constexpr sql::Database::Tag kDatabaseTag{"Test"};
+
+// Chromium's history keeps no visit older than this (HistoryBackend's
+// kExpireDaysThreshold); older pages would be dropped on write anyway.
+constexpr base::TimeDelta kHistoryWindow = base::Days(90);
+
+// Largest source file read into memory (Safari export parts, CSV).
+constexpr size_t kMaxFileBytes = 256 * 1024 * 1024;
+
+// One page of history read from a source.
+struct HistoryPage {
+  GURL url;
+  std::u16string title;
+  int visit_count = 1;
+  int typed_count = 0;
+  base::Time last_visit;
+};
+
+// A decrypted login.
+struct Login {
+  GURL url;
+  std::string username;
+  std::string password;
+};
+
+template <typename T>
+struct ReadResult {
+  ImportStatus status = ImportStatus::kNotRequested;
+  std::vector<T> items;
+  // Logins only: rows that could not be decrypted.
+  int failures = 0;
+  // CSV text to hand to the password importer (export files).
+  std::string csv;
+};
+
+struct SourceData {
+  ReadResult<HistoryPage> history;
+  ReadResult<Login> passwords;
+};
+
+bool KeepPage(const GURL& url, base::Time last_visit, base::Time cutoff) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !last_visit.is_null() &&
+         last_visit >= cutoff;
+}
+
+// Copies |source| (and its -wal / -journal companions) into |dir| so a running
+// browser's lock or an open WAL does not get in the way. Returns the copy, or
+// the error that kept the source from being read.
+base::expected<base::FilePath, ImportStatus> CopySource(
+    const base::FilePath& source,
+    const base::FilePath& dir) {
+  if (!base::PathExists(source)) {
+    return base::unexpected(ImportStatus::kNotFound);
+  }
+  base::File probe(source, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!probe.IsValid()) {
+    return base::unexpected(
+        probe.error_details() == base::File::FILE_ERROR_ACCESS_DENIED
+            ? ImportStatus::kPermissionDenied
+            : ImportStatus::kUnreadable);
+  }
+  probe.Close();
+  base::FilePath copy = dir.Append(source.BaseName());
+  if (!base::CopyFile(source, copy)) {
+    return base::unexpected(ImportStatus::kUnreadable);
+  }
+  for (const char* suffix : {"-wal", "-journal"}) {
+    base::FilePath companion(source.value() + suffix);
+    if (base::PathExists(companion)) {
+      base::CopyFile(companion, base::FilePath(copy.value() + suffix));
+    }
+  }
+  return copy;
+}
+
+std::unique_ptr<sql::Database> OpenDatabase(const base::FilePath& path) {
+  auto db = std::make_unique<sql::Database>(
+      sql::DatabaseOptions().set_exclusive_locking(false), kDatabaseTag);
+  if (!db->Open(path)) {
+    return nullptr;
+  }
+  return db;
+}
