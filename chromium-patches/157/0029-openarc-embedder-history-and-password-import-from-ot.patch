diff --git a/openarc/browser/openarc_importer.h b/openarc/browser/openarc_importer.h
new file mode 100644
index 000000000000..cc89193806af
--- /dev/null
+++ b/openarc/browser/openarc_importer.h
@@ -0,0 +1,81 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_IMPORTER_H_
+#define OPENARC_BROWSER_OPENARC_IMPORTER_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+
+class Profile;
+
+namespace openarc {
+
+// Imports history and saved passwords from another browser into a //chrome
+// profile (plan D3b; the public contract is OACImport.h). The sources are read
+// on a background sequence from temporary copies; history is written through
+// //chrome's ProfileWriter (the import path of Chrome's own importers), and
+// passwords through password_manager::PasswordImporter (the importer behind
+// chrome://password-manager's "Import passwords"), which skips duplicates and
+// keeps an already saved login when the imported one has another password.
+
+enum class ImportSourceKind {
+  // A Chromium-family profile folder: History, Login Data, Login Data For
+  // Account.
+  kChromiumProfile,
+  // ~/Library/Safari: History.db (needs Full Disk Access).
+  kSafari,
+  // Safari's export ZIP, a passwords CSV or a Safari history JSON file.
+  kExportFile,
+};
+
+enum class ImportStatus {
+  kNotRequested,
+  kSuccess,
+  kNotFound,
+  kPermissionDenied,
+  kKeychainDenied,
+  kDecryptionFailed,
+  kUnreadable,
+  kUnavailable,
+};
+
+struct ImportRequest {
+  ImportRequest();
+  ImportRequest(const ImportRequest&);
+  ImportRequest& operator=(const ImportRequest&);
+  ~ImportRequest();
+
+  ImportSourceKind kind = ImportSourceKind::kExportFile;
+  base::FilePath path;
+  // kChromiumProfile only: the keychain item with the browser's password key.
+  std::string keychain_service;
+  std::string keychain_account;
+  bool history = false;
+  bool passwords = false;
+};
+
+struct ImportOutcome {
+  ImportStatus history_status = ImportStatus::kNotRequested;
+  int history_count = 0;
+  ImportStatus password_status = ImportStatus::kNotRequested;
+  int password_count = 0;
+  int password_conflicts = 0;
+  int password_failures = 0;
+};
+
+using ImportCallback = base::OnceCallback<void(const ImportOutcome&)>;
+
+// Runs one import into |profile| (an on-disk profile) and calls |done| once on
+// the UI thread. If the profile is destroyed first, the parts not written yet
+// report kUnavailable.
+void ImportIntoProfile(Profile* profile,
+                       const ImportRequest& request,
+                       ImportCallback done);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_IMPORTER_H_
diff --git a/openarc/browser/openarc_importer.mm b/openarc/browser/openarc_importer.mm
new file mode 100644
index 000000000000..94c34e72964d
--- /dev/null
+++ b/openarc/browser/openarc_importer.mm
@@ -0,0 +1,733 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// History and password import (plan D3b, openarc_importer.h, OACImport.h).
+//
+// Reading (background sequence, temporary copies of the source files):
+// - Chromium-family History: the `urls` table (url, title, visit_count,
+//   typed_count, last_visit_time in microseconds since 1601), hidden rows left
+//   out.
+// - Chromium-family Login Data / Login Data For Account: `logins` rows that
+//   are not "never save" entries; `password_value` is "v10" + AES-128-CBC
+//   (IV of 16 spaces, PKCS#7) under PBKDF2-HMAC-SHA1(<Safe Storage password>,
+//   "saltysalt", 1003 iterations, 16 bytes), the scheme of
+//   components/os_crypt/async/browser/keychain_key_provider.mm. The Safe
+//   Storage password is read from the keychain (ReadSafeStoragePassword).
+// - Safari History.db: history_items joined with their newest history_visits
+//   row (visit_time in seconds since 2001, CFAbsoluteTime); redirect sources
+//   and failed loads left out.
+// - Safari's export: History*.json ({"metadata": {"data_type": "history"},
+//   "history": [{url, title, time_usec, visit_count, destination_url, ...}]})
+//   and Passwords.csv, in a ZIP or as single files.
+//
+// Writing (UI thread): history through //chrome's ProfileWriter
+// (AddPagesWithDetails with an imported visit source), passwords as CSV rows
+// through password_manager::PasswordImporter into the profile store (CSV text
+// goes through Chromium's sandboxed parser first). Conflicts (same site and
+// username, other password) keep the saved login.
+
+#include "openarc/browser/openarc_importer.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/json/json_reader.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "base/values.h"
