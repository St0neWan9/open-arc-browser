@@ -0,0 +1,35 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BRIDGE_OAC_PASSWORD_BREACH_INTERNAL_H_
+#define OPENARC_BRIDGE_OAC_PASSWORD_BREACH_INTERNAL_H_
+
+namespace content {
+class WebContents;
+}
+namespace password_manager {
+struct LeakedPasswordDetails;
+}
+
+namespace openarc {
+
+// The password breach check (plan B235). After a sign-in, //components' leak
+// detection hashes the password with SHA-1 and asks Have I Been Pwned's range
+// API for the first 5 hex digits (k-anonymity: the rest stays on the Mac); a
+// matching suffix with a count above 0 is a leak. Replaces Google's check,
+// which needs an account or an API key.
+void InstallPasswordBreachCheck();
+
+// -[OACApplication passwordBreachCheckEnabled]. On by default.
+void SetPasswordBreachCheckEnabled(bool enabled);
+bool IsPasswordBreachCheckEnabled();
+
+// Shows the warning for a leaked credential as an info bar above the page.
+void ShowPasswordBreachWarning(
+    content::WebContents* web_contents,
+    const password_manager::LeakedPasswordDetails& details);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BRIDGE_OAC_PASSWORD_BREACH_INTERNAL_H_
