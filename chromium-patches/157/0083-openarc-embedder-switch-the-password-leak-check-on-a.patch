diff --git a/openarc/bridge/oac_password_breach.mm b/openarc/bridge/oac_password_breach.mm
new file mode 100644
index 000000000000..e87ae0c6a171
--- /dev/null
+++ b/openarc/bridge/oac_password_breach.mm
@@ -0,0 +1,236 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/bridge/oac_password_breach_internal.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/hash/sha1.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/types/expected.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/password_manager/core/browser/leak_detection/bulk_leak_check.h"
+#include "components/password_manager/core/browser/leak_detection/leak_detection_check.h"
+#include "components/password_manager/core/browser/leak_detection/leak_detection_check_factory.h"
+#include "components/password_manager/core/browser/leak_detection/leak_detection_types.h"
+#include "components/password_manager/core/browser/leak_detection_delegate.h"
+#include "components/password_manager/core/browser/leak_detection_dialog_utils.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace openarc {
+
+namespace {
+
+bool g_enabled = true;
+
+constexpr char kRangeURL[] = "https://api.pwnedpasswords.com/range/";
+// Answers are a few hundred lines of 35 hex digits and a count (padded to
+// ≈ 800-1000 lines); 1 MB is far above that.
+constexpr size_t kMaxResponseBytes = 1024 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("openarc_password_breach_check", R"(
+      semantics {
+        sender: "Open Arc password breach check"
+        description:
+          "After the user signs in to a site, checks whether the password "
+          "appears in Have I Been Pwned's list of breached passwords. Only "
+          "the first 5 hexadecimal digits of the password's SHA-1 hash are "
+          "sent; the match runs on the device."
+        trigger: "A successful sign-in with a password."
+        data: "5 hexadecimal digits of the password's SHA-1 hash."
+        destination: OTHER
+        destination_other: "api.pwnedpasswords.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Settings > General > Warn when a saved password was in a data "
+          "breach."
+      })");
+
+// `body`: lines "SUFFIX:COUNT". True when `suffix` is there with a count
+// above 0 (padding lines have 0).
+bool ResponseListsSuffix(std::string_view body, std::string_view suffix) {
+  for (std::string_view line : base::SplitStringPiece(
+           body, "\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const size_t colon = line.find(':');
+    if (colon == std::string_view::npos ||
+        !base::EqualsCaseInsensitiveASCII(line.substr(0, colon), suffix)) {
+      continue;
+    }
+    int count = 0;
+    return base::StringToInt(line.substr(colon + 1), &count) && count > 0;
+  }
+  return false;
+}
+
+class BreachCheck : public password_manager::LeakDetectionCheck {
+ public:
+  explicit BreachCheck(
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+      : url_loader_factory_(std::move(url_loader_factory)) {}
+
+  void Start(password_manager::LeakDetectionInitiator initiator,
+             const password_manager::PasswordForm& credentials,
+             LeakDetectionCallback callback) override {
+    callback_ = std::move(callback);
+    const std::string hash = base::HexEncode(
+        base::SHA1HashString(base::UTF16ToUTF8(credentials.password_value.value())));
+    suffix_ = hash.substr(5);
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(kRangeURL + hash.substr(0, 5));
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->load_flags = net::LOAD_DISABLE_CACHE;
+    // Every answer is padded to a similar size, so its length tells nothing.
+    request->headers.SetHeader("Add-Padding", "true");
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               kTrafficAnnotation);
+    loader_->DownloadToString(
+        url_loader_factory_.get(),
+        base::BindOnce(&BreachCheck::OnResponse, base::Unretained(this)),
+        kMaxResponseBytes);
+  }
+
+ private:
+  void OnResponse(std::optional<std::string> body) {
+    loader_.reset();
+    if (!body) {
+      std::move(callback_).Run(base::unexpected(
+          password_manager::LeakDetectionError::kNetworkError));
+      return;
+    }
+    std::move(callback_).Run(
+        password_manager::IsLeaked(ResponseListsSuffix(*body, suffix_)));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::string suffix_;
+  LeakDetectionCallback callback_;
+};
+
+class BreachCheckFactory : public password_manager::LeakDetectionCheckFactory {
+ public:
+  std::unique_ptr<password_manager::LeakDetectionCheck> TryCreateLeakCheck(
+      signin::IdentityManager* identity_manager,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+      version_info::Channel channel) const override {
+    if (!g_enabled || !url_loader_factory) {
+      return nullptr;
+    }
+    return std::make_unique<BreachCheck>(std::move(url_loader_factory));
+  }
+
+  // The bulk check (chrome://password-manager/checkup) needs Google's API.
+  std::unique_ptr<password_manager::BulkLeakCheck> TryCreateBulkLeakCheck(
+      password_manager::BulkLeakCheckDelegateInterface* delegate,
+      signin::IdentityManager* identity_manager,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+      const override {
+    return nullptr;
+  }
+};
+
+std::unique_ptr<password_manager::LeakDetectionCheckFactory> CreateFactory() {
+  return std::make_unique<BreachCheckFactory>();
+}
+
+// The warning: "A password you just used on <site> was found in a data
+// breach." with "Change Password", which opens the site's
+// /.well-known/change-password (the address Chrome's leak dialog uses).
+class BreachInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  explicit BreachInfoBarDelegate(GURL site) : site_(std::move(site)) {}
+
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    // No identifier of our own; it only feeds metrics, which Open Arc does
+    // not upload.
+    return SAVE_PASSWORD_INFOBAR_DELEGATE_MOBILE;
+  }
+
+  std::u16string GetMessageText() const override {
+    return u"A password you just used on " +
+           base::UTF8ToUTF16(site_.host()) +
+           u" was found in a data breach. Change it to keep your account "
+           u"safe.";
+  }
+
+  int GetButtons() const override { return BUTTON_OK; }
+
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return u"Change Password";
+  }
+
+  bool Accept() override {
+    content::WebContents* web_contents =
+        infobars::ContentInfoBarManager::WebContentsFromInfoBar(infobar());
+    if (web_contents && site_.is_valid()) {
+      const GURL target =
+          url::Origin::Create(site_).GetURL().Resolve(
+              ".well-known/change-password");
+      web_contents->GetController().LoadURL(
+          target, content::Referrer(), ui::PAGE_TRANSITION_LINK,
+          std::string());
+    }
+    return true;
+  }
+
+ private:
+  const GURL site_;
+};
+
+}  // namespace
+
+void InstallPasswordBreachCheck() {
+  password_manager::LeakDetectionDelegate::SetEmbedderFactoryCreator(
+      &CreateFactory);
+}
+
+void SetPasswordBreachCheckEnabled(bool enabled) {
+  g_enabled = enabled;
+}
+
+bool IsPasswordBreachCheckEnabled() {
+  return g_enabled;
+}
+
+void ShowPasswordBreachWarning(
+    content::WebContents* web_contents,
+    const password_manager::LeakedPasswordDetails& details) {
+  if (!g_enabled || !web_contents) {
+    return;
+  }
+  infobars::ContentInfoBarManager* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents);
+  if (!manager) {
+    return;
+  }
+  manager->AddInfoBar(CreateConfirmInfoBar(
+      std::make_unique<BreachInfoBarDelegate>(details.credentials.url)));
+}
+
+}  // namespace openarc
