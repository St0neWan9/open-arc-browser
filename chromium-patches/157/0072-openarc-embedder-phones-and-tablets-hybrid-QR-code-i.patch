+// Plan B155: a stand-in Bluetooth adapter, for the engine conformance test
+// only. The phone / tablet (hybrid) path of WebAuthn needs a Bluetooth adapter
+// that is present, allowed and powered before //chrome shows its QR code. A
+// test process may have none of that (no permission prompt can be answered,
+// and macOS kills a process that touches Bluetooth without the usage
+// description in its responsible app). This adapter answers "present, allowed",
+// accepts scans and never finds a device, so the flow stops at the QR code,
+// which is what the test checks. With --openarc-fake-bluetooth=off it starts
+// powered off and turns on when asked (//chrome's "turn on Bluetooth" step).
+//
+// Installed only when the browser process starts with
+// --openarc-fake-bluetooth[=off] (OACApplication passes it on from the host's
+// switches); nothing here runs otherwise.
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "device/bluetooth/bluetooth_adapter.h"
+#include "device/bluetooth/bluetooth_adapter_factory.h"
+#include "device/bluetooth/bluetooth_discovery_session_outcome.h"
+#include "device/fido/fido_request_handler_base.h"
+#import "openarc/bridge/oac_webauthn_internal.h"
+
+namespace openarc {
+
+namespace {
+
+class TestBluetoothAdapter final : public device::BluetoothAdapter {
+ public:
+  explicit TestBluetoothAdapter(bool powered) : powered_(powered) {}
+  TestBluetoothAdapter(const TestBluetoothAdapter&) = delete;
+  TestBluetoothAdapter& operator=(const TestBluetoothAdapter&) = delete;
+
+  // device::BluetoothAdapter:
+  void Initialize(base::OnceClosure callback) override {
+    std::move(callback).Run();
+  }
+  std::string GetAddress() const override { return "00:00:00:00:B1:55"; }
+  std::string GetName() const override { return "Open Arc Test Bluetooth"; }
+  void SetName(const std::string& name,
+               base::OnceClosure callback,
+               ErrorCallback error_callback) override {
+    Post(std::move(error_callback));
+  }
+  bool IsInitialized() const override { return true; }
+  bool IsPresent() const override { return true; }
+  bool IsPowered() const override { return powered_; }
+  PermissionStatus GetOsPermissionStatus() const override {
+    return PermissionStatus::kAllowed;
+  }
+  bool IsDiscoverable() const override { return false; }
+  void SetDiscoverable(bool discoverable,
+                       base::OnceClosure callback,
+                       ErrorCallback error_callback) override {
+    Post(std::move(error_callback));
+  }
+  bool IsDiscovering() const override { return scanning_; }
+  UUIDList GetUUIDs() const override { return {}; }
+  void CreateRfcommService(const device::BluetoothUUID& uuid,
+                           const ServiceOptions& options,
+                           CreateServiceCallback callback,
+                           CreateServiceErrorCallback error_callback) override {
+    Post(base::BindOnce(std::move(error_callback), "unsupported"));
+  }
+  void CreateL2capService(const device::BluetoothUUID& uuid,
+                          const ServiceOptions& options,
+                          CreateServiceCallback callback,
+                          CreateServiceErrorCallback error_callback) override {
+    Post(base::BindOnce(std::move(error_callback), "unsupported"));
+  }
+  void RegisterAdvertisement(
+      std::unique_ptr<device::BluetoothAdvertisement::Data> advertisement_data,
+      CreateAdvertisementCallback callback,
+      AdvertisementErrorCallback error_callback) override {
+    Post(base::BindOnce(
+        std::move(error_callback),
+        device::BluetoothAdvertisement::ERROR_UNSUPPORTED_PLATFORM));
+  }
+  device::BluetoothLocalGattService* GetGattService(
+      const std::string& identifier) const override {
+    return nullptr;
+  }
+
+ protected:
+  ~TestBluetoothAdapter() override = default;
+
+  base::WeakPtr<device::BluetoothAdapter> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+  // Takes effect at once; observers and the pending SetPowered() callback hear
+  // of it from a fresh task, as from the platform.
+  bool SetPoweredImpl(bool powered) override {
+    powered_ = powered;
+    Post(base::BindOnce(&TestBluetoothAdapter::DidChangePower,
+                        weak_factory_.GetWeakPtr()));
+    return true;
+  }
+  void StartScanWithFilter(
+      std::unique_ptr<device::BluetoothDiscoveryFilter> discovery_filter,
+      DiscoverySessionResultCallback callback) override {
+    scanning_ = true;
+    Post(base::BindOnce(std::move(callback), /*is_error=*/false,
+                        device::UMABluetoothDiscoverySessionOutcome::SUCCESS));
+  }
+  void UpdateFilter(
+      std::unique_ptr<device::BluetoothDiscoveryFilter> discovery_filter,
+      DiscoverySessionResultCallback callback) override {
+    Post(base::BindOnce(std::move(callback), /*is_error=*/false,
+                        device::UMABluetoothDiscoverySessionOutcome::SUCCESS));
+  }
+  void StopScan(DiscoverySessionResultCallback callback) override {
+    scanning_ = false;
+    Post(base::BindOnce(std::move(callback), /*is_error=*/false,
+                        device::UMABluetoothDiscoverySessionOutcome::SUCCESS));
+  }
+  void RemovePairingDelegateInternal(
+      device::BluetoothDevice::PairingDelegate* pairing_delegate) override {}
+
+ private:
+  // Callbacks answer from a fresh task, as a platform adapter does.
+  static void Post(base::OnceClosure closure) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(closure));
+  }
+
+  void DidChangePower() {
+    NotifyAdapterPoweredChanged(powered_);
+    RunPendingPowerCallbacks();
+  }
+
+  bool powered_;
+  bool scanning_ = false;
+  base::WeakPtrFactory<TestBluetoothAdapter> weak_factory_{this};
+};
+
+}  // namespace
+
+void InstallFakeBluetoothForTesting(bool powered) {
+  // Kept for the life of the process: the factory holds only a weak pointer,
+  // and device/fido must not fall back to the real adapter later.
+  static base::NoDestructor<scoped_refptr<TestBluetoothAdapter>> adapter(
+      base::MakeRefCounted<TestBluetoothAdapter>(powered));
+  device::BluetoothAdapterFactory::SetAdapterForTesting(*adapter);
+  // device/fido skips Bluetooth when the responsible process (the test
+  // runner) lacks the usage description; this adapter is not macOS's.
+  static base::NoDestructor<
+      device::FidoRequestHandlerBase::ScopedAlwaysAllowBLECalls>
+      allow_ble_calls;
+}
+
+}  // namespace openarc
