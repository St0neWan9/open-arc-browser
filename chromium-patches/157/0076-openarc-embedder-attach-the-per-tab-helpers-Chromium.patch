 // The prompt view of PermissionRequestManager: the shell's prompt through the
 // bridge (plan C12), or a dismissing one when no bridge is registered.
 std::unique_ptr<permissions::PermissionPrompt> CreatePermissionPrompt(
@@ -35,8 +417,10 @@
 // static
 void TabHelpersAccess::AttachTabHelpers(content::WebContents* web_contents) {
   TabHelpers::AttachTabHelpers(web_contents);
+  // Chromium 157 attaches most per-tab helpers in TabFeatures, not TabHelpers.
+  AttachTabFeatureHelpers(web_contents);
   // Built-in ad blocking (plan C16): forced activation of Chrome's subresource
-  // filter, which TabHelpers just attached, and the per-page blocked count.
+  // filter, attached just above, and the per-page blocked count.
   AdBlockTabHelper::CreateForWebContents(web_contents);
   // The Chrome Web Store names this browser on its install button and shows
   // no "Switch to Chrome" prompt or banner (plan B61, 06 §18.3).
