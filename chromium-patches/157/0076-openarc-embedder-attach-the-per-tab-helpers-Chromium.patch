 namespace openarc {
 
+// Open Arc embedder change (Chromium 157): owns the per-tab helpers that
+// TabFeatures keeps as plain members since 157 (they were WebContentsUserData
+// attached by TabHelpers before). Lives as long as the WebContents, as a
+// TabFeatures does for a Browser tab. Its presence also marks a WebContents
+// whose 157 helpers are attached, so attaching twice is a no-op.
+class TabFeatureHelpers
+    : public content::WebContentsUserData<TabFeatureHelpers>,
+      public content::WebContentsObserver {
+ public:
+  ~TabFeatureHelpers() override = default;
+
+  // Where helpers that TabFeatures registers with the tab
+  // (tabs::TabInterface::GetUnownedUserDataHost()) register instead; declared
+  // first so it outlives them.
+  ui::UnownedUserDataHost unowned_user_data_host;
+
+  // Registered in `unowned_user_data_host`. Destroyed when the WebContents is
+  // (WebContentsDestroyed()), while the password manager client it uses is
+  // still there, as TabFeatures destroys it before the tab's WebContents.
+  std::unique_ptr<ManagePasswordsUIController> manage_passwords_ui_controller;
+  std::unique_ptr<commerce::CommerceTabHelper> commerce_tab_helper;
+  std::unique_ptr<history::WebContentsTopSitesObserver> top_sites_observer;
+  std::unique_ptr<client_hints::ClientHintsWebContentsObserver>
+      client_hints_observer;
+  std::unique_ptr<FileSystemAccessTabHelper> file_system_access_tab_helper;
+  std::unique_ptr<metrics::MetricsServicesWebContentsObserver>
+      metrics_services_observer;
+  std::unique_ptr<OneTimePermissionsTrackerHelper>
+      one_time_permissions_tracker_helper;
+  // Registered in `unowned_user_data_host`, where the error page's interfaces
+  // find it (NetErrorTabHelper::SetEmbedderUserDataHostLookup()).
+  std::unique_ptr<chrome_browser_net::NetErrorTabHelper> net_error_tab_helper;
+
+ private:
+  friend WebContentsUserData;
+  explicit TabFeatureHelpers(content::WebContents* web_contents)
+      : content::WebContentsUserData<TabFeatureHelpers>(*web_contents),
+        content::WebContentsObserver(web_contents) {}
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override {
+    manage_passwords_ui_controller.reset();
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabFeatureHelpers);
+
 namespace {
 
+// The lookup of ManagePasswordsUIController::SetEmbedderUserDataHostLookup()
+// and NetErrorTabHelper::SetEmbedderUserDataHostLookup().
+ui::UnownedUserDataHost* TabFeatureUserDataHost(
+    content::WebContents* web_contents) {
+  TabFeatureHelpers* helpers = TabFeatureHelpers::FromWebContents(web_contents);
+  return helpers ? &helpers->unowned_user_data_host : nullptr;
+}
