+// The NSWindow side of a DevToolsHost.
+@interface OpenArcDevToolsWindowController : NSObject <NSWindowDelegate>
+- (instancetype)initWithHost:(openarc::DevToolsHost*)host
+                        view:(NSView*)view;
+@property(nonatomic, readonly) NSWindow* window;
+- (void)detachHost;
+@end
+
+@implementation OpenArcDevToolsWindowController {
+  raw_ptr<openarc::DevToolsHost> _host;
+  NSWindow* __strong _window;
+}
+
+- (instancetype)initWithHost:(openarc::DevToolsHost*)host view:(NSView*)view {
+  if ((self = [super init])) {
+    _host = host;
+    NSRect frame =
+        NSMakeRect(0, 0, openarc::kDevToolsWindowWidth,
+                   openarc::kDevToolsWindowHeight);
+    _window = [[NSWindow alloc]
+        initWithContentRect:frame
+                  styleMask:NSWindowStyleMaskTitled |
+                            NSWindowStyleMaskClosable |
+                            NSWindowStyleMaskMiniaturizable |
+                            NSWindowStyleMaskResizable
+                    backing:NSBackingStoreBuffered
+                      defer:NO];
+    _window.releasedWhenClosed = NO;
+    _window.delegate = self;
+    _window.minSize = NSMakeSize(400, 240);
+    // Frame remembered across launches (inferred convenience).
+    [_window setFrameAutosaveName:@"OpenArcDevToolsWindow"];
+    if (![_window setFrameUsingName:@"OpenArcDevToolsWindow"]) {
+      [_window center];
+    }
+    view.frame = _window.contentView.bounds;
+    view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    [_window.contentView addSubview:view];
+  }
+  return self;
+}
+
+- (NSWindow*)window {
+  return _window;
+}
+
+- (void)detachHost {
+  _host = nullptr;
+  _window.delegate = nil;
+}
+
+- (void)windowWillClose:(NSNotification*)notification {
+  if (openarc::DevToolsHost* host = _host) {
+    _host = nullptr;
+    host->WindowWillClose();
+  }
+}
+
+@end
