+content::WebContents* OACFindTabWebContentsForExtensions(
+    int tab_id,
+    content::BrowserContext* browser_context,
+    bool include_incognito) {
+  if (!browser_context) {
+    return nullptr;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  for (OACTab* tab in LiveTabs().objectEnumerator) {
+    content::WebContents* contents = tab.webContents;
+    if (!contents ||
+        sessions::SessionTabHelper::IdForTab(contents).id() != tab_id) {
+      continue;
+    }
+    Profile* tab_profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    if (tab_profile == profile ||
+        (include_incognito && profile->IsSameOrParent(tab_profile))) {
+      return contents;
+    }
+  }
+  return nullptr;
+}
