+- (BOOL)enterPictureInPictureAutomatically:(BOOL)automatic {
+  if (_closed) {
+    return NO;
+  }
+  content::MediaSession* session =
+      content::MediaSession::GetIfExists(_webContents.get());
+  if (!session) {
+    return NO;
+  }
+  if (!automatic) {
+    session->EnterPictureInPicture();
+    return YES;
+  }
+  // [03 §Advanced] observed "Enable Picture in Picture when you leave a video
+  // tab" and [06 §12] observed "Automatic Picture-In-Picture" per site: only a
+  // playing video, and only where the site's setting allows it (Chrome's
+  // auto-PiP content setting; "ask" counts as allowed, matching the observed
+  // default "Allowed").
+  media_session::mojom::MediaSessionInfoPtr info =
+      session->GetMediaSessionInfoSync();
+  if (!info ||
+      info->playback_state !=
+          media_session::mojom::MediaPlaybackState::kPlaying ||
+      info->picture_in_picture_state ==
+          media_session::mojom::MediaPictureInPictureState::
+              kInPictureInPicture) {
+    return NO;
+  }
+  bool has_video = false;
+  if (info->audio_video_states) {
+    for (auto state : *info->audio_video_states) {
+      has_video |=
+          state == media_session::mojom::MediaAudioVideoState::kAudioVideo ||
+          state == media_session::mojom::MediaAudioVideoState::kVideoOnly;
+    }
+  }
+  if (!has_video) {
+    return NO;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(_webContents->GetBrowserContext());
+  const GURL& url = _webContents->GetLastCommittedURL();
+  if (HostContentSettingsMapFactory::GetForProfile(profile)->GetContentSetting(
+          url, url, ContentSettingsType::AUTO_PICTURE_IN_PICTURE) ==
+      CONTENT_SETTING_BLOCK) {
+    return NO;
+  }
+  session->EnterPictureInPicture();
+  return YES;
+}
+
+- (void)exitPictureInPicture {
+  if (!_closed && _webContents->HasPictureInPictureVideo()) {
+    PictureInPictureWindowManager::GetInstance()->ExitPictureInPicture();
+  }
 }
 
