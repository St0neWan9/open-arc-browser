+- (void)savePageToURL:(NSURL*)url
+               format:(OACSavePageFormat)format
+    completionHandler:(void (^)(NSError*))completionHandler {
+  void (^finish)(NSError*) = [completionHandler copy];
+  if (_closed) {
+    NSError* error = OACMakeError(OACErrorTabClosed, @"The tab is closed.");
+    OACPostToMainThread(^{
+      finish(error);
+    });
+    return;
+  }
+  if (!url.isFileURL) {
+    NSError* error =
+        OACMakeError(OACErrorInvalidArgument, @"Save Page As needs a file URL.");
+    OACPostToMainThread(^{
+      finish(error);
+    });
+    return;
+  }
+  openarc::SavePageFormat chromium_format =
+      openarc::SavePageFormat::kComplete;
+  switch (format) {
+    case OACSavePageFormatComplete:
+      chromium_format = openarc::SavePageFormat::kComplete;
+      break;
+    case OACSavePageFormatHTMLOnly:
+      chromium_format = openarc::SavePageFormat::kHtmlOnly;
+      break;
+    case OACSavePageFormatSingleFile:
+      chromium_format = openarc::SavePageFormat::kSingleFile;
+      break;
+  }
+  openarc::SavePage(
+      _webContents.get(), base::apple::NSURLToFilePath(url), chromium_format,
+      base::BindOnce(^(bool started) {
+        NSError* error =
+            started ? nil
+                    : OACMakeError(OACErrorInvalidArgument,
+                                   @"The page could not be saved.");
+        OACPostToMainThread(^{
+          finish(error);
+        });
+      }));
 }
 
 - (void)showDevToolsWithPanel:(NSString*)panel {
+  if (_closed) {
+    return;
+  }
+  // Panel names of OACTab.h: nil = last used, "elements" = Inspect Elements
+  // (pick an element), "console", "network".
+  if (!panel) {
+    openarc::ShowDevTools(_webContents.get(), openarc::DevToolsCommand::kShow,
+                          std::string());
+  } else if ([panel isEqualToString:@"elements"]) {
+    openarc::ShowDevTools(_webContents.get(),
+                          openarc::DevToolsCommand::kInspectElement,
+                          std::string());
+  } else {
+    openarc::ShowDevTools(_webContents.get(),
+                          openarc::DevToolsCommand::kShowPanel,
+                          base::SysNSStringToUTF8(panel));
+  }
+}
