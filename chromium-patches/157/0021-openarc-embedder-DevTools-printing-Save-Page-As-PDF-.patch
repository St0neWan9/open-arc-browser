+
+DevToolsHostOwner::DevToolsHostOwner(content::WebContents* inspected)
+    : content::WebContentsUserData<DevToolsHostOwner>(*inspected) {}
+
+DevToolsHostOwner::~DevToolsHostOwner() = default;
+
+void DevToolsHostOwner::SetHost(std::unique_ptr<DevToolsHost> host) {
+  host_ = std::move(host);
+}
+
+void DevToolsHostOwner::ResetHostSoon() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<DevToolsHostOwner> owner) {
+                       if (owner) {
+                         owner->SetHost(nullptr);
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DevToolsHostOwner);
+
+DevToolsHost::DevToolsHost(content::WebContents* inspected,
+                           DevToolsHostOwner* owner)
+    : inspected_(inspected->GetWeakPtr()), owner_(owner) {}
+
+DevToolsHost::~DevToolsHost() {
+  closing_ = true;
+  [window_controller_ detachHost];
+  [window_controller_.window orderOut:nil];
+  [window_controller_.window close];
+  window_controller_ = nil;
+  if (bindings_) {
+    bindings_->Detach();
+  }
+  // The bindings belong to the front end's WebContents: drop the pointer
+  // before they go (raw_ptr must not dangle).
+  bindings_ = nullptr;
+  Observe(nullptr);
+  if (frontend_) {
+    frontend_->SetDelegate(nullptr);
+  }
+  // Destroys DevToolsUI, its bindings and their forwarding delegate.
+  frontend_.reset();
+}
+
+bool DevToolsHost::Start(const std::string& panel) {
+  content::WebContents* inspected = inspected_.get();
+  if (!inspected) {
+    return false;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(inspected->GetBrowserContext());
+  if (!DevToolsWindow::AllowDevToolsFor(profile, inspected)) {
+    return false;
+  }
+  frontend_ =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  frontend_->SetDelegate(this);
+  Observe(frontend_.get());
+  // DevTools zooms its own UI with PageZoom (⌘+ / ⌘- inside the front end).
+  zoom::ZoomController::CreateForWebContents(frontend_.get());
+  zoom::ZoomController::FromWebContents(frontend_.get())
+      ->SetShowsNotificationBubble(false);
+
+  // The URL Chrome builds for a tab target, sanitized the same way.
+  std::string url = std::string(kFrontendURL) +
+                    "?remoteBase=" + DevToolsUI::GetRemoteBaseURL().spec() +
+                    "&targetType=tab";
+  if (!panel.empty()) {
+    url += "&panel=" + panel;
+  }
+  frontend_->GetController().LoadURL(
+      DevToolsUIBindings::SanitizeFrontendURL(GURL(url)), content::Referrer(),
+      ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+  bindings_ = DevToolsUIBindings::ForWebContents(frontend_.get());
+  if (!bindings_) {
+    return false;
+  }
+  // The bindings own (and delete) their delegate.
+  bindings_->SetDelegate(
+      new DevToolsBindingsForwarder(weak_factory_.GetWeakPtr()));
+  bindings_->AttachTo(content::DevToolsAgentHost::GetOrCreateForTab(inspected));
+
+  window_controller_ = [[OpenArcDevToolsWindowController alloc]
+      initWithHost:this
+              view:frontend_->GetNativeView().GetNativeNSView()];
+  UpdateTitle();
+  [window_controller_.window makeKeyAndOrderFront:nil];
+  frontend_->Focus();
+  return true;
+}
+
+void DevToolsHost::Run(DevToolsCommand command, const std::string& panel) {
+  if (!loaded_) {
+    has_pending_command_ = true;
+    pending_command_ = command;
+    pending_panel_ = panel;
+    return;
+  }
+  RunNow(command, panel);
+}
+
+void DevToolsHost::RunNow(DevToolsCommand command, const std::string& panel) {
+  ActivateWindow();
+  if (!bindings_) {
+    return;
+  }
+  switch (command) {
+    case DevToolsCommand::kShow:
+      break;
+    case DevToolsCommand::kInspectElement:
+      // DevToolsWindow::DoAction for kInspect.
+      bindings_->CallClientMethod("DevToolsAPI", "enterInspectElementMode");
+      break;
+    case DevToolsCommand::kShowPanel:
+      bindings_->CallClientMethod("DevToolsAPI", "showPanel",
+                                  base::Value(panel));
+      break;
+  }
+}
+
+void DevToolsHost::OnLoadCompleted() {
+  document_loaded_ = true;
+  UpdateTitle();
+  MaybeBecomeReady();
+}
+
+void DevToolsHost::ConnectionReady() {
+  connection_ready_ = true;
+  MaybeBecomeReady();
+}
+
+void DevToolsHost::MaybeBecomeReady() {
+  if (loaded_ || !document_loaded_ || !connection_ready_) {
+    return;
+  }
+  loaded_ = true;
+  if (has_pending_command_) {
+    has_pending_command_ = false;
+    RunNow(pending_command_, pending_panel_);
+  }
+}
+
+void DevToolsHost::ActivateWindow() {
+  if (closing_) {
+    return;
+  }
+  UpdateTitle();
+  [window_controller_.window makeKeyAndOrderFront:nil];
+  if (frontend_) {
+    frontend_->Focus();
+  }
+}
+
+void DevToolsHost::UpdateTitle() {
+  content::WebContents* inspected = inspected_.get();
+  if (!inspected || !window_controller_) {
+    return;
+  }
+  // inferred: Chrome titles its undocked window "DevTools - <url>".
+  std::string url = inspected->GetLastCommittedURL().spec();
+  window_controller_.window.title =
+      base::SysUTF8ToNSString("DevTools - " + url);
+}
+
+void DevToolsHost::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  [window_controller_ detachHost];
+  [window_controller_.window orderOut:nil];
+  owner_->ResetHostSoon();
+}
+
+void DevToolsHost::WindowWillClose() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  owner_->ResetHostSoon();
+}
+
+void DevToolsHost::OpenInNewTab(const std::string& url) {
+  content::WebContents* inspected = inspected_.get();
+  if (!inspected) {
+    return;
+  }
+  // A link in DevTools (a resource, documentation): a new tab next to the
+  // inspected page; the tab's delegate (the shell) places it.
+  inspected->OpenURL(content::OpenURLParams(
+                         GURL(url), content::Referrer(),
+                         WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                         ui::PAGE_TRANSITION_LINK,
+                         /*is_renderer_initiated=*/false),
+                     /*navigation_handle_callback=*/{});
+}
+
+void DevToolsHost::OpenSearchResultsInNewTab(const std::string& query) {
+  content::WebContents* inspected = inspected_.get();
+  if (!inspected) {
+    return;
+  }
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(inspected->GetBrowserContext()));
+  if (!service) {
+    return;
+  }
+  OpenInNewTab(
+      GetDefaultSearchURLForSearchTerms(service, base::UTF8ToUTF16(query))
+          .spec());
+}
+
+content::WebContents* DevToolsHost::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // The front end reloading itself stays in its window (DevToolsWindow does
+  // the same); anything else opens next to the inspected page.
+  if (params.url.SchemeIs(content::kChromeDevToolsScheme)) {
+    frontend_->GetController().Reload(content::ReloadType::NORMAL, false);
+    return frontend_.get();
+  }
+  content::WebContents* inspected = inspected_.get();
+  if (!inspected) {
+    return nullptr;
+  }
+  content::OpenURLParams modified = params;
+  modified.referrer = content::Referrer();
+  if (modified.disposition == WindowOpenDisposition::CURRENT_TAB) {
+    modified.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  return inspected->OpenURL(modified, /*navigation_handle_callback=*/{});
+}
+
+void DevToolsHost::ContentsZoomChange(bool zoom_in) {
+  zoom::PageZoom::Zoom(frontend_.get(), zoom_in ? content::PAGE_ZOOM_IN
+                                                : content::PAGE_ZOOM_OUT);
+}
+
+bool DevToolsHost::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // Keys DevTools did not use: ⌘W closes the window (the window's own key
+  // equivalent), the rest go to the app's menu (View ▸ Developer ▸ items keep
+  // working while DevTools has focus).
+  if (event.skip_if_unhandled) {
+    return false;
+  }
+  NSEvent* ns_event = event.os_event.Get();
+  if (!ns_event || ns_event.type != NSEventTypeKeyDown) {
+    return false;
+  }
+  if ((ns_event.modifierFlags & NSEventModifierFlagDeviceIndependentFlagsMask) ==
+          NSEventModifierFlagCommand &&
+      [ns_event.charactersIgnoringModifiers isEqualToString:@"w"]) {
+    [window_controller_.window performClose:nil];
+    return true;
+  }
+  return [NSApp.mainMenu performKeyEquivalent:ns_event];
+}
+
+void DevToolsHost::RunFileChooser(
+    content::RenderFrameHost* render_frame_host,
+    scoped_refptr<content::FileSelectListener> listener,
+    const blink::mojom::FileChooserParams& params) {
+  // DevTools' own file inputs (import a HAR, a snippet): not supported in the
+  // separate window yet (plan C15 keeps DevTools' save/load-to-disk features
+  // out of scope).
+  listener->FileSelectionCanceled();
+}
+
+void DevToolsHost::RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                                          content::RenderFrameHost* new_host) {
+  // DevToolsWindow::MainWebContentRenderFrameHostChanged: a new document of
+  // the front end has new bindings; move our delegate over.
+  DevToolsUIBindings* new_bindings =
+      DevToolsUIBindings::ForWebContents(frontend_.get());
+  if (!new_bindings || new_bindings == bindings_) {
+    return;
+  }
+  bindings_->TransferDelegate(*new_bindings);
+  bindings_ = new_bindings;
+}
+
+}  // namespace
+
+void ShowDevTools(content::WebContents* inspected,
+                  DevToolsCommand command,
+                  const std::string& panel) {
+  if (!inspected) {
+    return;
+  }
+  DevToolsHostOwner::CreateForWebContents(inspected);
+  DevToolsHostOwner* owner = DevToolsHostOwner::FromWebContents(inspected);
+  if (!owner->host()) {
+    auto host = std::make_unique<DevToolsHost>(inspected, owner);
+    // Open on the requested panel; Inspect Elements also picks an element.
+    const std::string initial_panel =
+        command == DevToolsCommand::kShowPanel        ? panel
+        : command == DevToolsCommand::kInspectElement ? "elements"
+                                                      : std::string();
+    if (!host->Start(initial_panel)) {
+      return;
+    }
+    owner->SetHost(std::move(host));
+    if (command != DevToolsCommand::kInspectElement) {
+      return;
+    }
+  }
+  owner->host()->Run(command, panel);
+}
+
+void CloseDevTools(content::WebContents* inspected) {
+  if (!inspected) {
+    return;
+  }
+  if (DevToolsHostOwner* owner = DevToolsHostOwner::FromWebContents(inspected);
+      owner && owner->host()) {
+    owner->host()->Close();
+  }
+}
+
+void PrintPage(content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  printing::StartPrint(contents,
+                       /*print_preview_disabled=*/true,
+                       /*has_selection=*/false);
+}
+
+void SavePage(content::WebContents* contents,
+              const base::FilePath& path,
+              SavePageFormat format,
+              base::OnceCallback<void(bool started)> done) {
+  if (!contents || path.empty()) {
+    std::move(done).Run(false);
+    return;
+  }
+  if (!contents->IsSavable()) {
+    // Not a document Blink can serialize (a PDF, an image, a video): save the
+    // original file, as Chrome's Save Page As does, as a download forced to
+    // `path` (no second "save as" prompt).
+    std::unique_ptr<download::DownloadUrlParameters> download =
+        content::DownloadRequestUtils::CreateDownloadForWebContentsMainFrame(
+            contents, contents->GetLastCommittedURL(),
+            net::DefineNetworkTrafficAnnotation("openarc_save_page_as", R"(
+              semantics {
+                sender: "Open Arc Save Page As"
+                description:
+                  "Saves the current page's original file (a PDF, an image or "
+                  "media) to the location the user chose."
+                trigger: "File > Save Page As on a page that is not HTML."
+                data: "None."
+                destination: WEBSITE
+              }
+              policy {
+                cookies_allowed: YES
+                cookies_store: "user"
+                setting: "None."
+                policy_exception_justification: "Not implemented."
+              })"));
+    // Keep the original file's type: "page.html" for a PDF becomes "page.pdf".
+    base::FilePath target = path;
+    const base::FilePath::StringType original_extension =
+        base::FilePath::FromUTF8Unsafe(
+            contents->GetLastCommittedURL().ExtractFileName())
+            .Extension();
+    if (!original_extension.empty()) {
+      target = target.ReplaceExtension(original_extension);
+    } else if (contents->GetContentsMimeType() == "application/pdf") {
+      target = target.ReplaceExtension(FILE_PATH_LITERAL(".pdf"));
+    }
+    download->set_file_path(target);
+    download->set_prompt(false);
+    contents->GetBrowserContext()->GetDownloadManager()->DownloadUrl(
+        std::move(download));
+    std::move(done).Run(true);
+    return;
+  }
+  content::SavePageType type = content::SAVE_PAGE_TYPE_AS_COMPLETE_HTML;
+  switch (format) {
+    case SavePageFormat::kComplete:
+      type = content::SAVE_PAGE_TYPE_AS_COMPLETE_HTML;
+      break;
+    case SavePageFormat::kHtmlOnly:
+      type = content::SAVE_PAGE_TYPE_AS_ONLY_HTML;
+      break;
+    case SavePageFormat::kSingleFile:
+      type = content::SAVE_PAGE_TYPE_AS_MHTML;
+      break;
+  }
+  // The resources folder of a complete page: "<name>_files" next to it, as
+  // Chrome names it.
+  const base::FilePath dir =
+      path.DirName().Append(path.RemoveExtension().BaseName().value() +
+                            FILE_PATH_LITERAL("_files"));
+  std::move(done).Run(contents->SavePage(path, dir, type));
+}
+
+}  // namespace openarc
