+
+// One DevTools front end (its own WebContents) in an NSWindow, attached to the
+// inspected tab. Plays the role of Chrome's undocked DevToolsWindow for a tab
+// that has no Browser: it serves the front end's bindings (through a
+// forwarding DevToolsUIBindings::Delegate, which the bindings own) and is the
+// delegate of the front end's WebContents.
+class DevToolsHost : public content::WebContentsDelegate,
+                     public content::WebContentsObserver {
+ public:
+  DevToolsHost(content::WebContents* inspected, DevToolsHostOwner* owner);
+  DevToolsHost(const DevToolsHost&) = delete;
+  DevToolsHost& operator=(const DevToolsHost&) = delete;
+  ~DevToolsHost() override;
+
+  // Loads the front end on `panel` ("" = last used), attaches it to the
+  // inspected tab and shows the window. Returns false when DevTools is not
+  // allowed for the profile.
+  bool Start(const std::string& panel);
+  // Runs `command` now if the front end is loaded, else once it is.
+  void Run(DevToolsCommand command, const std::string& panel);
+  // Closes the window; the owner then destroys this host.
+  void Close();
+  // The window's close button or ⌘W.
+  void WindowWillClose();
+
+  // Called by the bindings (DevToolsUIBindings::Delegate, forwarded).
+  content::WebContents* inspected() { return inspected_.get(); }
+  void ActivateWindow();
+  void OpenInNewTab(const std::string& url);
+  void OpenSearchResultsInNewTab(const std::string& query);
+  void OnLoadCompleted();
+  void ConnectionReady();
+
+  // content::WebContentsDelegate (the front end's contents):
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  void ActivateContents(content::WebContents* contents) override {
+    ActivateWindow();
+  }
+  void CloseContents(content::WebContents* source) override { Close(); }
+  void ContentsZoomChange(bool zoom_in) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+  void RunFileChooser(content::RenderFrameHost* render_frame_host,
+                      scoped_refptr<content::FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) override;
+
+  // content::WebContentsObserver (the front end's contents): a new document of
+  // the front end has new bindings.
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override;
+
+ private:
+  void RunNow(DevToolsCommand command, const std::string& panel);
+  void MaybeBecomeReady();
+  void UpdateTitle();
+
+  base::WeakPtr<content::WebContents> inspected_;
+  raw_ptr<DevToolsHostOwner> owner_;
+  std::unique_ptr<content::WebContents> frontend_;
+  // Owned by the front end's WebContents (its DevToolsUI).
+  raw_ptr<DevToolsUIBindings> bindings_ = nullptr;
+  OpenArcDevToolsWindowController* __strong window_controller_ = nil;
+  // The front end takes commands once its document loaded and its connection
+  // to the inspected tab is up (it has its root target); before that, an
+  // "enterInspectElementMode" is lost.
+  bool document_loaded_ = false;
+  bool connection_ready_ = false;
+  bool loaded_ = false;
+  bool closing_ = false;
+  bool has_pending_command_ = false;
+  DevToolsCommand pending_command_ = DevToolsCommand::kShow;
+  std::string pending_panel_;
+  base::WeakPtrFactory<DevToolsHost> weak_factory_{this};
+};
+
+// The delegate the front end's bindings own. Forwards to the host while it
+// lives; everything Chrome's docked-window features need (infobars, eye
+// dropper, docking, certificate viewer) is unsupported.
+class DevToolsBindingsForwarder : public DevToolsUIBindings::Delegate {
+ public:
+  explicit DevToolsBindingsForwarder(base::WeakPtr<DevToolsHost> host)
