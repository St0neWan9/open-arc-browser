+// MARK: - OACExtensionWindow
+
+namespace {
+
+// The live tabs of a weak tab list (OACExtensionWindow).
+NSArray<OACTab*>* LiveTabsIn(NSPointerArray* tabs) {
+  NSMutableArray<OACTab*>* result = [NSMutableArray array];
+  for (OACTab* tab in tabs) {
+    if (tab && !tab.closed && tab.webContents) {
+      [result addObject:tab];
+    }
+  }
+  return result;
+}
+
+NSPointerArray* WeakTabs(NSArray<OACTab*>* tabs) {
+  NSPointerArray* result = [NSPointerArray weakObjectsPointerArray];
+  for (OACTab* tab in tabs) {
+    [result addPointer:(__bridge void*)tab];
+  }
+  return result;
+}
+
+}  // namespace
+
+@implementation OACExtensionWindow {
+  NSUUID* _identifier;
+  __weak OACProfile* _profile;
+  NSPointerArray* _tabs;
+  NSPointerArray* _activeTabs;
+}
+
+@synthesize focused = _focused;
+@synthesize popup = _popup;
+@synthesize frame = _frame;
+
+- (instancetype)initWithIdentifier:(NSUUID*)identifier
+                           profile:(OACProfile*)profile {
+  if ((self = [super init])) {
+    _identifier = [identifier copy];
+    _profile = profile;
+    _tabs = [NSPointerArray weakObjectsPointerArray];
+    _activeTabs = [NSPointerArray weakObjectsPointerArray];
+    _frame = CGRectZero;
+  }
+  return self;
+}
+
+- (NSUUID*)identifier {
+  return _identifier;
+}
+
+- (OACProfile*)profile {
+  return _profile;
+}
+
+- (NSArray<OACTab*>*)tabs {
+  return LiveTabsIn(_tabs);
+}
+
+- (void)setTabs:(NSArray<OACTab*>*)tabs {
+  _tabs = WeakTabs(tabs);
+}
+
+- (NSArray<OACTab*>*)activeTabs {
+  return LiveTabsIn(_activeTabs);
+}
+
+- (void)setActiveTabs:(NSArray<OACTab*>*)activeTabs {
+  _activeTabs = WeakTabs(activeTabs);
+}
+
+@end
+
+namespace {
+
+// Plan B126: the shell's windows, most recently focused first.
+NSArray<OACExtensionWindow*>* g_extension_windows = @[];
+
+// The Chromium window id (a SessionID) of each window identifier, made once.
+NSMutableDictionary<NSUUID*, NSNumber*>* ExtensionWindowIDs() {
+  static NSMutableDictionary<NSUUID*, NSNumber*>* ids =
+      [NSMutableDictionary dictionary];
+  return ids;
+}
+
+int ExtensionWindowIDFor(NSUUID* identifier) {
+  NSNumber* known = ExtensionWindowIDs()[identifier];
+  if (!known) {
+    known = @(SessionID::NewUnique().id());
+    ExtensionWindowIDs()[identifier] = known;
+  }
+  return known.intValue;
+}
+
+// The Chromium profile of a window: the on-disk profile, or for an incognito
+// window its off-the-record profile when it exists (listing windows never
+// creates one).
+content::BrowserContext* BrowserContextOfWindow(OACExtensionWindow* window) {
+  OACProfile* profile = window.profile;
+  if (!profile.valid) {
+    return nullptr;
+  }
+  if (!profile.offTheRecord) {
+    return profile.chromeProfile;
+  }
+  OACProfile* original = profile.originalProfile;
+  Profile* chrome = original.valid ? original.chromeProfile : nullptr;
+  if (!chrome || !chrome->HasPrimaryOTRProfile()) {
+    return nullptr;
+  }
+  return chrome->GetPrimaryOTRProfile(/*create_if_needed=*/false);
+}
+
+// Gives every listed tab its window's id (tab.windowId, tabs.query); a tab in
+// no window gets none. The first window that lists a tab wins.
+void AssignTabWindowIDs() {
+  std::map<content::WebContents*, int> window_of_tab;
+  for (OACExtensionWindow* window in g_extension_windows) {
+    const int window_id = ExtensionWindowIDFor(window.identifier);
+    for (OACTab* tab in window.tabs) {
+      window_of_tab.emplace(tab.webContents, window_id);
+    }
+  }
+  for (OACTab* tab in OACApplication.sharedApplication.liveTabsForBridge) {
+    content::WebContents* contents = tab.webContents;
+    auto* helper = contents
+                       ? sessions::SessionTabHelper::FromWebContents(contents)
+                       : nullptr;
+    if (!helper) {
+      continue;
+    }
+    auto it = window_of_tab.find(contents);
+    const SessionID wanted = it == window_of_tab.end()
+                                 ? SessionID::InvalidValue()
+                                 : SessionID::FromSerializedValue(it->second);
+    if (helper->window_id() != wanted) {
+      helper->SetWindowID(wanted);
+    }
+  }
+}
+
+}  // namespace
