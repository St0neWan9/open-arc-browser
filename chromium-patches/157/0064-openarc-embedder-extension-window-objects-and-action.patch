+- (BOOL)openPopupForAPIOfExtension:(const Extension&)extension
+                             onTab:(OACTab*)tab
+                          callback:
+                              (base::OnceCallback<void(
+                                   extensions::ExtensionHost*)>)callback {
+  Profile* profile = self.chromeProfile;
+  if (!profile || OriginalProfileOfTab(tab) != profile) {
+    return NO;
+  }
+  // As Chrome's toolbar: no popup over one that is open.
+  if (_popup && !_popup.closed) {
+    return NO;
+  }
+  OACExtensionPopup* popup = [self makePopupOfExtension:&extension onTab:tab];
+  if (!popup) {
+    return NO;
+  }
+  [popup setLoadCallback:std::move(callback)];
+  [self deliverUnrequestedPopup:popup onTab:tab];
+  return YES;
+}
