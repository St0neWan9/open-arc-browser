+// The embedder windows of ExtensionTabUtil (plan B126): every window the
+// shell reported, most recently focused first; ExtensionTabUtil keeps those
+// of the extension's profile.
+std::vector<extensions::ExtensionTabUtil::EmbedderWindow> ListWindows() {
+  std::vector<extensions::ExtensionTabUtil::EmbedderWindow> result;
+  for (OACExtensionWindow* window in g_extension_windows) {
+    content::BrowserContext* context = BrowserContextOfWindow(window);
+    if (!context) {
+      continue;
+    }
+    extensions::ExtensionTabUtil::EmbedderWindow entry;
+    entry.id = ExtensionWindowIDFor(window.identifier);
+    entry.browser_context = context;
+    entry.focused = window.focused;
+    entry.popup = window.popup;
+    entry.bounds = gfx::ScreenRectFromNSRect(NSRectFromCGRect(window.frame));
+    NSArray<OACTab*>* active = window.activeTabs;
+    for (OACTab* tab in window.tabs) {
+      content::WebContents* contents = tab.webContents;
+      // A window's tabs are of its profile (an incognito window's tabs are
+      // off the record).
+      if (!contents || contents->GetBrowserContext() != context ||
+          extensions::ExtensionTabUtil::GetWindowIdOfTab(contents) !=
+              entry.id) {
+        continue;
+      }
+      extensions::ExtensionTabUtil::EmbedderTab tab_entry;
+      tab_entry.contents = contents;
+      tab_entry.active = [active containsObject:tab];
+      tab_entry.in_current_window = false;
+      entry.tabs.push_back(tab_entry);
+    }
+    result.push_back(std::move(entry));
+  }
+  return result;
+}
