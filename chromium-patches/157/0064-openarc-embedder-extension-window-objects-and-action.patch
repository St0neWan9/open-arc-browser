 // chrome.tabs.query's embedder tab list (an Open Arc patch): every live tab of
-// the profile. The shell does not tell the bridge which tabs are on screen,
-// so "active" means the tab's page is visible, and every tab counts as in the
-// current window (inferred: Arc shows one window's tabs in its sidebar).
+// the profile. Once the shell reported windows of the profile (plan B126), a
+// tab is active when its window shows it, and in the current window when its
+// window is the profile's most recently focused one. Otherwise "active" means
+// the tab's page is visible and every tab counts as in the current window
+// (inferred: Arc shows one window's tabs in its sidebar).
 std::vector<extensions::ExtensionTabUtil::EmbedderTab> ListTabs(
     content::BrowserContext* browser_context,
     bool include_incognito) {
   std::vector<extensions::ExtensionTabUtil::EmbedderTab> result;
   Profile* profile = Profile::FromBrowserContext(browser_context);
+  std::vector<extensions::ExtensionTabUtil::EmbedderWindow> windows =
+      extensions::ExtensionTabUtil::GetEmbedderWindows(browser_context,
+                                                       include_incognito);
+  const bool has_windows = !windows.empty();
   for (OACTab* tab in OACApplication.sharedApplication.liveTabsForBridge) {
     content::WebContents* contents = tab.webContents;
     if (!contents) {
@@ -1269,11 +1544,43 @@ void ShowInstallConfirmation(
     entry.active =
         contents->GetVisibility() == content::Visibility::VISIBLE;
     entry.in_current_window = true;
+    if (has_windows) {
+      entry.active = false;
+      entry.in_current_window = false;
+      for (size_t i = 0; i < windows.size(); ++i) {
+        for (const auto& window_tab : windows[i].tabs) {
+          if (window_tab.contents == contents) {
+            entry.active = window_tab.active;
+            entry.in_current_window = i == 0;
+          }
+        }
+      }
+    }
     result.push_back(entry);
   }
   return result;
 }
 
+// chrome.action.openPopup()'s embedder popup opener (plan B125): the popup
+// opens on the tab like an `_execute_action` shortcut's and reaches the shell
+// through -extensions:didOpenPopup:onTab:.
+bool OpenPopupForExtensionAPI(
+    const Extension& extension,
+    content::WebContents* contents,
+    base::OnceCallback<void(extensions::ExtensionHost*)> callback) {
+  OACTab* tab = OACTabForWebContents(contents);
+  OACProfile* profile = tab.profile;
+  if (!tab || !profile.valid) {
+    return false;
+  }
+  OACProfile* original = profile.originalProfile ?: profile;
+  OACExtensions* extensions = original.extensions;
+  return extensions && [extensions openPopupForAPIOfExtension:extension
+                                                        onTab:tab
+                                                     callback:std::move(
+                                                                  callback)];
+}
