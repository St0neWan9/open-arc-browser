+// MARK: - OACPasswordSavePrompt
+
+namespace openarc {
+// What the user chose in the password bubble.
+enum class PasswordSaveAnswer {
+  kSave,
+  kNever,
+  kDecline,
+  kDismiss,
+};
+}  // namespace openarc
+
+@interface OACPasswordSavePrompt ()
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                       kind:(OACPasswordSavePromptKind)kind
+                   username:(NSString*)username
+             passwordLength:(NSUInteger)passwordLength
+                     answer:(base::OnceCallback<void(openarc::PasswordSaveAnswer,
+                                                     NSString*)>)answer;
+@end
+
+@implementation OACPasswordSavePrompt {
+  OACPasswordSavePromptKind _kind;
+  NSString* _username;
+  NSUInteger _passwordLength;
+  base::OnceCallback<void(openarc::PasswordSaveAnswer, NSString*)> _answer;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                       kind:(OACPasswordSavePromptKind)kind
+                   username:(NSString*)username
+             passwordLength:(NSUInteger)passwordLength
+                     answer:(base::OnceCallback<void(openarc::PasswordSaveAnswer,
+                                                     NSString*)>)answer {
+  if ((self = [super initWithTab:tab origin:origin isFromSubframe:NO])) {
+    _kind = kind;
+    _username = [username copy];
+    _passwordLength = passwordLength;
+    _answer = std::move(answer);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self cancel];
+}
+
+- (OACPasswordSavePromptKind)kind {
+  return _kind;
+}
+- (NSString*)username {
+  return _username;
+}
+- (NSUInteger)passwordLength {
+  return _passwordLength;
+}
+
+- (void)answer:(openarc::PasswordSaveAnswer)answer username:(NSString*)username {
+  if (![self markFinished]) {
+    return;
+  }
+  if (_answer) {
+    std::move(_answer).Run(answer, username);
+  }
+}
+
+- (void)saveWithUsername:(NSString*)username {
+  [self answer:openarc::PasswordSaveAnswer::kSave username:username];
+}
+- (void)neverForThisSite {
+  [self answer:_kind == OACPasswordSavePromptKindSave
+                   ? openarc::PasswordSaveAnswer::kNever
+                   : openarc::PasswordSaveAnswer::kDecline
+      username:nil];
+}
+- (void)decline {
+  [self answer:openarc::PasswordSaveAnswer::kDecline username:nil];
+}
+- (void)cancel {
+  [self answer:openarc::PasswordSaveAnswer::kDismiss username:nil];
+}
+
+@end
+
+// MARK: - OACAutofillSuggestion
+
+@interface OACAutofillSuggestion ()
+- (instancetype)initWithKind:(OACAutofillSuggestionKind)kind
+                    mainText:(NSString*)mainText
+                   minorText:(NSString*)minorText
+                       label:(NSString*)label
+                  selectable:(BOOL)selectable
+                  acceptable:(BOOL)acceptable;
+@end
+
+@implementation OACAutofillSuggestion {
+  OACAutofillSuggestionKind _kind;
+  NSString* _mainText;
+  NSString* _minorText;
+  NSString* _label;
+  BOOL _selectable;
+  BOOL _acceptable;
+}
+
+- (instancetype)initWithKind:(OACAutofillSuggestionKind)kind
+                    mainText:(NSString*)mainText
+                   minorText:(NSString*)minorText
+                       label:(NSString*)label
+                  selectable:(BOOL)selectable
+                  acceptable:(BOOL)acceptable {
+  if ((self = [super init])) {
+    _kind = kind;
+    _mainText = [mainText copy];
+    _minorText = [minorText copy];
+    _label = [label copy];
+    _selectable = selectable;
+    _acceptable = acceptable;
+  }
+  return self;
+}
+
+- (OACAutofillSuggestionKind)kind {
+  return _kind;
+}
+- (NSString*)mainText {
+  return _mainText;
+}
+- (NSString*)minorText {
+  return _minorText;
+}
+- (NSString*)label {
+  return _label;
+}
+- (BOOL)isSelectable {
+  return _selectable;
+}
+- (BOOL)isAcceptable {
+  return _acceptable;
+}
+
+@end
