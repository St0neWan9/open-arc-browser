+// MARK: - OACAutofillPopup
+
+@interface OACAutofillPopup ()
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                       view:(base::WeakPtr<openarc::ShellAutofillPopupView>)view;
+// Called by the view: new rows, bounds or highlight.
+- (void)updateSuggestions:(NSArray<OACAutofillSuggestion*>*)suggestions
+            elementBounds:(CGRect)elementBounds
+            isRightToLeft:(BOOL)isRightToLeft
+            selectedIndex:(NSInteger)selectedIndex;
+@end
+
+// MARK: - Views
+
+namespace openarc {
+
+namespace {
+
+OACAutofillSuggestionKind SuggestionKindFor(const autofill::Suggestion& s) {
+  using autofill::FillingProduct;
+  using autofill::SuggestionType;
+  switch (s.type) {
+    case SuggestionType::kTitle:
+      return OACAutofillSuggestionKindTitle;
+    case SuggestionType::kSeparator:
+      return OACAutofillSuggestionKindSeparator;
+    case SuggestionType::kDatalistEntry:
+      return OACAutofillSuggestionKindDataList;
+    case SuggestionType::kAutocompleteEntry:
+      return OACAutofillSuggestionKindAutocomplete;
+    case SuggestionType::kPasswordEntry:
+    case SuggestionType::kAccountStoragePasswordEntry:
+    case SuggestionType::kBackupPasswordEntry:
+    case SuggestionType::kPasswordFieldByFieldFilling:
+    case SuggestionType::kFillPassword:
+      return OACAutofillSuggestionKindPassword;
+    case SuggestionType::kAddressEntry:
+    case SuggestionType::kAddressEntryOnTyping:
+    case SuggestionType::kAddressFieldByFieldFilling:
+      return OACAutofillSuggestionKindAddress;
+    case SuggestionType::kCreditCardEntry:
+    case SuggestionType::kVirtualCreditCardEntry:
+      return OACAutofillSuggestionKindCreditCard;
+    default:
+      return OACAutofillSuggestionKindAction;
+  }
+}
+
+NSString* JoinTexts(const std::vector<autofill::Suggestion::Text>& texts) {
+  std::u16string joined;
+  for (const auto& text : texts) {
+    if (text.value.empty()) {
+      continue;
+    }
+    if (!joined.empty()) {
+      joined += u"  ";
+    }
+    joined += text.value;
+  }
+  return base::SysUTF16ToNSString(joined);
+}
+
+OACAutofillSuggestion* BridgeSuggestion(const autofill::Suggestion& s) {
+  std::u16string label;
+  for (const auto& line : s.labels) {
+    for (const auto& text : line) {
+      if (text.value.empty()) {
+        continue;
+      }
+      if (!label.empty()) {
+        label += u"  ";
+      }
+      label += text.value;
+    }
+  }
+  if (!s.additional_label.empty()) {
+    if (!label.empty()) {
+      label += u"  ";
+    }
+    label += s.additional_label;
+  }
+  return [[OACAutofillSuggestion alloc]
+      initWithKind:SuggestionKindFor(s)
+          mainText:base::SysUTF16ToNSString(s.main_text.value)
+         minorText:JoinTexts(s.minor_texts)
+             label:base::SysUTF16ToNSString(label)
+        selectable:s.IsSelectable()
+        acceptable:s.IsAcceptable()];
+}
+
+}  // namespace
+
+// AutofillPopupView for the shell: one OACAutofillPopup request per shown
+// popup. Owned by itself (as PopupViewViews is): deleted on Hide().
+class ShellAutofillPopupView : public autofill::AutofillPopupView {
+ public:
+  ShellAutofillPopupView(
+      OACTab* tab,
+      base::WeakPtr<autofill::AutofillPopupController> controller)
+      : tab_(tab), controller_(std::move(controller)) {}
+  ShellAutofillPopupView(const ShellAutofillPopupView&) = delete;
+  ShellAutofillPopupView& operator=(const ShellAutofillPopupView&) = delete;
+
+  // autofill::AutofillPopupView:
+  bool Show(autofill::AutoselectFirstSuggestion autoselect) override {
+    OACTab* tab = tab_;
+    if (!controller_ || !tab || tab.isClosed) {
+      return false;
+    }
+    content::WebContents* contents = controller_->GetWebContents();
+    request_ = [[OACAutofillPopup alloc]
+        initWithTab:tab
+             origin:contents ? OACOriginFromURLOrigin(
+                                   contents->GetPrimaryMainFrame()
+                                       ->GetLastCommittedOrigin())
+                             : nil
+               view:weak_factory_.GetWeakPtr()];
+    selected_ = -1;
+    if (autoselect.value()) {
+      for (int i = 0; i < controller_->GetLineCount(); ++i) {
+        if (controller_->GetSuggestionAt(i).IsSelectable()) {
+          Select(i);
+          break;
+        }
+      }
+    }
+    Publish(/*notify=*/false);
+    OACAutofillPopup* request = request_;
+    OACPresentDialogRequest(
+        tab, request, @selector(tab:showAutofillPopup:),
+        ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+          return [delegate tab:owner showAutofillPopup:request];
+        });
+    // Chrome starts its accidental-click guard when the popup is painted.
+    controller_->OnPopupPainted();
+    return true;
+  }
+
+  void Hide() override {
+    // The controller is no longer valid after it hides us.
+    controller_ = nullptr;
+    OACAutofillPopup* request = request_;
+    request_ = nil;
+    [request withdrawByEngine];
+    delete this;
+  }
+
+  bool HandleKeyPressEvent(const input::NativeWebKeyboardEvent& event) override {
+    if (!controller_) {
+      return false;
+    }
+    const int modifiers = event.GetModifiers();
+    const bool has_non_shift_modifier =
+        modifiers & blink::WebInputEvent::kKeyModifiers &
+        ~blink::WebInputEvent::kShiftKey;
+    switch (event.windows_key_code) {
+      case ui::VKEY_UP:
+        Step(-1);
+        return true;
+      case ui::VKEY_DOWN:
+        Step(+1);
+        return true;
+      case ui::VKEY_ESCAPE:
+        controller_->Hide(autofill::SuggestionHidingReason::kUserAborted);
+        return true;
+      case ui::VKEY_RETURN:
+        if (selected_ >= 0 && !has_non_shift_modifier) {
+          Accept(selected_);
+          return true;
+        }
+        return false;
+      case ui::VKEY_TAB:
+        // Choose the highlighted row and let Tab move the focus on, as
+        // Chrome's popup does.
+        if (selected_ >= 0 && !has_non_shift_modifier) {
+          Accept(selected_);
+        }
+        return false;
+      case ui::VKEY_DELETE:
+        if ((modifiers & blink::WebInputEvent::kShiftKey) && selected_ >= 0 &&
+            controller_->RemoveSuggestion(selected_)) {
+          return true;
+        }
+        return false;
+      default:
+        return false;
+    }
+  }
+
+  void OnSuggestionsChanged(bool prefer_prev_arrow_side) override {
+    if (!controller_) {
+      return;
+    }
+    if (selected_ >= controller_->GetLineCount()) {
+      selected_ = -1;
+    }
+    Publish(/*notify=*/true);
+  }
+
+  bool OverlapsWithPictureInPictureWindow() const override { return false; }
+  void AxAnnounce(const std::u16string& text) override {}
+  std::optional<int32_t> GetAxUniqueId() override { return std::nullopt; }
+
+  base::WeakPtr<autofill::AutofillPopupView> CreateSubPopupView(
+      base::WeakPtr<autofill::AutofillPopupController> sub_controller)
+      override {
+    // Sub-menus (manual fallback, address field-by-field) are not drawn:
+    // their rows stay reachable from the main list. Follow-up.
+    return nullptr;
+  }
+  std::optional<size_t> GetIndexOfSubPopupAnchorSuggestion() const override {
+    return std::nullopt;
+  }
+  bool HasFocus() const override { return contains_pointer_; }
+  base::WeakPtr<autofill::AutofillPopupView> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  // From OACAutofillPopup.
+  void Select(int index) {
+    if (!controller_) {
+      return;
+    }
+    if (index < 0 || index >= controller_->GetLineCount() ||
+        !controller_->GetSuggestionAt(index).IsSelectable()) {
+      if (selected_ >= 0) {
+        selected_ = -1;
+        controller_->UnselectSuggestion();
+      }
+      return;
+    }
+    selected_ = index;
+    controller_->SelectSuggestion(index);
+  }
+
+  void SelectFromShell(int index) {
+    Select(index);
+    Publish(/*notify=*/true);
+  }
+
+  void Accept(int index) {
+    if (!controller_ || index < 0 || index >= controller_->GetLineCount() ||
+        !controller_->GetSuggestionAt(index).IsAcceptable()) {
+      return;
+    }
+    contains_pointer_ = false;
+    // Chrome may hide (and so delete) this view while accepting.
+    base::WeakPtr<autofill::AutofillPopupController> controller = controller_;
+    controller->AcceptSuggestion(
+        index, autofill::AutofillMetrics::SuggestionAcceptedMethod::kMouse,
+        /*was_obscured=*/false);
+  }
+
+  void AcceptFromShell(int index) {
+    // A click on the shell's dropdown may have taken keyboard focus from the
+    // page; give it back so the filled field keeps the caret.
+    content::WebContents* contents =
+        controller_ ? controller_->GetWebContents() : nullptr;
+    base::WeakPtr<content::WebContents> weak_contents =
+        contents ? contents->GetWeakPtr() : nullptr;
+    Accept(index);  // May delete `this`.
+    if (weak_contents) {
+      weak_contents->Focus();
+    }
+  }
+
+  // The shell closed the dropdown (Escape in the shell, a click elsewhere).
+  void HideFromShell() {
+    if (controller_) {
+      controller_->Hide(autofill::SuggestionHidingReason::kUserAborted);
+    }
+  }
+
+  void SetContainsPointer(bool contains) { contains_pointer_ = contains; }
+
+ private:
+  ~ShellAutofillPopupView() override = default;
+
+  // Moves the highlight to the next selectable row (wrapping, as Chrome's
+  // popup does).
+  void Step(int direction) {
+    const int count = controller_->GetLineCount();
+    if (count == 0) {
+      return;
+    }
+    int index = selected_;
+    for (int i = 0; i < count; ++i) {
+      index = index < 0 ? (direction > 0 ? 0 : count - 1)
+                        : (index + direction + count) % count;
+      if (controller_->GetSuggestionAt(index).IsSelectable()) {
+        Select(index);
+        Publish(/*notify=*/true);
+        return;
+      }
+    }
+  }
+
+  // Copies the controller's rows into the request; `notify` tells the shell.
+  void Publish(bool notify) {
+    OACAutofillPopup* request = request_;
+    if (!controller_ || !request || request.isFinished) {
+      return;
+    }
+    NSMutableArray<OACAutofillSuggestion*>* rows = [NSMutableArray array];
+    for (const autofill::Suggestion& suggestion :
+         controller_->GetSuggestions()) {
+      [rows addObject:BridgeSuggestion(suggestion)];
+    }
+    // element_bounds() is in screen coordinates (ChromeAutofillClient adds
+    // the container's screen origin); the shell wants view coordinates.
+    gfx::RectF bounds = controller_->element_bounds();
+    if (content::WebContents* contents = controller_->GetWebContents()) {
+      const gfx::Rect container = contents->GetContainerBounds();
+      bounds.Offset(-container.x(), -container.y());
+    }
+    [request updateSuggestions:rows
+                 elementBounds:CGRectMake(bounds.x(), bounds.y(),
+                                          bounds.width(), bounds.height())
+                 isRightToLeft:controller_->GetElementTextDirection() ==
+                               base::i18n::RIGHT_TO_LEFT
+                 selectedIndex:selected_];
+    if (!notify) {
+      return;
+    }
+    OACTab* tab = tab_;
+    OACPostToMainThread(^{
+      id<OACDialogDelegate> delegate = tab.dialogDelegate;
+      if (tab && !tab.isClosed && !request.isFinished &&
+          [delegate respondsToSelector:@selector(tab:didUpdateAutofillPopup:)]) {
+        [delegate tab:tab didUpdateAutofillPopup:request];
+      }
+    });
+  }
+
+  __weak OACTab* tab_;
+  base::WeakPtr<autofill::AutofillPopupController> controller_;
+  OACAutofillPopup* __strong request_ = nil;
+  int selected_ = -1;
+  bool contains_pointer_ = false;
+  base::WeakPtrFactory<ShellAutofillPopupView> weak_factory_{this};
+};
+
+}  // namespace openarc
+
+@implementation OACAutofillPopup {
+  NSArray<OACAutofillSuggestion*>* _suggestions;
+  CGRect _elementBounds;
+  BOOL _isRightToLeft;
+  NSInteger _selectedIndex;
+  BOOL _containsPointer;
+  base::WeakPtr<openarc::ShellAutofillPopupView> _view;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                       view:(base::WeakPtr<openarc::ShellAutofillPopupView>)view {
+  if ((self = [super initWithTab:tab origin:origin isFromSubframe:NO])) {
+    _suggestions = @[];
+    _elementBounds = CGRectZero;
+    _selectedIndex = -1;
+    _view = std::move(view);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self cancel];
+}
+
+- (void)updateSuggestions:(NSArray<OACAutofillSuggestion*>*)suggestions
+            elementBounds:(CGRect)elementBounds
+            isRightToLeft:(BOOL)isRightToLeft
+            selectedIndex:(NSInteger)selectedIndex {
+  _suggestions = [suggestions copy];
+  _elementBounds = elementBounds;
+  _isRightToLeft = isRightToLeft;
+  _selectedIndex = selectedIndex;
+}
+
+- (NSArray<OACAutofillSuggestion*>*)suggestions {
+  return _suggestions;
+}
+- (CGRect)elementBounds {
+  return _elementBounds;
+}
+- (BOOL)isRightToLeft {
+  return _isRightToLeft;
+}
+- (NSInteger)selectedIndex {
+  return _selectedIndex;
+}
+- (BOOL)containsPointer {
+  return _containsPointer;
+}
+
+- (void)setContainsPointer:(BOOL)containsPointer {
+  _containsPointer = containsPointer;
+  if (_view) {
+    _view->SetContainsPointer(containsPointer);
+  }
+}
+
+- (void)selectSuggestionAtIndex:(NSInteger)index {
+  if (self.isFinished || !_view) {
+    return;
+  }
+  _view->SelectFromShell(static_cast<int>(index));
+}
+
+- (void)acceptSuggestionAtIndex:(NSInteger)index {
+  if (self.isFinished || !_view) {
+    return;
+  }
+  _view->AcceptFromShell(static_cast<int>(index));
+}
+
+- (void)cancel {
+  if (![self markFinished]) {
+    return;
+  }
+  if (_view) {
+    // Closing the dropdown hides Chrome's controller, which hides the view.
+    base::WeakPtr<openarc::ShellAutofillPopupView> view = _view;
+    _view = nullptr;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<openarc::ShellAutofillPopupView> view) {
+              if (view) {
+                view->HideFromShell();
+              }
+            },
+            view));
+  }
+}
+
+@end
+
+namespace openarc {
+
+namespace {
+
+// AutofillPopupView::SetEmbedderFactory's factory.
+base::WeakPtr<autofill::AutofillPopupView> CreateShellAutofillPopupView(
+    base::WeakPtr<autofill::AutofillPopupController> controller) {
+  OACTab* tab = OACTabForWebContents(controller->GetWebContents());
+  if (!tab || tab.isClosed) {
+    return nullptr;  // Chrome hides the popup (kViewDestroyed).
+  }
+  return (new ShellAutofillPopupView(tab, controller))->GetWeakPtr();
+}
+
+// The password bubble of one tab: the bubble controller Chrome's Views bubble
+// would own, and the request the shell answers.
+class ShellPasswordBubble {
+ public:
+  ShellPasswordBubble(ManagePasswordsUIController& controller, OACTab* tab)
+      : controller_(controller.GetModelDelegateProxy()),
+        bubble_(std::make_unique<SaveUpdateBubbleController>(
+            controller.GetModelDelegateProxy(),
+            PasswordBubbleControllerBase::DisplayReason::kAutomatic)) {
+    // The controller's pending credential is what the bubble controller
+    // copied (its own accessor is protected).
+    const password_manager::PasswordForm& form = controller.GetPendingPassword();
+    base::WeakPtr<ShellPasswordBubble> weak_this = weak_factory_.GetWeakPtr();
+    request_ = [[OACPasswordSavePrompt alloc]
+           initWithTab:tab
+                origin:OACOriginFromURLOrigin(controller.GetOrigin())
+                  kind:bubble_->IsCurrentStateUpdate()
+                           ? OACPasswordSavePromptKindUpdate
+                           : OACPasswordSavePromptKindSave
+              username:base::SysUTF16ToNSString(form.username_value)
+        passwordLength:form.password_value.size()
+                answer:base::BindOnce(
+                           [](base::WeakPtr<ShellPasswordBubble> self,
+                              PasswordSaveAnswer answer, NSString* username) {
+                             if (self) {
+                               self->Answer(answer, username);
+                             }
+                           },
+                           weak_this)];
+    OACPasswordSavePrompt* request = request_;
+    OACPresentDialogRequest(
+        tab, request, @selector(tab:offerToSavePassword:),
+        ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+          return [delegate tab:owner offerToSavePassword:request];
+        });
+  }
+  ShellPasswordBubble(const ShellPasswordBubble&) = delete;
+  ShellPasswordBubble& operator=(const ShellPasswordBubble&) = delete;
+
+  ~ShellPasswordBubble() {
+    [request_ withdrawByEngine];
+    // ~SaveUpdateBubbleController reports the interaction and tells the
+    // controller the bubble is gone (OnBubbleHidden).
+    bubble_.reset();
+  }
+
+  // The UI controller (as its model delegate); null once it is gone.
+  PasswordsModelDelegate* controller() const { return controller_.get(); }
+
+ private:
+  // The user answered: act on the bubble controller, then close (from a fresh
+  // task, since closing re-enters the UI controller).
+  void Answer(PasswordSaveAnswer answer, NSString* username) {
+    if (bubble_ && controller_ &&
+        (controller_->GetState() ==
+             password_manager::ui::PENDING_PASSWORD_STATE ||
+         controller_->GetState() ==
+             password_manager::ui::PENDING_PASSWORD_UPDATE_STATE)) {
+      switch (answer) {
+        case PasswordSaveAnswer::kSave:
+          if (username) {
+            bubble_->OnCredentialEdited(
+                base::SysNSStringToUTF16(username),
+                controller_->GetPendingPassword().password_value);
+          }
+          bubble_->OnSaveClicked();
+          break;
+        case PasswordSaveAnswer::kNever:
+          bubble_->OnNeverForThisSiteClicked();
+          break;
+        case PasswordSaveAnswer::kDecline:
+          if (bubble_->IsCurrentStateUpdate()) {
+            bubble_->OnNoThanksClicked();
+          } else {
+            bubble_->OnNotNowClicked();
+          }
+          break;
+        case PasswordSaveAnswer::kDismiss:
+          break;  // No interaction: Chrome counts the dismissal.
+      }
+    }
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ShellPasswordBubble::CloseSoon,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  static void CloseSoon(base::WeakPtr<ShellPasswordBubble> self);
+
+  base::WeakPtr<PasswordsModelDelegate> controller_;
+  std::unique_ptr<SaveUpdateBubbleController> bubble_;
+  OACPasswordSavePrompt* __strong request_ = nil;
+  base::WeakPtrFactory<ShellPasswordBubble> weak_factory_{this};
+};
+
+// ManagePasswordsUIController's embedder bubble host: at most one bubble per
+// tab (Chrome has one per window).
+class BridgePasswordBubbleHost
+    : public ManagePasswordsUIController::EmbedderBubbleHost {
+ public:
+  static BridgePasswordBubbleHost& Get() {
+    static base::NoDestructor<BridgePasswordBubbleHost> host;
+    return *host;
+  }
+
+  void ShowBubble(ManagePasswordsUIController& controller) override {
+    HideBubble(controller);
+    const password_manager::ui::State state = controller.GetState();
+    if (state != password_manager::ui::PENDING_PASSWORD_STATE &&
+        state != password_manager::ui::PENDING_PASSWORD_UPDATE_STATE) {
+      // Other bubbles (saved confirmation, manage, leak warnings, passkeys)
+      // have no shell view yet. Follow-up.
+      return;
+    }
+    OACTab* tab = OACTabForWebContents(controller.GetWebContents());
+    if (!tab || tab.isClosed) {
+      return;
+    }
+    bubbles_.push_back(std::make_unique<ShellPasswordBubble>(controller, tab));
+  }
+
+  void HideBubble(ManagePasswordsUIController& controller) override {
+    for (auto it = bubbles_.begin(); it != bubbles_.end(); ++it) {
+      PasswordsModelDelegate* owner = (*it)->controller();
+      if (owner == static_cast<PasswordsModelDelegate*>(&controller) ||
+          !owner) {
+        // Out of the list before it is destroyed: its destructor re-enters
+        // HideBubble through OnBubbleHidden.
+        std::unique_ptr<ShellPasswordBubble> bubble = std::move(*it);
+        bubbles_.erase(it);
+        bubble.reset();
+        return;
+      }
+    }
+  }
+
+  void Close(ShellPasswordBubble* bubble) {
+    for (auto it = bubbles_.begin(); it != bubbles_.end(); ++it) {
+      if (it->get() == bubble) {
+        std::unique_ptr<ShellPasswordBubble> owned = std::move(*it);
+        bubbles_.erase(it);
+        owned.reset();
+        return;
+      }
+    }
+  }
+
+ private:
+  friend class base::NoDestructor<BridgePasswordBubbleHost>;
+  BridgePasswordBubbleHost() = default;
+
+  std::vector<std::unique_ptr<ShellPasswordBubble>> bubbles_;
+};
+
+// static
+void ShellPasswordBubble::CloseSoon(base::WeakPtr<ShellPasswordBubble> self) {
+  if (self) {
+    BridgePasswordBubbleHost::Get().Close(self.get());
+  }
+}
+
+}  // namespace
+
+void InstallBridgeAutofillHost() {
+  ManagePasswordsUIController::SetEmbedderBubbleHost(
+      &BridgePasswordBubbleHost::Get());
+  autofill::AutofillPopupView::SetEmbedderFactory(
+      &CreateShellAutofillPopupView);
+}
+
+}  // namespace openarc
