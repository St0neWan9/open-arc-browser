diff --git a/openarc/browser/openarc_web_contents_view_delegate.h b/openarc/browser/openarc_web_contents_view_delegate.h
new file mode 100644
index 000000000000..e77679b415a7
--- /dev/null
+++ b/openarc/browser/openarc_web_contents_view_delegate.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_WEB_CONTENTS_VIEW_DELEGATE_H_
+#define OPENARC_BROWSER_OPENARC_WEB_CONTENTS_VIEW_DELEGATE_H_
+
+#include <memory>
+
+#include "content/public/browser/web_contents_view_delegate.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace openarc {
+
+// The view delegate of every tab's WebContents. Its only job is to give each
+// page's render widget view Chrome's event delegate, which carries the
+// two-finger swipe back and forward through the tab's history (with its arrow
+// overlay) and the spelling menu validation. Everything else keeps content's
+// defaults: the shell draws the page's context menu from the tab's
+// WebContentsDelegate (HandleContextMenu runs first, so ShowContextMenu here
+// is never reached), and drops pass through unchanged.
+class OpenArcWebContentsViewDelegate : public content::WebContentsViewDelegate {
+ public:
+  OpenArcWebContentsViewDelegate();
+  OpenArcWebContentsViewDelegate(const OpenArcWebContentsViewDelegate&) =
+      delete;
+  OpenArcWebContentsViewDelegate& operator=(
+      const OpenArcWebContentsViewDelegate&) = delete;
+  ~OpenArcWebContentsViewDelegate() override;
+
+  // content::WebContentsViewDelegate:
+  NSObject<RenderWidgetHostViewMacDelegate>* GetDelegateForHost(
+      content::RenderWidgetHost* render_widget_host,
+      bool is_popup) override;
+};
+
+std::unique_ptr<content::WebContentsViewDelegate>
+CreateWebContentsViewDelegate(content::WebContents* web_contents);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_WEB_CONTENTS_VIEW_DELEGATE_H_
diff --git a/openarc/browser/openarc_web_contents_view_delegate.mm b/openarc/browser/openarc_web_contents_view_delegate.mm
new file mode 100644
index 000000000000..5b493692fa1d
--- /dev/null
+++ b/openarc/browser/openarc_web_contents_view_delegate.mm
@@ -0,0 +1,34 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/browser/openarc_web_contents_view_delegate.h"
+
+#import "chrome/browser/renderer_host/chrome_render_widget_host_view_mac_delegate.h"
+
+namespace openarc {
+
+OpenArcWebContentsViewDelegate::OpenArcWebContentsViewDelegate() = default;
+
+OpenArcWebContentsViewDelegate::~OpenArcWebContentsViewDelegate() = default;
+
+NSObject<RenderWidgetHostViewMacDelegate>*
+OpenArcWebContentsViewDelegate::GetDelegateForHost(
+    content::RenderWidgetHost* render_widget_host,
+    bool is_popup) {
+  // Popups (<select> lists, date pickers) have no history to swipe through.
+  if (is_popup) {
+    return nil;
+  }
+  // Chrome's delegate navigates with chrome::GoBack(WebContents*) and
+  // GoForward, which need no Chrome window.
+  return [[ChromeRenderWidgetHostViewMacDelegate alloc]
+      initWithRenderWidgetHost:render_widget_host];
+}
+
+std::unique_ptr<content::WebContentsViewDelegate>
+CreateWebContentsViewDelegate(content::WebContents* web_contents) {
+  return std::make_unique<OpenArcWebContentsViewDelegate>();
+}
+
+}  // namespace openarc
