@@ -143,10 +144,10 @@ void CreateLoginTabHelper(content::WebContents* web_contents) override {
 std::unique_ptr<content::WebContentsViewDelegate>
 OpenArcContentBrowserClient::GetWebContentsViewDelegate(
     content::WebContents* web_contents) {
-  // Chrome's view delegate shows Chrome's context menu and drag-and-drop UI.
-  // The shell draws its own menus (OACTabDelegate tab:willShowContextMenu:),
-  // so content's default behaviour stays.
-  return nullptr;
+  // Not Chrome's view delegate: that one shows Chrome's context menu and
+  // drag-and-drop UI, and the shell draws its own menus. Ours only adds the
+  // two-finger history swipe to each page (issue #21).
+  return CreateWebContentsViewDelegate(web_contents);
 }
 
