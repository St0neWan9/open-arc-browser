 .../views/autofill/popup/popup_view_views.cc  |  17 +++
 4 files changed, 205 insertions(+), 11 deletions(-)

diff --git a/chrome/browser/ui/autofill/autofill_popup_view.h b/chrome/browser/ui/autofill/autofill_popup_view.h
index feddf1bd8122..7819500af4c7 100644
--- a/chrome/browser/ui/autofill/autofill_popup_view.h
+++ b/chrome/browser/ui/autofill/autofill_popup_view.h
@@ -13,6 +13,7 @@
 
 #include "base/memory/weak_ptr.h"
 #include "base/time/time.h"
+#include "build/build_config.h"
 #include "components/autofill/core/browser/foundations/autofill_client.h"
 #include "components/autofill/core/browser/ui/tabbed_pane_enums.h"
 #include "components/autofill/core/common/aliases.h"
@@ -71,6 +72,18 @@ class AutofillPopupView {
       std::optional<const TabbedPaneConfig> tabbed_pane_config = std::nullopt,
       std::optional<const SubPopupConfig> sub_popup_config = std::nullopt);
 
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: an app that embeds Chrome's browser process and owns the UI
+  // (chrome::EmbedderOwnsUI()) draws the Autofill popup itself; Chrome's Views
+  // popup needs a Views or Cocoa browser window around the tab. While a
+  // factory is set, Create() returns what it returns (nullptr hides the
+  // popup, as when the Views popup cannot be shown). Sub-popups are the
+  // embedder view's CreateSubPopupView().
+  using EmbedderFactory = base::WeakPtr<AutofillPopupView> (*)(
+      base::WeakPtr<AutofillPopupController> controller);
+  static void SetEmbedderFactory(EmbedderFactory factory);
+#endif
+
   // Attempts to display the Autofill popup and fills it with data from the
   // controller. Returns whether the popup was shown.
   virtual bool Show(AutoselectFirstSuggestion autoselect_first_suggestion) = 0;
diff --git a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
index 87f9d9810b08..8e8cbf967dc5 100644
--- a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
+++ b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
@@ -121,6 +121,15 @@ int ManagePasswordsUIController::save_fallback_timeout_in_seconds_ = 90;
 
 namespace {
 
+#if BUILDFLAG(IS_MAC)
+// Open Arc: see ManagePasswordsUIController::SetEmbedderBubbleHost().
+ManagePasswordsUIController::EmbedderBubbleHost* g_embedder_bubble_host =
+    nullptr;
+// Open Arc: see ManagePasswordsUIController::SetEmbedderUserDataHostLookup().
+ManagePasswordsUIController::EmbedderUserDataHostLookup
+    g_embedder_user_data_host_lookup = nullptr;
+#endif
+
 using Logger = autofill::SavePasswordProgressLogger;
 using enum password_manager::PasswordForm::Store;
 
@@ -199,8 +208,35 @@ GetSaveProgressLogger(password_manager::PasswordManagerClient* client) {
 ManagePasswordsUIController::ManagePasswordsUIController(
     tabs::TabInterface& tab,
     content::WebContents* web_contents)
+    : ManagePasswordsUIController(tab.GetUnownedUserDataHost(),
+                                  web_contents,
+                                  /*owned_by_embedder=*/false) {
+  tab_will_detach_subscription_ = tab.RegisterWillDetach(base::BindRepeating(
+      [](ManagePasswordsUIController* controller, tabs::TabInterface* tab,
+         tabs::TabInterface::DetachReason reason) {
+        if (reason == tabs::TabInterface::DetachReason::kDelete) {
+          controller->Cleanup();
+        }
+      },
+      base::Unretained(this)));
+}
+
+#if BUILDFLAG(IS_MAC)
+ManagePasswordsUIController::ManagePasswordsUIController(
+    ui::UnownedUserDataHost& host,
+    content::WebContents* web_contents)
+    : ManagePasswordsUIController(host,
+                                  web_contents,
+                                  /*owned_by_embedder=*/true) {}
+#endif
+
+ManagePasswordsUIController::ManagePasswordsUIController(
+    ui::UnownedUserDataHost& host,
+    content::WebContents* web_contents,
+    bool owned_by_embedder)
     : content::WebContentsObserver(web_contents),
-      scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {
+      owned_by_embedder_(owned_by_embedder),
+      scoped_unowned_user_data_(host, *this) {
   passwords_data_.set_client(
       ChromePasswordManagerClient::FromWebContents(web_contents));
   password_manager::PasswordStoreInterface* profile_password_store =
@@ -213,14 +249,6 @@ ManagePasswordsUIController::ManagePasswordsUIController(
   if (account_password_store) {
     account_password_store->AddObserver(this);
   }
-  tab_will_detach_subscription_ = tab.RegisterWillDetach(base::BindRepeating(
-      [](ManagePasswordsUIController* controller, tabs::TabInterface* tab,
-         tabs::TabInterface::DetachReason reason) {
-        if (reason == tabs::TabInterface::DetachReason::kDelete) {
-          controller->Cleanup();
-        }
-      },
-      base::Unretained(this)));
 }
 
 ManagePasswordsUIController::~ManagePasswordsUIController() {
@@ -241,6 +269,15 @@ ManagePasswordsUIController* ManagePasswordsUIController::FromWebContents(
   }
   tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(
       const_cast<content::WebContents*>(web_contents));
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: an embedder's tab has no TabInterface; its controller is
+  // registered in the embedder's host.
+  if (!tab && g_embedder_user_data_host_lookup) {
+    ui::UnownedUserDataHost* host =
+        g_embedder_user_data_host_lookup(web_contents);
+    return host ? Get(*host) : nullptr;
+  }
+#endif
   return From(tab);
 }
 
@@ -442,6 +479,10 @@ void ManagePasswordsUIController::OnPromptEnableAutoSignin() {
   if (dialog_controller_) {
     return;
   }
+  // Open Arc: the dialog is web-modal in a Browser window.
+  if (owned_by_embedder_) {
+    return;
+  }
   auto* raw_controller = new CredentialManagerDialogControllerImpl(
       Profile::FromBrowserContext(web_contents()->GetBrowserContext()), this);
   dialog_controller_.reset(raw_controller);
@@ -539,6 +580,11 @@ void ManagePasswordsUIController::OnCredentialLeak(
   if (dialog_controller_) {
     return;
   }
+  // Open Arc: the leak dialog and the password change flow need a tab
+  // (tabs::TabInterface) in a Browser window.
+  if (owned_by_embedder_) {
+    return;
+  }
 
   // Hide the manage passwords bubble if currently shown.
   if (IsShowingBubble()) {
@@ -1123,9 +1169,14 @@ void ManagePasswordsUIController::
 
 void ManagePasswordsUIController::NavigateToPasswordCheckup(
     password_manager::PasswordCheckReferrer referrer) {
-  chrome::ShowPasswordCheck(
+  BrowserWindowInterface* browser =
       GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
-          web_contents()));
+          web_contents());
+  // Open Arc: an embedder's tab has no Browser window.
+  if (!browser) {
+    return;
+  }
+  chrome::ShowPasswordCheck(browser);
   password_manager::LogPasswordCheckReferrer(referrer);
 }
 
@@ -1237,6 +1288,10 @@ void ManagePasswordsUIController::NavigateToPasswordChangeSettings() {
   BrowserWindowInterface* browser =
       GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
           web_contents());
+  // Open Arc: an embedder's tab has no Browser window.
+  if (!browser) {
+    return;
+  }
   ShowSingletonTabOverwritingNTP(browser,
                                  GURL(chrome::kChromeUiPasswordChangeUrl),
                                  NavigateParams::IGNORE_AND_NAVIGATE);
@@ -1270,6 +1325,29 @@ void ManagePasswordsUIController::UpdateBubbleAndIconVisibility() {
     ClearPopUpFlagForBubble();
   }
 
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: the embedding app draws the bubble (no Browser window, no
+  // omnibox icon). Same steps as UpdatePasswordIconAndBubbleState() without
+  // the icon.
+  if (g_embedder_bubble_host) {
+    const password_manager::ui::State state = GetState();
+    if (state != last_page_action_state_) {
+      g_embedder_bubble_host->HideBubble(*this);
+    }
+    last_page_action_state_ = state;
+    if (IsAutomaticallyOpeningBubble() ||
+        bubble_status_ == BubbleStatus::SHOULD_POP_UP_WITH_FOCUS) {
+      g_embedder_bubble_host->HideBubble(*this);
+      // Detaches a closing bubble, so OnBubbleHidden() isn't called.
+      weak_ptr_factory_.InvalidateWeakPtrs();
+      g_embedder_bubble_host->ShowBubble(*this);
+      // If the bubble appeared the status is updated in OnBubbleShown().
+      ClearPopUpFlagForBubble();
+    }
+    return;
+  }
+#endif
+
   BrowserWindowInterface* browser =
       GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
           web_contents());
@@ -1570,6 +1648,12 @@ bool ManagePasswordsUIController::BubbleManagerHasPasswordBubbleInQueue()
 }
 
 void ManagePasswordsUIController::ShowBubble() {
+#if BUILDFLAG(IS_MAC)
+  if (g_embedder_bubble_host) {
+    g_embedder_bubble_host->ShowBubble(*this);
+    return;
+  }
+#endif
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->ShowManagePasswordsBubble(user_action_);
   }
@@ -1577,6 +1661,12 @@ void ManagePasswordsUIController::ShowBubble() {
 
 void ManagePasswordsUIController::HideBubble(bool initiated_by_bubble_manager) {
   is_mouse_hovered_ = false;
+#if BUILDFLAG(IS_MAC)
+  if (g_embedder_bubble_host) {
+    g_embedder_bubble_host->HideBubble(*this);
+    return;
+  }
+#endif
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->HideManagePasswordsBubble();
   }
@@ -1617,6 +1707,10 @@ void ManagePasswordsUIController::StartTrustedVaultErrorResolutionFlow() {
   BrowserWindowInterface* browser =
       GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
           web_contents());
+  // Open Arc: an embedder's tab has no Browser window.
+  if (!browser) {
+    return;
+  }
   OpenTabForSyncKeyRetrieval(
       browser,
       trusted_vault::TrustedVaultUserActionTriggerForUMA::kPasswordSavePrompt);
@@ -1714,3 +1808,17 @@ void ManagePasswordsUIController::QueueOrShowBubble(bool user_action) {
     manager->RequestShowController(*this, user_action);
   }
 }
+
+#if BUILDFLAG(IS_MAC)
+// static
+void ManagePasswordsUIController::SetEmbedderBubbleHost(
+    EmbedderBubbleHost* host) {
+  g_embedder_bubble_host = host;
+}
+
+// static
+void ManagePasswordsUIController::SetEmbedderUserDataHostLookup(
+    EmbedderUserDataHostLookup lookup) {
+  g_embedder_user_data_host_lookup = lookup;
+}
+#endif
diff --git a/chrome/browser/ui/passwords/manage_passwords_ui_controller.h b/chrome/browser/ui/passwords/manage_passwords_ui_controller.h
index 2815920fb2c6..7335d348d1b6 100644
--- a/chrome/browser/ui/passwords/manage_passwords_ui_controller.h
+++ b/chrome/browser/ui/passwords/manage_passwords_ui_controller.h
@@ -15,6 +15,7 @@
 #include "base/memory/raw_ptr.h"
 #include "base/memory/weak_ptr.h"
 #include "base/timer/timer.h"
+#include "build/build_config.h"
 #include "chrome/browser/ui/autofill/bubble_controller_base.h"
 #include "chrome/browser/ui/passwords/manage_passwords_state.h"
 #include "chrome/browser/ui/passwords/passwords_client_ui_delegate.h"
@@ -82,6 +83,19 @@ class ManagePasswordsUIController
 
   ManagePasswordsUIController(tabs::TabInterface& tab,
                               content::WebContents* web_contents);
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: for a tab of an app that embeds Chrome's browser process and
+  // owns the UI (chrome::EmbedderOwnsUI()). Such a tab has no
+  // tabs::TabInterface, so the embedder owns the controller in its own
+  // per-WebContents data and registers it in `host`, where FromWebContents()
+  // finds it (SetEmbedderUserDataHostLookup()). With no tab to report that it
+  // closes, the embedder destroys the controller no later than in
+  // WebContentsObserver::WebContentsDestroyed(). Prompts that need a tab or a
+  // Browser window (credential chooser, auto sign-in first-run dialog, leak
+  // dialog) are not shown for such a tab.
+  ManagePasswordsUIController(ui::UnownedUserDataHost& host,
+                              content::WebContents* web_contents);
+#endif
   ManagePasswordsUIController(const ManagePasswordsUIController&) = delete;
   ManagePasswordsUIController& operator=(const ManagePasswordsUIController&) =
       delete;
@@ -270,6 +284,39 @@ class ManagePasswordsUIController
 
   void ShowAutoSignInToast();
 
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: an app that embeds Chrome's browser process and owns the UI
+  // (chrome::EmbedderOwnsUI()) draws the password bubble itself; its tabs have
+  // no Browser window, so the omnibox icon and the Views bubble never appear.
+  // While a host is set, the controller asks it instead of the Browser window
+  // whenever Chrome would pop the bubble up, and when Chrome would close it.
+  // The host builds the bubble controller for GetState() from
+  // GetModelDelegateProxy() (for example a SaveUpdateBubbleController), as
+  // Chrome's Views bubble does, and destroys it when the user answered or the
+  // bubble went away.
+  class EmbedderBubbleHost {
+   public:
+    virtual ~EmbedderBubbleHost() = default;
+    // Shows the bubble for the controller's current state. May decline (the
+    // state has no embedder bubble); the controller then stays as if the
+    // bubble had been closed.
+    virtual void ShowBubble(ManagePasswordsUIController& controller) = 0;
+    // Closes the bubble of `controller` if one is open. Must tolerate being
+    // called while that bubble is closing.
+    virtual void HideBubble(ManagePasswordsUIController& controller) = 0;
+  };
+  // Not owned; nullptr clears it. UI thread only.
+  static void SetEmbedderBubbleHost(EmbedderBubbleHost* host);
+
+  // Open Arc: returns the host an embedder registered the controller of
+  // `web_contents` in (see the constructor above), or nullptr. FromWebContents()
+  // asks it for a WebContents that is not a tab. nullptr clears it. UI thread
+  // only.
+  using EmbedderUserDataHostLookup =
+      ui::UnownedUserDataHost* (*)(content::WebContents* web_contents);
+  static void SetEmbedderUserDataHostLookup(EmbedderUserDataHostLookup lookup);
+#endif
+
  protected:
   // Called when a PasswordForm is autofilled, when a new PasswordForm is
   // submitted, or when a navigation occurs to update the visibility of the
@@ -318,6 +365,11 @@ class ManagePasswordsUIController
   PasswordsLeakDialogDelegate* GetPasswordsLeakDialogDelegate() override;
 
  private:
+  // Open Arc: shared by the public constructors.
+  ManagePasswordsUIController(ui::UnownedUserDataHost& host,
+                              content::WebContents* web_contents,
+                              bool owned_by_embedder);
+
   void OnReauthCompleted();
 
   enum class BubbleStatus {
@@ -468,6 +520,10 @@ class ManagePasswordsUIController
 
   base::CallbackListSubscription tab_will_detach_subscription_;
 
+  // Open Arc: created for a tab without a tabs::TabInterface (the embedder
+  // constructor).
+  const bool owned_by_embedder_;
+
   ui::ScopedUnownedUserData<ManagePasswordsUIController>
       scoped_unowned_user_data_;
 
