From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: voidforge <voidforge@valuz.io>
Date: Mon, 26 Oct 2026 19:32:02 -0700
Subject: [PATCH] openarc: chrome: let an embedder turn TFLite language
 detection off

Plan B47 (page translation). The renderer detects a page's language with
the TFLite model the optimization guide downloads; without the model it
uses only the page's lang attribute and Content-Language header, so a
page without them is never offered translation. An embedder without
Google API keys and with the component updater off never gets the
model, while the CLD3 detector that the renderer falls back to without
TFLite is linked in anyway.

IsTFLiteLanguageDetectionEnabled() now also checks the feature
kTFLiteLanguageDetection (enabled by default), so such an embedder can
disable it to use CLD3. Chrome's behavior is unchanged.
---
 components/translate/core/common/translate_util.cc | 9 ++++++++-
 components/translate/core/common/translate_util.h  | 4 ++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/components/translate/core/common/translate_util.cc b/components/translate/core/common/translate_util.cc
index 7763bae3c566..bf3491af69e2 100644
--- a/components/translate/core/common/translate_util.cc
+++ b/components/translate/core/common/translate_util.cc
@@ -7,6 +7,7 @@
 #include <string>
 
 #include "base/command_line.h"
+#include "base/feature_list.h"
 #include "base/metrics/field_trial_params.h"
 #include "build/build_config.h"
 #include "components/translate/core/common/translate_switches.h"
@@ -40,12 +41,18 @@ GURL GetTranslateSecurityOrigin() {
   return GURL(security_origin);
 }
 
+// Open Arc: an embedder without the optimization guide's model downloads (no
+// Google API keys, no component updater) never gets the TFLite model, so pages
+// without a lang attribute would never be detected. Turning this feature off
+// selects the CLD3 detector that is linked in anyway.
+BASE_FEATURE(kTFLiteLanguageDetection, base::FEATURE_ENABLED_BY_DEFAULT);
+
 bool IsTFLiteLanguageDetectionEnabled() {
 // The feature is explicitly disabled on WebView.
 // TODO(crbug.com/40819484): Enable the feature on WebView.
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_WIN) || \
     BUILDFLAG(IS_MAC) || BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
-  return true;
+  return base::FeatureList::IsEnabled(kTFLiteLanguageDetection);
 #else
   return false;
 #endif
diff --git a/components/translate/core/common/translate_util.h b/components/translate/core/common/translate_util.h
index 7a3b71edf5b1..d1313595ab05 100644
--- a/components/translate/core/common/translate_util.h
+++ b/components/translate/core/common/translate_util.h
@@ -20,6 +20,10 @@ extern const char kSecurityOrigin[];
 // language checks and to obtain the list of available languages.
 GURL GetTranslateSecurityOrigin();
 
+// Open Arc: TFLite-based language detection, on by default. An embedder that
+// cannot download the model turns it off to use CLD3.
+BASE_DECLARE_FEATURE(kTFLiteLanguageDetection);
+
 // Return whether TFLite-based language detection is enabled.
 bool IsTFLiteLanguageDetectionEnabled();
 
