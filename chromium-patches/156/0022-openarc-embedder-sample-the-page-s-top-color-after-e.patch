+// Plan B45: a finished load was sampled. Posted like every state change; the
+// delegate reads the new value from `state`.
+- (void)pageTopColorSampled:(openarc::PageTopColorKind)kind color:(SkColor)color {
+  if (_closed) {
+    return;
+  }
+  _pageTopColorKind = kind == openarc::PageTopColorKind::kScrollbar
+                          ? OACPageTopColorKindScrollbar
+                          : OACPageTopColorKindColor;
+  _pageTopColor =
+      kind == openarc::PageTopColorKind::kScrollbar
+          ? OACColor{0, 0, 0, 0}
+          : OACColor{SkColorGetR(color) / 255.0, SkColorGetG(color) / 255.0,
+                     SkColorGetB(color) / 255.0, 1.0};
+  [self webContentsDidChangeState];
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (tab && !tab.isClosed &&
+        [delegate respondsToSelector:@selector(tabDidSamplePageTopColor:)]) {
+      [delegate tabDidSamplePageTopColor:tab];
+    }
+  });
+}
