@@ -0,0 +1,89 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_PAGE_TOP_COLOR_H_
+#define OPENARC_BROWSER_OPENARC_PAGE_TOP_COLOR_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace openarc {
+
+// What a sample found at the top-right of the visible page (plan B45).
+enum class PageTopColorKind {
+  // A rendered page color (`color`).
+  kColor,
+  // A classic (always shown) scrollbar sits at the right edge of the viewport,
+  // so the sample would land on its track: the shell uses its fallback color.
+  kScrollbar,
+};
+
+// Samples the color the web toolbar takes from the page ([06 §17.4] observed
+// in Arc 1.170.0): the rendered color at the top row of the visible page, at
+// its right end, once every time a main-frame load finishes (navigation,
+// reload; at the scroll position of that moment). Scrolling and later style
+// changes do not trigger a new sample. When a classic scrollbar occupies the
+// right edge, the result is kScrollbar instead.
+//
+// How: when loading stops, a script in an isolated world reads the classic
+// scrollbar's width (window.innerWidth − documentElement.clientWidth; 0 with
+// overlay scrollbars or `::-webkit-scrollbar { display: none }`), a visual
+// state round trip makes sure the finished page's frame reached the
+// compositor, then CopyFromSurface copies a small area at the top-right corner
+// of the view and averages it. A tab that finishes loading while hidden is
+// sampled when it is next shown.
+class PageTopColorSampler : public content::WebContentsObserver {
+ public:
+  using Callback =
+      base::RepeatingCallback<void(PageTopColorKind kind, SkColor color)>;
+
+  // The sample area, in DIP, anchored at the top-right corner of the view.
+  // inferred: [06 §17.4] gives "a ~1–2 px area" with the exact size unknown;
+  // 3 × 12 reproduces both edge probes of the capture: a 2 px black strip at
+  // the right edge of a red band gave #540000 (one third red), a 1 px black
+  // line at the top of a red band gave #E92721 (about 11/12 red).
+  static constexpr int kSampleWidth = 3;
+  static constexpr int kSampleHeight = 12;
+
+  PageTopColorSampler(content::WebContents* web_contents, Callback callback);
+  PageTopColorSampler(const PageTopColorSampler&) = delete;
+  PageTopColorSampler& operator=(const PageTopColorSampler&) = delete;
+  ~PageTopColorSampler() override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void DidStopLoading() override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override;
+
+ private:
+  // Starts a sample for the current page (a new generation; older results in
+  // flight are dropped).
+  void Sample();
+  void DidMeasureScrollbar(int generation, base::Value result);
+  void DidSubmitVisualState(int generation, bool success);
+  void Copy(int generation);
+  void DidCopy(int generation, SkColor color, bool ok);
+  void RetryOrWait(int generation);
+
+  Callback callback_;
+  // Bumped by every Sample(); results of an older generation are ignored.
+  int generation_ = 0;
+  int attempts_ = 0;
+  // A cross-document main-frame navigation (or reload) committed and its
+  // load has not been sampled yet. Later loads of the same document (a
+  // subframe, a fetch that shows the spinner) do not sample again.
+  bool load_needs_sample_ = false;
+  // A load finished while the tab was hidden: sample when it is shown.
+  bool pending_until_visible_ = false;
+  base::WeakPtrFactory<PageTopColorSampler> weak_factory_{this};
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_PAGE_TOP_COLOR_H_
