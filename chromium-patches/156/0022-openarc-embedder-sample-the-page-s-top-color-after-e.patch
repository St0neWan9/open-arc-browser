new file mode 100644
index 000000000000..56a1b1abd5b9
--- /dev/null
+++ b/openarc/browser/openarc_page_top_color.mm
@@ -0,0 +1,239 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_page_top_color.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace openarc {
+
+namespace {
+
+// Width of a classic scrollbar at the right edge of the viewport, in CSS
+// pixels: the layout viewport minus the scrolling element's client width
+// (quirks mode scrolls the body). 0 with overlay scrollbars and with
+// `::-webkit-scrollbar { display: none }`.
+constexpr char16_t kScrollbarWidthScript[] =
+    u"(() => { try {"
+    u" const e = document.scrollingElement || document.documentElement;"
+    u" if (!e) return 0;"
+    u" return Math.max(0, window.innerWidth - e.clientWidth);"
+    u" } catch (_) { return 0; } })()";
+
+// A difference this small is rounding at fractional zoom levels, not a
+// scrollbar (a classic scrollbar is 15 DIP, at least 3 CSS px at 500 %).
+constexpr int kScrollbarMinimumWidth = 2;
+
+// Copies that fail (the frame is not ready, the view is being resized) are
+// retried this many times, this far apart.
+constexpr int kMaxAttempts = 4;
+constexpr base::TimeDelta kRetryDelay = base::Milliseconds(150);
+constexpr base::TimeDelta kCopyTimeout = base::Seconds(2);
+
+// Averages the copied pixels in sRGB, composited over white (a page without
+// its own background is drawn on white). The copy comes in the display's
+// color space (Display P3 on most Macs); the shell paints the bar in sRGB, so
+// the pixels are converted first. Returns false for an empty bitmap.
+bool AverageColor(const SkBitmap& source, SkColor* out) {
+  if (source.drawsNothing() || source.width() <= 0 || source.height() <= 0) {
+    return false;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::Make(
+          source.width(), source.height(), kN32_SkColorType,
+          kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB())) ||
+      !source.readPixels(bitmap.pixmap(), 0, 0)) {
+    return false;
+  }
+  double red = 0, green = 0, blue = 0;
+  const int count = bitmap.width() * bitmap.height();
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      const SkColor c = bitmap.getColor(x, y);
+      const double a = SkColorGetA(c) / 255.0;
+      red += SkColorGetR(c) * a + 255.0 * (1 - a);
+      green += SkColorGetG(c) * a + 255.0 * (1 - a);
+      blue += SkColorGetB(c) * a + 255.0 * (1 - a);
+    }
+  }
+  auto channel = [count](double sum) {
+    return static_cast<U8CPU>(std::clamp(sum / count + 0.5, 0.0, 255.0));
+  };
+  *out = SkColorSetRGB(channel(red), channel(green), channel(blue));
+  return true;
+}
+
+}  // namespace
+
+PageTopColorSampler::PageTopColorSampler(content::WebContents* web_contents,
+                                         Callback callback)
+    : content::WebContentsObserver(web_contents),
+      callback_(std::move(callback)) {}
+
+PageTopColorSampler::~PageTopColorSampler() = default;
+
+void PageTopColorSampler::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+      !handle->IsSameDocument()) {
+    load_needs_sample_ = true;
+  }
+}
+
+void PageTopColorSampler::DidStopLoading() {
+  if (!load_needs_sample_) {
+    return;
+  }
+  load_needs_sample_ = false;
+  if (web_contents()->GetVisibility() == content::Visibility::HIDDEN) {
+    // Hidden views produce no frames; sample once the tab is shown.
+    ++generation_;
+    pending_until_visible_ = true;
+    return;
+  }
+  Sample();
+}
+
+void PageTopColorSampler::OnVisibilityChanged(
+    content::Visibility visibility) {
+  if (visibility != content::Visibility::HIDDEN && pending_until_visible_ &&
+      !web_contents()->IsLoading()) {
+    Sample();
+  }
+}
+
+void PageTopColorSampler::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus status) {
+  ++generation_;
+  pending_until_visible_ = false;
+}
+
+void PageTopColorSampler::Sample() {
+  pending_until_visible_ = false;
+  const int generation = ++generation_;
+  attempts_ = 0;
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      kScrollbarWidthScript,
+      base::BindOnce(&PageTopColorSampler::DidMeasureScrollbar,
+                     weak_factory_.GetWeakPtr(), generation),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void PageTopColorSampler::DidMeasureScrollbar(int generation,
+                                              base::Value result) {
+  if (generation != generation_) {
+    return;
+  }
+  int width = 0;
+  if (result.is_int()) {
+    width = result.GetInt();
+  } else if (result.is_double()) {
+    width = static_cast<int>(result.GetDouble());
+  }
+  if (width > kScrollbarMinimumWidth) {
+    // [06 §17.4] observed: with a classic scrollbar the toolbar falls back to
+    // the Space's neutral color.
+    callback_.Run(PageTopColorKind::kScrollbar, SK_ColorTRANSPARENT);
+    return;
+  }
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;
+  }
+  // Make sure the finished page's frame reached the compositor before copying.
+  frame->InsertVisualStateCallback(
+      base::BindOnce(&PageTopColorSampler::DidSubmitVisualState,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void PageTopColorSampler::DidSubmitVisualState(int generation, bool success) {
+  if (generation != generation_) {
+    return;
+  }
+  Copy(generation);
+}
+
+void PageTopColorSampler::Copy(int generation) {
+  content::RenderWidgetHostView* view =
+      web_contents()->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    RetryOrWait(generation);
+    return;
+  }
+  const gfx::Size size = view->GetViewBounds().size();
+  if (size.width() < kSampleWidth || size.height() < kSampleHeight) {
+    RetryOrWait(generation);
+    return;
+  }
+  const gfx::Rect area(size.width() - kSampleWidth, 0, kSampleWidth,
+                       kSampleHeight);
+  // The copy may complete off the UI thread.
+  auto done = base::BindPostTask(
+      base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindOnce(&PageTopColorSampler::DidCopy,
+                     weak_factory_.GetWeakPtr(), generation));
+  view->CopyFromSurface(
+      area, gfx::Size(), kCopyTimeout,
+      base::BindOnce(
+          [](base::OnceCallback<void(SkColor, bool)> done,
+             const content::CopyFromSurfaceResult& result) {
+            SkColor color = SK_ColorTRANSPARENT;
+            const bool ok =
+                result.has_value() && AverageColor(result->bitmap, &color);
+            std::move(done).Run(color, ok);
+          },
+          std::move(done)));
+}
+
+void PageTopColorSampler::DidCopy(int generation, SkColor color, bool ok) {
+  if (generation != generation_) {
+    return;
+  }
+  if (!ok) {
+    RetryOrWait(generation);
+    return;
+  }
+  callback_.Run(PageTopColorKind::kColor, color);
+}
+
+void PageTopColorSampler::RetryOrWait(int generation) {
+  if (web_contents()->GetVisibility() == content::Visibility::HIDDEN) {
+    pending_until_visible_ = true;
+    return;
+  }
+  if (++attempts_ >= kMaxAttempts) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageTopColorSampler::Copy, weak_factory_.GetWeakPtr(),
+                     generation),
+      kRetryDelay);
+}
+
+}  // namespace openarc
