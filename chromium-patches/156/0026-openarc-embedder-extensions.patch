+// The ExtensionView of a popup: hosts nothing itself (the shell's bubble
+// shows the WebContents' view) and forwards size and load to the popup.
+class PopupExtensionView : public extensions::ExtensionView {
+ public:
+  explicit PopupExtensionView(OACExtensionPopup* popup) : popup_(popup) {}
+
+  void set_native_view(gfx::NativeView view) { native_view_ = view; }
+
+  // extensions::ExtensionView:
+  gfx::NativeView GetNativeView() override { return native_view_; }
+  void ResizeDueToAutoResize(content::WebContents* web_contents,
+                             const gfx::Size& new_size) override {
+    [popup_ hostDidResizeTo:new_size];
+  }
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    // Chrome's popup view enables auto-resize the same way (views::WebView),
+    // so the page reports the size it needs. The popup page commits in a new
+    // main frame (cross-site from the initial about:blank one), which is not
+    // the primary one yet when it is created: every main frame gets it.
+    EnableAutoResize(frame);
+  }
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override {
+    return false;
+  }
+  void OnLoaded() override { [popup_ hostDidLoad]; }
+
+  static void EnableAutoResize(content::RenderFrameHost* frame) {
+    if (frame && !frame->GetParent() && frame->GetView()) {
+      frame->GetView()->EnableAutoResize(kPopupMinSize, kPopupMaxSize);
+    }
+  }
+
+ private:
+  __weak OACExtensionPopup* popup_;
+  gfx::NativeView native_view_;
+};
+
+// The ExtensionViewHost delegate of a popup. Links the popup opens
+// (chrome.tabs-less `window.open`, target=_blank) go to the shell as new-tab
+// requests from the popup's tab.
+class PopupHostDelegate : public extensions::ExtensionViewHost::Delegate {
+ public:
+  explicit PopupHostDelegate(OACTab* tab) : tab_(tab) {}
+
+  content::WebContents* OpenURL(
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    OACTab* tab = tab_;
+    content::WebContents* contents = tab.webContents;
+    if (!contents || !contents->GetDelegate()) {
+      return nullptr;
+    }
+    // The tab's own WebContentsDelegate turns a non-current-tab open into an
+    // OACNewTabRequest of that tab.
+    content::OpenURLParams forwarded(params);
+    if (forwarded.disposition == WindowOpenDisposition::CURRENT_TAB) {
+      forwarded.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    }
+    return contents->GetDelegate()->OpenURLFromTab(
+        contents, forwarded, std::move(navigation_handle_callback));
+  }
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
+  std::unique_ptr<content::EyeDropper> OpenEyeDropper(
+      content::RenderFrameHost* frame,
+      content::EyeDropperListener* listener) override {
+    return nullptr;
+  }
+  extensions::WindowController* GetExtensionWindowController() override {
+    return nullptr;
+  }
+
+ private:
+  __weak OACTab* tab_;
+};
