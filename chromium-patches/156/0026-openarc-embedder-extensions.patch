+// Observes a profile's ExtensionRegistry and ExtensionActionDispatcher for an
+// OACExtensions.
+class ExtensionsObserverBridge : public extensions::ExtensionRegistryObserver,
+                                 public extensions::ExtensionActionDispatcher::
+                                     Observer,
+                                 public extensions::IconImage::Observer {
+ public:
+  ExtensionsObserverBridge(OACExtensions* owner, Profile* profile)
+      : owner_(owner), profile_(profile) {
+    registry_observation_.Observe(extensions::ExtensionRegistry::Get(profile));
+    if (auto* dispatcher =
+            extensions::ExtensionActionDispatcher::Get(profile)) {
+      dispatcher_ = dispatcher;
+      dispatcher->AddObserver(this);
+    }
+  }
+  ExtensionsObserverBridge(const ExtensionsObserverBridge&) = delete;
+  ExtensionsObserverBridge& operator=(const ExtensionsObserverBridge&) =
+      delete;
+  ~ExtensionsObserverBridge() override {
+    if (dispatcher_) {
+      dispatcher_->RemoveObserver(this);
+    }
+  }
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override {
+    Changed();
+  }
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override {
+    Changed();
+  }
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const Extension* extension,
+                            bool is_update) override {
+    Changed();
+  }
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const Extension* extension,
+                              extensions::UninstallReason reason) override {
+    Changed();
+  }
+  void OnShutdown(extensions::ExtensionRegistry* registry) override {
+    registry_observation_.Reset();
+  }
+
+  // extensions::ExtensionActionDispatcher::Observer:
+  void OnExtensionActionUpdated(
+      ExtensionAction* extension_action,
+      content::WebContents* web_contents,
+      content::BrowserContext* browser_context) override {
+    if (!browser_context ||
+        Profile::FromBrowserContext(browser_context)->GetOriginalProfile() !=
+            profile_) {
+      return;
+    }
+    [owner_ actionDidUpdate:extension_action->extension_id()
+                webContents:web_contents];
+  }
+  void OnShuttingDown() override {
+    if (dispatcher_) {
+      dispatcher_->RemoveObserver(this);
+      dispatcher_ = nullptr;
+    }
+  }
+
+  // An action's default icon loads asynchronously (IconImage); until it has,
+  // it reads as a transparent image. Chrome's toolbar watches it
+  // (ExtensionActionIconFactory); the bridge reports the change as an action
+  // update for every tab.
+  void WatchIcon(ExtensionAction* action) {
+    extensions::IconImage* image = action->default_icon_image();
+    if (!image || icon_observations_.IsObservingSource(image)) {
+      return;
+    }
+    icon_extensions_[image] = action->extension_id();
+    icon_observations_.AddObservation(image);
+  }
+
+  // extensions::IconImage::Observer:
+  void OnExtensionIconImageChanged(extensions::IconImage* image) override {
+    auto it = icon_extensions_.find(image);
+    if (it != icon_extensions_.end()) {
+      [owner_ actionDidUpdate:it->second webContents:nullptr];
+    }
+  }
+  void OnExtensionIconImageDestroyed(extensions::IconImage* image) override {
+    icon_observations_.RemoveObservation(image);
+    icon_extensions_.erase(image);
+  }
+
+ private:
+  void Changed() { [owner_ registryDidChange]; }
+
+  __weak OACExtensions* owner_;
+  raw_ptr<Profile> profile_;
+  raw_ptr<extensions::ExtensionActionDispatcher> dispatcher_ = nullptr;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  base::ScopedMultiSourceObservation<extensions::IconImage,
+                                     extensions::IconImage::Observer>
+      icon_observations_{this};
+  std::map<extensions::IconImage*, std::string> icon_extensions_;
+};
