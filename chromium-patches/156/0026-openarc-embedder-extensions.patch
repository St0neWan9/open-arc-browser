+// MARK: - OACExtensionPopup
+
+@implementation OACExtensionPopup {
+  NSString* _extensionIdentifier;
+  __weak OACTab* _tab;
+  __weak OACExtensions* _owner;
+  std::unique_ptr<openarc::PopupExtensionView> _view;
+  std::unique_ptr<extensions::ExtensionViewHost> _host;
+  CGSize _preferredSize;
+  BOOL _hasLoaded;
+  BOOL _closed;
+}
+
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithHost:(std::unique_ptr<extensions::ExtensionViewHost>)host
+                         tab:(OACTab*)tab
+                       owner:(OACExtensions*)owner {
+  if ((self = [super init])) {
+    _extensionIdentifier = ToNS(host->extension_id());
+    _tab = tab;
+    _owner = owner;
+    _host = std::move(host);
+    _view = std::make_unique<openarc::PopupExtensionView>(self);
+    _view->set_native_view(_host->host_contents()->GetNativeView());
+    _host->set_view(_view.get());
+    // window.close() in the popup (and Escape, which ExtensionViewHost turns
+    // into Close()).
+    __weak OACExtensionPopup* weakSelf = self;
+    _host->SetCloseHandler(base::BindOnce(^(extensions::ExtensionHost*) {
+      [weakSelf hostDidAskToClose];
+    }));
+    // Starts the renderer and loads the popup page; OnLoaded() follows.
+    _host->CreateRendererSoon();
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self tearDown];
+}
+
+- (NSString*)extensionIdentifier {
+  return _extensionIdentifier;
+}
+- (OACTab*)tab {
+  return _tab;
+}
+- (NSView*)view {
+  if (_closed || !_host) {
+    return nil;
+  }
+  return _host->host_contents()->GetNativeView().GetNativeNSView();
+}
+- (CGSize)preferredSize {
+  return _preferredSize;
+}
+- (BOOL)hasLoaded {
+  return _hasLoaded;
+}
+- (BOOL)isClosed {
+  return _closed;
+}
+
+- (void)focus {
+  if (!_closed && _host) {
+    _host->host_contents()->Focus();
+  }
+}
+
+- (void)close {
+  if (_closed) {
+    return;
+  }
+  [self tearDown];
+  OACExtensions* owner = _owner;
+  [owner popupDidClose:self];
+  __weak OACExtensionPopup* weakSelf = self;
+  id<OACExtensionPopupDelegate> delegate = _delegate;
+  OACPostToMainThread(^{
+    OACExtensionPopup* popup = weakSelf;
+    if (popup &&
+        [delegate respondsToSelector:@selector(extensionPopupDidClose:)]) {
+      [delegate extensionPopupDidClose:popup];
+    }
+  });
+}
+
+- (void)tearDown {
+  _closed = YES;
+  if (!_host) {
+    return;
+  }
+  NSView* view = _host->host_contents()->GetNativeView().GetNativeNSView();
+  [view removeFromSuperview];
+  // The host's WebContents goes with it; the view object must not outlive
+  // the host's pointer to it.
+  std::unique_ptr<extensions::ExtensionViewHost> host = std::move(_host);
+  host->set_view(nullptr);
+  host.reset();
+  _view.reset();
+}
+
+- (void)hostDidLoad {
+  if (_closed || _hasLoaded) {
+    return;
+  }
+  _hasLoaded = YES;
+  // The committed page's main frame (see PopupExtensionView).
+  openarc::PopupExtensionView::EnableAutoResize(
+      _host->host_contents()->GetPrimaryMainFrame());
+  __weak OACExtensionPopup* weakSelf = self;
+  OACPostToMainThread(^{
+    OACExtensionPopup* popup = weakSelf;
+    id<OACExtensionPopupDelegate> delegate = popup.delegate;
+    if (popup && !popup.closed &&
+        [delegate respondsToSelector:@selector(extensionPopupDidLoad:)]) {
+      [delegate extensionPopupDidLoad:popup];
+    }
+  });
+}
+
+- (void)hostDidResizeTo:(const gfx::Size&)size {
+  if (_closed) {
+    return;
+  }
+  CGSize newSize = CGSizeMake(size.width(), size.height());
+  if (CGSizeEqualToSize(newSize, _preferredSize)) {
+    return;
+  }
+  _preferredSize = newSize;
+  __weak OACExtensionPopup* weakSelf = self;
+  OACPostToMainThread(^{
+    OACExtensionPopup* popup = weakSelf;
+    id<OACExtensionPopupDelegate> delegate = popup.delegate;
+    if (popup && !popup.closed &&
+        [delegate respondsToSelector:@selector(extensionPopup:didResizeTo:)]) {
+      [delegate extensionPopup:popup didResizeTo:popup.preferredSize];
+    }
+  });
+}
+
+- (void)hostDidAskToClose {
+  // From inside the host's own call stack: close in a later turn.
+  __weak OACExtensionPopup* weakSelf = self;
+  OACPostToMainThread(^{
+    [weakSelf close];
+  });
+}
+
+@end
+
+// MARK: - OACExtensions
+
+@implementation OACExtensions {
+  __weak OACProfile* _profile;
+  std::unique_ptr<openarc::ExtensionsObserverBridge> _observer;
+  OACExtensionPopup* _popup;
+  BOOL _changePosted;
+}
+
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithProfile:(OACProfile*)profile {
+  if ((self = [super init])) {
+    _profile = profile;
+    if (Profile* chrome = profile.chromeProfile) {
+      _observer = std::make_unique<openarc::ExtensionsObserverBridge>(
+          self, chrome->GetOriginalProfile());
+    }
+  }
+  return self;
+}
+
+- (void)invalidate {
+  [_popup close];
+  _popup = nil;
+  _observer.reset();
+}
+
+- (OACProfile*)profile {
+  return _profile;
+}
+
+- (Profile*)chromeProfile {
+  OACProfile* profile = _profile;
+  Profile* chrome = profile.valid ? profile.chromeProfile : nullptr;
+  return chrome ? chrome->GetOriginalProfile() : nullptr;
+}
+
+- (OACExtensionInfo*)infoForExtension:(const Extension&)extension
+                              enabled:(BOOL)enabled
+                              profile:(Profile*)profile
+                                tabID:(std::optional<int>)tabID {
+  NSData* icon = nil;
+  NSString* badge = @"";
+  NSString* title = @"";
+  BOOL actionEnabled = NO;
+  BOOL hasPopup = NO;
+  ExtensionAction* action =
+      enabled ? extensions::ExtensionActionManager::Get(profile)
+                    ->GetExtensionAction(extension)
+              : nullptr;
+  if (action) {
+    if (_observer) {
+      _observer->WatchIcon(action);
+    }
+    const int tab = tabID.value_or(ExtensionAction::kDefaultTabId);
+    extensions::IconImage* defaultImage = action->default_icon_image();
+    if (defaultImage && !defaultImage->did_complete_initial_load()) {
+      // IconImage loads a scale only when a representation is asked for;
+      // asking starts the load (the observer reports when it is in).
+      defaultImage->image_skia().GetRepresentation(kIconScale);
+    }
+    const bool defaultLoading = defaultImage &&
+                                !defaultImage->did_complete_initial_load();
+    gfx::Image image = ActionIcon(*action, tab);
+    // A default icon still loading reads as transparent: show the
+    // placeholder until it is in (the observer reports it then).
+    icon = defaultLoading && action->GetExplicitlySetIcon(tab).IsEmpty() &&
+                   action->GetDeclarativeIcon(tab).IsEmpty()
+               ? nil
+               : PNGFromImage(image);
+    badge = ToNS(action->GetDisplayBadgeText(tab));
+    title = ToNS(action->GetTitle(tab));
+    actionEnabled = action->GetIsVisible(tab);
+    hasPopup = action->HasPopup(tab);
+  }
+  if (!icon) {
+    // No action, or an icon still loading: the action's placeholder (the
+    // first letter of the name), as Chrome's toolbar shows.
+    icon = action ? PNGFromImage(action->GetPlaceholderIconImage()) : nil;
+  }
+  return [[OACExtensionInfo alloc]
+      initWithIdentifier:ToNS(extension.id())
+                    name:ToNS(extension.name())
+                 version:ToNS(extension.VersionString())
+                 enabled:enabled
+      allowedInIncognito:extensions::util::IsIncognitoEnabled(extension.id(),
+                                                              profile)
+                unpacked:extensions::Manifest::IsUnpackedLocation(
+                             extension.location())
+                    icon:icon
+               badgeText:badge
+             actionTitle:title
+           actionEnabled:actionEnabled
+                hasPopup:hasPopup];
+}
+
+- (NSArray<OACExtensionInfo*>*)installedExtensions {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    return @[];
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  NSMutableArray<OACExtensionInfo*>* result = [NSMutableArray array];
+  for (const auto& extension : registry->enabled_extensions()) {
+    if (IsUserExtension(*extension)) {
+      [result addObject:[self infoForExtension:*extension
+                                       enabled:YES
+                                       profile:profile
+                                         tabID:std::nullopt]];
+    }
+  }
+  for (const auto& extension : registry->disabled_extensions()) {
+    if (IsUserExtension(*extension)) {
+      [result addObject:[self infoForExtension:*extension
+                                       enabled:NO
+                                       profile:profile
+                                         tabID:std::nullopt]];
+    }
+  }
+  return result;
+}
+
+- (NSArray<OACExtensionInfo*>*)actionsForTab:(OACTab*)tab {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  content::WebContents* contents = tab.webContents;
+  if (!profile || !contents || OriginalProfileOfTab(tab) != profile) {
+    return @[];
+  }
+  const bool off_the_record =
+      contents->GetBrowserContext()->IsOffTheRecord();
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents).id();
+  NSMutableArray<OACExtensionInfo*>* result = [NSMutableArray array];
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(profile)->enabled_extensions()) {
+    if (!IsUserExtension(*extension) ||
+        !extensions::ActionInfo::GetExtensionActionInfo(extension.get())) {
+      continue;
+    }
+    if (off_the_record &&
+        !extensions::util::IsIncognitoEnabled(extension->id(), profile)) {
+      continue;
+    }
+    [result addObject:[self infoForExtension:*extension
+                                     enabled:YES
+                                     profile:profile
+                                       tabID:tab_id]];
+  }
+  return result;
+}
+
+- (OACExtensionPopup*)popup {
+  return _popup;
+}
+
+- (OACExtensionPopup*)runActionOfExtension:(NSString*)extensionIdentifier
+                                     onTab:(OACTab*)tab {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  content::WebContents* contents = tab.webContents;
+  if (!profile || !contents || OriginalProfileOfTab(tab) != profile) {
+    return nil;
+  }
+  const Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          base::SysNSStringToUTF8(extensionIdentifier));
+  extensions::ExtensionActionRunner* runner =
+      extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!extension || !runner) {
+    return nil;
+  }
+  // One popup at a time, as Chrome's toolbar does.
+  [_popup close];
+  _popup = nil;
+
+  // Grants activeTab on the tab and either sends action.onClicked or asks for
+  // the popup, as a click on Chrome's toolbar button does.
+  const ExtensionAction::ShowAction show =
+      runner->RunAction(extension, /*grant_tab_permissions=*/true);
+  if (show != ExtensionAction::ShowAction::kShowPopup) {
+    return nil;
+  }
+  ExtensionAction* action =
+      extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+          *extension);
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents).id();
+  if (!action || !action->HasPopup(tab_id)) {
+    return nil;
+  }
+  // The popup runs in the tab's context: the off-the-record profile for an
+  // incognito tab when the extension runs split there, else the original.
+  Profile* tab_profile =
+      Profile::FromBrowserContext(contents->GetBrowserContext());
+  content::BrowserContext* host_context =
+      tab_profile->IsOffTheRecord() &&
+              extensions::IncognitoInfo::IsSplitMode(extension)
+          ? static_cast<content::BrowserContext*>(tab_profile)
+          : profile;
+  auto host = std::make_unique<extensions::ExtensionViewHost>(
+      extension, host_context, action->GetPopupUrl(tab_id),
+      extensions::mojom::ViewType::kExtensionPopup,
+      std::make_unique<openarc::PopupHostDelegate>(tab));
+  _popup = [[OACExtensionPopup alloc] initWithHost:std::move(host)
+                                               tab:tab
+                                             owner:self];
+  return _popup;
+}
+
+- (void)popupDidClose:(OACExtensionPopup*)popup {
+  if (_popup == popup) {
+    _popup = nil;
+  }
+}
+
+- (void)installFromWebStoreWithIdentifier:(NSString*)extensionIdentifier
+                        completionHandler:(void (^)(NSError*))completionHandler {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    NSError* error = OACMakeError(OACErrorProfileUnavailable,
+                                  @"The profile is not loaded.");
+    OACPostToMainThread(^{
+      completionHandler(error);
+    });
+    return;
+  }
+  // Chrome's standalone Web Store installer: fetches the item's data from the
+  // store, asks through ExtensionInstallPrompt (our embedder dialog), then
+  // downloads and installs the CRX.
+  auto installer = base::MakeRefCounted<extensions::WebstoreInstallWithPrompt>(
+      base::SysNSStringToUTF8(extensionIdentifier), profile,
+      gfx::NativeWindow(),
+      base::BindOnce(^(bool success, const std::string& error,
+                       extensions::webstore_install::Result result) {
+        NSError* nsError =
+            success ? nil
+                    : OACMakeError(OACErrorInvalidArgument,
+                                   error.empty() ? @"The install failed."
+                                                 : ToNS(error));
+        OACPostToMainThread(^{
+          completionHandler(nsError);
+        });
+      }));
+  installer->BeginInstall();
+}
+
+- (void)loadUnpackedFromURL:(NSURL*)folderURL
+          completionHandler:(void (^)(NSString*, NSError*))completionHandler {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile || !folderURL.isFileURL) {
+    NSError* error = OACMakeError(
+        profile ? OACErrorInvalidArgument : OACErrorProfileUnavailable,
+        profile ? @"Not a folder URL." : @"The profile is not loaded.");
+    OACPostToMainThread(^{
+      completionHandler(nil, error);
+    });
+    return;
+  }
+  // Chromium disables unpacked extensions outside developer mode
+  // (ExtensionManagement::IsAllowedByUnpackedDeveloperModePolicy), as
+  // chrome://extensions' "Load unpacked" requires it on.
+  profile->GetPrefs()->SetBoolean(prefs::kExtensionsUIDeveloperMode, true);
+  scoped_refptr<extensions::UnpackedInstaller> installer =
+      extensions::UnpackedInstaller::Create(profile);
+  installer->set_be_noisy_on_failure(false);
+  installer->set_completion_callback(base::BindOnce(
+      ^(const Extension* extension, const base::FilePath& path,
+        const std::u16string& error) {
+        NSString* identifier = extension ? ToNS(extension->id()) : nil;
+        NSError* nsError =
+            extension ? nil
+                      : OACMakeError(OACErrorInvalidArgument,
+                                     base::SysUTF16ToNSString(error));
+        OACPostToMainThread(^{
+          completionHandler(identifier, nsError);
+        });
+      }));
+  installer->Load(base::apple::NSURLToFilePath(folderURL));
+}
+
+- (void)setEnabled:(BOOL)enabled forExtension:(NSString*)extensionIdentifier {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    return;
+  }
+  extensions::ExtensionRegistrar* registrar =
+      extensions::ExtensionRegistrar::Get(profile);
+  const std::string identifier = base::SysNSStringToUTF8(extensionIdentifier);
+  if (enabled) {
+    registrar->EnableExtension(identifier);
+  } else {
+    registrar->DisableExtension(
+        identifier, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+}
+
+- (void)uninstallExtension:(NSString*)extensionIdentifier {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    return;
+  }
+  const std::string identifier = base::SysNSStringToUTF8(extensionIdentifier);
+  if (_popup && _popup.extensionIdentifier == extensionIdentifier) {
+    [_popup close];
+  }
+  std::u16string error;
+  extensions::ExtensionRegistrar::Get(profile)->UninstallExtension(
+      identifier, extensions::UNINSTALL_REASON_USER_INITIATED, &error);
+}
+
+// MARK: Events
+
+- (void)registryDidChange {
+  // Close a popup whose extension went away.
+  if (_popup) {
+    Profile* profile = self.chromeProfile;
+    if (!profile || !extensions::ExtensionRegistry::Get(profile)
+                         ->enabled_extensions()
+                         .Contains(base::SysNSStringToUTF8(
+                             _popup.extensionIdentifier))) {
+      [_popup close];
+    }
+  }
+  // Coalesced: an install loads, installs and maybe enables in one turn.
+  if (_changePosted) {
+    return;
+  }
+  _changePosted = YES;
+  __weak OACExtensions* weakSelf = self;
+  OACPostToMainThread(^{
+    OACExtensions* strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    strongSelf->_changePosted = NO;
+    id<OACExtensionsDelegate> delegate = strongSelf.delegate;
+    if ([delegate respondsToSelector:@selector(extensionsDidChange:)]) {
+      [delegate extensionsDidChange:strongSelf];
+    }
+  });
+}
+
+- (void)actionDidUpdate:(const std::string&)extensionID
+            webContents:(content::WebContents*)webContents {
+  NSString* identifier = ToNS(extensionID);
+  OACTab* tab = webContents ? OACTabForWebContents(webContents) : nil;
+  if (webContents && !tab) {
+    return;  // Not one of the shell's tabs.
+  }
+  __weak OACExtensions* weakSelf = self;
+  __weak OACTab* weakTab = tab;
+  const bool everyTab = !webContents;
+  OACPostToMainThread(^{
+    OACExtensions* strongSelf = weakSelf;
+    OACTab* strongTab = weakTab;
+    id<OACExtensionsDelegate> delegate = strongSelf.delegate;
+    if (!strongSelf || (!everyTab && !strongTab)) {
+      return;
+    }
+    if ([delegate respondsToSelector:@selector
+                  (extensions:didUpdateActionOfExtension:tab:)]) {
+      [delegate extensions:strongSelf
+          didUpdateActionOfExtension:identifier
+                                 tab:strongTab];
+    }
+  });
+}
+
+@end
+
+// MARK: - Hooks
+
+namespace {
+
+// ExtensionInstallPrompt's embedder dialog (an Open Arc patch): every install
+// confirmation goes to the profile's OACExtensions delegate.
+void ShowInstallConfirmation(
+    std::unique_ptr<ExtensionInstallPromptShowParams> show_params,
+    ExtensionInstallPrompt::DoneCallback done_callback,
+    std::unique_ptr<InstallPromptData> prompt) {
+  Profile* profile = show_params->profile();
+  content::WebContents* contents = show_params->GetParentWebContents();
+  OACTab* tab = contents ? OACTabForWebContents(contents) : nil;
+  OACProfile* owner = nil;
+  if (profile) {
+    for (OACProfile* candidate in OACApplication.sharedApplication
+             .loadedProfiles) {
+      if (candidate.valid &&
+          candidate.chromeProfile == profile->GetOriginalProfile()) {
+        owner = candidate;
+        break;
+      }
+    }
+  }
+  const Extension* extension = prompt->extension();
+  NSMutableArray<NSString*>* warnings = [NSMutableArray array];
+  for (size_t i = 0; i < prompt->GetPermissionCount(); ++i) {
+    [warnings addObject:base::SysUTF16ToNSString(prompt->GetPermission(i))];
+  }
+  OACExtensionInstallRequest* request = [[OACExtensionInstallRequest alloc]
+      initWithTab:tab
+       identifier:extension ? ToNS(extension->id()) : @""
+             name:extension ? ToNS(extension->name()) : @""
+             icon:PNGFromImage(prompt->icon())
+            title:base::SysUTF16ToNSString(prompt->GetDialogTitle())
+      acceptTitle:base::SysUTF16ToNSString(prompt->GetAcceptButtonLabel())
+      cancelTitle:base::SysUTF16ToNSString(prompt->GetAbortButtonLabel())
+      permissionWarnings:warnings
+         callback:std::move(done_callback)];
+  OACExtensions* extensions = owner.valid ? owner.extensions : nil;
+  // From a posted task (OACDefines.h): never inside Chromium's call.
+  OACPostToMainThread(^{
+    id<OACExtensionsDelegate> delegate = extensions.delegate;
+    BOOL shown = NO;
+    if (extensions &&
+        [delegate respondsToSelector:@selector(extensions:confirmInstall:)]) {
+      shown = [delegate extensions:extensions confirmInstall:request];
+    }
+    if (!shown) {
+      [request cancel];
+    }
+  });
+}
+
+// chrome.tabs.query's embedder tab list (an Open Arc patch): every live tab of
+// the profile. The shell does not tell the bridge which tabs are on screen,
+// so "active" means the tab's page is visible, and every tab counts as in the
+// current window (inferred: Arc shows one window's tabs in its sidebar).
+std::vector<extensions::ExtensionTabUtil::EmbedderTab> ListTabs(
+    content::BrowserContext* browser_context,
+    bool include_incognito) {
+  std::vector<extensions::ExtensionTabUtil::EmbedderTab> result;
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  for (OACTab* tab in OACApplication.sharedApplication.liveTabsForBridge) {
+    content::WebContents* contents = tab.webContents;
+    if (!contents) {
+      continue;
+    }
+    Profile* tab_profile =
+        Profile::FromBrowserContext(contents->GetBrowserContext());
+    if (tab_profile != profile &&
+        !(include_incognito && profile->IsSameOrParent(tab_profile))) {
+      continue;
+    }
+    extensions::ExtensionTabUtil::EmbedderTab entry;
+    entry.contents = contents;
+    entry.active =
+        contents->GetVisibility() == content::Visibility::VISIBLE;
+    entry.in_current_window = true;
+    result.push_back(entry);
+  }
+  return result;
+}
+
+}  // namespace
+
+void OACInstallExtensionHooks() {
+  ExtensionInstallPrompt::SetEmbedderShowDialogCallback(
+      base::BindRepeating(&ShowInstallConfirmation));
+  extensions::ExtensionTabUtil::SetEmbedderTabList(
+      base::BindRepeating(&ListTabs));
+}
