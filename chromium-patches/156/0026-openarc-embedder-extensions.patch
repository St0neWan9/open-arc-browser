+// Chromium's popup limits (chrome/browser/ui/extensions/extension_popup_types.h,
+// a Views-side target the embedder does not link).
+constexpr gfx::Size kPopupMinSize(25, 25);
+constexpr gfx::Size kPopupMaxSize(800, 600);
+
+// Action icons go to the shell at 16 pt in 2x pixels.
+constexpr float kIconScale = 2.0f;
+
+NSString* ToNS(const std::string& value) {
+  return base::SysUTF8ToNSString(value);
+}
+
+NSData* PNGFromImage(const gfx::Image& image) {
+  if (image.IsEmpty()) {
+    return nil;
+  }
+  const gfx::ImageSkia* skia = image.ToImageSkia();
+  if (!skia || skia->isNull()) {
+    return nil;
+  }
+  const SkBitmap bitmap = skia->GetRepresentation(kIconScale).GetBitmap();
+  if (bitmap.drawsNothing()) {
+    return nil;
+  }
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  return encoded ? [NSData dataWithBytes:encoded->data()
+                                  length:encoded->size()]
+                 : nil;
+}
+
+// Extensions the user manages: no component extensions (PDF viewer, Web
+// Store app), no themes or apps.
+bool IsUserExtension(const Extension& extension) {
+  return extension.is_extension() &&
+         extensions::ui_util::ShouldDisplayInExtensionSettings(extension);
+}
+
+// The on-disk profile behind |tab|, and whether the tab is off the record.
+Profile* OriginalProfileOfTab(OACTab* tab) {
+  content::WebContents* contents = tab.webContents;
+  if (!contents) {
+    return nullptr;
+  }
+  return Profile::FromBrowserContext(contents->GetBrowserContext())
+      ->GetOriginalProfile();
+}
+
+// The action's icon on |tab_id|: the one an extension set for the tab or
+// declaratively, else its default icon (Chrome's ExtensionActionIconFactory
+// order, without the grayscale treatment).
+gfx::Image ActionIcon(const ExtensionAction& action, int tab_id) {
+  gfx::Image icon = action.GetExplicitlySetIcon(tab_id);
+  if (icon.IsEmpty()) {
+    icon = action.GetDeclarativeIcon(tab_id);
+  }
+  if (icon.IsEmpty()) {
+    icon = action.GetDefaultIconImage();
+  }
+  return icon;
+}
