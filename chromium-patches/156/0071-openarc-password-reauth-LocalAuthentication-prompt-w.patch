From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: St0neWan9 <pawamaba@gmail.com>
Date: Sat, 31 Oct 2026 21:28:17 +0700
Subject: [PATCH] openarc: password reauth: LocalAuthentication prompt with or
 without Touch ID

Plan B152. With "Touch ID before filling" on, choosing a saved password
asks DeviceAuthenticatorMac to reauthenticate. Upstream uses
LocalAuthentication only when biometrics are available, and otherwise the
Authorization Services password dialog (password_manager_util_mac). On a
Mac whose Touch ID is missing or not paired (a Mac Studio with a Touch ID
keyboard that is not connected) that dialog is the only path, and
AuthorizationCopyRights fails with errAuthorizationInteractionNotAllowed
(-60007) when the process's security session has no graphic access; the
fill callback never ran, so the field stayed empty.

The authenticator now uses the LocalAuthentication prompt whenever macOS
can authenticate the device owner (biometrics, a paired watch, or the login
password), so the user gets Touch ID where available and the login
password otherwise, in the same cancellable sheet. The Authorization
Services dialog stays only for Macs where LocalAuthentication offers
nothing. The reuse window (60 s for filling) is unchanged.

Tests only: --openarc-fake-device-reauth=pass,fail,... answers the prompt
with scripted results (the last one repeats) so the engine conformance
test can check filling after success and cancel; nothing runs without the
switch. The upstream unit test now expects the LocalAuthentication path
when only a screen lock is available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../mac/device_authenticator_mac.mm           | 62 ++++++++++++++++++-
 .../mac/device_authenticator_mac_unittest.mm  | 14 +++--
 2 files changed, 70 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/device_reauth/mac/device_authenticator_mac.mm b/chrome/browser/device_reauth/mac/device_authenticator_mac.mm
index 9f4a15de75a7..b34c6f3e3f92 100644
--- a/chrome/browser/device_reauth/mac/device_authenticator_mac.mm
+++ b/chrome/browser/device_reauth/mac/device_authenticator_mac.mm
@@ -4,13 +4,16 @@
 
 #include "chrome/browser/device_reauth/mac/device_authenticator_mac.h"
 
+#include <optional>
 #include <vector>
 
+#include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/memory/ptr_util.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/no_destructor.h"
 #include "base/notreached.h"
+#include "base/strings/string_split.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/thread_pool.h"
 #include "chrome/browser/browser_process.h"
@@ -74,6 +77,45 @@ void OnAvailabilityChecked(ReauthAvailability availability) {
   }
 }
 
+// Open Arc, tests only: --openarc-fake-device-reauth=<answers> replaces the
+// system prompt with scripted answers, a comma separated list of "pass" and
+// "fail" used in order (the last one repeats), so the engine conformance test
+// can check filling after a successful and a cancelled reauth without a
+// person at the Mac. Nothing here runs without the switch.
+constexpr char kFakeDeviceReauthSwitch[] = "openarc-fake-device-reauth";
+
+class FakeReauthContext : public device::fido::mac::TouchIdContext {
+ public:
+  explicit FakeReauthContext(bool answer) : answer_(answer) {}
+
+  void PromptTouchId(const std::u16string& reason, Callback callback) override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), answer_));
+  }
+
+ private:
+  const bool answer_;
+};
+
+// The next scripted answer, or nullopt without the switch (UI thread).
+std::optional<bool> NextFakeReauthAnswer() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kFakeDeviceReauthSwitch)) {
+    return std::nullopt;
+  }
+  static size_t next = 0;
+  const std::vector<std::string> answers = base::SplitString(
+      command_line->GetSwitchValueASCII(kFakeDeviceReauthSwitch), ",",
+      base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (answers.empty()) {
+    return false;
+  }
+  const std::string& answer = answers[std::min(next, answers.size() - 1)];
+  ++next;
+  return answer == "pass";
+}
+
 }  // namespace
 
 // static
@@ -145,7 +187,19 @@ void OnAvailabilityChecked(ReauthAvailability availability) {
     return;
   }
   callback_ = std::move(callback);
-  if (!CanAuthenticateWithBiometrics()) {
+  // Open Arc: LocalAuthentication's device owner prompt whenever macOS offers
+  // one, not only with biometrics. It asks for Touch ID (or a paired watch)
+  // where available and for the login password otherwise, and Cancel() can
+  // dismiss it. Upstream used the Authorization Services password dialog
+  // whenever biometrics were missing (a Mac without Touch ID, a Touch ID
+  // keyboard that is not paired): that dialog fails with
+  // errAuthorizationInteractionNotAllowed (-60007) when the process's security
+  // session lacks graphic access, and choosing a saved password then filled
+  // nothing. The dialog stays as the last resort when LocalAuthentication
+  // offers nothing (no login password).
+  const bool fake_reauth =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(kFakeDeviceReauthSwitch);
+  if (!fake_reauth && !CanAuthenticateWithBiometricOrScreenLock()) {
     // AuthenticateUserWithNonBiometrics runs a dialog with a nested run loop.
     // Post a task to run it asynchronously, so that it doesn't block the
     // current call stack. This prevents UaF in the callers if the page is
@@ -158,7 +212,11 @@ void OnAvailabilityChecked(ReauthAvailability availability) {
     return;
   }
 
-  touch_id_auth_context_ = device::fido::mac::TouchIdContext::Create();
+  if (std::optional<bool> fake_answer = NextFakeReauthAnswer()) {
+    touch_id_auth_context_ = std::make_unique<FakeReauthContext>(*fake_answer);
+  } else {
+    touch_id_auth_context_ = device::fido::mac::TouchIdContext::Create();
+  }
   touch_id_auth_context_->PromptTouchId(
       message,
       base::BindOnce(&DeviceAuthenticatorMac::OnAuthenticationCompleted,
diff --git a/chrome/browser/device_reauth/mac/device_authenticator_mac_unittest.mm b/chrome/browser/device_reauth/mac/device_authenticator_mac_unittest.mm
index 36112da72186..505b24484929 100644
--- a/chrome/browser/device_reauth/mac/device_authenticator_mac_unittest.mm
+++ b/chrome/browser/device_reauth/mac/device_authenticator_mac_unittest.mm
@@ -67,7 +67,9 @@
   bool is_screen_lock_available() { return std::get<1>(GetParam()); }
 
   void SimulateReauthSuccess() {
-    if (is_biometric_available()) {
+    // Open Arc: LocalAuthentication's prompt whenever biometrics or a login
+    // password can authenticate the user.
+    if (is_biometric_available() || is_screen_lock_available()) {
       touch_id_environment()->SimulateTouchIdPromptSuccess();
     } else {
       EXPECT_CALL(system_authenticator(), AuthenticateUserWithNonBiometrics)
@@ -76,7 +78,9 @@ void SimulateReauthSuccess() {
   }
 
   void SimulateReauthFailure() {
-    if (is_biometric_available()) {
+    // Open Arc: LocalAuthentication's prompt whenever biometrics or a login
+    // password can authenticate the user.
+    if (is_biometric_available() || is_screen_lock_available()) {
       touch_id_environment()->SimulateTouchIdPromptFailure();
     } else {
       EXPECT_CALL(system_authenticator(), AuthenticateUserWithNonBiometrics)
@@ -190,8 +194,10 @@ void SimulateReauthFailure() {
 }
 
 TEST_P(DeviceAuthenticatorMacTest, CancelPendingAuthentication) {
-  // Non-biometric reauth is modal, and hence cannot be requested twice.
-  if (!is_biometric_available()) {
+  // Non-biometric reauth is modal, and hence cannot be requested twice. Open
+  // Arc: only the Authorization Services fallback is (no biometrics and no
+  // screen lock); LocalAuthentication's prompt can be cancelled.
+  if (!is_biometric_available() && !is_screen_lock_available()) {
     return;
   }
   touch_id_environment()->SimulateTouchIdPromptSuccess();
