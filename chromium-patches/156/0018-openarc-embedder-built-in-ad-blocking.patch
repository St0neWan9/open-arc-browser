diff --git a/openarc/bridge/oac_site_settings.mm b/openarc/bridge/oac_site_settings.mm
new file mode 100644
index 000000000000..7d5858afc913
--- /dev/null
+++ b/openarc/bridge/oac_site_settings.mm
@@ -0,0 +1,247 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACSiteSettings (OACSiteSettings.h): one per OACProfile.
+//
+// Implemented so far: ad blocking (plan C16, Chromium's "ads" content
+// setting) and zoom (HostZoomMap). Permission decisions, Developer Mode,
+// automatic Picture in Picture, the cookie count, clearing a site and the
+// stored-origins list come with plan C12; until then they report Chromium's
+// defaults and their setters do nothing.
+
+#import <OpenArcCore/OACSiteSettings.h>
+
+#include <cmath>
+#include <string>
+
+#include "base/check.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/host_zoom_map.h"
+#include "openarc/browser/openarc_ad_blocker.h"
+#include "third_party/blink/public/common/page/page_zoom.h"
+#include "url/gurl.h"
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_profile_internal.h"
+#import "openarc/bridge/oac_site_settings_internal.h"
+
+namespace {
+
+GURL URLForOrigin(OACOrigin* origin) {
+  std::string spec = base::SysNSStringToUTF8(origin.scheme) + "://" +
+                     base::SysNSStringToUTF8(origin.host);
+  if (origin.port) {
+    spec += ":" + base::NumberToString(origin.port.integerValue);
+  }
+  return GURL(spec + "/");
+}
+
+}  // namespace
+
+@implementation OACSiteSettingsState {
+  NSDictionary<NSNumber*, NSNumber*>* _permissionDecisions;
+  BOOL _developerModeEnabled;
+  BOOL _automaticPictureInPictureAllowed;
+  double _zoomFactor;
+  NSInteger _cookieCount;
+  NSNumber* _adBlockingEnabled;
+}
+
+- (instancetype)initWithZoomFactor:(double)zoomFactor
+                 adBlockingEnabled:(NSNumber*)adBlockingEnabled {
+  if ((self = [super init])) {
+    _permissionDecisions = @{};
+    // [06 §12] observed defaults: Developer Mode Off, Automatic
+    // Picture-In-Picture Allowed.
+    _developerModeEnabled = NO;
+    _automaticPictureInPictureAllowed = YES;
+    _zoomFactor = zoomFactor;
+    _cookieCount = 0;
+    _adBlockingEnabled = [adBlockingEnabled copy];
+  }
+  return self;
+}
+
+- (NSDictionary<NSNumber*, NSNumber*>*)permissionDecisions {
+  return _permissionDecisions;
+}
+
+- (BOOL)isDeveloperModeEnabled {
+  return _developerModeEnabled;
+}
+
+- (BOOL)isAutomaticPictureInPictureAllowed {
+  return _automaticPictureInPictureAllowed;
+}
+
+- (double)zoomFactor {
+  return _zoomFactor;
+}
+
+- (NSInteger)cookieCount {
+  return _cookieCount;
+}
+
+- (NSNumber*)adBlockingEnabled {
+  return _adBlockingEnabled;
+}
+
+- (OACPermissionDecision)decisionForPermission:(OACPermissionKind)kind {
+  NSNumber* decision = _permissionDecisions[@(kind)];
+  return decision ? static_cast<OACPermissionDecision>(decision.integerValue)
+                  : OACPermissionDecisionAsk;
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  return self;
+}
+
+@end
+
+@implementation OACSiteSettings {
+  __weak OACProfile* _profile;
+  NSHashTable<id<OACSiteSettingsObserver>>* _observers;
+}
+
+- (instancetype)initWithProfile:(OACProfile*)profile {
+  if ((self = [super init])) {
+    _profile = profile;
+    _observers = [NSHashTable weakObjectsHashTable];
+  }
+  return self;
+}
+
+- (OACProfile*)profile {
+  return _profile;
+}
+
+- (Profile*)chromeProfile {
+  return _profile.chromeProfile;
+}
+
+- (void)settingsForOrigin:(OACOrigin*)origin
+        completionHandler:(void (^)(OACSiteSettingsState* state))handler {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  const GURL url = URLForOrigin(origin);
+  double zoom_factor = 1.0;
+  NSNumber* ad_blocking = nil;
+  if (profile) {
+    zoom_factor = blink::ZoomLevelToZoomFactor(
+        content::HostZoomMap::GetDefaultForBrowserContext(profile)
+            ->GetZoomLevelForHostAndScheme(std::string(url.scheme()),
+                                           std::string(url.host())));
+    openarc::AdBlocker& blocker = openarc::AdBlocker::Get();
+    if (blocker.IsAvailable()) {
+      ad_blocking = @(blocker.IsEnabled() &&
+                      openarc::AdBlocker::IsEnabledForSite(profile, url));
+    }
+  }
+  OACSiteSettingsState* state =
+      [[OACSiteSettingsState alloc] initWithZoomFactor:zoom_factor
+                                     adBlockingEnabled:ad_blocking];
+  OACPostToMainThread(^{
+    handler(state);
+  });
+}
+
+- (void)setDecision:(OACPermissionDecision)decision
+      forPermission:(OACPermissionKind)kind
+             origin:(OACOrigin*)origin {
+  // TODO(C12): the permission manager.
+}
+
+- (void)setDeveloperModeEnabled:(BOOL)enabled forOrigin:(OACOrigin*)origin {
+  // TODO(C12): our own website setting.
+}
+
+- (void)setAutomaticPictureInPictureAllowed:(BOOL)allowed
+                                  forOrigin:(OACOrigin*)origin {
+  // TODO(C12): the auto-PiP content setting.
+}
+
+- (BOOL)setZoomFactor:(double)zoomFactor
+            forOrigin:(OACOrigin*)origin
+                error:(NSError**)error {
+  CHECK(NSThread.isMainThread);
+  if (!std::isfinite(zoomFactor) || zoomFactor < 0.25 || zoomFactor > 5.0) {
+    if (error) {
+      *error = OACMakeError(OACErrorInvalidArgument,
+                            @"Zoom factor out of range (0.25...5).");
+    }
+    return NO;
+  }
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    if (error) {
+      *error = OACMakeError(OACErrorProfileUnavailable,
+                            @"The profile is gone.");
+    }
+    return NO;
+  }
+  const GURL url = URLForOrigin(origin);
+  content::HostZoomMap::GetDefaultForBrowserContext(profile)
+      ->SetZoomLevelForHostAndScheme(std::string(url.scheme()),
+                                     std::string(url.host()),
+                                     blink::ZoomFactorToZoomLevel(zoomFactor));
+  [self notifyChangeForOrigin:origin];
+  return YES;
+}
+
+- (void)setAdBlockingEnabled:(BOOL)enabled forOrigin:(OACOrigin*)origin {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    return;
+  }
+  openarc::AdBlocker::SetEnabledForSite(profile, URLForOrigin(origin),
+                                        enabled);
+  [self notifyChangeForOrigin:origin];
+}
+
+- (BOOL)isAdBlockingEnabledForOrigin:(OACOrigin*)origin {
+  CHECK(NSThread.isMainThread);
+  return openarc::AdBlocker::IsEnabledForSite(self.chromeProfile,
+                                              URLForOrigin(origin));
+}
+
+- (void)clearDataForOrigin:(OACOrigin*)origin
+         completionHandler:(void (^)(void))completionHandler {
+  // TODO(C12): BrowsingDataRemover filtered to the site.
+  OACPostToMainThread(completionHandler);
+}
+
+- (void)originsWithStoredSettingsWithCompletionHandler:
+    (void (^)(NSArray<OACOrigin*>* origins))completionHandler {
+  // TODO(C12).
+  OACPostToMainThread(^{
+    completionHandler(@[]);
+  });
+}
+
+- (void)addObserver:(id<OACSiteSettingsObserver>)observer {
+  [_observers addObject:observer];
+}
+
+- (void)removeObserver:(id<OACSiteSettingsObserver>)observer {
+  [_observers removeObject:observer];
+}
+
+- (void)notifyChangeForOrigin:(OACOrigin*)origin {
+  __weak OACSiteSettings* weakSelf = self;
+  OACPostToMainThread(^{
+    OACSiteSettings* settings = weakSelf;
+    if (!settings) {
+      return;
+    }
+    for (id<OACSiteSettingsObserver> observer in settings->_observers
+             .allObjects) {
+      [observer siteSettings:settings didChangeForOrigin:origin];
+    }
+  });
+}
+
+@end
