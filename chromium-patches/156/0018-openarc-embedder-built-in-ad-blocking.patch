+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_AD_BLOCKER_H_
+#define OPENARC_BROWSER_OPENARC_AD_BLOCKER_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+class PrefService;
+class Profile;
+
+namespace openarc {
+
+// Built-in ad blocking (plan C16) on Chromium's own subresource filter
+// (//components/subresource_filter), the engine Chrome uses for its Better Ads
+// enforcement. Why this engine, and not declarativeNetRequest: it needs no
+// extension system, no Chrome Web Store and no Google ruleset component: we
+// hand it a ruleset ourselves, it indexes it once into its memory-mapped
+// flatbuffer format, shares it with every renderer, and filters subresources
+// in Blink and subframe navigations in the browser process.
+//
+// The pieces:
+// - Ruleset. EasyList + EasyPrivacy, converted at build time with Chromium's
+//   ruleset_converter into the "unindexed ruleset" format
+//   (chromium-bridge/build-adblock-ruleset.sh) and shipped in the framework's
+//   Resources/AdBlock/ (ruleset.pb, ruleset.version, ATTRIBUTION). At startup
+//   it goes to Chrome's RulesetService, which indexes it once per version into
+//   <user data dir>/Subresource Filter/Indexed Rules and publishes it. The
+//   Google component that would normally supply it stays off
+//   (--disable-component-update).
+// - Activation. Chrome activates the filter only on pages Safe Browsing lists
+//   (off here, no Google API keys). We force activation per tab through the
+//   filter's own forced-activation hook (DevtoolsInteractionTracker, the same
+//   switch DevTools' "Page.setAdBlockingEnabled" uses), re-asserted before
+//   every main-frame navigation, from the global on/off setting.
+// - Per-site allow list. Chrome's ADS content setting: ALLOW for an origin
+//   turns the filter off there (ProfileInteractionManager honours it), per
+//   profile, and incognito inherits it.
+// - Global on/off. A Local State pref (kEnabledPref, default on), so it holds
+//   for every profile of the app and survives restarts; Settings reads and
+//   writes it through OACApplication.adBlockingEnabled.
+//
+// TODO(C16 updater): fetch newer rulesets from our static host instead of
+// waiting for an app update. Design: a daily BEST_EFFORT task reads a small
+// manifest (version, SHA-256, size) from kRulesetUpdateManifestURL (empty
+// until the host exists, which keeps the updater off), downloads the
+// unindexed ruleset over HTTPS into <user data dir>/Open Arc Ad Block/<version>/
+// when the version differs, checks the hash, and calls LoadRuleset() with it.
+// RulesetService then indexes and publishes it without a restart. The bundled
+// ruleset stays the fallback. A Settings switch ("Update filter lists
+// automatically") comes with it. Until then, --openarc-ad-block-ruleset=<dir>
+// (a directory with ruleset.pb and ruleset.version) loads a ruleset from disk,
+// the same entry point the updater will use.
+class AdBlocker {
+ public:
+  // Where the updater will read its manifest; empty keeps it off. See the
+  // TODO above.
+  static constexpr char kRulesetUpdateManifestURL[] = "";
+  // Local State pref holding the global switch.
+  static constexpr char kEnabledPref[] = "openarc.ad_blocking.enabled";
+  // Development switch: load the ruleset from this directory instead of the
+  // framework's Resources/AdBlock.
+  static constexpr char kRulesetDirectorySwitch[] = "openarc-ad-block-ruleset";
+
+  AdBlocker(const AdBlocker&) = delete;
+  AdBlocker& operator=(const AdBlocker&) = delete;
+
+  // The browser process's instance (UI thread only).
+  static AdBlocker& Get();
+
+  // Registers the global pref on Local State. Called once Local State exists
+  // (OpenArcBrowserMainExtraParts::PostEarlyInitialization).
+  void Initialize(PrefService* local_state);
+  // Called before Local State goes away (PostMainMessageLoopRun).
+  void Shutdown();
+  // Hands the bundled ruleset (or --openarc-ad-block-ruleset) to Chrome's
+  // RulesetService. Called after the service exists (PostBrowserStart).
+  void LoadBundledRuleset();
+  // Hands the unindexed ruleset in |directory| (ruleset.pb, ruleset.version,
+  // ATTRIBUTION) to the RulesetService, after reading its version in the
+  // background. A version it already indexed is not indexed again. Returns
+  // false when there is no RulesetService.
+  bool LoadRuleset(const base::FilePath& directory);
+  // A ruleset was supplied or an indexed one is on disk.
+  bool IsAvailable() const;
+  // The content version of the newest ruleset ("" when none).
+  std::string RulesetVersion() const;
+
+  bool IsEnabled() const;
+  void SetEnabled(bool enabled);
+
+  // The per-site switch for the origin of |url| in |profile| (its original
+  // profile's setting for an off-the-record one, which inherits it). True
+  // unless the site is on the allow list.
+  static bool IsEnabledForSite(Profile* profile, const GURL& url);
+  static void SetEnabledForSite(Profile* profile, const GURL& url,
+                                bool enabled);
+
+ private:
+  friend class base::NoDestructor<AdBlocker>;
+  AdBlocker();
+  ~AdBlocker();
+
+  raw_ptr<PrefService> local_state_ = nullptr;
+  std::string supplied_version_;
+};
+
+// Per tab: forces the subresource filter's activation from the global switch
+// before each main-frame navigation, and counts the subresources and frames
+// the filter blocked on the current page (plan C16, "blocked count per tab").
+//
+// The count comes from the console messages the filter writes for every
+// blocked load once activation is "enabled" (Blink's subresource filter and
+// the browser's child-frame throttle both start them with the same fixed
+// text, kBlockedMessagePrefix); the filter keeps no other per-page count a
+// browser-side observer can read. A Chromium rebase that changes the text
+// shows up as a zero count, never as wrong blocking.
+class AdBlockTabHelper : public content::WebContentsObserver,
+                         public content::WebContentsUserData<AdBlockTabHelper> {
+ public:
+  static constexpr char16_t kBlockedMessagePrefix[] =
+      u"Chrome blocked resource ";
+
+  AdBlockTabHelper(const AdBlockTabHelper&) = delete;
+  AdBlockTabHelper& operator=(const AdBlockTabHelper&) = delete;
+  ~AdBlockTabHelper() override;
+
+  // Loads blocked on the current page of the primary frame tree.
+  int blocked_count() const { return blocked_count_; }
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override;
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void OnDidAddMessageToConsole(
+      content::RenderFrameHost* source_frame,
+      blink::mojom::ConsoleMessageLevel log_level,
+      const std::u16string& message,
+      int32_t line_no,
+      const std::u16string& source_id,
+      const std::optional<std::u16string>& untrusted_stack_trace) override;
+
+ private:
+  friend class content::WebContentsUserData<AdBlockTabHelper>;
+  explicit AdBlockTabHelper(content::WebContents* web_contents);
+
+  void ApplyActivation();
+
+  int blocked_count_ = 0;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_AD_BLOCKER_H_
diff --git a/openarc/browser/openarc_ad_blocker.mm b/openarc/browser/openarc_ad_blocker.mm
new file mode 100644
index 000000000000..6bb70c425efe
--- /dev/null
+++ b/openarc/browser/openarc_ad_blocker.mm
@@ -0,0 +1,259 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_ad_blocker.h"
+
+#include <optional>
+#include <string>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/subresource_filter/content/browser/devtools_interaction_tracker.h"
+#include "components/subresource_filter/content/browser/ruleset_service.h"
+#include "components/subresource_filter/core/browser/ruleset_version.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "openarc/common/openarc_paths.h"
+
+namespace openarc {
+
+namespace {
+
+// Files of a ruleset directory (chromium-bridge/build-adblock-ruleset.sh).
+constexpr char kRulesetFile[] = "ruleset.pb";
+constexpr char kVersionFile[] = "ruleset.version";
+constexpr char kAttributionFile[] = "ATTRIBUTION";
+
+// Framework-relative location of the bundled ruleset.
+base::FilePath BundledRulesetDirectory() {
+  return GetFrameworkVersionDirectory().Append("Resources").Append("AdBlock");
+}
+
+subresource_filter::RulesetService* RulesetService() {
+  return g_browser_process
+             ? g_browser_process->subresource_filter_ruleset_service()
+             : nullptr;
+}
+
+HostContentSettingsMap* SettingsMap(Profile* profile) {
+  return profile ? HostContentSettingsMapFactory::GetForProfile(profile)
+                 : nullptr;
+}
+
+}  // namespace
+
+// static
+AdBlocker& AdBlocker::Get() {
+  static base::NoDestructor<AdBlocker> instance;
+  return *instance;
+}
+
+AdBlocker::AdBlocker() = default;
+AdBlocker::~AdBlocker() = default;
+
+void AdBlocker::Initialize(PrefService* local_state) {
+  CHECK(local_state);
+  local_state_ = local_state;
+  // Chrome registers its Local State prefs in one central list we do not
+  // patch; this one is ours, registered on the live registry before anything
+  // reads it. Unknown keys already in Local State are kept until then, so the
+  // stored choice survives restarts.
+  auto* registry =
+      static_cast<PrefRegistrySimple*>(local_state->DeprecatedGetPrefRegistry());
+  if (!local_state->FindPreference(kEnabledPref)) {
+    registry->RegisterBooleanPref(kEnabledPref, true);
+  }
+}
+
+void AdBlocker::Shutdown() {
+  local_state_ = nullptr;
+}
+
+void AdBlocker::LoadBundledRuleset() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  // A framework built without the lists (build-adblock-ruleset.sh not run)
+  // has no Resources/AdBlock: the filter then has nothing to match, unless an
+  // earlier ruleset is still indexed in the user data directory.
+  LoadRuleset(command_line.HasSwitch(kRulesetDirectorySwitch)
+                  ? command_line.GetSwitchValuePath(kRulesetDirectorySwitch)
+                  : BundledRulesetDirectory());
+}
+
+namespace {
+
+// Reads a ruleset directory's version on a thread that may block; "" when the
+// directory does not hold a ruleset.
+std::string ReadRulesetVersion(const base::FilePath& directory) {
+  std::string version;
+  if (!base::PathExists(directory.Append(kRulesetFile)) ||
+      !base::ReadFileToString(directory.Append(kVersionFile), &version)) {
+    return std::string();
+  }
+  return std::string(base::TrimWhitespaceASCII(version, base::TRIM_ALL));
+}
+
+}  // namespace
+
+bool AdBlocker::LoadRuleset(const base::FilePath& directory) {
+  if (!RulesetService()) {
+    return false;
+  }
+  // The version file is read off the UI thread; the service then indexes the
+  // ruleset (once per version, on its own background sequence) and publishes
+  // it to every renderer. A version already indexed is used as is.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadRulesetVersion, directory),
+      base::BindOnce(
+          [](const base::FilePath& directory, const std::string& version) {
+            subresource_filter::RulesetService* service = RulesetService();
+            if (version.empty()) {
+              LOG(WARNING) << "OpenArc: no ad blocking ruleset in "
+                           << directory;
+              return;
+            }
+            if (!service) {
+              return;
+            }
+            subresource_filter::UnindexedRulesetInfo info;
+            info.content_version = version;
+            info.ruleset_path = directory.Append(kRulesetFile);
+            // Copied next to the indexed ruleset: the lists' license travels
+            // with them.
+            info.license_path = directory.Append(kAttributionFile);
+            service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+            AdBlocker::Get().supplied_version_ = version;
+          },
+          directory));
+  return true;
+}
+
+bool AdBlocker::IsAvailable() const {
+  return !RulesetVersion().empty();
+}
+
+std::string AdBlocker::RulesetVersion() const {
+  if (!supplied_version_.empty()) {
+    return supplied_version_;
+  }
+  subresource_filter::RulesetService* service = RulesetService();
+  if (!service) {
+    return std::string();
+  }
+  subresource_filter::IndexedRulesetVersion indexed =
+      service->GetMostRecentlyIndexedVersion();
+  return indexed.IsValid() ? indexed.content_version : std::string();
+}
+
+bool AdBlocker::IsEnabled() const {
+  return local_state_ ? local_state_->GetBoolean(kEnabledPref) : true;
+}
+
+void AdBlocker::SetEnabled(bool enabled) {
+  // Read by every tab's AdBlockTabHelper at its next main-frame navigation;
+  // the page on screen keeps its filter until it is reloaded.
+  if (local_state_) {
+    local_state_->SetBoolean(kEnabledPref, enabled);
+  }
+}
+
+// static
+bool AdBlocker::IsEnabledForSite(Profile* profile, const GURL& url) {
+  HostContentSettingsMap* map = SettingsMap(profile);
+  if (!map || !url.is_valid()) {
+    return true;
+  }
+  // ADS: BLOCK (the default) = ads are blocked; ALLOW = the site is on the
+  // allow list.
+  return map->GetContentSetting(url, GURL(), ContentSettingsType::ADS) !=
+         CONTENT_SETTING_ALLOW;
+}
+
+// static
+void AdBlocker::SetEnabledForSite(Profile* profile,
+                                  const GURL& url,
+                                  bool enabled) {
+  HostContentSettingsMap* map = SettingsMap(profile);
+  if (!map || !url.is_valid()) {
+    return;
+  }
+  // Enabling removes the exception, so the site follows the default again.
+  map->SetContentSettingDefaultScope(
+      url, GURL(), ContentSettingsType::ADS,
+      enabled ? CONTENT_SETTING_DEFAULT : CONTENT_SETTING_ALLOW);
+}
+
+// AdBlockTabHelper ------------------------------------------------------------
+
+AdBlockTabHelper::AdBlockTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AdBlockTabHelper>(*web_contents) {
+  ApplyActivation();
+}
+
+AdBlockTabHelper::~AdBlockTabHelper() = default;
+
+void AdBlockTabHelper::ApplyActivation() {
+  // The subresource filter's forced activation (DevTools' switch): every page
+  // load activates the filter at level "enabled" whatever Safe Browsing says;
+  // the ADS allow list still turns it off per site
+  // (ProfileInteractionManager::OnPageActivationComputed).
+  subresource_filter::DevtoolsInteractionTracker::CreateForWebContents(
+      web_contents());
+  subresource_filter::DevtoolsInteractionTracker::FromWebContents(
+      web_contents())
+      ->ToggleForceActivation(AdBlocker::Get().IsEnabled());
+}
+
+void AdBlockTabHelper::DidStartNavigation(content::NavigationHandle* handle) {
+  // Activation is computed when the main-frame response arrives
+  // (SafeBrowsingPageActivationThrottle::WillProcessResponse), so the switch
+  // read here applies to this navigation.
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    ApplyActivation();
+  }
+}
+
+void AdBlockTabHelper::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+      !handle->IsSameDocument()) {
+    blocked_count_ = 0;
+  }
+}
+
+void AdBlockTabHelper::OnDidAddMessageToConsole(
+    content::RenderFrameHost* source_frame,
+    blink::mojom::ConsoleMessageLevel log_level,
+    const std::u16string& message,
+    int32_t line_no,
+    const std::u16string& source_id,
+    const std::optional<std::u16string>& untrusted_stack_trace) {
+  if (!source_frame || !source_frame->GetPage().IsPrimary()) {
+    return;
+  }
+  if (base::StartsWith(message, kBlockedMessagePrefix)) {
+    ++blocked_count_;
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AdBlockTabHelper);
+
+}  // namespace openarc
