diff --git a/openarc/bridge/public/OpenArcCore/OACApplication.h b/openarc/bridge/public/OpenArcCore/OACApplication.h
new file mode 100644
index 000000000000..9180ab7d9ed0
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACApplication.h
@@ -0,0 +1,152 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACApplication: the embedded Chromium browser process.
+//
+// Maps to: the lifetime of the `BrowserEngine` instance (app/Sources/OpenArcEngine/
+// BrowserEngine.swift). `OpenArcChromium` (plan C8) starts it once at launch, before the first
+// `makeTab`, and shuts it down from the termination flush (`LaunchFlow`'s termination observer).
+// Plan tasks: C6 (embedder start), C8 (framework), C11 (profiles), D8 (local crash reports).
+//
+// Startup model (README §Process model): the app's own NSApplication runs the main run loop. The
+// app's principal class is `OACBrowserApplication` (OACBrowserApplication.h) so Chromium's event
+// handling contract holds. `-startWithConfiguration:error:` runs Chromium's browser-process
+// startup on the main thread and returns once the UI thread is ready to create profiles and tabs;
+// it does NOT run a message loop of its own (the bridge's main delegate takes over the browser
+// process run step and leaves the loop to AppKit).
+
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class OACProfile;
+@class OACNewTabRequest;
+@protocol OACApplicationDelegate;
+
+/// Startup parameters. Copied by `-startWithConfiguration:error:`; later changes have no effect.
+OAC_EXPORT
+@interface OACApplicationConfiguration : NSObject <NSCopying>
+
+/// Chromium's user data directory. Default profiles live in `<userDataDirectory>/Profiles/<UUID>`.
+/// The shell passes `<app data dir>/Chromium`, where the app data dir is
+/// `~/Library/Application Support/org.openarc.browser/` or `OPENARC_DATA_DIR` (app/README.md
+/// §Data directory), so a development data dir also isolates engine data.
+@property (nonatomic, copy) NSURL *userDataDirectory;
+
+/// Disk cache root. nil: `~/Library/Caches/org.openarc.browser/Chromium`.
+@property (nonatomic, copy, nullable) NSURL *cacheDirectory;
+
+/// Crashpad database for local crash reports (plan D8, decision Q8: stored locally, never
+/// uploaded). nil: `<userDataDirectory>/Crashpad`.
+@property (nonatomic, copy, nullable) NSURL *crashDumpDirectory;
+
+/// UI locale for Chromium's own strings (error pages, WebUI), e.g. "en-US". nil: the system's.
+@property (nonatomic, copy, nullable) NSString *locale;
+
+/// Process arguments handed to Chromium's command line (`ProcessInfo.arguments`). Unknown
+/// switches are ignored by Chromium.
+@property (nonatomic, copy) NSArray<NSString *> *arguments;
+
+/// Extra Chromium switches for development (e.g. "--enable-logging=stderr"). Empty in release.
+@property (nonatomic, copy) NSArray<NSString *> *additionalSwitches;
+
+/// DevTools remote debugging port; 0 (default) keeps it off.
+@property (nonatomic) NSInteger remoteDebuggingPort;
+
+- (instancetype)initWithUserDataDirectory:(NSURL *)userDataDirectory NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+/// Lifecycle of the engine.
+typedef NS_ENUM(NSInteger, OACApplicationState) {
+    OACApplicationStateNotStarted = 0,
+    OACApplicationStateRunning = 1,
+    OACApplicationStateShuttingDown = 2,
+    /// Shut down. Chromium cannot be started twice in one process; relaunch the app instead.
+    OACApplicationStateTerminated = 3,
+};
+
+/// The browser process. One per app process.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACApplication : NSObject
+
+/// The single instance.
+@property (class, nonatomic, readonly) OACApplication *sharedApplication NS_SWIFT_NAME(shared);
+
+@property (nonatomic, readonly) OACApplicationState state;
+
+/// Engine-wide callbacks. Weak.
+@property (nonatomic, weak, nullable) id<OACApplicationDelegate> delegate;
+
+/// Starts the browser process: command line, feature list, Chromium threads, the profile manager
+/// and the bridge's browser parts. Call once, on the main thread, from
+/// `applicationWillFinishLaunching` or later. Returns NO with `OACErrorAlreadyStarted` when called
+/// twice.
+- (BOOL)startWithConfiguration:(OACApplicationConfiguration *)configuration error:(NSError **)error
+    NS_SWIFT_NAME(start(configuration:));
+
+/// Shuts the engine down: closes every tab without running unload handlers, flushes cookies,
+/// prefs and history to disk, destroys profiles and joins Chromium's threads. Calls the handler on
+/// the main thread when done. Meant for `applicationShouldTerminate:` returning
+/// `NSTerminateLater`; the app must exit afterwards.
+- (void)shutdownWithCompletionHandler:(void (^)(void))completionHandler NS_SWIFT_NAME(shutdown(completionHandler:));
+
+/// Chromium version, e.g. "156.0.8078.48". Settings ▸ About shows it next to the app version.
+@property (nonatomic, readonly, copy) NSString *chromiumVersion;
+
+/// User agent string sent by default (Chromium's reduced UA; no product token of our own, to keep
+/// site compatibility).
+@property (nonatomic, readonly, copy) NSString *userAgent;
+
+/// The configuration the engine started with; nil before start.
+@property (nonatomic, readonly, copy, nullable) OACApplicationConfiguration *configuration;
+
+// MARK: Profiles (plan C11)
+
+/// Loads (creating on first use) the on-disk profile for a model `Profile.id`. Loading reads disk
+/// on Chromium's background threads; the handler runs on the main thread. Several calls for the
+/// same id share one load and return the same object.
+- (void)loadProfileWithIdentifier:(NSUUID *)identifier
+                completionHandler:(void (^)(OACProfile *_Nullable profile, NSError *_Nullable error))completionHandler
+    NS_SWIFT_NAME(loadProfile(identifier:completionHandler:));
+
+/// The profile for `identifier` if it is already loaded, else nil.
+- (nullable OACProfile *)loadedProfileWithIdentifier:(NSUUID *)identifier NS_SWIFT_NAME(loadedProfile(identifier:));
+
+/// Every loaded on-disk profile (not the off-the-record ones).
+@property (nonatomic, readonly, copy) NSArray<OACProfile *> *loadedProfiles;
+
+/// Deletes a profile's engine data (cookies, storage, history, cache, extensions). Mirrors the
+/// model's profile deletion (`TreeOps` delete profile, refused for the Default profile or while
+/// Spaces use it). Every tab of the profile must be closed first, else the handler gets
+/// `OACErrorInvalidArgument`.
+- (void)deleteProfileWithIdentifier:(NSUUID *)identifier
+                  completionHandler:(void (^)(NSError *_Nullable error))completionHandler
+    NS_SWIFT_NAME(deleteProfile(identifier:completionHandler:));
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+/// Engine-wide callbacks, on the main thread.
+NS_SWIFT_UI_ACTOR
+@protocol OACApplicationDelegate <NSObject>
+@optional
+
+/// Something outside any tab wants a new tab: an extension (`chrome.tabs.create`), a notification
+/// click, a WebUI link. `request.opener` is nil. Maps to `EngineEvent.newTabRequested`.
+- (void)application:(OACApplication *)application didRequestNewTab:(OACNewTabRequest *)request;
+
+/// A profile's last off-the-record tab closed and its off-the-record context was destroyed
+/// (`TabConfiguration.isOffTheRecord`: "the context is destroyed with its last tab").
+- (void)application:(OACApplication *)application didDestroyOffTheRecordProfileOfIdentifier:(NSUUID *)identifier;
+
+/// A helper process (GPU, network, utility) died. Renderer crashes go to the tab instead
+/// (`-[OACTabDelegate tab:renderProcessDidTerminate:]`).
+- (void)application:(OACApplication *)application helperProcessDidTerminateWithName:(NSString *)processName;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACBrowserApplication.h b/openarc/bridge/public/OpenArcCore/OACBrowserApplication.h
new file mode 100644
index 000000000000..fc545fa55cc4
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACBrowserApplication.h
@@ -0,0 +1,36 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACBrowserApplication: the NSApplication subclass Chromium needs in the browser process.
+//
+// Chromium's Mac event handling (nested run loops for menus and drags, `sendEvent:` tracking that
+// keeps tasks from running inside an event dispatch, the shutdown path) relies on the
+// NSApplication being a class that tracks "is handling sendEvent". `content_shell` and Chrome
+// use their own subclasses for this; ours is `OACBrowserApplication`, which the bridge implements
+// against Chromium's protocols in the .mm file (they are not part of this public header so the
+// shell never sees a Chromium type).
+//
+// Wiring (plan C8, the shell side): the bundle's Info.plist sets
+// `NSPrincipalClass = OACBrowserApplication`. SwiftUI's `App` uses `NSApplication.shared`, which
+// instantiates the principal class, so the SwiftUI scene, menus and `OpenArcAppDelegate`
+// (`NSApplicationDelegateAdaptor`) keep working unchanged. Before `OACApplication` starts, nothing
+// Chromium-specific happens in this class.
+//
+// This is the only public header that imports AppKit.
+
+#import <AppKit/AppKit.h>
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACBrowserApplication : NSApplication
+
+/// YES while `-sendEvent:` is on the stack. Chromium reads it to decide whether a task may run
+/// now or must wait for the event to finish.
+@property (nonatomic, readonly, getter=isHandlingSendEvent) BOOL handlingSendEvent;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACDefines.h b/openarc/bridge/public/OpenArcCore/OACDefines.h
new file mode 100644
index 000000000000..17b1ae66f143
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACDefines.h
@@ -0,0 +1,111 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OpenArcCore: shared macros, error domain and small value types of the Chromium bridge.
+//
+// Every public header of OpenArcCore.framework imports this file. The framework is built with
+// Chromium's `-fvisibility=hidden`, so every public class carries `OAC_EXPORT` and every public C
+// symbol carries `OAC_EXTERN`; nothing of Chromium itself is exported (chromium-bridge/README.md
+// §Build and packaging).
+//
+// Threading contract for the whole framework (README §Threading): every class and protocol that is
+// not an immutable value is main-thread only (`NS_SWIFT_UI_ACTOR`, imported into Swift as
+// `@MainActor`). Chromium's BrowserThread::UI is the macOS main thread. The bridge calls delegates
+// and completion handlers on the main thread, from a posted task, never re-entrantly from inside a
+// call the shell made and never from inside a Chromium observer iteration.
+//
+// Immutable value objects (state snapshots, request descriptions) are `NS_SWIFT_SENDABLE`.
+//
+// No header except OACBrowserApplication.h imports AppKit. Views are passed as a forward-declared
+// `NSView`, which Swift imports as an opaque class (SE-0384), so the Swift target that wraps this
+// framework (`OpenArcChromium`, plan C8) can hand the view to `SurfaceContent.native(AnyObject)`
+// without importing AppKit itself. Images cross the bridge as PNG bytes, like `Favicon.pngData`
+// and `EngineSnapshot.pngData` in app/Sources/OpenArcEngine/BrowserEngine.swift.
+
+#import <Foundation/Foundation.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+#if defined(__cplusplus)
+#define OAC_EXTERN extern "C" __attribute__((visibility("default")))
+#else
+#define OAC_EXTERN extern __attribute__((visibility("default")))
+#endif
+
+/// Marks a public Objective-C class as exported from OpenArcCore.framework.
+#define OAC_EXPORT __attribute__((visibility("default")))
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// Version of this header set. Bumped on every incompatible change; `OpenArcChromium` checks it
+/// against the value it was compiled with at startup.
+OAC_EXTERN const NSInteger OACBridgeAPIVersion;
+
+/// Error domain of every NSError the bridge returns. Swift imports the codes as `OACError`.
+OAC_EXTERN NSErrorDomain const OACErrorDomain;
+
+/// Error codes. Where `EngineError` (BrowserEngine.swift) has a matching case it is named per
+/// case; the others are proposed additions (SWIFT_PROTOCOL_CHANGES.md §13).
+typedef NS_ERROR_ENUM(OACErrorDomain, OACErrorCode) {
+    /// `OACApplication` is not running (never started, or already shut down).
+    OACErrorNotStarted = 1,
+    /// `-startWithConfiguration:error:` was called twice.
+    OACErrorAlreadyStarted = 2,
+    /// The profile could not be created or loaded, or it was destroyed.
+    OACErrorProfileUnavailable = 3,
+    /// The tab is closed. `EngineError.tabClosed`.
+    OACErrorTabClosed = 4,
+    /// A live tab already has the requested identifier. `EngineError.duplicateTabID`.
+    OACErrorDuplicateTabIdentifier = 5,
+    /// No frame to copy (hidden, crashed or not painted yet). `EngineError.snapshotUnavailable`.
+    OACErrorSnapshotUnavailable = 6,
+    /// The URL is invalid or uses a scheme the engine refuses to navigate to.
+    OACErrorInvalidURL = 7,
+    /// The engine is shutting down and refuses new work.
+    OACErrorShuttingDown = 8,
+    /// A parameter is out of range (for example a zoom level).
+    OACErrorInvalidArgument = 9,
+    /// The request was already answered, or it was cancelled by the engine.
+    OACErrorRequestFinished = 10,
+};
+
+/// Main-frame security level of the visible navigation entry, derived from Chromium's security
+/// state. Drives the "Secure" pill of the Site Control Center ([06 §12] observed label; today the
+/// shell derives it from the URL scheme alone, see `SiteOrigin.isSecure`).
+typedef NS_ENUM(NSInteger, OACSecurityLevel) {
+    /// http, file, about: and other pages without a secure connection.
+    OACSecurityLevelNone = 0,
+    /// A valid HTTPS connection.
+    OACSecurityLevelSecure = 1,
+    /// HTTPS with mixed or otherwise degraded content.
+    OACSecurityLevelWarning = 2,
+    /// A certificate error the user clicked through, or a site flagged as dangerous.
+    OACSecurityLevelDangerous = 3,
+};
+
+/// An sRGB color with straight alpha, components 0...1. Mirrors `RGBAColor` in OpenArcModel.
+typedef struct OACColor {
+    double red;
+    double green;
+    double blue;
+    double alpha;
+} OACColor;
+
+/// A site's origin: scheme, host and port. Mirrors `SiteOrigin` in
+/// app/Sources/OpenArcShell/SiteControls/SiteSettingsProvider.swift (scheme and host lowercased;
+/// port nil when it is the scheme's default).
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACOrigin : NSObject <NSCopying>
+@property (nonatomic, readonly, copy) NSString *scheme;
+@property (nonatomic, readonly, copy) NSString *host;
+/// nil: the scheme's default port.
+@property (nonatomic, readonly, copy, nullable) NSNumber *port;
+
+- (instancetype)initWithScheme:(NSString *)scheme host:(NSString *)host port:(nullable NSNumber *)port NS_DESIGNATED_INITIALIZER;
+/// nil for URLs without a host (about:blank, file URLs, data URLs).
+- (nullable instancetype)initWithURL:(NSURL *)url;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACDialogDelegate.h b/openarc/bridge/public/OpenArcCore/OACDialogDelegate.h
new file mode 100644
index 000000000000..2ff3c26e24c8
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACDialogDelegate.h
@@ -0,0 +1,207 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACDialogDelegate: dialogs and prompts the shell draws itself (plan C12).
+//
+// Maps to: nothing in OpenArcEngine yet. The proposed Swift side is `EngineDialogRequest` and a
+// `BrowserTab.dialogRequests()` stream (SWIFT_PROTOCOL_CHANGES.md §3). C12 acceptance: "each
+// dialog has a SwiftUI view; behavior from Chromium".
+//
+// Why shell-drawn (README §Keeping //chrome without its UI): Chrome draws these with Views
+// (`JavaScriptTabModalDialogViewViews`, the permission bubble, the login view). We keep the
+// `//chrome` controllers that decide WHEN to ask and WHAT to remember (the JavaScript dialog
+// manager's suppression rules, `permissions::PermissionRequestManager`, the login handler, the
+// external protocol handler's policy) and replace only the drawing: the bridge implements the
+// controller's UI hook and forwards a request object here.
+//
+// Request objects, one per prompt:
+// - Answer exactly once with one of the request's reply methods; later replies are ignored.
+// - The engine may cancel a request on its own (the tab navigated, closed, or the page withdrew
+//   the request). The bridge then calls `-tab:didCancelDialogRequest:` (optional) and
+//   `isFinished` turns YES; the shell removes its view.
+// - Dropping the last reference to an unanswered request answers it with its default (alert:
+//   dismissed, confirm: cancel, prompt: nil, permission: dismissed (not remembered), auth: cancel,
+//   file chooser: cancel, external protocol: block), so a page never hangs.
+// - With no dialog delegate, or when the delegate method returns NO, the default answer is used
+//   right away.
+//
+// The look of every one of these dialogs is not in docs/arc-spec (unknown); C12 designs them.
+
+#import <OpenArcCore/OACDefines.h>
+#import <OpenArcCore/OACTab.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+// MARK: - Base
+
+/// Common part of every request.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACDialogRequest : NSObject
+/// The tab that asked. nil once that tab closed (the request is cancelled then).
+@property (nonatomic, readonly, weak, nullable) OACTab *tab;
+/// The requesting origin, shown in the dialog ("example.com wants to…"). nil for opaque origins
+/// (data: URLs, sandboxed frames); the shell then shows "This page".
+@property (nonatomic, readonly, copy, nullable) OACOrigin *origin;
+/// The request comes from a cross-origin iframe of `tab`'s page.
+@property (nonatomic, readonly) BOOL isFromSubframe;
+/// YES once answered or cancelled.
+@property (nonatomic, readonly, getter=isFinished) BOOL finished;
+/// Answers with the request's default (see the file comment).
+- (void)cancel;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+// MARK: - JavaScript dialogs
+
+typedef NS_ENUM(NSInteger, OACJavaScriptDialogKind) {
+    OACJavaScriptDialogKindAlert = 0,
+    OACJavaScriptDialogKindConfirm = 1,
+    OACJavaScriptDialogKindPrompt = 2,
+    /// "Leave site? Changes you made may not be saved." (beforeunload). `message` is Chromium's
+    /// localized text: pages cannot set it.
+    OACJavaScriptDialogKindBeforeUnload = 3,
+};
+
+/// alert(), confirm(), prompt() and the beforeunload prompt. Tab-modal: the shell draws it over
+/// the tab's web panel only. Chromium's rules stay in charge: dialogs from a background tab wait
+/// until it is shown, and repeated dialogs offer "Prevent this page from creating additional
+/// dialogs" (`showsSuppressOption`).
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACJavaScriptDialogRequest : OACDialogRequest
+@property (nonatomic, readonly) OACJavaScriptDialogKind kind;
+@property (nonatomic, readonly, copy) NSString *message;
+/// prompt() default text; empty otherwise.
+@property (nonatomic, readonly, copy) NSString *defaultPromptText;
+/// For beforeunload: YES when it is a reload rather than leaving the page (button text differs).
+@property (nonatomic, readonly) BOOL isReload;
+/// Offer the "prevent additional dialogs" checkbox.
+@property (nonatomic, readonly) BOOL showsSuppressOption;
+
+/// OK / Leave. `promptText` is used for prompt() only. `suppressFurtherDialogs` from the checkbox.
+- (void)acceptWithPromptText:(nullable NSString *)promptText suppressFurtherDialogs:(BOOL)suppressFurtherDialogs
+    NS_SWIFT_NAME(accept(promptText:suppressFurtherDialogs:));
+/// Cancel / Stay (alert: same as dismissing).
+- (void)dismissSuppressingFurtherDialogs:(BOOL)suppressFurtherDialogs NS_SWIFT_NAME(dismiss(suppressFurtherDialogs:));
+@end
+
+// MARK: - HTTP authentication
+
+/// HTTP Basic/Digest auth and proxy auth. Chromium's login handler fills saved credentials from the
+/// password manager first (C13); `suggestedUsername` comes from there.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACAuthenticationRequest : OACDialogRequest
+/// The authentication realm string the server sent (shown as-is, untrusted).
+@property (nonatomic, readonly, copy) NSString *realm;
+/// The server or proxy host and port that asks.
+@property (nonatomic, readonly, copy) NSString *challengerHostPort;
+@property (nonatomic, readonly) BOOL isProxy;
+/// The connection is not encrypted (show a warning in the dialog).
+@property (nonatomic, readonly) BOOL isInsecureConnection;
+@property (nonatomic, readonly, copy, nullable) NSString *suggestedUsername;
+
+- (void)proceedWithUsername:(NSString *)username password:(NSString *)password;
+@end
+
+// MARK: - Permissions
+
+/// Permission kinds the shell can prompt for. The first four match `SitePermissionKind` in
+/// app/Sources/OpenArcShell/SiteControls/SiteSettingsProvider.swift (camera, microphone, location,
+/// notifications); the rest are proposed additions (SWIFT_PROTOCOL_CHANGES.md §5).
+typedef NS_ENUM(NSInteger, OACPermissionKind) {
+    OACPermissionKindCamera = 0,
+    OACPermissionKindMicrophone = 1,
+    OACPermissionKindLocation = 2,
+    OACPermissionKindNotifications = 3,
+    OACPermissionKindClipboardRead = 4,
+    OACPermissionKindMIDI = 5,
+    OACPermissionKindStorageAccess = 6,
+    OACPermissionKindScreenWakeLock = 7,
+    OACPermissionKindMultipleDownloads = 8,
+    OACPermissionKindLocalFonts = 9,
+    OACPermissionKindWindowManagement = 10,
+    OACPermissionKindIdleDetection = 11,
+    OACPermissionKindProtectedMedia = 12,
+};
+
+/// A permission prompt. Chromium groups requests that arrive together (camera + microphone from
+/// one getUserMedia call) into one prompt, so `kinds` can hold more than one.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACPermissionRequest : OACDialogRequest
+/// `OACPermissionKind` values as NSNumbers, in Chromium's display order.
+@property (nonatomic, readonly, copy) NSArray<NSNumber *> *kinds NS_REFINED_FOR_SWIFT;
+/// The request comes from a user gesture (prompts without one may be shown quietly).
+@property (nonatomic, readonly) BOOL hasUserGesture;
+
+/// Allow. `remember` NO: allow this time only (until the page is closed); YES: store "allow" for
+/// the origin in the profile's site settings.
+- (void)allowRemembering:(BOOL)remember NS_SWIFT_NAME(allow(remembering:));
+/// Block. `remember` YES stores "block" for the origin.
+- (void)denyRemembering:(BOOL)remember NS_SWIFT_NAME(deny(remembering:));
+/// Closed without a decision (Chromium counts dismissals toward its auto-block heuristic).
+- (void)dismiss;
+@end
+
+// MARK: - File chooser
+
+typedef NS_ENUM(NSInteger, OACFileChooserMode) {
+    OACFileChooserModeOpen = 0,
+    OACFileChooserModeOpenMultiple = 1,
+    OACFileChooserModeOpenFolder = 2,
+    /// showSaveFilePicker().
+    OACFileChooserModeSave = 3,
+};
+
+/// `<input type=file>` and the File System Access pickers. The shell shows an `NSOpenPanel` /
+/// `NSSavePanel` as a sheet on the tab's window.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACFileChooserRequest : OACDialogRequest
+@property (nonatomic, readonly) OACFileChooserMode mode;
+/// Uniform type identifiers derived from the `accept` attribute; empty: any file.
+@property (nonatomic, readonly, copy) NSArray<NSString *> *acceptedTypeIdentifiers;
+/// Suggested file name or starting folder, if the page gave one.
+@property (nonatomic, readonly, copy, nullable) NSURL *defaultURL;
+/// `capture` attribute set (no camera capture UI on macOS: treated as a normal open panel).
+@property (nonatomic, readonly) BOOL wantsCapture;
+
+- (void)selectURLs:(NSArray<NSURL *> *)fileURLs;
+@end
+
+// MARK: - External protocol
+
+/// A navigation to a scheme Chromium cannot handle (mailto:, zoommtg:, slack:…). Chromium's policy
+/// (per-origin "always allow" memory, blocked schemes, user gesture rules) runs first; this request
+/// only appears when Chromium would show its "Open <App>?" dialog.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACExternalProtocolRequest : OACDialogRequest
+@property (nonatomic, readonly, copy) NSURL *URL;
+/// Display name of the app that handles the scheme (from LaunchServices); nil if none.
+@property (nonatomic, readonly, copy, nullable) NSString *handlerApplicationName;
+/// Bundle URL of that app, for its icon.
+@property (nonatomic, readonly, copy, nullable) NSURL *handlerApplicationURL;
+@property (nonatomic, readonly) BOOL hasUserGesture;
+
+/// Opens the URL in the handler app. `rememberForOrigin` stores "always allow" for this scheme on
+/// the requesting origin.
+- (void)openRememberingForOrigin:(BOOL)rememberForOrigin NS_SWIFT_NAME(open(rememberingForOrigin:));
+@end
+
+// MARK: - Delegate
+
+/// Implemented by the shell. Each method returns YES when the shell will show UI and answer the
+/// request later, NO to let the bridge use the default answer right away.
+NS_SWIFT_UI_ACTOR
+@protocol OACDialogDelegate <NSObject>
+@optional
+- (BOOL)tab:(OACTab *)tab runJavaScriptDialog:(OACJavaScriptDialogRequest *)request;
+- (BOOL)tab:(OACTab *)tab requestAuthentication:(OACAuthenticationRequest *)request;
+- (BOOL)tab:(OACTab *)tab requestPermission:(OACPermissionRequest *)request;
+- (BOOL)tab:(OACTab *)tab runFileChooser:(OACFileChooserRequest *)request;
+- (BOOL)tab:(OACTab *)tab openExternalProtocol:(OACExternalProtocolRequest *)request;
+
+/// The engine cancelled an unanswered request (navigation, tab closed, page withdrew it).
+- (void)tab:(OACTab *)tab didCancelDialogRequest:(OACDialogRequest *)request;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACDownloads.h b/openarc/bridge/public/OpenArcCore/OACDownloads.h
new file mode 100644
index 000000000000..e50da99e767f
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACDownloads.h
@@ -0,0 +1,101 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACDownloads: a profile's downloads. Skeleton for plan C12 ("downloads" in its row) and the
+// Library's Downloads section ([06 §8] observed: search field "Search Downloads…", a "Filter"
+// button, empty state "Nothing here yet!"; [01 §Window] observed "View Downloads…").
+//
+// Maps to: nothing in OpenArcEngine yet; proposed `EngineDownloads` (SWIFT_PROTOCOL_CHANGES.md §8).
+// The Chromium side: the profile's `content::DownloadManager` with `//chrome`'s download core
+// service (history-backed list, dangerous file checks, Safe Browsing off), and
+// `DownloadManagerDelegate` replaced so Chromium's download bubble and shelf never appear.
+//
+// The download location comes from Settings ([03] observed "Download location", default
+// Downloads): the shell sets `defaultDirectory`; the bridge never asks where to save unless
+// `promptsForLocation` is YES.
+//
+// Skeleton: the shape is fixed enough for the Library list; the dangerous-download flow and the
+// "ask where to save" dialog are settled in C12.
+
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class OACProfile;
+@class OACDownloads;
+
+typedef NS_ENUM(NSInteger, OACDownloadState) {
+    OACDownloadStateInProgress = 0,
+    OACDownloadStatePaused = 1,
+    OACDownloadStateComplete = 2,
+    OACDownloadStateCancelled = 3,
+    OACDownloadStateInterrupted = 4,
+    /// Waiting for the user to keep or discard a file Chromium flagged as dangerous.
+    OACDownloadStateNeedsConfirmation = 5,
+};
+
+/// Immutable snapshot of one download.
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACDownloadItem : NSObject <NSCopying>
+/// Stable across launches (Chromium's download GUID).
+@property (nonatomic, readonly, copy) NSString *identifier;
+@property (nonatomic, readonly, copy) NSURL *sourceURL;
+/// The page the download started from, if any.
+@property (nonatomic, readonly, copy, nullable) NSURL *referrerURL;
+/// Final file location; nil until decided.
+@property (nonatomic, readonly, copy, nullable) NSURL *fileURL;
+@property (nonatomic, readonly, copy) NSString *suggestedFilename;
+@property (nonatomic, readonly, copy, nullable) NSString *MIMEType;
+@property (nonatomic, readonly) OACDownloadState state;
+@property (nonatomic, readonly) int64_t receivedBytes;
+/// -1 when unknown.
+@property (nonatomic, readonly) int64_t totalBytes;
+@property (nonatomic, readonly, copy) NSDate *startDate;
+@property (nonatomic, readonly, copy, nullable) NSDate *endDate;
+/// Started from an off-the-record profile (kept in memory only).
+@property (nonatomic, readonly) BOOL isOffTheRecord;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_SWIFT_UI_ACTOR
+@protocol OACDownloadsObserver <NSObject>
+@optional
+- (void)downloads:(OACDownloads *)downloads didAddItem:(OACDownloadItem *)item;
+/// Progress is coalesced to at most a few updates per second.
+- (void)downloads:(OACDownloads *)downloads didUpdateItem:(OACDownloadItem *)item;
+- (void)downloads:(OACDownloads *)downloads didRemoveItemWithIdentifier:(NSString *)identifier;
+@end
+
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACDownloads : NSObject
+
+@property (nonatomic, readonly, weak, nullable) OACProfile *profile;
+
+/// Where files go. Set by the shell from the "Download location" setting.
+@property (nonatomic, copy) NSURL *defaultDirectory;
+/// Ask for a location for every download. Default NO.
+@property (nonatomic) BOOL promptsForLocation;
+
+/// Every download in the profile's history, newest first.
+@property (nonatomic, readonly, copy) NSArray<OACDownloadItem *> *items;
+
+- (void)pauseItemWithIdentifier:(NSString *)identifier;
+- (void)resumeItemWithIdentifier:(NSString *)identifier;
+- (void)cancelItemWithIdentifier:(NSString *)identifier;
+/// For `OACDownloadStateNeedsConfirmation`: keep (YES) or discard (NO) the file.
+- (void)confirmItemWithIdentifier:(NSString *)identifier keep:(BOOL)keep;
+/// Removes the entry from the list (the file stays on disk).
+- (void)removeItemWithIdentifier:(NSString *)identifier;
+/// Starts a download without navigating (context menu "Download Linked File", Save Image As).
+- (void)downloadURL:(NSURL *)url;
+
+- (void)addObserver:(id<OACDownloadsObserver>)observer;
+- (void)removeObserver:(id<OACDownloadsObserver>)observer;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACExtensions.h b/openarc/bridge/public/OpenArcCore/OACExtensions.h
new file mode 100644
index 000000000000..0f2852f0334c
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACExtensions.h
@@ -0,0 +1,117 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACExtensions: a profile's extensions. Skeleton for plan C14 (install from the Web Store,
+// toolbar actions in the Site Control Center, popups). Spec: [01 §Extensions] observed
+// "Add Extension…" and "Manage Extensions…"; [06 §12] observed the Site Control Center
+// "Extensions" section with an add button and "Manage" when extensions exist.
+//
+// Maps to: `SiteExtensionAction` and `SiteSettingsProvider.runExtensionAction` in
+// app/Sources/OpenArcShell/SiteControls/SiteSettingsProvider.swift; the rest is proposed as
+// `EngineExtensions` (SWIFT_PROTOCOL_CHANGES.md §9).
+// The Chromium side (kept from `//chrome`, decision Q7): `ExtensionService` / `ExtensionRegistry`,
+// the Web Store installer (webstore_private API on chromewebstore.google.com), and
+// `ExtensionActionManager`. Chrome's toolbar (`ExtensionsToolbarContainer`) is replaced: action
+// icons are given to the shell as data, and popups are hosted in a view the shell places in its
+// own popover. Install confirmation (Chrome's install dialog) is a request to the shell.
+//
+// Skeleton: enough for the Site Control Center list and the Add / Manage menu items. Permissions
+// changes, side panels and the extension context menu are settled in C14. "Manage Extensions…"
+// opens chrome://extensions in a tab until a native page exists.
+
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class NSView;
+@class OACProfile;
+@class OACTab;
+@class OACExtensions;
+
+/// One installed extension, with its action state for a given tab when one was asked for.
+/// Maps to `SiteExtensionAction` (id, name; the icon replaces the SF Symbol placeholder).
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACExtensionInfo : NSObject <NSCopying>
+/// The 32-character extension id (`SiteExtensionAction.id`).
+@property (nonatomic, readonly, copy) NSString *identifier;
+@property (nonatomic, readonly, copy) NSString *name;
+@property (nonatomic, readonly, copy) NSString *version;
+@property (nonatomic, readonly, getter=isEnabled) BOOL enabled;
+@property (nonatomic, readonly) BOOL allowedInIncognito;
+/// The action icon (for the tab, if the info was read for one) at 32 px, PNG.
+@property (nonatomic, readonly, copy, nullable) NSData *iconPNGData;
+/// Badge text and tooltip of the action for the tab; empty when none.
+@property (nonatomic, readonly, copy) NSString *badgeText;
+@property (nonatomic, readonly, copy) NSString *actionTitle;
+/// The action is enabled on that tab (page actions may be disabled per page).
+@property (nonatomic, readonly) BOOL isActionEnabled;
+/// Clicking the action opens a popup (else it sends a click event to the extension).
+@property (nonatomic, readonly) BOOL hasPopup;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+/// Install confirmation for a Web Store install. Answer once; dropping it unanswered cancels.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACExtensionInstallRequest : NSObject
+@property (nonatomic, readonly, copy) NSString *extensionName;
+@property (nonatomic, readonly, copy, nullable) NSData *iconPNGData;
+/// Human-readable permission warnings from Chromium ("Read and change all your data on all
+/// websites").
+@property (nonatomic, readonly, copy) NSArray<NSString *> *permissionWarnings;
+- (void)approve;
+- (void)cancel;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_SWIFT_UI_ACTOR
+@protocol OACExtensionsDelegate <NSObject>
+@optional
+/// The installed set or an extension's state changed.
+- (void)extensionsDidChange:(OACExtensions *)extensions;
+/// An action's icon, badge or enabled state changed for `tab` (nil: every tab).
+- (void)extensions:(OACExtensions *)extensions didUpdateActionOfExtension:(NSString *)extensionIdentifier tab:(nullable OACTab *)tab;
+/// Chromium wants to confirm an install. Return YES to show UI and answer later, NO to cancel.
+- (BOOL)extensions:(OACExtensions *)extensions confirmInstall:(OACExtensionInstallRequest *)request;
+/// The extension wants its popup shown (action clicked, or `chrome.action.openPopup()`). The shell
+/// puts `popupView` in a popover anchored to the Site Control Center row (inferred: where the
+/// popup appears is not in the spec). The view resizes itself to the popup's content; observe its
+/// frame. Calling `-closePopup` or closing the popover ends it.
+- (void)extensions:(OACExtensions *)extensions showPopupView:(NSView *)popupView forExtension:(NSString *)extensionIdentifier tab:(OACTab *)tab;
+- (void)extensions:(OACExtensions *)extensions didClosePopupForExtension:(NSString *)extensionIdentifier;
+@end
+
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACExtensions : NSObject
+
+@property (nonatomic, readonly, weak, nullable) OACProfile *profile;
+@property (nonatomic, weak, nullable) id<OACExtensionsDelegate> delegate;
+
+/// Installed extensions, without per-tab action state.
+@property (nonatomic, readonly, copy) NSArray<OACExtensionInfo *> *installedExtensions;
+
+/// Extensions with an action on `tab`, with that tab's icon, badge and enabled state. The Site
+/// Control Center "Extensions" section (`SiteSettingsState.extensions`).
+- (NSArray<OACExtensionInfo *> *)actionsForTab:(OACTab *)tab;
+
+/// Runs an extension's action on `tab` (`SiteSettingsProvider.runExtensionAction`). Opens the popup
+/// through the delegate when the action has one.
+- (void)runActionOfExtension:(NSString *)extensionIdentifier onTab:(OACTab *)tab;
+- (void)closePopup;
+
+/// Installs from the Web Store by id (the store page's "Add to Open Arc" button goes through the
+/// same path via the webstore private API).
+- (void)installFromWebStoreWithIdentifier:(NSString *)extensionIdentifier
+                        completionHandler:(void (^)(NSError *_Nullable error))completionHandler;
+/// Loads an unpacked extension from a folder (developer mode in chrome://extensions).
+- (void)loadUnpackedFromURL:(NSURL *)folderURL completionHandler:(void (^)(NSError *_Nullable error))completionHandler;
+- (void)setEnabled:(BOOL)enabled forExtension:(NSString *)extensionIdentifier;
+- (void)uninstallExtension:(NSString *)extensionIdentifier;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACProfile.h b/openarc/bridge/public/OpenArcCore/OACProfile.h
new file mode 100644
index 000000000000..69fedc7829b4
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACProfile.h
@@ -0,0 +1,88 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACProfile: one isolated browsing context.
+//
+// Maps to: a model `Profile` (`Profile.id`, OpenArcModel) as used in `TabConfiguration.profileID`,
+// and the off-the-record variant for `TabConfiguration.isOffTheRecord` (incognito windows,
+// `WorkspaceController.makeIncognito`). Plan task C11: on-disk data directory per Profile,
+// isolation of cookies and storage. On the Chromium side it wraps one `Profile` (a
+// `content::BrowserContext`) owned by Chromium's `ProfileManager`.
+//
+// Lifetime (README §Ownership):
+// - On-disk profiles stay loaded until `OACApplication` shuts down or the profile is deleted.
+// - The off-the-record profile is Chromium's primary OTR profile of its original profile. It is
+//   created by `offTheRecordProfile` and destroyed when its last tab closes and the shell holds no
+//   reference to it, so every incognito window of one profile shares one context while any of them
+//   is open (Chromium's usual incognito semantics).
+// - When Chromium destroys the underlying profile, `isValid` turns NO and every method fails with
+//   `OACErrorProfileUnavailable`.
+
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class OACSiteSettings;
+@class OACDownloads;
+@class OACExtensions;
+
+/// Kinds of stored browsing data, for `-clearBrowsingDataOfTypes:...`.
+typedef NS_OPTIONS(NSUInteger, OACBrowsingDataTypes) {
+    OACBrowsingDataTypeHistory = 1 << 0,
+    OACBrowsingDataTypeCookies = 1 << 1,
+    OACBrowsingDataTypeCache = 1 << 2,
+    OACBrowsingDataTypeSiteStorage = 1 << 3,
+    OACBrowsingDataTypeDownloadsList = 1 << 4,
+    OACBrowsingDataTypePasswords = 1 << 5,
+    OACBrowsingDataTypeAutofill = 1 << 6,
+    OACBrowsingDataTypeSiteSettings = 1 << 7,
+};
+
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACProfile : NSObject
+
+/// The model `Profile.id`. An off-the-record profile has its original profile's identifier.
+@property (nonatomic, readonly, copy) NSUUID *identifier;
+
+/// An incognito context: nothing reaches disk and it dies with its last tab.
+@property (nonatomic, readonly, getter=isOffTheRecord) BOOL offTheRecord;
+
+/// NO once Chromium has destroyed the profile.
+@property (nonatomic, readonly, getter=isValid) BOOL valid;
+
+/// `<userDataDirectory>/Profiles/<identifier>`; nil for an off-the-record profile.
+@property (nonatomic, readonly, copy, nullable) NSURL *dataDirectory;
+
+/// For an off-the-record profile, the profile it derives from; nil otherwise.
+@property (nonatomic, readonly, nullable) OACProfile *originalProfile NS_SWIFT_NAME(originalProfile);
+
+/// The off-the-record variant, created on first use. Calling it on an off-the-record profile
+/// returns the receiver.
+@property (nonatomic, readonly) OACProfile *offTheRecordProfile NS_SWIFT_NAME(offTheRecordProfile);
+
+/// Whether the off-the-record variant exists right now (without creating it).
+@property (nonatomic, readonly) BOOL hasOffTheRecordProfile;
+
+/// Per-site permissions, zoom, cookies (Site Control Center, `SiteSettingsProvider`).
+@property (nonatomic, readonly) OACSiteSettings *siteSettings;
+
+/// The profile's downloads (Library ▸ Downloads). Skeleton for plan C12.
+@property (nonatomic, readonly) OACDownloads *downloads;
+
+/// The profile's extensions. Skeleton for plan C14. Off-the-record profiles share the original's
+/// extensions; only those allowed in incognito run there.
+@property (nonatomic, readonly) OACExtensions *extensions;
+
+/// Removes stored data of `types` written since `since` (nil: all time). inferred: the spec
+/// records no Clear Browsing Data surface, Chromium's chrome://settings page covers it until one is
+/// designed.
+- (void)clearBrowsingDataOfTypes:(OACBrowsingDataTypes)types
+                           since:(nullable NSDate *)since
+               completionHandler:(void (^)(void))completionHandler;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
