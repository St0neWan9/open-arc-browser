+#include "openarc/app/openarc_main_delegate.h"
+#include "openarc/common/openarc_paths.h"
+
+extern "C" __attribute__((visibility("default"))) int OACChildProcessMain(
+    int argc,
+    const char** argv) {
+  openarc::ConfigureBundleOverrides();
