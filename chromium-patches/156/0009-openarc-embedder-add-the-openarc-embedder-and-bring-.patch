@@ -0,0 +1,64 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_APP_OPENARC_MAIN_DELEGATE_H_
+#define OPENARC_APP_OPENARC_MAIN_DELEGATE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <variant>
+
+#include "base/files/file_path.h"
+#include "content/public/app/content_main_delegate.h"
+
+namespace content {
+class BrowserMainRunner;
+}
+
+namespace openarc {
+
+class OpenArcContentBrowserClient;
+class OpenArcContentClient;
+
+// Content main delegate for every Open Arc process. In the browser process it
+// starts Chromium inside the app's running NSApplication instead of running a
+// loop of its own (chromium-bridge/README.md, Startup sequence):
+// BrowserMainRunner::Initialize() runs the startup tasks, then the UI thread's
+// message pump is attached to the app's main CFRunLoop. Shutdown happens in
+// ShutdownBrowser(), called by OACApplication.
+//
+// TODO(C6b): derive from //chrome's ChromeMainDelegate (decision Q7).
+class OpenArcMainDelegate : public content::ContentMainDelegate {
+ public:
+  // |user_data_directory|: Chromium's user data directory in the browser
+  // process (OACApplicationConfiguration); empty in child processes.
+  explicit OpenArcMainDelegate(const base::FilePath& user_data_directory = {});
+  OpenArcMainDelegate(const OpenArcMainDelegate&) = delete;
+  OpenArcMainDelegate& operator=(const OpenArcMainDelegate&) = delete;
+  ~OpenArcMainDelegate() override;
+
+  // Stops the browser process: browser main parts' teardown, then the
+  // browser threads. Only for the browser process, once.
+  void ShutdownBrowser();
+
+  // content::ContentMainDelegate:
+  std::optional<int> BasicStartupComplete() override;
+  void PreSandboxStartup() override;
+  std::variant<int, content::MainFunctionParams> RunProcess(
+      const std::string& process_type,
+      content::MainFunctionParams main_function_params) override;
+  content::ContentClient* CreateContentClient() override;
+  content::ContentBrowserClient* CreateContentBrowserClient() override;
+
+ private:
+  const base::FilePath user_data_directory_;
+  std::unique_ptr<OpenArcContentClient> content_client_;
+  std::unique_ptr<OpenArcContentBrowserClient> browser_client_;
+  std::unique_ptr<content::BrowserMainRunner> browser_main_runner_;
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_APP_OPENARC_MAIN_DELEGATE_H_
