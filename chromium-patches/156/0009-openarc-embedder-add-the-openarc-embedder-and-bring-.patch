+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_BROWSER_MAIN_PARTS_H_
+#define OPENARC_BROWSER_OPENARC_BROWSER_MAIN_PARTS_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "content/public/browser/browser_main_parts.h"
+
+namespace display {
+class ScopedNativeScreen;
+}
+
+namespace openarc {
+
+class OpenArcBrowserContext;
+
+// Browser-process startup and shutdown hooks. Owns the browsing contexts,
+// which must be destroyed before content stops its threads.
+class OpenArcBrowserMainParts : public content::BrowserMainParts {
+ public:
+  OpenArcBrowserMainParts();
+  OpenArcBrowserMainParts(const OpenArcBrowserMainParts&) = delete;
+  OpenArcBrowserMainParts& operator=(const OpenArcBrowserMainParts&) = delete;
+  ~OpenArcBrowserMainParts() override;
+
+  // The single instance while the browser process runs, else nullptr.
+  static OpenArcBrowserMainParts* Get();
+
+  // Returns the context for |key|, creating it on first use. |key| is the
+  // profile's identifier, with a suffix for the off-the-record variant.
+  OpenArcBrowserContext* GetOrCreateBrowserContext(const std::string& key,
+                                                   const base::FilePath& path,
+                                                   bool off_the_record);
+  OpenArcBrowserContext* FindBrowserContext(const std::string& key);
+
+  // Runs once, in PostMainMessageLoopRun, before the contexts are destroyed,
+  // so the bridge can close every tab that still uses one.
+  void SetWillDestroyBrowserContextsCallback(base::OnceClosure callback);
+
+  // content::BrowserMainParts:
+  int PreCreateThreads() override;
+  int PreMainMessageLoopRun() override;
+  void PostMainMessageLoopRun() override;
+
+ private:
+  base::OnceClosure will_destroy_browser_contexts_;
+  // The display::Screen every web view's widget observes (content does not
+  // create one; the embedder must, as content_shell does).
+  std::unique_ptr<display::ScopedNativeScreen> screen_;
+  std::map<std::string, std::unique_ptr<OpenArcBrowserContext>>
+      browser_contexts_;
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_BROWSER_MAIN_PARTS_H_
diff --git a/openarc/browser/openarc_browser_main_parts.mm b/openarc/browser/openarc_browser_main_parts.mm
