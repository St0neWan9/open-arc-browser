new file mode 100644
index 000000000000..bef49fcad6df
--- /dev/null
+++ b/openarc/app/openarc_helper_main.cc
@@ -0,0 +1,86 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The child-process executable: renderer, GPU and utility processes. It sets
+// up the seatbelt sandbox, then loads the OpenArcCore library and calls
+// OACChildProcessMain. It must not link //base: the library carries its own
+// copy, and two would split the allocator and globals.
+//
+// Layout (plan C8): the helper is OpenArcCore.framework/Versions/A/Helpers/
+// openarc_helper and the library is Versions/A/OpenArcCore, so the library is
+// ../OpenArcCore relative to the helper. The helper app bundles and their
+// sandbox profiles are plan C10.
+
+#include <dlfcn.h>
+#include <libgen.h>
+#include <mach-o/dyld.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <memory>
+
+#include "base/allocator/early_zone_registration_apple.h"
+#include "base/compiler_specific.h"
+#include "sandbox/mac/seatbelt_exec.h"
+
+namespace {
+
+using ChildProcessMainPtr = int (*)(int, const char**);
+
+// Relative to the helper's directory (Versions/A/Helpers).
+constexpr char kLibraryRelativePath[] = "../OpenArcCore";
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  partition_alloc::EarlyMallocZoneRegistration();
+
+  uint32_t exec_path_size = 0;
+  if (_NSGetExecutablePath(nullptr, &exec_path_size) != -1) {
+    fprintf(stderr, "_NSGetExecutablePath: get length failed\n");
+    abort();
+  }
+  std::unique_ptr<char[]> exec_path(new char[exec_path_size]);
+  if (_NSGetExecutablePath(exec_path.get(), &exec_path_size) != 0) {
+    fprintf(stderr, "_NSGetExecutablePath: get path failed\n");
+    abort();
+  }
+
+  sandbox::SeatbeltExecServer::CreateFromArgumentsResult seatbelt =
+      sandbox::SeatbeltExecServer::CreateFromArguments(exec_path.get(), argc,
+                                                       argv);
+  if (seatbelt.sandbox_required) {
+    if (!seatbelt.server || !seatbelt.server->InitializeSandbox()) {
+      fprintf(stderr, "Failed to initialize the sandbox.\n");
+      abort();
+    }
+  }
+
+  const char* dir = dirname(exec_path.get());
+  if (!dir) {
+    fprintf(stderr, "dirname failed\n");
+    abort();
+  }
+  const size_t path_size =
+      UNSAFE_TODO(strlen(dir)) + sizeof(kLibraryRelativePath) + 1;
+  std::unique_ptr<char[]> library_path(new char[path_size]);
+  UNSAFE_TODO(snprintf(library_path.get(), path_size, "%s/%s", dir,
+                       kLibraryRelativePath));
+
+  void* library = dlopen(library_path.get(), RTLD_LAZY | RTLD_LOCAL | RTLD_FIRST);
+  if (!library) {
+    UNSAFE_TODO(
+        fprintf(stderr, "dlopen %s: %s\n", library_path.get(), dlerror()));
+    abort();
+  }
+  const auto child_main = reinterpret_cast<ChildProcessMainPtr>(
+      dlsym(library, "OACChildProcessMain"));
+  if (!child_main) {
+    UNSAFE_TODO(fprintf(stderr, "dlsym OACChildProcessMain: %s\n", dlerror()));
+    abort();
+  }
+  // exit() rather than return, as Chrome's helpers do.
+  exit(child_main(argc, const_cast<const char**>(argv)));
+}
