--- /dev/null
+++ b/openarc/bridge/oac_profile.mm
@@ -0,0 +1,126 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import <OpenArcCore/OACProfile.h>
+
+#include <string>
+
+#include "base/apple/foundation_util.h"
+#include "base/check.h"
+#include "base/strings/sys_string_conversions.h"
+#include "openarc/browser/openarc_browser_context.h"
+#include "openarc/browser/openarc_browser_main_parts.h"
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_profile_internal.h"
+
+// Plan C11 owns real per-profile storage and //chrome's Profile (C6b); this is
+// the bring-up subset: one content browser context per profile identifier,
+// plus an off-the-record variant. Site settings, downloads and extensions come
+// with C12 and C14.
+@implementation OACProfile {
+  NSUUID* _identifier;
+  NSURL* _dataDirectory;
+  __weak OACProfile* _originalProfile;
+  OACProfile* _offTheRecordProfile;
+  BOOL _valid;
+}
+
+- (instancetype)initWithIdentifier:(NSUUID*)identifier
+                     dataDirectory:(NSURL*)dataDirectory
+                   originalProfile:(OACProfile*)originalProfile {
+  if ((self = [super init])) {
+    _identifier = [identifier copy];
+    _dataDirectory = [dataDirectory copy];
+    _originalProfile = originalProfile;
+    _valid = YES;
+  }
+  return self;
+}
+
+- (std::string)contextKey {
+  return base::SysNSStringToUTF8(_identifier.UUIDString) +
+         (_originalProfile ? ":otr" : "");
+}
+
+- (content::BrowserContext*)browserContext {
+  auto* parts = openarc::OpenArcBrowserMainParts::Get();
+  if (!_valid || !parts) {
+    return nullptr;
+  }
+  OACProfile* original = _originalProfile;
+  base::FilePath path =
+      original ? base::apple::NSURLToFilePath(original.dataDirectory)
+               : base::apple::NSURLToFilePath(_dataDirectory);
+  return parts->GetOrCreateBrowserContext([self contextKey], path,
+                                          /*off_the_record=*/original != nil);
+}
+
+- (void)invalidate {
+  _valid = NO;
+  [_offTheRecordProfile invalidate];
+  _offTheRecordProfile = nil;
+}
+
+- (NSUUID*)identifier {
+  return _identifier;
+}
+
+- (BOOL)isOffTheRecord {
+  return _originalProfile != nil;
+}
+
+- (BOOL)isValid {
+  return _valid;
+}
+
+- (NSURL*)dataDirectory {
+  return _originalProfile ? nil : _dataDirectory;
+}
+
+- (OACProfile*)originalProfile {
+  return _originalProfile;
+}
+
+- (OACProfile*)offTheRecordProfile {
+  if (_originalProfile) {
+    return self;
+  }
+  if (!_offTheRecordProfile) {
+    _offTheRecordProfile = [[OACProfile alloc] initWithIdentifier:_identifier
+                                                    dataDirectory:nil
+                                                  originalProfile:self];
+  }
+  return _offTheRecordProfile;
+}
+
+- (BOOL)hasOffTheRecordProfile {
+  return _offTheRecordProfile != nil;
+}
+
+- (OACSiteSettings*)siteSettings {
+  // C12 / B13: OACSiteSettings is not implemented yet. The non-null contract
+  // of the header cannot be kept, so calling this is a programming error.
+  CHECK(false) << "OACProfile.siteSettings is not implemented yet (plan C12)";
+  return nil;
+}
+
+- (OACDownloads*)downloads {
+  CHECK(false) << "OACProfile.downloads is not implemented yet (plan C12)";
+  return nil;
+}
+
+- (OACExtensions*)extensions {
+  CHECK(false) << "OACProfile.extensions is not implemented yet (plan C14)";
+  return nil;
+}
+
+- (void)clearBrowsingDataOfTypes:(OACBrowsingDataTypes)types
+                           since:(NSDate*)since
+               completionHandler:(void (^)(void))completionHandler {
+  // TODO(C11): BrowsingDataRemover.
+  OACPostToMainThread(completionHandler);
+}
+
+@end
