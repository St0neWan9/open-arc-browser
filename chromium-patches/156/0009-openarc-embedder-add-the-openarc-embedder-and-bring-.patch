+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_tab_preferences.h"
+
+#include "content/public/browser/web_contents.h"
+
+namespace openarc {
+
+OpenArcTabPreferences::OpenArcTabPreferences(content::WebContents* web_contents)
+    : content::WebContentsUserData<OpenArcTabPreferences>(*web_contents) {}
+
+OpenArcTabPreferences::~OpenArcTabPreferences() = default;
+
+void OpenArcTabPreferences::SetColorScheme(
+    blink::mojom::PreferredColorScheme color_scheme) {
+  if (color_scheme_ == color_scheme) {
+    return;
+  }
+  color_scheme_ = color_scheme;
+  // Recomputes WebPreferences (OverrideWebPreferences reads color_scheme_)
+  // and sends them to every renderer of the tab; pages listening for the
+  // prefers-color-scheme media query update live.
+  GetWebContents().OnWebPreferencesChanged();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(OpenArcTabPreferences);
+
+}  // namespace openarc
