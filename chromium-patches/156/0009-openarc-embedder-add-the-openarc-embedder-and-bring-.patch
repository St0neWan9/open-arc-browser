+}
+
+- (OACCaptureState)captureState {
+  return 0;  // C9.
+}
+
+- (BOOL)isFullscreen {
+  return _fields.fullscreen;
+}
+
+- (BOOL)hasThemeColor {
+  return _fields.hasThemeColor;
+}
+
+- (OACColor)themeColor {
+  return _fields.themeColor;
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  return self;
+}
+
+@end
+
+@implementation OACNavigation {
+  NSURL* _url;
+  BOOL _crossDocument;
+  BOOL _rendererInitiated;
+  NSError* _error;
+  NSInteger _httpStatusCode;
+}
