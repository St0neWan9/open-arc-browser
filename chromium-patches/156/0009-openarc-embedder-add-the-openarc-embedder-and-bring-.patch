+
+#ifndef OPENARC_BRIDGE_OAC_REQUESTS_INTERNAL_H_
+#define OPENARC_BRIDGE_OAC_REQUESTS_INTERNAL_H_
+
+#import <OpenArcCore/OACDialogDelegate.h>
+#import <OpenArcCore/OACTabDelegate.h>
+
+#include <memory>
+#include <string>
+
+#include "content/public/browser/javascript_dialog_manager.h"
+
+namespace content {
+class WebContents;
+}
+
+@interface OACNewTabRequest ()
+// A URL request: the shell creates the tab itself.
+- (instancetype)initWithOpener:(OACTab*)opener
+                       profile:(OACProfile*)profile
+                           URL:(NSURL*)URL
+                   disposition:(OACNewTabDisposition)disposition
+                hasUserGesture:(BOOL)hasUserGesture
+                requestedFrame:(CGRect)requestedFrame;
+// A script-opened window: Chromium already made |contents|.
+- (instancetype)initWithOpener:(OACTab*)opener
+                       profile:(OACProfile*)profile
+                           URL:(NSURL*)URL
+                   disposition:(OACNewTabDisposition)disposition
+                hasUserGesture:(BOOL)hasUserGesture
+                requestedFrame:(CGRect)requestedFrame
+               pendingContents:(std::unique_ptr<content::WebContents>)contents;
+// Adopted or declined.
+@property(nonatomic, readonly, getter=isFinished) BOOL finished;
+@end
+
+@interface OACDialogRequest ()
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+             isFromSubframe:(BOOL)isFromSubframe;
+@end
