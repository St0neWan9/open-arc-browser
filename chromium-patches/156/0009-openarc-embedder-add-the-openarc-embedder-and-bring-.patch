+// Rebuilds the snapshot; returns the previous fields.
+- (OACTabStateFields)refreshState {
+  OACTabStateFields previous = _fields;
+  if (!_webContents) {
+    return previous;
+  }
+  content::WebContents* contents = _webContents.get();
+  const GURL& visible = contents->GetVisibleURL();
+  const GURL& committed = contents->GetLastCommittedURL();
+  _fields.url = visible.is_empty() ? nil : net::NSURLWithGURL(visible);
+  _fields.committedURL =
+      committed.is_empty() ? nil : net::NSURLWithGURL(committed);
+  _fields.title = base::SysUTF16ToNSString(contents->GetTitle());
+  _fields.loading = contents->IsLoading();
+  _fields.loadProgress = contents->GetLoadProgress();
+  _fields.canGoBack = contents->GetController().CanGoBack();
+  _fields.canGoForward = contents->GetController().CanGoForward();
+  _fields.crashed = contents->IsCrashed();
+  OACAudioState audio = 0;
+  if (contents->IsCurrentlyAudible()) {
+    audio |= OACAudioStateAudible;
+  }
+  if (contents->IsAudioMuted()) {
+    audio |= OACAudioStateMuted;
+  }
+  _fields.audioState = audio;
+  _fields.securityLevel = committed.SchemeIsCryptographic()
+                              ? OACSecurityLevelSecure
+                              : OACSecurityLevelNone;  // C9: SecurityStateTabHelper.
+  _fields.zoomFactor = blink::ZoomLevelToZoomFactor(
+      content::HostZoomMap::GetZoomLevel(contents));
+  _fields.fullscreen = contents->IsFullscreen();
+  const std::optional<SkColor> theme = contents->GetThemeColor();
+  _fields.hasThemeColor = theme.has_value();
+  _fields.themeColor =
+      theme ? OACColor{SkColorGetR(*theme) / 255.0, SkColorGetG(*theme) / 255.0,
+                       SkColorGetB(*theme) / 255.0, SkColorGetA(*theme) / 255.0}
+            : OACColor{0, 0, 0, 0};
+  _state = [[OACTabState alloc] initWithFields:_fields];
+  return previous;
+}
+
+static BOOL SameURL(NSURL* a, NSURL* b) {
+  return a == b || [a isEqual:b];
+}
+
+// Posts the delegate calls for whatever changed, from a fresh main-thread task
+// (never re-entrantly; OACDefines.h threading contract).
+- (void)webContentsDidChangeState {
+  OACTabStateFields before = [self refreshState];
+  OACTabStateFields after = _fields;
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (!tab || tab.isClosed || !delegate) {
+      return;
+    }
+    if (!SameURL(before.url, after.url) &&
+        [delegate respondsToSelector:@selector(tab:didChangeURL:)]) {
+      [delegate tab:tab didChangeURL:after.url];
+    }
+    if (![before.title ?: @"" isEqualToString:after.title ?: @""] &&
+        [delegate respondsToSelector:@selector(tab:didChangeTitle:)]) {
+      [delegate tab:tab didChangeTitle:after.title ?: @""];
+    }
+    if ((before.loading != after.loading ||
+         before.loadProgress != after.loadProgress) &&
+        [delegate respondsToSelector:@selector(tab:didChangeLoading:progress:)]) {
+      [delegate tab:tab
+          didChangeLoading:after.loading
+                  progress:after.loadProgress];
+    }
+    if ((before.canGoBack != after.canGoBack ||
+         before.canGoForward != after.canGoForward) &&
+        [delegate respondsToSelector:@selector(tab:
+                                         didChangeCanGoBack:canGoForward:)]) {
+      [delegate tab:tab
+          didChangeCanGoBack:after.canGoBack
+                canGoForward:after.canGoForward];
+    }
+    if (before.audioState != after.audioState &&
+        [delegate respondsToSelector:@selector(tab:didChangeAudioState:)]) {
+      [delegate tab:tab didChangeAudioState:after.audioState];
+    }
+    if (before.securityLevel != after.securityLevel &&
+        [delegate respondsToSelector:@selector(tab:didChangeSecurityLevel:)]) {
+      [delegate tab:tab didChangeSecurityLevel:after.securityLevel];
+    }
+    if (before.zoomFactor != after.zoomFactor &&
+        [delegate respondsToSelector:@selector(tab:didChangeZoomFactor:)]) {
+      [delegate tab:tab didChangeZoomFactor:after.zoomFactor];
+    }
+    if (before.fullscreen != after.fullscreen &&
+        [delegate respondsToSelector:@selector(tab:didChangeFullscreen:)]) {
+      [delegate tab:tab didChangeFullscreen:after.fullscreen];
+    }
+    const bool theme_changed =
+        before.hasThemeColor != after.hasThemeColor ||
+        before.themeColor.red != after.themeColor.red ||
+        before.themeColor.green != after.themeColor.green ||
+        before.themeColor.blue != after.themeColor.blue ||
+        before.themeColor.alpha != after.themeColor.alpha;
+    if (theme_changed &&
+        [delegate respondsToSelector:@selector(tab:
+                                         didChangeThemeColor:hasThemeColor:)]) {
+      [delegate tab:tab
+          didChangeThemeColor:after.themeColor
+                hasThemeColor:after.hasThemeColor];
+    }
+    if ((!SameURL(before.faviconURL, after.faviconURL) ||
+         before.faviconPNGData != after.faviconPNGData) &&
+        [delegate respondsToSelector:@selector(tab:
+                                         didChangeFaviconURL:pngData:)]) {
+      [delegate tab:tab
+          didChangeFaviconURL:after.faviconURL
+                      pngData:after.faviconPNGData];
+    }
+  });
+}
