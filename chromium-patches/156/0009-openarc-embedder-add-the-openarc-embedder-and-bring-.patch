+// found in the LICENSE file.
+
+#ifndef OPENARC_COMMON_OPENARC_PATHS_H_
+#define OPENARC_COMMON_OPENARC_PATHS_H_
+
+#include "base/files/file_path.h"
+
+namespace openarc {
+
+// Where the engine's own files live, relative to OpenArcCore.framework (plan
+// C8), whichever process asks (the app, or a helper inside the framework):
+//
+//   OpenArcCore.framework/Versions/A/            GetFrameworkVersionDirectory()
+//     OpenArcCore                                the library
+//     Resources/openarc.pak, icudtl.dat, ...     GetResourcesPakPath()
+//     Helpers/openarc_helper                     GetHelperExecutablePath()
+//     Libraries/                                 SwiftShader
+
+// The framework's versioned directory (Versions/A), i.e. the directory of the
+// library that contains this code.
+base::FilePath GetFrameworkVersionDirectory();
+
+// openarc.pak, the engine's resource pack.
+base::FilePath GetResourcesPakPath();
+
+// The child-process executable (renderer, GPU, utility).
+base::FilePath GetHelperExecutablePath();
+
+// Points base::apple's framework bundle (used to find icudtl.dat, the V8
+// snapshot and Libraries/) at the framework's versioned directory, as Chrome
+// does, and sets the base bundle id used for Mach rendezvous names. Must run
+// before ICU and V8 load, in every process.
+void ConfigureBundleOverrides();
+
+}  // namespace openarc
+
+#endif  // OPENARC_COMMON_OPENARC_PATHS_H_
diff --git a/openarc/common/openarc_paths.mm b/openarc/common/openarc_paths.mm
new file mode 100644
index 000000000000..03f25020339d
--- /dev/null
+++ b/openarc/common/openarc_paths.mm
@@ -0,0 +1,60 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/common/openarc_paths.h"
+
+#import <Foundation/Foundation.h>
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdlib.h>
+
+#include "base/apple/bundle_locations.h"
+#include "base/apple/foundation_util.h"
+#include "base/check.h"
+
+namespace openarc {
+
+namespace {
+
+// Base bundle id of every engine process (the app's placeholder id, CLAUDE.md,
+// decision Q5). Mach rendezvous names derive from it, so the browser process
+// and its unbundled helpers must agree on it whatever the host process is (the
+// app, openarc_shell_test, xctest). Change it together with the app's id.
+constexpr char kBaseBundleID[] = "org.openarc.browser";
+
+}  // namespace
+
+base::FilePath GetFrameworkVersionDirectory() {
+  Dl_info info;
+  CHECK(dladdr(reinterpret_cast<const void*>(&GetFrameworkVersionDirectory),
+               &info));
+  // dli_fname is the path the library was loaded from; resolve symlinks
+  // (Versions/Current, a symlinked app location) so the sandbox sees the same
+  // path it is given.
+  char resolved[PATH_MAX];
+  const char* path = realpath(info.dli_fname, resolved) ? resolved
+                                                        : info.dli_fname;
+  return base::FilePath(path).DirName();
+}
+
+base::FilePath GetResourcesPakPath() {
+  return GetFrameworkVersionDirectory().Append("Resources").Append(
+      "openarc.pak");
+}
+
+base::FilePath GetHelperExecutablePath() {
+  return GetFrameworkVersionDirectory().Append("Helpers").Append(
+      "openarc_helper");
+}
+
+void ConfigureBundleOverrides() {
+  // icudtl.dat and v8_context_snapshot.*.bin are looked up as resources of the
+  // "framework bundle"; Versions/A works as that NSBundle (Chrome uses its
+  // framework's versioned directory the same way).
+  base::apple::SetOverrideFrameworkBundlePath(GetFrameworkVersionDirectory());
+
+  base::apple::SetBaseBundleIDOverride(kBaseBundleID);
+}
+
+}  // namespace openarc
diff --git a/openarc/shell_test/openarc_shell_test_main.mm b/openarc/shell_test/openarc_shell_test_main.mm
new file mode 100644
index 000000000000..ce92f34380bb
--- /dev/null
+++ b/openarc/shell_test/openarc_shell_test_main.mm
@@ -0,0 +1,205 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// openarc_shell_test: the bring-up host for OpenArcCore (plan C6), our
+// equivalent of content_shell. It uses only the public Objective-C API, the
+// way the Swift shell will (chromium-bridge/README.md, Startup sequence):
+//
+//   1. NSApplication is OACBrowserApplication (the app's principal class).
+//   2. applicationWillFinishLaunching: starts the engine.
+//   3. One profile, one tab, the tab's view hosted in a bare NSWindow.
+//   4. The URL comes from the command line (default about:blank).
+//
+// Usage: openarc_shell_test [--user-data-dir=PATH] [--quit-after-load]
+//                           [chromium switches] [URL]
+//
+// --quit-after-load quits through NSApp terminate (the normal ⌘Q path,
+// including OACApplication's shutdown) 2 s after the first navigation
+// finishes, for unattended runs.
+
+#import <AppKit/AppKit.h>
+#import <OpenArcCore/OpenArcCore.h>
+
+@interface OASTAppDelegate : NSObject <NSApplicationDelegate, OACTabDelegate>
+@end
+
+@implementation OASTAppDelegate {
+  NSURL* _url;
+  NSURL* _userDataDirectory;
+  BOOL _quitAfterLoad;
+  NSWindow* _window;
+  OACTab* _tab;
+}
+
+- (instancetype)init {
+  if ((self = [super init])) {
+    NSString* urlString = @"about:blank";
+    for (NSString* argument in NSProcessInfo.processInfo.arguments) {
+      if ([argument isEqualToString:@"--quit-after-load"]) {
+        _quitAfterLoad = YES;
+      } else if ([argument hasPrefix:@"--user-data-dir="]) {
+        _userDataDirectory = [NSURL
+            fileURLWithPath:[argument substringFromIndex:16]
+                isDirectory:YES];
+      } else if (![argument hasPrefix:@"-"] &&
+                 argument != NSProcessInfo.processInfo.arguments[0]) {
+        urlString = argument;
+      }
+    }
+    _url = [NSURL URLWithString:urlString];
+    if (!_userDataDirectory) {
+      _userDataDirectory = [NSURL
+          fileURLWithPath:[NSTemporaryDirectory()
+                              stringByAppendingPathComponent:
+                                  @"openarc_shell_test"]
+              isDirectory:YES];
+    }
+  }
+  return self;
+}
+
+- (void)applicationWillFinishLaunching:(NSNotification*)notification {
+  OACApplicationConfiguration* configuration =
+      [[OACApplicationConfiguration alloc]
+          initWithUserDataDirectory:_userDataDirectory];
+  NSError* error = nil;
+  if (![OACApplication.sharedApplication startWithConfiguration:configuration
+                                                          error:&error]) {
+    NSLog(@"openarc_shell_test: engine start failed: %@", error);
+    exit(1);
+  }
+  NSLog(@"openarc_shell_test: engine started, Chromium %@",
+        OACApplication.sharedApplication.chromiumVersion);
+}
+
+- (void)applicationDidFinishLaunching:(NSNotification*)notification {
+  [self buildMenu];
+  _window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 1024, 768)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskResizable |
+                          NSWindowStyleMaskMiniaturizable
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  _window.title = @"openarc_shell_test";
+  _window.releasedWhenClosed = NO;
+  [_window center];
+
+  // A fixed identifier, standing in for a model Profile.id.
+  NSUUID* profileID =
+      [[NSUUID alloc] initWithUUIDString:@"00000000-0000-4000-8000-0000000000C6"];
+  [OACApplication.sharedApplication
+      loadProfileWithIdentifier:profileID
+              completionHandler:^(OACProfile* profile, NSError* error) {
+                if (!profile) {
+                  NSLog(@"openarc_shell_test: profile failed: %@", error);
+                  [NSApp terminate:nil];
+                  return;
+                }
+                NSLog(@"openarc_shell_test: profile loaded at %@",
+                      profile.dataDirectory.path);
+                [self openTabInProfile:profile];
+              }];
+}
+
+- (void)openTabInProfile:(OACProfile*)profile {
+  OACTabConfiguration* configuration =
+      [[OACTabConfiguration alloc] initWithProfile:profile];
+  configuration.initialURL = _url;
+  configuration.startsHidden = NO;
+  configuration.initialSize = _window.contentView.bounds.size;
+  NSError* error = nil;
+  _tab = [OACTab tabWithConfiguration:configuration error:&error];
+  if (!_tab) {
+    NSLog(@"openarc_shell_test: tab failed: %@", error);
+    [NSApp terminate:nil];
+    return;
+  }
+  _tab.delegate = self;
+  NSView* view = _tab.nativeView;
+  view.frame = _window.contentView.bounds;
+  view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [_window.contentView addSubview:view];
+  [_tab setVisible:YES];
+  [_window makeKeyAndOrderFront:nil];
+  [NSApp activateIgnoringOtherApps:YES];
+  [_tab setFocused:YES];
+  NSLog(@"openarc_shell_test: tab %@ loading %@", _tab.identifier, _url);
+}
+
+- (void)buildMenu {
+  NSMenu* mainMenu = [[NSMenu alloc] init];
+  NSMenuItem* appItem = [[NSMenuItem alloc] init];
+  NSMenu* appMenu = [[NSMenu alloc] init];
+  [appMenu addItemWithTitle:@"Quit openarc_shell_test"
+                     action:@selector(terminate:)
+              keyEquivalent:@"q"];
+  appItem.submenu = appMenu;
+  [mainMenu addItem:appItem];
+  NSApp.mainMenu = mainMenu;
+}
+
+- (BOOL)applicationShouldTerminateAfterLastWindowClosed:(NSApplication*)app {
+  return YES;
+}
+
+- (NSApplicationTerminateReply)applicationShouldTerminate:
+    (NSApplication*)sender {
+  if (OACApplication.sharedApplication.state != OACApplicationStateRunning) {
+    return NSTerminateNow;
+  }
+  _tab = nil;
+  [OACApplication.sharedApplication shutdownWithCompletionHandler:^{
+    NSLog(@"openarc_shell_test: engine shut down");
+    [NSApp replyToApplicationShouldTerminate:YES];
+  }];
+  return NSTerminateLater;
+}
+
+// MARK: OACTabDelegate
+
+- (void)tab:(OACTab*)tab didChangeTitle:(NSString*)title {
+  _window.title = title.length ? title : @"openarc_shell_test";
+}
+
+- (void)tab:(OACTab*)tab didChangeURL:(NSURL*)url {
+  NSLog(@"openarc_shell_test: URL %@", url);
+}
+
+- (void)tab:(OACTab*)tab didFinishNavigation:(OACNavigation*)navigation {
+  NSLog(@"openarc_shell_test: navigation finished %@ status=%ld error=%@",
+        navigation.URL, (long)navigation.HTTPStatusCode, navigation.error);
+  if (_quitAfterLoad) {
+    _quitAfterLoad = NO;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC),
+                   dispatch_get_main_queue(), ^{
+                     NSLog(@"openarc_shell_test: quitting (--quit-after-load)");
+                     [NSApp terminate:nil];
+                   });
+  }
+}
+
+- (void)tab:(OACTab*)tab
+    renderProcessDidTerminate:(OACRenderProcessTermination)reason {
+  NSLog(@"openarc_shell_test: renderer terminated, reason %ld", (long)reason);
+}
+
+- (void)tabDidRequestClose:(OACTab*)tab {
+  [tab close];
+  [_window close];
+}
+
+@end
+
+int main(int argc, const char** argv) {
+  @autoreleasepool {
+    // What Info.plist's NSPrincipalClass does for the real app.
+    [OACBrowserApplication sharedApplication];
+    OASTAppDelegate* delegate = [[OASTAppDelegate alloc] init];
+    NSApp.delegate = delegate;
+    NSApp.activationPolicy = NSApplicationActivationPolicyRegular;
+    [NSApp run];
+  }
+  return 0;
+}
