+++ b/openarc/bridge/public/OpenArcCore/OACSiteSettings.h
@@ -0,0 +1,106 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACSiteSettings: per-site settings of one profile.
+//
+// Maps to: `SiteSettingsProvider` in app/Sources/OpenArcShell/SiteControls/SiteSettingsProvider.swift
+// (the Site Control Center popover, [06 §12] observed rows). Method by method:
+//   settings(for:profileID:)              -> -settingsForOrigin:completionHandler:
+//   apply(.permission(kind, decision))    -> -setDecision:forPermission:origin:
+//   apply(.developerMode)                 -> -setDeveloperModeEnabled:forOrigin:
+//   apply(.automaticPictureInPicture)     -> -setAutomaticPictureInPictureAllowed:forOrigin:
+//   apply(.zoom(percent:))                -> -setZoomFactor:forOrigin:
+//   apply(.adBlocking)                    -> -setAdBlockingEnabled:forOrigin:  (plan C16)
+//   apply(.clearSiteData)                 -> -clearDataForOrigin:completionHandler:
+//   runExtensionAction(...)               -> -[OACExtensions runActionOfExtension:onTab:] (C14)
+// `profileID` in the Swift protocol picks the `OACProfile`, whose `siteSettings` this is.
+// An off-the-record profile has its own settings, which start from its original's (Chromium's
+// incognito inheritance rules, e.g. "block" is inherited, "allow" is not for most permissions).
+//
+// The Chromium side: `HostContentSettingsMap` and the permission manager (decisions),
+// `HostZoomMap` (zoom), the cookie manager (cookie count), `BrowsingDataRemover` (clear),
+// Picture in Picture's auto-enter content setting. "Developer Mode" is not a Chromium concept: it
+// is stored as our own per-origin content setting (website setting registered by the bridge) whose
+// meaning is decided by the shell. unknown: the spec records the row and its default, not what it
+// does.
+
+#import <OpenArcCore/OACDefines.h>
+#import <OpenArcCore/OACDialogDelegate.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class OACProfile;
+
+/// A stored permission decision. Maps to `SitePermissionDecision` (`.ask` = no stored decision).
+typedef NS_ENUM(NSInteger, OACPermissionDecision) {
+    OACPermissionDecisionAsk = 0,
+    OACPermissionDecisionAllow = 1,
+    OACPermissionDecisionBlock = 2,
+};
+
+/// Everything the Site Control Center shows for one site. Maps to `SiteSettingsState`.
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACSiteSettingsState : NSObject <NSCopying>
+/// Stored decisions keyed by `OACPermissionKind` (NSNumber); kinds without a decision are absent
+/// (`SiteSettingsState.permissions`).
+@property (nonatomic, readonly, copy) NSDictionary<NSNumber *, NSNumber *> *permissionDecisions NS_REFINED_FOR_SWIFT;
+/// `isDeveloperModeOn`; default NO ([06 §12] observed "Off").
+@property (nonatomic, readonly, getter=isDeveloperModeEnabled) BOOL developerModeEnabled;
+/// `isAutomaticPictureInPictureAllowed`; default YES ([06 §12] observed "Allowed").
+@property (nonatomic, readonly, getter=isAutomaticPictureInPictureAllowed) BOOL automaticPictureInPictureAllowed;
+/// Zoom factor for the site; 1.0 = default. `zoomPercent` = round(factor × 100).
+@property (nonatomic, readonly) double zoomFactor;
+/// Cookies stored for the site and its subdomains (`cookieCount`).
+@property (nonatomic, readonly) NSInteger cookieCount;
+/// nil while the engine has no ad blocker (`isAdBlockingOn`, plan C16).
+@property (nonatomic, readonly, copy, nullable) NSNumber *adBlockingEnabled;
+
+- (OACPermissionDecision)decisionForPermission:(OACPermissionKind)kind NS_SWIFT_NAME(decision(for:));
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+@class OACSiteSettings;
+
+/// Stored settings changed (another tab's prompt answered, settings page, sync of Chromium
+/// prefs). The Site Control Center refreshes if it shows `origin`. nil origin: many sites changed.
+NS_SWIFT_UI_ACTOR
+@protocol OACSiteSettingsObserver <NSObject>
+- (void)siteSettings:(OACSiteSettings *)siteSettings didChangeForOrigin:(nullable OACOrigin *)origin;
+@end
+
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACSiteSettings : NSObject
+
+/// The owning profile. Weak: the profile owns this object.
+@property (nonatomic, readonly, weak, nullable) OACProfile *profile;
+
+/// Reads the state. Async because the cookie count lives in the network service.
+- (void)settingsForOrigin:(OACOrigin *)origin
+        completionHandler:(void (^)(OACSiteSettingsState *state))completionHandler
+    NS_SWIFT_NAME(settings(for:completionHandler:));
+
+- (void)setDecision:(OACPermissionDecision)decision forPermission:(OACPermissionKind)kind origin:(OACOrigin *)origin
+    NS_SWIFT_NAME(setDecision(_:for:origin:));
+- (void)setDeveloperModeEnabled:(BOOL)enabled forOrigin:(OACOrigin *)origin;
+- (void)setAutomaticPictureInPictureAllowed:(BOOL)allowed forOrigin:(OACOrigin *)origin;
+/// Stores the zoom for the origin's host; open tabs on it follow. 1.0 removes the entry.
+- (BOOL)setZoomFactor:(double)zoomFactor forOrigin:(OACOrigin *)origin error:(NSError **)error;
+/// Plan C16. Fails silently (no-op) while the engine has no ad blocker.
+- (void)setAdBlockingEnabled:(BOOL)enabled forOrigin:(OACOrigin *)origin;
+/// Removes cookies, storage, cache and stored permissions of the origin's site (eTLD+1).
+- (void)clearDataForOrigin:(OACOrigin *)origin completionHandler:(void (^)(void))completionHandler;
+
+/// Origins with any stored setting, for a future "all sites" list. inferred.
+- (void)originsWithStoredSettingsWithCompletionHandler:(void (^)(NSArray<OACOrigin *> *origins))completionHandler;
+
+/// Observers are held weakly.
+- (void)addObserver:(id<OACSiteSettingsObserver>)observer;
+- (void)removeObserver:(id<OACSiteSettingsObserver>)observer;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACTab.h b/openarc/bridge/public/OpenArcCore/OACTab.h
new file mode 100644
index 000000000000..8910539e3041
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACTab.h
@@ -0,0 +1,306 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACTab: one live web contents.
+//
+// Maps to: `BrowserTab` and its `TabSurface` (app/Sources/OpenArcEngine/BrowserEngine.swift,
+// Surface.swift); `OACTabConfiguration` maps to `TabConfiguration`; `OACTabState` maps to
+// `BrowserTabState`. The Chromium side wraps one `content::WebContents` plus the tab helpers
+// `//chrome` attaches to a tab (favicon driver, find, zoom, permissions, password manager,
+// autofill, extensions, content settings), created the way Chrome creates a tab but with no
+// `Browser` or `TabStripModel` (README §Keeping //chrome without its UI).
+// Plan tasks: C8 (create, navigate, host the view), C9 (events), C12 (dialogs), C15 (DevTools,
+// view source, print, Picture in Picture), C17 (page top color).
+//
+// Ownership (README §Ownership): `OACTab` owns its WebContents. The tab is alive from creation
+// until `-close` (or an `OACTabDelegate` close request that the shell accepts by calling
+// `-close`). After `-close`, `isClosed` is YES, `nativeView` is nil, commands fail with
+// `OACErrorTabClosed`, and the delegate gets `tabDidClose:` exactly once. Releasing the last
+// reference to an open tab closes it too (the bridge never keeps a tab alive on its own), so the
+// Swift wrapper (`OpenArcChromium`) holds a strong reference per live `EngineTabID` and drops it in
+// `closeTab`.
+//
+// Event model: the bridge calls `OACTabDelegate` (OACTabDelegate.h) on the main thread; the Swift
+// wrapper turns each call into a `TabEvent` on the tab's `AsyncBroadcaster`, with
+// `.snapshot(currentState)` built from `-state` as the first element of every new stream.
+
+#import <OpenArcCore/OACDefines.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class NSView;
+@class OACProfile;
+@class OACTab;
+@class OACTabState;
+@class OACFindOptions;
+@protocol OACTabDelegate;
+@protocol OACDialogDelegate;
+
+// MARK: - Configuration
+
+/// The color scheme a page sees through `prefers-color-scheme`. Maps to `WebColorScheme`
+/// (app/Sources/OpenArcEngine/BrowserEngine.swift; B21, [04 §dark mode] observed).
+typedef NS_ENUM(NSInteger, OACColorScheme) {
+    OACColorSchemeLight = 0,
+    OACColorSchemeDark = 1,
+};
+
+/// Parameters for creating a tab. Maps to `TabConfiguration`.
+OAC_EXPORT
+@interface OACTabConfiguration : NSObject <NSCopying>
+
+/// The browsing context. Pass `profile.offTheRecordProfile` for `TabConfiguration.isOffTheRecord`.
+@property (nonatomic, strong) OACProfile *profile;
+
+/// Loaded right away. nil: a blank page (about:blank, no history entry).
+@property (nonatomic, copy, nullable) NSURL *initialURL;
+
+/// The tab that opened this one (`TabConfiguration.opener`). Gives the new page `window.opener`
+/// and the opener's session storage when `request` came from that opener.
+@property (nonatomic, weak, nullable) OACTab *opener;
+
+/// Requested identifier (`TabConfiguration.requestedID`, an `EngineTabID`). nil lets the bridge
+/// choose. A live duplicate fails with `OACErrorDuplicateTabIdentifier`.
+@property (nonatomic, copy, nullable) NSUUID *requestedIdentifier;
+
+/// Created hidden: the renderer runs at background priority and paints nothing until the tab is
+/// shown (`-setVisible:`). Default YES; tabs created for the selected tab pass NO.
+@property (nonatomic) BOOL startsHidden;
+
+/// Initial view size in points, so the first layout matches the web panel. Zero: 800×600.
+@property (nonatomic) CGSize initialSize;
+
+/// Color scheme the page sees from its first load (`TabConfiguration.preferredColorScheme`).
+/// Default light.
+@property (nonatomic) OACColorScheme preferredColorScheme;
+
+- (instancetype)initWithProfile:(OACProfile *)profile NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+// MARK: - State snapshot
+
+/// Audio state. Maps to `AudioState`.
+typedef NS_OPTIONS(NSUInteger, OACAudioState) {
+    /// The page is producing sound (regardless of mute).
+    OACAudioStateAudible = 1 << 0,
+    /// The tab is muted (`-setMuted:`).
+    OACAudioStateMuted = 1 << 1,
+};
+
+/// Media capture in progress, for the sidebar's recording indicators. Proposed in
+/// SWIFT_PROTOCOL_CHANGES.md §6 (no `BrowserTabState` field yet). inferred: the spec records no
+/// indicator.
+typedef NS_OPTIONS(NSUInteger, OACCaptureState) {
+    OACCaptureStateCamera = 1 << 0,
+    OACCaptureStateMicrophone = 1 << 1,
+    OACCaptureStateScreen = 1 << 2,
+};
+
+/// Immutable snapshot of a tab's observable state. Maps to `BrowserTabState`; the fields that
+/// `BrowserTabState` lacks are listed in SWIFT_PROTOCOL_CHANGES.md §6.
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACTabState : NSObject <NSCopying>
+
+/// Visible URL (`BrowserTabState.url`): the pending URL during a browser-initiated navigation, the
+/// committed one otherwise (Chromium's "visible URL" rule, which keeps the address safe from
+/// spoofing). nil for a blank tab.
+@property (nonatomic, readonly, copy, nullable) NSURL *URL;
+/// Last committed URL, for the "Copy URL" family of commands ([01 §Edit] observed items).
+@property (nonatomic, readonly, copy, nullable) NSURL *committedURL;
+/// Page title; empty when the page has none (`BrowserTabState.title`).
+@property (nonatomic, readonly, copy) NSString *title;
+
+/// `LoadState.isLoading`.
+@property (nonatomic, readonly, getter=isLoading) BOOL loading;
+/// `LoadState.progress`, 0...1.
+@property (nonatomic, readonly) double loadProgress;
+
+/// `Favicon.url`.
+@property (nonatomic, readonly, copy, nullable) NSURL *faviconURL;
+/// `Favicon.pngData`: the decoded icon at the size the bridge picked (32 px), as PNG.
+@property (nonatomic, readonly, copy, nullable) NSData *faviconPNGData;
+
+/// `NavigationState`.
+@property (nonatomic, readonly) BOOL canGoBack;
+@property (nonatomic, readonly) BOOL canGoForward;
+
+/// `BrowserTabState.isCrashed`: the renderer died and the page was not reloaded since.
+@property (nonatomic, readonly, getter=isCrashed) BOOL crashed;
+
+/// `BrowserTabState.audio`.
+@property (nonatomic, readonly) OACAudioState audioState;
+
+// Fields with no `BrowserTabState` counterpart yet (SWIFT_PROTOCOL_CHANGES.md §6).
+
+/// Security of the visible entry (Site Control Center "Secure" pill).
+@property (nonatomic, readonly) OACSecurityLevel securityLevel;
+/// Page zoom as a factor (1.0 = 100 %). See `-setZoomFactor:`.
+@property (nonatomic, readonly) double zoomFactor;
+/// Camera, microphone or screen capture in use.
+@property (nonatomic, readonly) OACCaptureState captureState;
+/// The page is in HTML fullscreen (element.requestFullscreen).
+@property (nonatomic, readonly, getter=isFullscreen) BOOL fullscreen;
+/// The page's `<meta name="theme-color">`, if any (plan C17).
+@property (nonatomic, readonly) BOOL hasThemeColor;
+@property (nonatomic, readonly) OACColor themeColor;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+// MARK: - Find in page
+
+/// Options for `-findString:options:`. Edit ▸ Find ▸ Find… / Find Next / Find Previous /
+/// Use Selection to Find ([01 §Edit] observed items; the find bar look is not in the spec).
+OAC_EXPORT
+@interface OACFindOptions : NSObject <NSCopying>
+/// Search backwards (Find Previous).
+@property (nonatomic) BOOL backwards;
+/// Case sensitive. Default NO.
+@property (nonatomic) BOOL matchCase;
+/// YES: continue from the current match (Find Next / Previous); NO: a new search.
+@property (nonatomic) BOOL findNext;
+@end
+
+// MARK: - Tab
+
+/// One live web contents.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACTab : NSObject
+
+/// Creates a tab. On success the tab exists right away and starts loading `initialURL`; the
+/// delegate (set right after) gets the first callbacks from the next main-thread task, so no event
+/// is lost. Fails with `OACErrorProfileUnavailable`, `OACErrorDuplicateTabIdentifier`,
+/// `OACErrorInvalidURL` or `OACErrorNotStarted`. Maps to `BrowserEngine.makeTab`.
++ (nullable instancetype)tabWithConfiguration:(OACTabConfiguration *)configuration error:(NSError **)error
+    NS_SWIFT_NAME(init(configuration:));
+
+/// The live tab with this identifier, if any. Maps to `BrowserEngine.tab(for:)`.
++ (nullable OACTab *)tabWithIdentifier:(NSUUID *)identifier NS_SWIFT_NAME(tab(identifier:));
+
+/// `EngineTabID.rawValue`.
+@property (nonatomic, readonly, copy) NSUUID *identifier;
+/// The browsing context (`BrowserTab.profileID` is `profile.identifier`).
+@property (nonatomic, readonly) OACProfile *profile;
+
+/// Navigation, loading and page events. Weak.
+@property (nonatomic, weak, nullable) id<OACTabDelegate> delegate;
+/// Shell-drawn dialogs (plan C12). Weak. With no dialog delegate, every request gets its default
+/// answer (alerts dismissed, permissions denied, auth cancelled) so a page never hangs.
+@property (nonatomic, weak, nullable) id<OACDialogDelegate> dialogDelegate;
+
+/// Current state (`BrowserTab.currentState`). A new snapshot object after every change.
+@property (nonatomic, readonly, copy) OACTabState *state;
+
+@property (nonatomic, readonly, getter=isClosed) BOOL closed;
+
+// MARK: Navigation (`BrowserTab.load / goBack / goForward / reload / stopLoading`)
+
+/// Loads a URL as if typed (page transition "typed"). Returns NO with `OACErrorInvalidURL` for an
+/// invalid URL or a refused scheme (javascript:), `OACErrorTabClosed` after `-close`.
+- (BOOL)loadURL:(NSURL *)url error:(NSError **)error;
+/// No-op returning YES when there is nothing to go back to (the shell disables the button from
+/// `canGoBack`).
+- (BOOL)goBackWithError:(NSError **)error;
+- (BOOL)goForwardWithError:(NSError **)error;
+/// Reload. `bypassingCache`: View ▸ Force Refresh the Page ([01 §View] observed item).
+- (BOOL)reloadBypassingCache:(BOOL)bypassingCache error:(NSError **)error NS_SWIFT_NAME(reload(bypassingCache:));
+- (BOOL)stopLoadingWithError:(NSError **)error;
+
+// MARK: Audio (`BrowserTab.setMuted`)
+
+- (void)setMuted:(BOOL)muted;
+
+// MARK: Appearance (`BrowserTab.setPreferredColorScheme`)
+
+/// The color scheme the page sees (`prefers-color-scheme`, and the default colors of pages without
+/// their own). Setting it updates the page live; setting the current value does nothing.
+@property (nonatomic) OACColorScheme preferredColorScheme;
+
+// MARK: View hosting (`TabSurface`)
+
+/// The view that shows the page. The shell's `SurfaceHost` adds it as a subview and sizes it;
+/// the bridge never moves it between superviews itself. A view is in at most one superview at a
+/// time, which matches "a surface is in at most one host" in Surface.swift. nil after `-close`.
+@property (nonatomic, readonly, nullable) NSView *nativeView;
+
+/// Visibility, which drives renderer priority, painting and `document.visibilityState`.
+/// `SurfaceHost` attach makes the tab visible, detach makes it hidden. Occlusion by other windows
+/// is detected by Chromium itself.
+- (void)setVisible:(BOOL)visible;
+
+/// Keyboard focus into the page (`TabSurface.setFocused`): makes the view first responder of its
+/// window and focuses the page's focused element.
+- (void)setFocused:(BOOL)focused;
+
+// MARK: Snapshot (`BrowserTab.snapshot`)
+
+/// Copies the last painted frame, scaled so the longer side is at most `maxPixelSize`, as PNG.
+/// Fails with `OACErrorSnapshotUnavailable` for a hidden tab without a cached frame or a crashed
+/// renderer. The handler runs on the main thread.
+- (void)snapshotWithMaxPixelSize:(NSInteger)maxPixelSize
+               completionHandler:(void (^)(NSData *_Nullable pngData, CGSize pixelSize, NSError *_Nullable error))completionHandler
+    NS_SWIFT_NAME(snapshot(maxPixelSize:completionHandler:));
+
+// MARK: Zoom (View ▸ Zoom to Actual Size / Zoom In / Zoom Out, [01 §View] observed items)
+
+/// Sets the page zoom; Chromium stores it per host in the profile's zoom map, so other tabs on
+/// the same site follow (the Site Control Center reads it as `SiteSettingsState.zoomPercent`).
+/// Valid range 0.25...5.0; others fail with `OACErrorInvalidArgument`.
+- (BOOL)setZoomFactor:(double)zoomFactor error:(NSError **)error;
+/// Next preset level up (Chromium's preset list), down, or back to the default.
+- (void)zoomIn;
+- (void)zoomOut;
+- (void)resetZoom;
+
+// MARK: Find in page (plan C12; results via `-[OACTabDelegate tab:didUpdateFindResult:...]`)
+
+/// Starts or continues a search. Returns a request id that the matching results carry; an empty
+/// string stops the search like `-stopFinding...`.
+- (NSInteger)findString:(NSString *)string options:(OACFindOptions *)options NS_SWIFT_NAME(find(_:options:));
+/// Ends find-in-page. `keepSelection` leaves the active match selected (Jump to Selection).
+- (void)stopFindingKeepingSelection:(BOOL)keepSelection NS_SWIFT_NAME(stopFinding(keepingSelection:));
+/// The current selection, for Edit ▸ Find ▸ Use Selection to Find. Async (lives in the renderer).
+- (void)selectedTextWithCompletionHandler:(void (^)(NSString *text))completionHandler;
+
+// MARK: Editing and page commands
+
+/// Edit menu commands on the focused frame (Undo, Redo, Cut, Copy, Paste, Paste and Match Style,
+/// Delete, Select All; [01 §Edit] observed items). The responder chain reaches the web view
+/// already; these exist for the command bar, which is not in the responder chain.
+- (void)performEditCommand:(NSString *)command NS_SWIFT_NAME(performEditCommand(_:));
+
+/// File ▸ Print ([01 §File] observed item); Chromium's print preview is replaced by the macOS
+/// print panel (plan C15).
+- (void)print;
+
+/// File ▸ Save Page As ([01 §File] observed item): saves the page as a web archive or HTML.
+- (void)savePageToURL:(NSURL *)url completionHandler:(void (^)(NSError *_Nullable error))completionHandler;
+
+/// View ▸ Developer ▸ Developer Tools / Inspect Elements / JavaScript Console / Network Inspector
+/// ([01 §View] observed items, plan C15). DevTools opens in its own window owned by the bridge;
+/// docking into the web panel is a later decision.
+- (void)showDevToolsWithPanel:(nullable NSString *)panel NS_SWIFT_NAME(showDevTools(panel:));
+/// View ▸ Developer ▸ View Source: asks the delegate for a new tab with `view-source:` +URL.
+- (void)viewSource;
+
+/// Leaves HTML fullscreen (Escape is handled by the page view itself).
+- (void)exitFullscreen;
+
+// MARK: Lifetime (`BrowserEngine.closeTab`)
+
+/// Closes the tab immediately, without beforeunload handlers. Idempotent.
+- (void)close;
+
+/// Runs the page's beforeunload handler first; the delegate's `tabDidRequestClose:` then fires if
+/// the page agreed (or the user confirmed the leave-page dialog). For the user's ⌘W.
+- (void)closeRunningUnloadHandlers;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/openarc/bridge/public/OpenArcCore/OACTabDelegate.h b/openarc/bridge/public/OpenArcCore/OACTabDelegate.h
new file mode 100644
index 000000000000..e8bb8e7f45f5
--- /dev/null
+++ b/openarc/bridge/public/OpenArcCore/OACTabDelegate.h
@@ -0,0 +1,191 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACTabDelegate: navigation, loading and page events of one tab.
+//
+// Maps to: `TabEvent` (one callback per case) and the tab-originated `EngineEvent`s
+// (`newTabRequested`, `tabClosed`) in app/Sources/OpenArcEngine/BrowserEngine.swift. Plan task C9.
+// The Chromium side is a `content::WebContentsObserver` (URL, title, load, navigation, audio,
+// crash) plus a `content::WebContentsDelegate` (new tabs, close requests, fullscreen) plus the
+// favicon driver observer, all owned by the `OACTab`.
+//
+// Delivery rules (README §Threading):
+// - On the main thread, from a posted task, in the order Chromium produced the changes.
+// - Coalesced per run loop turn where Chromium may fire many times (load progress, title).
+// - A callback carries the new value and the tab's `state` already reflects it.
+// - After `tabDidClose:` nothing else is delivered for that tab.
+//
+// Swift wrapper mapping (`OpenArcChromium`, plan C8/C9):
+//   tab:didChangeURL:                     -> TabEvent.urlChanged
+//   tab:didChangeTitle:                   -> TabEvent.titleChanged
+//   tab:didChangeLoading:progress:        -> TabEvent.loadStateChanged
+//   tab:didChangeFaviconURL:pngData:      -> TabEvent.faviconChanged
+//   tab:didChangeCanGoBack:canGoForward:  -> TabEvent.navigationStateChanged
+//   tab:didChangeAudioState:              -> TabEvent.audioStateChanged
+//   tab:renderProcessDidTerminate:        -> TabEvent.renderProcessGone
+//   tabDidClose:                          -> TabEvent.closed + EngineEvent.tabClosed
+//   tab:didRequestNewTab:                 -> EngineEvent.newTabRequested
+//   everything else                       -> proposed events, SWIFT_PROTOCOL_CHANGES.md
+
+#import <OpenArcCore/OACDefines.h>
+#import <OpenArcCore/OACTab.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// How the page asked for a new tab. Maps to `NewTabDisposition`; Chromium's
+/// `WindowOpenDisposition` is folded into these four (current-tab navigations never reach the
+/// delegate, they just navigate).
+typedef NS_ENUM(NSInteger, OACNewTabDisposition) {
+    /// `NewTabDisposition.foregroundTab` (target=_blank, ⌘⇧-click).
+    OACNewTabDispositionForegroundTab = 0,
+    /// `NewTabDisposition.backgroundTab` (⌘-click, middle click).
+    OACNewTabDispositionBackgroundTab = 1,
+    /// `NewTabDisposition.newWindow` (⇧-click, [06 §4] observed: a new window opened).
+    OACNewTabDispositionNewWindow = 2,
+    /// `NewTabDisposition.popup` (window.open with window features).
+    OACNewTabDispositionPopup = 3,
+};
+
+/// A request for a new tab. Maps to `NewTabRequest`.
+///
+/// Two flavors:
+/// - URL requests (link clicks with a disposition, `viewSource`, extension and app requests):
+///   `hasPendingContents` is NO. The shell creates a normal tab with `OACTab +tabWithConfiguration:`
+///   (with `opener` set) wherever it decides (`TreeOps.openTab` into Today, Little Arc, Peek).
+/// - Script-opened windows (`window.open`, target=_blank with opener): Chromium has already made
+///   the new WebContents, because the page holds a live `window` reference to it.
+///   `hasPendingContents` is YES and the shell must call `-adoptWithIdentifier:error:` (to keep
+///   it) or `-decline` within the same main-thread turn or soon after; an unanswered request is
+///   declined when the opener closes. This is the gap noted in SWIFT_PROTOCOL_CHANGES.md §1:
+///   `NewTabRequest` has no way to hand over an engine-created tab today.
+OAC_EXPORT NS_SWIFT_UI_ACTOR
+@interface OACNewTabRequest : NSObject
+
+/// The tab that asked; nil for requests from outside a tab (`OACApplicationDelegate`).
+@property (nonatomic, readonly, weak, nullable) OACTab *opener;
+/// The profile the new tab must use (the opener's; an incognito opener yields its OTR profile).
+@property (nonatomic, readonly) OACProfile *profile;
+@property (nonatomic, readonly, copy) NSURL *URL;
+@property (nonatomic, readonly) OACNewTabDisposition disposition;
+/// `NewTabRequest.hasUserGesture`. Popups without a gesture are already filtered by Chromium's
+/// popup blocker before they reach the delegate (blocked ones are reported through
+/// `-tab:didBlockPopupWithURL:`).
+@property (nonatomic, readonly) BOOL hasUserGesture;
+/// Requested popup frame in screen points from `window.open` features; `CGRectNull` if none.
+@property (nonatomic, readonly) CGRect requestedFrame;
+
+/// See the class comment.
+@property (nonatomic, readonly) BOOL hasPendingContents;
+
+/// Keeps the engine-created contents as a new live tab with this identifier. Only valid when
+/// `hasPendingContents` is YES and the request was not answered yet; else returns nil with
+/// `OACErrorRequestFinished`.
+- (nullable OACTab *)adoptWithIdentifier:(nullable NSUUID *)identifier error:(NSError **)error NS_SWIFT_NAME(adopt(identifier:));
+/// Discards the request (and the pending contents, if any). Idempotent.
+- (void)decline;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+/// Why a renderer process ended. Maps to `TabEvent.renderProcessGone` (which carries no reason;
+/// see SWIFT_PROTOCOL_CHANGES.md §7).
+typedef NS_ENUM(NSInteger, OACRenderProcessTermination) {
+    OACRenderProcessTerminationCrashed = 0,
+    OACRenderProcessTerminationKilled = 1,
+    OACRenderProcessTerminationOutOfMemory = 2,
+    OACRenderProcessTerminationLaunchFailed = 3,
+};
+
+/// A main-frame navigation that finished (committed or failed). For history and future engine
+/// tests; the shell only needs URL/title/load today.
+OAC_EXPORT NS_SWIFT_SENDABLE
+@interface OACNavigation : NSObject
+@property (nonatomic, readonly, copy) NSURL *URL;
+/// NO for same-document navigations (fragment, pushState).
+@property (nonatomic, readonly) BOOL isCrossDocument;
+/// Started by the page (link, script) rather than by the shell.
+@property (nonatomic, readonly) BOOL isRendererInitiated;
+/// nil when it committed; the net error otherwise (Chromium shows its own error page).
+@property (nonatomic, readonly, copy, nullable) NSError *error;
+/// HTTP status of the main resource; 0 when there was none.
+@property (nonatomic, readonly) NSInteger HTTPStatusCode;
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+@end
+
+/// Tab events, on the main thread. All optional.
+NS_SWIFT_UI_ACTOR
+@protocol OACTabDelegate <NSObject>
+@optional
+
+// MARK: State changes (C9; one `TabEvent` each)
+
+- (void)tab:(OACTab *)tab didChangeURL:(nullable NSURL *)url NS_SWIFT_NAME(tab(_:didChangeURL:));
+- (void)tab:(OACTab *)tab didChangeTitle:(NSString *)title;
+- (void)tab:(OACTab *)tab didChangeLoading:(BOOL)isLoading progress:(double)progress;
+- (void)tab:(OACTab *)tab didChangeFaviconURL:(nullable NSURL *)faviconURL pngData:(nullable NSData *)pngData;
+- (void)tab:(OACTab *)tab didChangeCanGoBack:(BOOL)canGoBack canGoForward:(BOOL)canGoForward;
+- (void)tab:(OACTab *)tab didChangeAudioState:(OACAudioState)audioState;
+- (void)tab:(OACTab *)tab renderProcessDidTerminate:(OACRenderProcessTermination)reason;
+
+/// The tab is closed (by `-close`, by the shell accepting a close request, or by engine shutdown).
+- (void)tabDidClose:(OACTab *)tab;
+
+// MARK: State changes without a `TabEvent` yet (SWIFT_PROTOCOL_CHANGES.md §6)
+
+- (void)tab:(OACTab *)tab didChangeSecurityLevel:(OACSecurityLevel)securityLevel;
+- (void)tab:(OACTab *)tab didChangeZoomFactor:(double)zoomFactor;
+- (void)tab:(OACTab *)tab didChangeCaptureState:(OACCaptureState)captureState;
+/// `<meta name="theme-color">` appeared, changed or went away (plan C17).
+- (void)tab:(OACTab *)tab didChangeThemeColor:(OACColor)color hasThemeColor:(BOOL)hasThemeColor;
+/// The page entered or left HTML fullscreen. The shell hides the sidebar and makes the window full
+/// screen (inferred; the spec records no page-fullscreen behavior).
+- (void)tab:(OACTab *)tab didChangeFullscreen:(BOOL)isFullscreen;
+- (void)tab:(OACTab *)tab didFinishNavigation:(OACNavigation *)navigation;
+
+// MARK: Requests (C9)
+
+/// The page (or Chromium, for `viewSource`) wants a new tab. See `OACNewTabRequest`.
+/// Maps to `EngineEvent.newTabRequested`.
+- (void)tab:(OACTab *)tab didRequestNewTab:(OACNewTabRequest *)request;
+
+/// A popup was blocked; the shell may offer to open it. inferred: no spec surface.
+- (void)tab:(OACTab *)tab didBlockPopupWithURL:(NSURL *)url;
+
+/// The page asked to close itself (`window.close()` on a script-opened tab, or the user's
+/// `-closeRunningUnloadHandlers` passed beforeunload). The tab stays open until the shell calls
+/// `-close`: the shell archives or removes the model tab through `TreeOps` first. Proposed event
+/// `TabEvent.closeRequested` (SWIFT_PROTOCOL_CHANGES.md §2).
+- (void)tabDidRequestClose:(OACTab *)tab;
+
+/// The page wants focus (window.focus()); the shell may select the tab. inferred.
+- (void)tabDidRequestActivation:(OACTab *)tab;
+
+/// Hovered link changed (status bubble at the bottom of the web panel, inferred; nil when the
+/// pointer leaves the link).
+- (void)tab:(OACTab *)tab didHoverLinkURL:(nullable NSURL *)url;
+
+/// A keyboard event the page did not consume. The shell returns YES when it handled it (so the
+/// app's shortcuts such as ⌘T, ⌘L, ⌘S keep working while the page has focus). The event is the
+/// `NSEvent`, typed `id` so this header stays free of AppKit.
+- (BOOL)tab:(OACTab *)tab handleUnhandledKeyEvent:(id)event;
+
+/// A context menu is about to show. The bridge draws Chromium's own menu items in an `NSMenu`;
+/// the shell may add items (Open Link in Split View, Open in Little Arc). inferred: the web page
+/// context menu is not in the spec. `menu` is the `NSMenu`, typed `id` for the same reason.
+- (void)tab:(OACTab *)tab willShowContextMenu:(id)menu forLinkURL:(nullable NSURL *)linkURL;
+
+// MARK: Find in page (C12)
+
+/// Results of `-findString:options:`. `isFinal` is YES once the whole page was searched.
+- (void)tab:(OACTab *)tab
+    didUpdateFindResultForRequest:(NSInteger)requestIdentifier
+                     numberOfMatches:(NSInteger)numberOfMatches
+                  activeMatchOrdinal:(NSInteger)activeMatchOrdinal
+                             isFinal:(BOOL)isFinal;
+
+@end
+
+NS_ASSUME_NONNULL_END
