+// Live tabs by identifier, for +tabWithIdentifier:. Weak values: the bridge
+// never keeps a tab alive on its own (README, Ownership).
+NSMapTable<NSUUID*, OACTab*>* LiveTabs() {
+  static NSMapTable<NSUUID*, OACTab*>* tabs =
+      [NSMapTable strongToWeakObjectsMapTable];
+  return tabs;
+}
+
+// Chromium's dispositions folded into OACNewTabDisposition (OACTabDelegate.h).
+OACNewTabDisposition DispositionFromChromium(
+    WindowOpenDisposition disposition) {
+  switch (disposition) {
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+      return OACNewTabDispositionBackgroundTab;
+    case WindowOpenDisposition::NEW_WINDOW:
+    case WindowOpenDisposition::OFF_THE_RECORD:
+      return OACNewTabDispositionNewWindow;
+    case WindowOpenDisposition::NEW_POPUP:
+      return OACNewTabDispositionPopup;
+    default:
+      return OACNewTabDispositionForegroundTab;
+  }
+}
+
+CGRect RequestedFrame(const blink::mojom::WindowFeatures& features) {
+  if (!features.has_width && !features.has_height && !features.has_x &&
+      !features.has_y) {
+    return CGRectNull;
+  }
+  return CGRectMake(features.bounds.x(), features.bounds.y(),
+                    features.bounds.width(), features.bounds.height());
+}
