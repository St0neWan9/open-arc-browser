+- (NSInteger)findString:(NSString*)string options:(OACFindOptions*)options {
+  if (_closed) {
+    return 0;
+  }
+  if (string.length == 0) {
+    [self stopFindingKeepingSelection:NO];
+    return 0;
+  }
+  auto find_options = blink::mojom::FindOptions::New();
+  find_options->forward = !options.backwards;
+  find_options->match_case = options.matchCase;
+  find_options->new_session = !options.findNext;
+  NSInteger request_id = 0;
+  _webContents->Find(base::SysNSStringToUTF16(string), std::move(find_options),
+                     /*skip_delay=*/true,
+                     [&](int id) { request_id = id; });
+  return request_id;
+}
