@@ -0,0 +1,96 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/app/openarc_main_delegate.h"
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/logging/logging_settings.h"
+#include "base/process/current_process.h"
+#include "base/task/current_thread.h"
+#include "content/public/browser/browser_main_runner.h"
+#include "content/public/common/content_switches.h"
+#include "content/public/common/main_function_params.h"
+#include "openarc/browser/openarc_content_browser_client.h"
+#include "openarc/common/openarc_content_client.h"
+#include "openarc/common/openarc_paths.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace openarc {
+
+OpenArcMainDelegate::OpenArcMainDelegate(
+    const base::FilePath& user_data_directory)
+    : user_data_directory_(user_data_directory) {}
+OpenArcMainDelegate::~OpenArcMainDelegate() = default;
+
+std::optional<int> OpenArcMainDelegate::BasicStartupComplete() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  logging::LoggingSettings settings;
+  // stderr by default during bring-up; --enable-logging=... still overrides.
+  settings.logging_dest =
+      command_line.HasSwitch(switches::kEnableLogging)
+          ? logging::LOG_DEFAULT
+          : (logging::LOG_TO_SYSTEM_DEBUG_LOG | logging::LOG_TO_STDERR);
+  logging::InitLogging(settings);
+  logging::SetLogItems(/*enable_process_id=*/true, /*enable_thread_id=*/true,
+                       /*enable_timestamp=*/true, /*enable_tickcount=*/false);
+  return std::nullopt;
+}
+
+void OpenArcMainDelegate::PreSandboxStartup() {
+  ui::ResourceBundle::InitSharedInstanceWithPakPath(GetResourcesPakPath());
+}
+
+std::variant<int, content::MainFunctionParams> OpenArcMainDelegate::RunProcess(
+    const std::string& process_type,
+    content::MainFunctionParams main_function_params) {
+  // Child processes run their usual main function.
+  if (!process_type.empty()) {
+    return std::move(main_function_params);
+  }
+
+  base::CurrentProcess::GetInstance().SetProcessType(
+      base::CurrentProcessType::PROCESS_BROWSER);
+
+  // Same shape as content on iOS: initialize the browser process (which runs
+  // every startup task up to PreMainMessageLoopRun synchronously), then hand
+  // the UI thread to the platform's loop. On Mac the platform's loop is the
+  // embedding app's -[NSApplication run].
+  browser_main_runner_ = content::BrowserMainRunner::Create();
+  const int result =
+      browser_main_runner_->Initialize(std::move(main_function_params));
+  if (result >= 0) {
+    LOG(ERROR) << "OpenArc: browser process initialization failed: " << result;
+    browser_main_runner_.reset();
+    return result;
+  }
+  base::CurrentUIThread::Get()->Attach();
+  // 0 tells content not to run BrowserMain() itself.
+  return 0;
+}
+
+void OpenArcMainDelegate::ShutdownBrowser() {
+  CHECK(browser_main_runner_);
+  // Detach first so nested RunLoops inside shutdown do not see the attached
+  // outer level as theirs.
+  base::CurrentUIThread::Get()->Detach();
+  browser_main_runner_->Shutdown();
+  browser_main_runner_.reset();
+}
+
+content::ContentClient* OpenArcMainDelegate::CreateContentClient() {
+  content_client_ = std::make_unique<OpenArcContentClient>();
+  return content_client_.get();
+}
+
+content::ContentBrowserClient*
+OpenArcMainDelegate::CreateContentBrowserClient() {
+  browser_client_ =
+      std::make_unique<OpenArcContentBrowserClient>(user_data_directory_);
+  return browser_client_.get();
+}
+
+}  // namespace openarc
