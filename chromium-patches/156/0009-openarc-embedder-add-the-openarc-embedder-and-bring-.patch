+- (BOOL)failIfClosed:(NSError**)error {
+  if (_closed) {
+    if (error) {
+      *error = OACMakeError(OACErrorTabClosed, @"The tab is closed.");
+    }
+    return YES;
+  }
+  return NO;
+}
