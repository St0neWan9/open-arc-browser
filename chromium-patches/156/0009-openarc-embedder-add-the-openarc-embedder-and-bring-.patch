+- (BOOL)setZoomFactor:(double)zoomFactor error:(NSError**)error {
+  if ([self failIfClosed:error]) {
+    return NO;
+  }
+  if (zoomFactor < 0.25 || zoomFactor > 5.0) {
+    if (error) {
+      *error = OACMakeError(OACErrorInvalidArgument,
+                            @"The zoom factor is out of range.");
+    }
+    return NO;
+  }
+  content::HostZoomMap::SetZoomLevel(
+      _webContents.get(), blink::ZoomFactorToZoomLevel(zoomFactor));
+  [self webContentsDidChangeState];
+  return YES;
+}
