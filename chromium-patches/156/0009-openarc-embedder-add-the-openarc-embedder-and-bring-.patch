++ (instancetype)tabWithConfiguration:(OACTabConfiguration*)configuration
+                               error:(NSError**)error {
+  CHECK(NSThread.isMainThread);
+  if (OACApplication.sharedApplication.state != OACApplicationStateRunning) {
+    if (error) {
+      *error = OACMakeError(OACErrorNotStarted, @"The engine is not running.");
+    }
+    return nil;
+  }
+  content::BrowserContext* context = configuration.profile.browserContext;
+  if (!context) {
+    if (error) {
+      *error = OACMakeError(OACErrorProfileUnavailable,
+                            @"The profile is not available.");
+    }
+    return nil;
+  }
+  NSUUID* identifier = configuration.requestedIdentifier ?: [NSUUID UUID];
+  if ([LiveTabs() objectForKey:identifier]) {
+    if (error) {
+      *error = OACMakeError(OACErrorDuplicateTabIdentifier,
+                            @"A live tab already has this identifier.");
+    }
+    return nil;
+  }
+  GURL initial_url;
+  if (configuration.initialURL) {
+    initial_url = net::GURLWithNSURL(configuration.initialURL);
+    if (!initial_url.is_valid() ||
+        initial_url.SchemeIs(url::kJavaScriptScheme)) {
+      if (error) {
+        *error = OACMakeError(OACErrorInvalidURL, @"The URL is not valid.");
+      }
+      return nil;
+    }
+  }
+  return [[OACTab alloc] initWithIdentifier:identifier
+                                    profile:configuration.profile
+                                    context:context
+                              configuration:configuration
+                                 initialURL:initial_url];
+}
+
+- (instancetype)initWithIdentifier:(NSUUID*)identifier
+                           profile:(OACProfile*)profile
+                           context:(content::BrowserContext*)context
+                     configuration:(OACTabConfiguration*)configuration
+                        initialURL:(const GURL&)initialURL {
+  if ((self = [super init])) {
+    content::WebContents::CreateParams params(context);
+    params.initially_hidden = configuration.startsHidden;
+    // TODO(C9): give a tab created for an opener's URL request the opener's
+    // browsing context (window.opener, session storage) where the link allows
+    // it. Script-opened windows already keep theirs (adoption).
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContents::Create(params);
+    [self setUpWithWebContents:std::move(contents)
+                    identifier:identifier
+                       profile:profile
+                   colorScheme:configuration.preferredColorScheme
+                          size:configuration.initialSize];
+    if (initialURL.is_valid()) {
+      [self loadGURL:initialURL];
+    }
+  }
+  return self;
+}
+
+- (instancetype)initAdoptingWebContents:
+                    (std::unique_ptr<content::WebContents>)webContents
+                             identifier:(NSUUID*)identifier
+                                profile:(OACProfile*)profile {
+  if ((self = [super init])) {
+    // A script-opened page starts with the opener's scheme (the opener set it
+    // through OpenArcTabPreferences, which the new contents does not have).
+    [self setUpWithWebContents:std::move(webContents)
+                    identifier:identifier
+                       profile:profile
+                   colorScheme:OACColorSchemeLight
+                          size:CGSizeZero];
+    // Content held the new window's first navigation until it was shown.
+    _webContents->GetController().LoadIfNecessary();
+  }
+  return self;
+}
+
+- (void)setUpWithWebContents:(std::unique_ptr<content::WebContents>)contents
+                  identifier:(NSUUID*)identifier
+                     profile:(OACProfile*)profile
+                 colorScheme:(OACColorScheme)colorScheme
+                        size:(CGSize)size {
+  _identifier = [identifier copy];
+  _profile = profile;
+  _pendingRequests = [NSHashTable hashTableWithOptions:NSPointerFunctionsStrongMemory];
+  _webContents = std::move(contents);
+  _dialogManager = std::make_unique<openarc::TabJavaScriptDialogManager>(self);
+  _bridge =
+      std::make_unique<openarc::TabWebContentsBridge>(self, _webContents.get());
+  _preferredColorScheme = colorScheme;
+  openarc::OpenArcTabPreferences::CreateForWebContents(_webContents.get());
+  openarc::OpenArcTabPreferences::FromWebContents(_webContents.get())
+      ->SetColorScheme(ToBlink(colorScheme));
+
+  if (size.width <= 0 || size.height <= 0) {
+    size = CGSizeMake(800, 600);
+  }
+  NSView* view = _webContents->GetNativeView().GetNativeNSView();
+  view.frame = NSMakeRect(0, 0, size.width, size.height);
+  view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+
+  [LiveTabs() setObject:self forKey:_identifier];
+  [OACApplication.sharedApplication registerTab:self];
+  [self refreshState];
+}
+
+- (void)dealloc {
+  // Releasing the last reference closes the tab (OACTab.h, Ownership). No
+  // delegate call here: nobody holds the tab any more.
+  for (OACNewTabRequest* request in _pendingRequests) {
+    [request decline];
+  }
+  _bridge.reset();
+  _webContents.reset();
+  _dialogManager.reset();
+}
