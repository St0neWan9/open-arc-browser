+// MARK: Lifetime
+
+- (void)close {
+  if (_closed) {
+    return;
+  }
+  _closed = YES;
+  [self.nativeView removeFromSuperview];
+  for (OACNewTabRequest* request in _pendingRequests) {
+    [request decline];
+  }
+  [_pendingRequests removeAllObjects];
+  _dialogManager->CancelDialogs(_webContents.get(), /*reset_state=*/true);
+  _bridge.reset();
+  _webContents.reset();
+  [LiveTabs() removeObjectForKey:_identifier];
+  [OACApplication.sharedApplication unregisterTab:self];
+  __weak OACTab* weakSelf = self;
+  id<OACTabDelegate> delegate = _delegate;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    if (tab && [delegate respondsToSelector:@selector(tabDidClose:)]) {
+      [delegate tabDidClose:tab];
+    }
+  });
+}
+
+- (void)closeRunningUnloadHandlers {
+  if (!_closed) {
+    // ClosePage runs beforeunload; CloseContents then reaches the delegate.
+    _webContents->ClosePage();
+  }
+}
+
+@end
