+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+
+namespace openarc {
+
+OpenArcContentBrowserClient::OpenArcContentBrowserClient(
+    const base::FilePath& user_data_directory)
+    : user_data_directory_(user_data_directory) {}
+OpenArcContentBrowserClient::~OpenArcContentBrowserClient() = default;
+
+std::unique_ptr<content::BrowserMainParts>
+OpenArcContentBrowserClient::CreateBrowserMainParts(
+    bool is_integration_test) {
+  return std::make_unique<OpenArcBrowserMainParts>();
+}
+
+std::string OpenArcContentBrowserClient::GetUserAgent() {
+  // Chromium's reduced user agent, with no product token of our own
+  // (OACApplication.h, userAgent).
+  return embedder_support::GetUserAgent();
+}
+
+blink::UserAgentMetadata OpenArcContentBrowserClient::GetUserAgentMetadata() {
+  return embedder_support::GetUserAgentMetadata();
+}
+
+base::FilePath OpenArcContentBrowserClient::GetChildProcessPath(int flags) {
+  // One unbundled helper for every child type until the helper apps of plan
+  // C10 exist (they will add the renderer / GPU / plugin / alerts variants).
+  return GetHelperExecutablePath();
+}
+
+std::string OpenArcContentBrowserClient::GetAcceptLangs(
+    content::BrowserContext* context) {
+  return "en-US,en";  // TODO(C6b): the profile's language prefs.
+}
+
+void OpenArcContentBrowserClient::ConfigureNetworkContextParams(
+    content::BrowserContext* context,
+    bool in_memory,
+    const base::FilePath& relative_partition_path,
+    network::mojom::NetworkContextParams* network_context_params,
+    cert_verifier::mojom::CertVerifierCreationParams*
+        cert_verifier_creation_params) {
+  network_context_params->user_agent = GetUserAgent();
+  network_context_params->accept_language = GetAcceptLangs(context);
+  // TODO(C11): persistent cookies and HTTP cache under the profile directory
+  // (file_paths); today cookies live in memory.
+}
+
+std::vector<base::FilePath>
+OpenArcContentBrowserClient::GetNetworkContextsParentDirectory() {
+  // The network service's sandbox may write only below these directories.
+  if (user_data_directory_.empty()) {
+    return {};
+  }
+  return {user_data_directory_};
+}
+
+void OpenArcContentBrowserClient::OverrideWebPreferences(
+    content::WebContents* web_contents,
+    content::SiteInstance& main_frame_site,
+    blink::web_pref::WebPreferences* prefs) {
+  // The shell decides the scheme per tab (the Space's theme, View ▸
+  // Appearance); the system appearance does not leak in. Tabs created by the
+  // engine itself (script-opened windows before adoption) start light.
+  const OpenArcTabPreferences* tab_preferences =
+      web_contents ? OpenArcTabPreferences::FromWebContents(web_contents)
+                   : nullptr;
+  const blink::mojom::PreferredColorScheme scheme =
+      tab_preferences ? tab_preferences->color_scheme()
+                      : blink::mojom::PreferredColorScheme::kLight;
+  prefs->preferred_color_scheme = scheme;
+  prefs->preferred_root_scrollbar_color_scheme = scheme;
+}
+
+}  // namespace openarc
