@@ -0,0 +1,316 @@
+# Copyright 2026 The Open Arc Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Open Arc's embedder of Chromium (plan tasks C6 to C11).
+#
+#   :openarc_framework   OpenArcCore.framework (plan C8): the browser-process
+#                        engine behind the public Objective-C API in
+#                        bridge/public/OpenArcCore, with its resources, headers,
+#                        module map and the helper.
+#   :openarc_shell_test  A bare Objective-C++ test host (our content_shell
+#                        equivalent for bring-up): one NSWindow, one profile,
+#                        one tab, URL from the command line.
+#   :openarc_helper      The child-process executable (renderer, GPU, utility).
+#                        Unbundled for now; helper apps and sandbox packaging are
+#                        plan task C10.
+#   :openarc_pak         Resource pack the engine loads at startup.
+#
+# Build: ninja -C out/Release openarc_framework openarc_shell_test
+# (chromium-bridge/build-framework.sh in the Open Arc repository wraps this).
+
+import("//build/config/mac/rules.gni")
+import("//chrome/version.gni")
+import("//third_party/icu/config.gni")
+import("//tools/grit/repack.gni")
+import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
+import("//ui/gl/features.gni")
+import("//v8/gni/v8.gni")
+
+assert(is_mac, "Open Arc is a macOS browser")
+
+# Headers of the public API. The copy in the Open Arc repository
+# (chromium-bridge/include) is the source of truth; this is a mirror kept in
+# sync by chromium-patches/export.sh's check (see chromium-patches/README.md).
+openarc_public_headers = [
+  "bridge/public/OpenArcCore/OACApplication.h",
+  "bridge/public/OpenArcCore/OACBrowserApplication.h",
+  "bridge/public/OpenArcCore/OACDefines.h",
+  "bridge/public/OpenArcCore/OACDialogDelegate.h",
+  "bridge/public/OpenArcCore/OACDownloads.h",
+  "bridge/public/OpenArcCore/OACExtensions.h",
+  "bridge/public/OpenArcCore/OACProfile.h",
+  "bridge/public/OpenArcCore/OACSiteSettings.h",
+  "bridge/public/OpenArcCore/OACTab.h",
+  "bridge/public/OpenArcCore/OACTabDelegate.h",
+  "bridge/public/OpenArcCore/OpenArcCore.h",
+]
+
+# Lets `#import <OpenArcCore/...>` resolve inside and outside the framework.
+config("openarc_public_config") {
+  include_dirs = [ "bridge/public" ]
+}
+
+# The content-level embedder: main delegate, content clients, browser main
+# parts and the browser context. TODO(C6b): derive from //chrome's
+# ChromeMainDelegate / ChromeContentBrowserClient instead (decision Q7); see
+# chromium-patches/README.md and docs/implementation-plan.md row C6b.
+source_set("embedder") {
+  visibility = [ ":*" ]
+  sources = [
+    "app/openarc_main_delegate.h",
+    "app/openarc_main_delegate.mm",
+    "browser/openarc_browser_context.h",
+    "browser/openarc_browser_context.mm",
+    "browser/openarc_browser_main_parts.h",
+    "browser/openarc_browser_main_parts.mm",
+    "browser/openarc_content_browser_client.h",
+    "browser/openarc_content_browser_client.mm",
+    "browser/openarc_tab_preferences.h",
+    "browser/openarc_tab_preferences.mm",
+    "common/openarc_content_client.h",
+    "common/openarc_content_client.mm",
+    "common/openarc_paths.h",
+    "common/openarc_paths.mm",
+  ]
+  public_configs = [ ":openarc_public_config" ]
+  deps = [
+    "//base",
+    "//components/embedder_support:user_agent",
+    "//content/public/app",
+    "//content/public/browser",
+    "//content/public/common",
+    "//net",
+    "//services/network/public/mojom",
+    "//third_party/blink/public/common",
+    "//ui/base",
+    "//ui/display",
+    "//url",
+  ]
+  frameworks = [
+    "AppKit.framework",
+    "Foundation.framework",
+  ]
+}
+
+# The Objective-C implementation of the public API.
+source_set("bridge") {
+  visibility = [ ":*" ]
+  sources = openarc_public_headers + [
+              "bridge/oac_application.mm",
+              "bridge/oac_application_internal.h",
+              "bridge/oac_browser_application.mm",
+              "bridge/oac_profile.mm",
+              "bridge/oac_profile_internal.h",
+              "bridge/oac_requests.mm",
+              "bridge/oac_requests_internal.h",
+              "bridge/oac_tab.mm",
+              "bridge/oac_tab_internal.h",
+              "bridge/oac_values.mm",
+            ]
+  public_configs = [ ":openarc_public_config" ]
+  deps = [
+    ":embedder",
+    "//base",
+    "//components/input",
+    "//components/viz/common",
+    "//content/public/app",
+    "//content/public/browser",
+    "//content/public/common",
+    "//net",
+    "//skia",
+    "//third_party/blink/public/common",
+    "//third_party/blink/public/mojom:mojom_core",
+    "//third_party/blink/public/mojom:mojom_platform",
+    "//ui/base",
+    "//ui/gfx",
+    "//ui/gfx/codec",
+    "//url",
+  ]
+  frameworks = [
+    "AppKit.framework",
+    "CoreGraphics.framework",
+    "Foundation.framework",
+  ]
+}
+
+# OpenArcCore.framework (plan C8): the engine library plus everything it needs
+# at run time, in a versioned framework the app embeds in Contents/Frameworks.
+#
+#   Versions/A/OpenArcCore            the library; install name
+#                                     @rpath/OpenArcCore.framework/Versions/A/OpenArcCore
+#   Versions/A/Headers, Modules/      public API and module map (Swift `import OpenArcCore`)
+#   Versions/A/Resources/             Info.plist, openarc.pak, icudtl.dat, V8 snapshot,
+#                                     ANGLE Metal shader cache
+#   Versions/A/Helpers/openarc_helper the child-process executable (unbundled until the
+#                                     helper apps of plan C10)
+#   Versions/A/Libraries/             SwiftShader (software GPU fallback)
+#
+# Chromium links statically into the library (is_component_build is false).
+# Only the public API is exported: see bridge/OpenArcCore.exports.
+openarc_framework_version = "A"
+
+bundle_data("openarc_framework_headers") {
+  sources = openarc_public_headers
+  outputs = [ "{{bundle_contents_dir}}/Headers/{{source_file_part}}" ]
+}
+
+bundle_data("openarc_framework_module_map") {
+  sources = [ "bridge/module.modulemap" ]
+  outputs = [ "{{bundle_contents_dir}}/Modules/{{source_file_part}}" ]
+}
+
+bundle_data("openarc_framework_resources") {
+  sources = [
+    "$root_out_dir/openarc.pak",
+    "//ui/gl/resources/angle-metal/gpu_shader_cache.bin",
+  ]
+  public_deps = [ ":openarc_pak" ]
+  if (icu_use_data_file) {
+    sources += [ "$root_out_dir/icudtl.dat" ]
+    public_deps += [ "//third_party/icu:icudata" ]
+  }
+  if (v8_use_external_startup_data) {
+    public_deps += [ "//v8" ]
+    if (use_v8_context_snapshot) {
+      sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
+      public_deps += [ "//tools/v8_context_snapshot" ]
+    }
+    if (!use_v8_context_snapshot || include_both_v8_snapshots) {
+      sources += [ "$root_out_dir/snapshot_blob.bin" ]
+    }
+  }
+  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+}
+
+bundle_data("openarc_framework_helpers") {
+  sources = [ "$root_out_dir/openarc_helper" ]
+  outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
+  public_deps = [ ":openarc_helper" ]
+}
+
+bundle_data("openarc_framework_swiftshader") {
+  sources = [
+    "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
+    "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
+  ]
+  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
+  public_deps = [ "//ui/gl:swiftshader_vk_library_copy" ]
+}
+
+# Restricts the library's exported symbols to the public API.
+config("openarc_framework_exports") {
+  inputs = [ "bridge/OpenArcCore.exports" ]
+  ldflags = [
+    "-Wl,-exported_symbols_list," +
+        rebase_path("bridge/OpenArcCore.exports", root_build_dir),
+  ]
+}
+
+mac_framework_bundle("openarc_framework") {
+  output_name = "OpenArcCore"
+  framework_version = openarc_framework_version
+  framework_contents = [
+    "Headers",
+    "Helpers",
+    "Libraries",
+    "Modules",
+    "Resources",
+  ]
+  info_plist = "bridge/framework-Info.plist"
+  extra_substitutions = [ "OPENARC_CHROMIUM_VERSION=$chrome_version_full" ]
+
+  sources = [ "bridge/oac_entry_points.mm" ]
+  deps = [
+    ":bridge",
+    ":embedder",
+    "//base",
+    "//content/public/app",
+    "//third_party/icu:icudata",
+  ]
+  public_configs = [ ":openarc_public_config" ]
+  configs += [ ":openarc_framework_exports" ]
+  bundle_deps = [
+    ":openarc_framework_headers",
+    ":openarc_framework_helpers",
+    ":openarc_framework_module_map",
+    ":openarc_framework_resources",
+  ]
+  if (enable_swiftshader) {
+    bundle_deps += [ ":openarc_framework_swiftshader" ]
+  }
+  ldflags = [ "-Wl,-install_name,@rpath/OpenArcCore.framework/Versions/$openarc_framework_version/OpenArcCore" ]
+}
+
+# Child processes (renderer, GPU, utility). It lives in the framework's Helpers/
+# directory, loads the framework's library (../OpenArcCore) and calls
+# OACChildProcessMain. Same split as Chrome's helpers: the executable only
+# sets up the sandbox and loads the library, so //base exists once per process.
+executable("openarc_helper") {
+  sources = [ "app/openarc_helper_main.cc" ]
+  deps = [
+    # Despite its path, this does not add a //base dependency.
+    "//base/allocator:early_zone_registration_apple",
+    "//base:compiler_specific",
+    "//sandbox/mac:seatbelt",
+  ]
+}
+
+# Bring-up test host: a bare NSApplication with one window and one tab.
+# It links OpenArcCore.framework from the build directory.
+executable("openarc_shell_test") {
+  sources = [ "shell_test/openarc_shell_test_main.mm" ]
+  deps = [ ":openarc_framework+link" ]
+  configs += [ ":openarc_public_config" ]
+  frameworks = [
+    "AppKit.framework",
+    "Foundation.framework",
+  ]
+  ldflags = [ "-Wl,-rpath,@executable_path" ]
+}
+
+repack("openarc_pak") {
+  sources = [
+    "$root_gen_dir/content/browser/devtools/devtools_resources.pak",
+    "$root_gen_dir/content/browser/tracing/tracing_resources.pak",
+    "$root_gen_dir/content/content_resources.pak",
+    "$root_gen_dir/content/gpu_resources.pak",
+    "$root_gen_dir/content/histograms_resources.pak",
+    "$root_gen_dir/content/process_resources.pak",
+    "$root_gen_dir/content/quota_internals_resources.pak",
+    "$root_gen_dir/content/service_worker_resources.pak",
+    "$root_gen_dir/content/traces_internals_resources.pak",
+    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
+    "$root_gen_dir/net/net_resources.pak",
+    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
+    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
+    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
+    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
+    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
+    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
+    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
+    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
+    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
+    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
+    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
+    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
+  ]
+  deps = [
+    "//content:content_resources",
+    "//content/browser/devtools:devtools_resources",
+    "//content/browser/resources",
+    "//content/browser/tracing:resources",
+    "//mojo/public/js:resources",
+    "//net:net_resources",
+    "//third_party/blink/public:devtools_inspector_resources",
+    "//third_party/blink/public:resources",
+    "//third_party/blink/public:scaled_resources_100_percent",
+    "//third_party/blink/public/strings",
+    "//third_party/blink/public/strings:permission_element_generated_strings",
+    "//third_party/blink/public/strings:permission_element_strings",
+    "//ui/resources",
+    "//ui/strings",
+    "//ui/webui/resources",
+  ]
+  output = "$root_out_dir/openarc.pak"
+}
