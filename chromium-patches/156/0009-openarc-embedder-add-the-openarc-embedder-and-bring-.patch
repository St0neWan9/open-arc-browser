+- (void)webContentsDidRequestNewTab:(OACNewTabRequest*)request {
+  if (request.hasPendingContents) {
+    // Kept until answered; declined when this tab closes unanswered
+    // (OACTabDelegate.h).
+    for (OACNewTabRequest* earlier in _pendingRequests.allObjects) {
+      if (earlier.isFinished) {
+        [_pendingRequests removeObject:earlier];
+      }
+    }
+    [_pendingRequests addObject:request];
+  }
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (tab && !tab.isClosed &&
+        [delegate respondsToSelector:@selector(tab:didRequestNewTab:)]) {
+      [delegate tab:tab didRequestNewTab:request];
+    } else {
+      [request decline];
+    }
+  });
+}
