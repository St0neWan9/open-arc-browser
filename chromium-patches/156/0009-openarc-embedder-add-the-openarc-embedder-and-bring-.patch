+- (void)webContentsDidUpdateFaviconURLs:
+    (const std::vector<blink::mojom::FaviconURLPtr>&)candidates {
+  // TODO(C6b): //chrome's favicon driver (history-backed, best-size picking).
+  // Until then: the first plain favicon, decoded at 32 px.
+  GURL icon_url;
+  for (const auto& candidate : candidates) {
+    if (candidate->icon_type == blink::mojom::FaviconIconType::kFavicon) {
+      icon_url = candidate->icon_url;
+      break;
+    }
+  }
+  if (!icon_url.is_valid() && !candidates.empty()) {
+    icon_url = candidates.front()->icon_url;
+  }
+  if (!icon_url.is_valid() || _closed) {
+    return;
+  }
+  NSURL* url = net::NSURLWithGURL(icon_url);
+  if (SameURL(url, _fields.faviconURL) && _fields.faviconPNGData) {
+    return;
+  }
+  __weak OACTab* weakSelf = self;
+  _faviconDownloadID = _webContents->DownloadImage(
+      icon_url, /*is_favicon=*/true,
+      gfx::Size(kFaviconPixelSize, kFaviconPixelSize),
+      /*max_bitmap_size=*/kFaviconPixelSize * 4, /*bypass_cache=*/false,
+      base::BindOnce(^(int download_id, int http_status_code,
+                       const GURL& image_url,
+                       const std::vector<SkBitmap>& bitmaps,
+                       const std::vector<gfx::Size>& sizes) {
+        [weakSelf faviconDownload:download_id
+                              URL:url
+                          bitmaps:bitmaps];
+      }));
+}
+
+- (void)faviconDownload:(int)downloadID
+                    URL:(NSURL*)url
+                bitmaps:(const std::vector<SkBitmap>&)bitmaps {
+  if (_closed || downloadID != _faviconDownloadID) {
+    return;
+  }
+  // Pick the bitmap closest to 32 px, then encode it as PNG.
+  const SkBitmap* best = nullptr;
+  for (const SkBitmap& bitmap : bitmaps) {
+    if (!best || std::abs(bitmap.width() - kFaviconPixelSize) <
+                     std::abs(best->width() - kFaviconPixelSize)) {
+      best = &bitmap;
+    }
+  }
+  NSData* png = nil;
+  if (best && !best->drawsNothing()) {
+    std::optional<std::vector<uint8_t>> encoded =
+        gfx::PNGCodec::EncodeBGRASkBitmap(*best, /*discard_transparency=*/false);
+    if (encoded) {
+      png = [NSData dataWithBytes:encoded->data() length:encoded->size()];
+    }
+  }
+  _fields.faviconURL = url;
+  _fields.faviconPNGData = png;
+  [self webContentsDidChangeState];
+}
