+- (void)setVisible:(BOOL)visible {
+  if (_closed) {
+    return;
+  }
+  // A tab created hidden has its WebContentsViewCocoa hidden by content
+  // (WebContentsViewMac::CreateView); WasShown() alone does not unhide the
+  // NSView, which Chrome does through its views host. Do both, in the order
+  // that never shows a stale frame.
+  NSView* view = self.nativeView;
+  if (visible) {
+    view.hidden = NO;
+    _webContents->WasShown();
+  } else {
+    _webContents->WasHidden();
+    view.hidden = YES;
+  }
+}
+
+- (void)setFocused:(BOOL)focused {
+  if (_closed) {
+    return;
+  }
+  if (focused) {
+    _webContents->Focus();
+  } else {
+    NSView* view = self.nativeView;
+    NSWindow* window = view.window;
+    NSResponder* responder = window.firstResponder;
+    if ([responder isKindOfClass:[NSView class]] &&
+        [(NSView*)responder isDescendantOf:view]) {
+      [window makeFirstResponder:nil];
+    }
+  }
+}
