+- (void)webContentsRenderProcessGone:(base::TerminationStatus)status {
+  [self webContentsDidChangeState];
+  OACRenderProcessTermination reason = OACRenderProcessTerminationCrashed;
+  switch (status) {
+    case base::TERMINATION_STATUS_PROCESS_WAS_KILLED:
+      reason = OACRenderProcessTerminationKilled;
+      break;
+    case base::TERMINATION_STATUS_OOM:
+      reason = OACRenderProcessTerminationOutOfMemory;
+      break;
+    case base::TERMINATION_STATUS_LAUNCH_FAILED:
+      reason = OACRenderProcessTerminationLaunchFailed;
+      break;
+    default:
+      break;
+  }
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (tab && !tab.isClosed &&
+        [delegate respondsToSelector:@selector(tab:renderProcessDidTerminate:)]) {
+      [delegate tab:tab renderProcessDidTerminate:reason];
+    }
+  });
+}
