+- (void)webContentsDidReplyToFind:(int)requestId
+                          matches:(int)matches
+                    activeOrdinal:(int)activeOrdinal
+                          isFinal:(bool)isFinal {
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (tab && !tab.isClosed &&
+        [delegate respondsToSelector:@selector
+                  (tab:
+                      didUpdateFindResultForRequest:numberOfMatches:
+                                 activeMatchOrdinal:isFinal:)]) {
