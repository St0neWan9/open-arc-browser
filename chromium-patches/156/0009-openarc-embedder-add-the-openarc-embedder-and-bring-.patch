@@ -0,0 +1,138 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_browser_context.h"
+
+#include <set>
+
+#include "base/time/time.h"
+#include "content/public/browser/background_sync_controller.h"
+#include "content/public/browser/zoom_level_delegate.h"
+#include "url/origin.h"
+
+namespace openarc {
+
+namespace {
+
+// Background Sync is off: content requires a controller once a page registers
+// a sync, so this one accepts registrations and never schedules a wake-up.
+class DisabledBackgroundSyncController
+    : public content::BackgroundSyncController {
+ public:
+  DisabledBackgroundSyncController() = default;
+  ~DisabledBackgroundSyncController() override = default;
+
+  base::TimeDelta GetNextEventDelay(
+      const content::BackgroundSyncRegistration& registration,
+      content::BackgroundSyncParameters* parameters,
+      base::TimeDelta time_till_soonest_scheduled_event_for_origin) override {
+    return base::TimeDelta::Max();
+  }
+  std::unique_ptr<BackgroundSyncEventKeepAlive>
+  CreateBackgroundSyncEventKeepAlive() override {
+    return nullptr;
+  }
+  void NoteSuspendedPeriodicSyncOrigins(
+      std::set<url::Origin> suspended_origins) override {}
+  void NoteRegisteredPeriodicSyncOrigins(
+      std::set<url::Origin> registered_origins) override {}
+  void AddToTrackedOrigins(const url::Origin& origin) override {}
+  void RemoveFromTrackedOrigins(const url::Origin& origin) override {}
+};
+
+}  // namespace
+
+OpenArcBrowserContext::OpenArcBrowserContext(const base::FilePath& path,
+                                             bool off_the_record)
+    : path_(path), off_the_record_(off_the_record) {}
+
+OpenArcBrowserContext::~OpenArcBrowserContext() {
+  NotifyWillBeDestroyed();
+  ShutdownStoragePartitions();
+}
+
+std::unique_ptr<content::ZoomLevelDelegate>
+OpenArcBrowserContext::CreateZoomLevelDelegate(
+    const base::FilePath& partition_path) {
+  // Zoom levels are kept in memory until //chrome's zoom prefs arrive (C6b).
+  return nullptr;
+}
+
+base::FilePath OpenArcBrowserContext::GetPath() const {
+  return path_;
+}
+
+bool OpenArcBrowserContext::IsOffTheRecord() {
+  return off_the_record_;
+}
+
+content::DownloadManagerDelegate*
+OpenArcBrowserContext::GetDownloadManagerDelegate() {
+  return nullptr;  // TODO(C12): downloads.
+}
+
+content::BrowserPluginGuestManager* OpenArcBrowserContext::GetGuestManager() {
+  return nullptr;
+}
+
+storage::SpecialStoragePolicy*
+OpenArcBrowserContext::GetSpecialStoragePolicy() {
+  return nullptr;
+}
+
+content::PlatformNotificationService*
+OpenArcBrowserContext::GetPlatformNotificationService() {
+  return nullptr;
+}
+
+content::PushMessagingService*
+OpenArcBrowserContext::GetPushMessagingService() {
+  return nullptr;
+}
+
+content::StorageNotificationService*
+OpenArcBrowserContext::GetStorageNotificationService() {
+  return nullptr;
+}
+
+content::SSLHostStateDelegate*
+OpenArcBrowserContext::GetSSLHostStateDelegate() {
+  return nullptr;
+}
+
+content::PermissionControllerDelegate*
+OpenArcBrowserContext::GetPermissionControllerDelegate() {
+  return nullptr;  // Every permission is denied until C12.
+}
+
+content::ClientHintsControllerDelegate*
+OpenArcBrowserContext::GetClientHintsControllerDelegate() {
+  return nullptr;
+}
+
+content::BackgroundFetchDelegate*
+OpenArcBrowserContext::GetBackgroundFetchDelegate() {
+  return nullptr;
+}
+
+content::BackgroundSyncController*
+OpenArcBrowserContext::GetBackgroundSyncController() {
+  if (!background_sync_controller_) {
+    background_sync_controller_ =
+        std::make_unique<DisabledBackgroundSyncController>();
+  }
+  return background_sync_controller_.get();
+}
+
+content::BrowsingDataRemoverDelegate*
+OpenArcBrowserContext::GetBrowsingDataRemoverDelegate() {
+  return nullptr;
+}
+
+content::ReduceAcceptLanguageControllerDelegate*
+OpenArcBrowserContext::GetReduceAcceptLanguageControllerDelegate() {
+  return nullptr;
+}
+
+}  // namespace openarc
