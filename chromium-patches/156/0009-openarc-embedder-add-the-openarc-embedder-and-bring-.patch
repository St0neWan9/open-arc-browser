+- (void)webContentsDidFinishNavigation:(content::NavigationHandle*)handle {
+  [self webContentsDidChangeState];
+  if (!handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  const GURL& url = handle->GetURL();
+  const bool committed = handle->HasCommitted();
+  const net::Error net_error = handle->GetNetErrorCode();
+  const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+  const NSInteger status = headers ? headers->response_code() : 0;
+  LOG(INFO) << "OpenArc: DidFinishNavigation url=" << url.spec()
+            << " committed=" << committed
+            << " error=" << net::ErrorToShortString(net_error)
+            << " status=" << status;
+  NSError* error = nil;
+  if (net_error != net::OK) {
+    error = [NSError
+        errorWithDomain:@"org.chromium.net"
+                   code:net_error
+               userInfo:@{
+                 NSLocalizedDescriptionKey :
+                     base::SysUTF8ToNSString(net::ErrorToString(net_error))
+               }];
+  }
+  OACNavigation* navigation =
+      [[OACNavigation alloc] initWithURL:net::NSURLWithGURL(url)
+                         isCrossDocument:!handle->IsSameDocument()
+                     isRendererInitiated:handle->IsRendererInitiated()
+                                   error:error
+                          HTTPStatusCode:status];
+  __weak OACTab* weakSelf = self;
+  OACPostToMainThread(^{
+    OACTab* tab = weakSelf;
+    id<OACTabDelegate> delegate = tab.delegate;
+    if (tab && !tab.isClosed &&
+        [delegate respondsToSelector:@selector(tab:didFinishNavigation:)]) {
+      [delegate tab:tab didFinishNavigation:navigation];
+    }
+  });
+}
