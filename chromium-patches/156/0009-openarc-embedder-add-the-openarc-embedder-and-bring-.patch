+
+const NSInteger OACBridgeAPIVersion = 1;
+NSErrorDomain const OACErrorDomain = @"org.openarc.OpenArcCore";
+
+namespace {
+
+// The port a scheme uses when none is given, or 0 if unknown.
+NSInteger DefaultPortForScheme(NSString* scheme) {
+  if ([scheme isEqualToString:@"http"] || [scheme isEqualToString:@"ws"]) {
+    return 80;
+  }
+  if ([scheme isEqualToString:@"https"] || [scheme isEqualToString:@"wss"]) {
+    return 443;
+  }
+  if ([scheme isEqualToString:@"ftp"]) {
+    return 21;
+  }
+  return 0;
+}
+
+}  // namespace
+
+void OACPostToMainThread(dispatch_block_t block) {
+  CFRunLoopRef main_loop = CFRunLoopGetMain();
+  CFRunLoopPerformBlock(main_loop, kCFRunLoopCommonModes, block);
+  CFRunLoopWakeUp(main_loop);
+}
+
+NSError* OACMakeError(OACErrorCode code, NSString* description) {
+  return [NSError errorWithDomain:OACErrorDomain
+                             code:code
+                         userInfo:@{NSLocalizedDescriptionKey : description}];
+}
+
+@implementation OACOrigin {
+  NSString* _scheme;
+  NSString* _host;
+  NSNumber* _port;
+}
+
+- (instancetype)initWithScheme:(NSString*)scheme
+                          host:(NSString*)host
+                          port:(NSNumber*)port {
+  if ((self = [super init])) {
+    _scheme = scheme.lowercaseString;
+    _host = host.lowercaseString;
+    if (port && port.integerValue != DefaultPortForScheme(_scheme)) {
+      _port = [port copy];
+    }
+  }
+  return self;
+}
+
+- (instancetype)initWithURL:(NSURL*)url {
+  NSURLComponents* components = [NSURLComponents componentsWithURL:url
+                                           resolvingAgainstBaseURL:NO];
+  if (!components.scheme.length || !components.host.length) {
+    return nil;
+  }
+  return [self initWithScheme:components.scheme
+                         host:components.host
+                         port:components.port];
+}
+
+- (NSString*)scheme {
+  return _scheme;
+}
+
+- (NSString*)host {
+  return _host;
+}
+
+- (NSNumber*)port {
+  return _port;
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  return self;
+}
+
+- (BOOL)isEqual:(id)object {
+  if (![object isKindOfClass:[OACOrigin class]]) {
+    return NO;
+  }
+  OACOrigin* other = object;
+  return [_scheme isEqualToString:other.scheme] &&
+         [_host isEqualToString:other.host] &&
+         (_port == other.port || [_port isEqual:other.port]);
+}
+
+- (NSUInteger)hash {
+  return _scheme.hash ^ _host.hash ^ _port.hash;
+}
+
+@end
+
+@implementation OACTabState {
+  OACTabStateFields _fields;
+}
+
+- (instancetype)initWithFields:(const OACTabStateFields&)fields {
+  if ((self = [super init])) {
+    _fields = fields;
+  }
+  return self;
+}
+
+- (NSURL*)URL {
+  return _fields.url;
+}
+
+- (NSURL*)committedURL {
+  return _fields.committedURL;
+}
+
+- (NSString*)title {
+  return _fields.title ?: @"";
+}
+
+- (BOOL)isLoading {
+  return _fields.loading;
+}
+
+- (double)loadProgress {
+  return _fields.loadProgress;
+}
+
+- (NSURL*)faviconURL {
+  return _fields.faviconURL;
+}
+
+- (NSData*)faviconPNGData {
+  return _fields.faviconPNGData;
+}
+
+- (BOOL)canGoBack {
+  return _fields.canGoBack;
+}
+
+- (BOOL)canGoForward {
+  return _fields.canGoForward;
+}
+
+- (BOOL)isCrashed {
+  return _fields.crashed;
+}
+
+- (OACAudioState)audioState {
+  return _fields.audioState;
+}
+
+- (OACSecurityLevel)securityLevel {
