diff --git a/openarc/bridge/oac_requests.mm b/openarc/bridge/oac_requests.mm
new file mode 100644
index 000000000000..1257f023557a
--- /dev/null
+++ b/openarc/bridge/oac_requests.mm
@@ -0,0 +1,415 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// OACNewTabRequest (OACTabDelegate.h) and the JavaScript dialog part of
+// OACDialogDelegate.h. The other dialog kinds (HTTP auth, permissions, file
+// chooser, external protocol) get their default answer from content itself
+// until plan C12: this content-level embedder installs no login delegate,
+// permission controller delegate or file chooser, so content cancels or denies
+// them.
+
+#import "openarc/bridge/oac_requests_internal.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/strings/sys_string_conversions.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/apple/url_conversions.h"
+#include "url/origin.h"
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+
+// MARK: - New tab requests
+
+@implementation OACNewTabRequest {
+  __weak OACTab* _opener;
+  OACProfile* _profile;
+  NSURL* _URL;
+  OACNewTabDisposition _disposition;
+  BOOL _hasUserGesture;
+  CGRect _requestedFrame;
+  BOOL _hasPendingContents;
+  BOOL _finished;
+  std::unique_ptr<content::WebContents> _pendingContents;
+}
+
+- (instancetype)initWithOpener:(OACTab*)opener
+                       profile:(OACProfile*)profile
+                           URL:(NSURL*)URL
+                   disposition:(OACNewTabDisposition)disposition
+                hasUserGesture:(BOOL)hasUserGesture
+                requestedFrame:(CGRect)requestedFrame {
+  if ((self = [super init])) {
+    _opener = opener;
+    _profile = profile;
+    _URL = [URL copy];
+    _disposition = disposition;
+    _hasUserGesture = hasUserGesture;
+    _requestedFrame = requestedFrame;
+  }
+  return self;
+}
+
+- (instancetype)initWithOpener:(OACTab*)opener
+                       profile:(OACProfile*)profile
+                           URL:(NSURL*)URL
+                   disposition:(OACNewTabDisposition)disposition
+                hasUserGesture:(BOOL)hasUserGesture
+                requestedFrame:(CGRect)requestedFrame
+               pendingContents:
+                   (std::unique_ptr<content::WebContents>)contents {
+  if ((self = [self initWithOpener:opener
+                           profile:profile
+                               URL:URL
+                       disposition:disposition
+                    hasUserGesture:hasUserGesture
+                    requestedFrame:requestedFrame])) {
+    _pendingContents = std::move(contents);
+    _hasPendingContents = YES;
+  }
+  return self;
+}
+
+- (OACTab*)opener {
+  return _opener;
+}
+- (OACProfile*)profile {
+  return _profile;
+}
+- (NSURL*)URL {
+  return _URL;
+}
+- (OACNewTabDisposition)disposition {
+  return _disposition;
+}
+- (BOOL)hasUserGesture {
+  return _hasUserGesture;
+}
+- (CGRect)requestedFrame {
+  return _requestedFrame;
+}
+- (BOOL)hasPendingContents {
+  return _hasPendingContents;
+}
+- (BOOL)isFinished {
+  return _finished;
+}
+
+- (OACTab*)adoptWithIdentifier:(NSUUID*)identifier error:(NSError**)error {
+  CHECK(NSThread.isMainThread);
+  if (_finished || !_pendingContents) {
+    if (error) {
+      *error = OACMakeError(OACErrorRequestFinished,
+                            @"The request was already answered.");
+    }
+    return nil;
+  }
+  if (OACApplication.sharedApplication.state != OACApplicationStateRunning) {
+    if (error) {
+      *error = OACMakeError(OACErrorNotStarted, @"The engine is not running.");
+    }
+    return nil;
+  }
+  NSUUID* tabIdentifier = identifier ?: [NSUUID UUID];
+  if ([OACTab tabWithIdentifier:tabIdentifier]) {
+    if (error) {
+      *error = OACMakeError(OACErrorDuplicateTabIdentifier,
+                            @"A live tab already has this identifier.");
+    }
+    return nil;
+  }
+  _finished = YES;
+  return [[OACTab alloc] initAdoptingWebContents:std::move(_pendingContents)
+                                      identifier:tabIdentifier
+                                         profile:_profile];
+}
+
+- (void)decline {
+  _finished = YES;
+  _pendingContents.reset();
+}
+
+@end
+
+// MARK: - Dialog requests
+
+@implementation OACDialogRequest {
+ @protected
+  __weak OACTab* _tab;
+  OACOrigin* _origin;
+  BOOL _isFromSubframe;
+  BOOL _finished;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+             isFromSubframe:(BOOL)isFromSubframe {
+  if ((self = [super init])) {
+    _tab = tab;
+    _origin = [origin copy];
+    _isFromSubframe = isFromSubframe;
+  }
+  return self;
+}
+
+- (OACTab*)tab {
+  return _tab;
+}
+- (OACOrigin*)origin {
+  return _origin;
+}
+- (BOOL)isFromSubframe {
+  return _isFromSubframe;
+}
+- (BOOL)isFinished {
+  return _finished;
+}
+- (void)cancel {
+  // Subclasses answer with their default.
+  _finished = YES;
+}
+
+@end
+
+@implementation OACJavaScriptDialogRequest {
+  OACJavaScriptDialogKind _kind;
+  NSString* _message;
+  NSString* _defaultPromptText;
+  BOOL _isReload;
+  BOOL _showsSuppressOption;
+  content::JavaScriptDialogManager::DialogClosedCallback _callback;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+             isFromSubframe:(BOOL)isFromSubframe
+                       kind:(OACJavaScriptDialogKind)kind
+                    message:(NSString*)message
+          defaultPromptText:(NSString*)defaultPromptText
+                   isReload:(BOOL)isReload
+        showsSuppressOption:(BOOL)showsSuppressOption
+                   callback:(content::JavaScriptDialogManager::
+                                 DialogClosedCallback)callback {
+  if ((self = [super initWithTab:tab
+                           origin:origin
+                   isFromSubframe:isFromSubframe])) {
+    _kind = kind;
+    _message = [message copy];
+    _defaultPromptText = [defaultPromptText copy];
+    _isReload = isReload;
+    _showsSuppressOption = showsSuppressOption;
+    _callback = std::move(callback);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  // Dropping the last reference answers with the default (OACDialogDelegate.h).
+  [self finishAccepting:NO promptText:nil];
+}
+
+- (OACJavaScriptDialogKind)kind {
+  return _kind;
+}
+- (NSString*)message {
+  return _message;
+}
+- (NSString*)defaultPromptText {
+  return _defaultPromptText;
+}
+- (BOOL)isReload {
+  return _isReload;
+}
+- (BOOL)showsSuppressOption {
+  return _showsSuppressOption;
+}
+
+- (void)finishAccepting:(BOOL)accepted promptText:(NSString*)promptText {
+  if (_finished) {
+    return;
+  }
+  _finished = YES;
+  if (_callback) {
+    std::move(_callback).Run(
+        accepted, promptText ? base::SysNSStringToUTF16(promptText)
+                             : std::u16string());
+  }
+}
+
+- (void)acceptWithPromptText:(NSString*)promptText
+      suppressFurtherDialogs:(BOOL)suppressFurtherDialogs {
+  if (suppressFurtherDialogs) {
+    _tab.suppressesJavaScriptDialogs = YES;
+  }
+  [self finishAccepting:YES
+             promptText:_kind == OACJavaScriptDialogKindPrompt ? promptText
+                                                               : nil];
+}
+
+- (void)dismissSuppressingFurtherDialogs:(BOOL)suppressFurtherDialogs {
+  if (suppressFurtherDialogs) {
+    _tab.suppressesJavaScriptDialogs = YES;
+  }
+  [self finishAccepting:NO promptText:nil];
+}
+
+- (void)cancel {
+  [self finishAccepting:NO promptText:nil];
+}
+
+- (void)cancelByEngine {
+  [self finishAccepting:NO promptText:nil];
+}
+
+@end
+
+// MARK: - JavaScript dialog manager
+
+namespace openarc {
+
+namespace {
+
+OACOrigin* OriginOfFrame(content::RenderFrameHost* frame) {
+  if (!frame) {
+    return nil;
+  }
+  const url::Origin& origin = frame->GetLastCommittedOrigin();
+  if (origin.opaque() || origin.host().empty()) {
+    return nil;
+  }
+  return [[OACOrigin alloc]
+      initWithScheme:base::SysUTF8ToNSString(origin.scheme())
+                host:base::SysUTF8ToNSString(origin.host())
+                port:@(origin.port())];
+}
+
+bool IsFromSubframe(content::RenderFrameHost* frame) {
+  return frame && frame->GetParentOrOuterDocument() != nullptr;
+}
+
+}  // namespace
+
+TabJavaScriptDialogManager::TabJavaScriptDialogManager(OACTab* tab)
+    : tab_(tab), pending_([NSHashTable weakObjectsHashTable]) {}
+
+TabJavaScriptDialogManager::~TabJavaScriptDialogManager() {
+  CancelDialogs(nullptr, /*reset_state=*/true);
+}
+
+void TabJavaScriptDialogManager::RunJavaScriptDialog(
+    content::WebContents* web_contents,
+    content::RenderFrameHost* render_frame_host,
+    content::JavaScriptDialogType dialog_type,
+    const std::u16string& message_text,
+    const std::u16string& default_prompt_text,
+    DialogClosedCallback callback,
+    bool* did_suppress_message) {
+  OACTab* tab = tab_;
+  if (!tab || tab.isClosed || tab.suppressesJavaScriptDialogs) {
+    // Content answers as if the user pressed Cancel.
+    *did_suppress_message = true;
+    return;
+  }
+  *did_suppress_message = false;
+  OACJavaScriptDialogKind kind = OACJavaScriptDialogKindAlert;
+  switch (dialog_type) {
+    case content::JAVASCRIPT_DIALOG_TYPE_ALERT:
+      kind = OACJavaScriptDialogKindAlert;
+      break;
+    case content::JAVASCRIPT_DIALOG_TYPE_CONFIRM:
+      kind = OACJavaScriptDialogKindConfirm;
+      break;
+    case content::JAVASCRIPT_DIALOG_TYPE_PROMPT:
+      kind = OACJavaScriptDialogKindPrompt;
+      break;
+  }
+  // Like Chrome: the suppress option appears from a page's second dialog on.
+  const BOOL shows_suppress_option = tab.javaScriptDialogCount > 0;
+  [tab noteJavaScriptDialogShown];
+  Present([[OACJavaScriptDialogRequest alloc]
+             initWithTab:tab
+                  origin:OriginOfFrame(render_frame_host)
+          isFromSubframe:IsFromSubframe(render_frame_host)
+                    kind:kind
+                 message:base::SysUTF16ToNSString(message_text)
+       defaultPromptText:base::SysUTF16ToNSString(default_prompt_text)
+                isReload:NO
+     showsSuppressOption:shows_suppress_option
+                callback:std::move(callback)]);
+}
+
+void TabJavaScriptDialogManager::RunBeforeUnloadDialog(
+    content::WebContents* web_contents,
+    content::RenderFrameHost* render_frame_host,
+    bool is_reload,
+    DialogClosedCallback callback) {
+  OACTab* tab = tab_;
+  if (!tab || tab.isClosed) {
+    std::move(callback).Run(false, std::u16string());
+    return;
+  }
+  // The text is ours, never the page's (OACDialogDelegate.h).
+  NSString* message =
+      is_reload ? @"Reload site? Changes you made may not be saved."
+                : @"Leave site? Changes you made may not be saved.";
+  Present([[OACJavaScriptDialogRequest alloc]
+             initWithTab:tab
+                  origin:OriginOfFrame(render_frame_host)
+          isFromSubframe:IsFromSubframe(render_frame_host)
+                    kind:OACJavaScriptDialogKindBeforeUnload
+                 message:message
+       defaultPromptText:@""
+                isReload:is_reload
+     showsSuppressOption:NO
+                callback:std::move(callback)]);
+}
+
+void TabJavaScriptDialogManager::CancelDialogs(
+    content::WebContents* web_contents,
+    bool reset_state) {
+  NSArray<OACJavaScriptDialogRequest*>* requests = pending_.allObjects;
+  [pending_ removeAllObjects];
+  OACTab* tab = tab_;
+  for (OACJavaScriptDialogRequest* request in requests) {
+    if (request.isFinished) {
+      continue;
+    }
+    [request cancelByEngine];
+    id<OACDialogDelegate> delegate = tab.dialogDelegate;
+    if (tab && [delegate respondsToSelector:@selector(tab:
+                                                 didCancelDialogRequest:)]) {
+      OACPostToMainThread(^{
+        [delegate tab:tab didCancelDialogRequest:request];
+      });
+    }
+  }
+  if (reset_state) {
+    tab.suppressesJavaScriptDialogs = NO;
+  }
+}
+
+void TabJavaScriptDialogManager::Present(OACJavaScriptDialogRequest* request) {
+  [pending_ addObject:request];
+  __weak OACTab* weak_tab = tab_;
+  // From a posted task, never re-entrantly (OACDefines.h). The block keeps the
+  // request alive until the delegate decided; with no delegate, or when it
+  // returns NO, the request is answered with its default right away.
+  OACPostToMainThread(^{
+    OACTab* tab = weak_tab;
+    id<OACDialogDelegate> delegate = tab.dialogDelegate;
+    BOOL presented = NO;
+    if (tab && !tab.isClosed && !request.isFinished &&
+        [delegate respondsToSelector:@selector(tab:runJavaScriptDialog:)]) {
+      presented = [delegate tab:tab runJavaScriptDialog:request];
+    }
+    if (!presented) {
+      [request cancel];
+    }
+  });
+}
+
+}  // namespace openarc
