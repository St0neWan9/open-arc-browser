+// Forwards WebContents events to its OACTab. Owned by the tab; never outlives
+// the WebContents.
+class TabWebContentsBridge : public content::WebContentsObserver,
+                             public content::WebContentsDelegate {
+ public:
+  TabWebContentsBridge(OACTab* tab, content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents), tab_(tab) {
+    web_contents->SetDelegate(this);
+  }
+  TabWebContentsBridge(const TabWebContentsBridge&) = delete;
+  TabWebContentsBridge& operator=(const TabWebContentsBridge&) = delete;
+  ~TabWebContentsBridge() override {
+    if (web_contents()) {
+      web_contents()->SetDelegate(nullptr);
+    }
+  }
+
+  // content::WebContentsObserver:
+  void DidStartLoading() override { [tab_ webContentsDidChangeState]; }
+  void DidStopLoading() override { [tab_ webContentsDidChangeState]; }
+  void LoadProgressChanged(double progress) override {
+    [tab_ webContentsDidChangeState];
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    [tab_ webContentsDidChangeState];
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    [tab_ webContentsDidFinishNavigation:handle];
+  }
+  void OnAudioStateChanged(bool audible) override {
+    [tab_ webContentsDidChangeState];
+  }
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    [tab_ webContentsRenderProcessGone:status];
+  }
+  void DidUpdateFaviconURL(
+      content::RenderFrameHost* render_frame_host,
+      const std::vector<blink::mojom::FaviconURLPtr>& candidates,
+      blink::mojom::FaviconUpdateReason reason) override {
+    [tab_ webContentsDidUpdateFaviconURLs:candidates];
+  }
+  void DidChangeThemeColor() override { [tab_ webContentsDidChangeThemeColor]; }
+  void DidToggleFullscreenModeForTab(bool entered_fullscreen,
+                                     bool will_cause_resize) override {
+    [tab_ webContentsDidToggleFullscreen:entered_fullscreen];
+  }
+
+  // content::WebContentsDelegate:
+  void NavigationStateChanged(content::WebContents* source,
+                              content::InvalidateTypes changed_flags) override {
+    [tab_ webContentsDidChangeState];
+  }
+  void CloseContents(content::WebContents* source) override {
+    [tab_ webContentsDidRequestClose];
+  }
+  void ActivateContents(content::WebContents* contents) override {
+    [tab_ webContentsDidRequestActivation];
+  }
+  void UpdateTargetURL(content::WebContents* source, const GURL& url) override {
+    [tab_ webContentsDidHoverURL:url];
+  }
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    return [tab_ webContentsHandleUnhandledKeyEvent:event];
+  }
+  void FindReply(content::WebContents* web_contents,
+                 int request_id,
+                 int number_of_matches,
+                 const gfx::Rect& selection_rect,
+                 int active_match_ordinal,
+                 bool final_update) override {
+    [tab_ webContentsDidReplyToFind:request_id
+                            matches:number_of_matches
+                      activeOrdinal:active_match_ordinal
+                            isFinal:final_update];
+  }
+  content::JavaScriptDialogManager* GetJavaScriptDialogManager(
+      content::WebContents* source) override {
+    return [tab_ javaScriptDialogManager];
+  }
+
+  // Navigations that leave the current tab (⌘-click, target=_blank without an
+  // opener, view-source) become URL requests; the shell decides where the new
+  // tab goes. Current-tab navigations just navigate.
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    if (params.disposition == WindowOpenDisposition::CURRENT_TAB ||
+        params.disposition == WindowOpenDisposition::SINGLETON_TAB ||
+        params.disposition == WindowOpenDisposition::SWITCH_TO_TAB) {
+      content::NavigationController::LoadURLParams load_params(params);
+      base::WeakPtr<content::NavigationHandle> handle =
+          source->GetController().LoadURLWithParams(load_params);
+      if (handle && navigation_handle_callback) {
+        std::move(navigation_handle_callback).Run(*handle);
+      }
+      return source;
+    }
+    if (params.disposition == WindowOpenDisposition::SAVE_TO_DISK ||
+        params.disposition == WindowOpenDisposition::IGNORE_ACTION) {
+      return nullptr;  // TODO(C12): downloads.
+    }
+    OACTab* tab = tab_;
+    if (!tab) {
+      return nullptr;
+    }
+    [tab webContentsDidRequestNewTab:[[OACNewTabRequest alloc]
+                                         initWithOpener:tab
+                                                profile:tab.profile
+                                                    URL:net::NSURLWithGURL(
+                                                            params.url)
+                                            disposition:DispositionFromChromium(
+                                                            params.disposition)
+                                         hasUserGesture:params.user_gesture
+                                         requestedFrame:CGRectNull]];
+    return nullptr;
+  }
+
+  // Script-opened windows: Chromium made the contents already; the shell
+  // adopts or declines them (OACNewTabRequest.hasPendingContents).
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    OACTab* tab = tab_;
+    if (!tab) {
+      return nullptr;
+    }
+    content::WebContents* raw = new_contents.get();
+    [tab webContentsDidRequestNewTab:[[OACNewTabRequest alloc]
+                                         initWithOpener:tab
+                                                profile:tab.profile
+                                                    URL:net::NSURLWithGURL(
+                                                            target_url)
+                                            disposition:DispositionFromChromium(
+                                                            disposition)
+                                         hasUserGesture:user_gesture
+                                         requestedFrame:RequestedFrame(
+                                                            window_features)
+                                        pendingContents:std::move(
+                                                            new_contents)]];
+    return raw;
+  }
+
+ private:
+  __weak OACTab* tab_;
+};
