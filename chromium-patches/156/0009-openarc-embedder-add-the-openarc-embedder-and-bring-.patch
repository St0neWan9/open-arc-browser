@@ -0,0 +1,84 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_browser_main_parts.h"
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "content/public/common/result_codes.h"
+#include "openarc/browser/openarc_browser_context.h"
+#include "ui/display/screen.h"
+
+namespace openarc {
+
+namespace {
+OpenArcBrowserMainParts* g_main_parts = nullptr;
+}  // namespace
+
+OpenArcBrowserMainParts::OpenArcBrowserMainParts() {
+  CHECK(!g_main_parts);
+  g_main_parts = this;
+}
+
+OpenArcBrowserMainParts::~OpenArcBrowserMainParts() {
+  CHECK_EQ(g_main_parts, this);
+  g_main_parts = nullptr;
+}
+
+// static
+OpenArcBrowserMainParts* OpenArcBrowserMainParts::Get() {
+  return g_main_parts;
+}
+
+OpenArcBrowserContext* OpenArcBrowserMainParts::GetOrCreateBrowserContext(
+    const std::string& key,
+    const base::FilePath& path,
+    bool off_the_record) {
+  auto& context = browser_contexts_[key];
+  if (!context) {
+    context = std::make_unique<OpenArcBrowserContext>(path, off_the_record);
+  }
+  return context.get();
+}
+
+OpenArcBrowserContext* OpenArcBrowserMainParts::FindBrowserContext(
+    const std::string& key) {
+  auto it = browser_contexts_.find(key);
+  return it == browser_contexts_.end() ? nullptr : it->second.get();
+}
+
+void OpenArcBrowserMainParts::SetWillDestroyBrowserContextsCallback(
+    base::OnceClosure callback) {
+  will_destroy_browser_contexts_ = std::move(callback);
+}
+
+int OpenArcBrowserMainParts::PreCreateThreads() {
+  screen_ = std::make_unique<display::ScopedNativeScreen>();
+  return content::RESULT_CODE_NORMAL_EXIT;
+}
+
+int OpenArcBrowserMainParts::PreMainMessageLoopRun() {
+  // No window and no tab here: the shell creates profiles and tabs through
+  // OACApplication once startup returns. Chromium restores nothing itself.
+  LOG(INFO) << "OpenArc: browser process started";
+  return content::RESULT_CODE_NORMAL_EXIT;
+}
+
+void OpenArcBrowserMainParts::PostMainMessageLoopRun() {
+  if (will_destroy_browser_contexts_) {
+    std::move(will_destroy_browser_contexts_).Run();
+  }
+  // Off-the-record contexts go first: they may refer to their originals.
+  for (auto it = browser_contexts_.begin(); it != browser_contexts_.end();) {
+    if (it->second->IsOffTheRecord()) {
+      it = browser_contexts_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  browser_contexts_.clear();
+  screen_.reset();
+}
+
+}  // namespace openarc
