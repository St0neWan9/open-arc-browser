diff --git a/openarc/bridge/oac_application.mm b/openarc/bridge/oac_application.mm
new file mode 100644
index 000000000000..8dc30f9357f1
--- /dev/null
+++ b/openarc/bridge/oac_application.mm
@@ -0,0 +1,347 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import <OpenArcCore/OACApplication.h>
+
+#import <AppKit/AppKit.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/apple/foundation_util.h"
+#include "base/check.h"
+#include "base/logging.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/version_info/version_info.h"
+#include "components/embedder_support/user_agent_utils.h"
+#include "content/public/app/content_main.h"
+#include "content/public/app/content_main_runner.h"
+#include "openarc/app/openarc_main_delegate.h"
+#include "openarc/browser/openarc_browser_main_parts.h"
+#include "openarc/common/openarc_paths.h"
+
+#import <OpenArcCore/OACBrowserApplication.h>
+#import <OpenArcCore/OACTab.h>
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_profile_internal.h"
+
+namespace {
+
+// The browser process's content objects. They live from start to shutdown and
+// are destroyed on the main thread at the end of shutdown.
+struct EngineState {
+  std::unique_ptr<openarc::OpenArcMainDelegate> main_delegate;
+  std::unique_ptr<content::ContentMainRunner> main_runner;
+  // Storage for argv: content keeps pointers into it during startup.
+  std::vector<std::string> arguments;
+  std::vector<const char*> argv;
+};
+
+EngineState* g_engine = nullptr;
+
+}  // namespace
+
+@implementation OACApplicationConfiguration {
+  NSURL* _userDataDirectory;
+  NSURL* _cacheDirectory;
+  NSURL* _crashDumpDirectory;
+  NSString* _locale;
+  NSArray<NSString*>* _arguments;
+  NSArray<NSString*>* _additionalSwitches;
+  NSInteger _remoteDebuggingPort;
+}
+
+- (instancetype)initWithUserDataDirectory:(NSURL*)userDataDirectory {
+  if ((self = [super init])) {
+    _userDataDirectory = [userDataDirectory copy];
+    _arguments = NSProcessInfo.processInfo.arguments;
+    _additionalSwitches = @[];
+  }
+  return self;
+}
+
+- (NSURL*)userDataDirectory {
+  return _userDataDirectory;
+}
+- (void)setUserDataDirectory:(NSURL*)value {
+  _userDataDirectory = [value copy];
+}
+- (NSURL*)cacheDirectory {
+  return _cacheDirectory;
+}
+- (void)setCacheDirectory:(NSURL*)value {
+  _cacheDirectory = [value copy];
+}
+- (NSURL*)crashDumpDirectory {
+  return _crashDumpDirectory;
+}
+- (void)setCrashDumpDirectory:(NSURL*)value {
+  _crashDumpDirectory = [value copy];
+}
+- (NSString*)locale {
+  return _locale;
+}
+- (void)setLocale:(NSString*)value {
+  _locale = [value copy];
+}
+- (NSArray<NSString*>*)arguments {
+  return _arguments;
+}
+- (void)setArguments:(NSArray<NSString*>*)value {
+  _arguments = [value copy];
+}
+- (NSArray<NSString*>*)additionalSwitches {
+  return _additionalSwitches;
+}
+- (void)setAdditionalSwitches:(NSArray<NSString*>*)value {
+  _additionalSwitches = [value copy];
+}
+- (NSInteger)remoteDebuggingPort {
+  return _remoteDebuggingPort;
+}
+- (void)setRemoteDebuggingPort:(NSInteger)value {
+  _remoteDebuggingPort = value;
+}
+
+- (id)copyWithZone:(NSZone*)zone {
+  OACApplicationConfiguration* copy = [[OACApplicationConfiguration alloc]
+      initWithUserDataDirectory:_userDataDirectory];
+  copy.cacheDirectory = _cacheDirectory;
+  copy.crashDumpDirectory = _crashDumpDirectory;
+  copy.locale = _locale;
+  copy.arguments = _arguments;
+  copy.additionalSwitches = _additionalSwitches;
+  copy.remoteDebuggingPort = _remoteDebuggingPort;
+  return copy;
+}
+
+@end
+
+@implementation OACApplication {
+  OACApplicationState _state;
+  __weak id<OACApplicationDelegate> _delegate;
+  OACApplicationConfiguration* _configuration;
+  NSMutableDictionary<NSUUID*, OACProfile*>* _profiles;
+  NSHashTable<OACTab*>* _tabs;
+}
+
++ (OACApplication*)sharedApplication {
+  static OACApplication* shared = [[OACApplication alloc] initPrivate];
+  return shared;
+}
+
+- (instancetype)initPrivate {
+  if ((self = [super init])) {
+    _profiles = [NSMutableDictionary dictionary];
+    _tabs = [NSHashTable weakObjectsHashTable];
+  }
+  return self;
+}
+
+- (OACApplicationState)state {
+  return _state;
+}
+
+- (id<OACApplicationDelegate>)delegate {
+  return _delegate;
+}
+
+- (void)setDelegate:(id<OACApplicationDelegate>)delegate {
+  _delegate = delegate;
+}
+
+- (OACApplicationConfiguration*)configuration {
+  return _configuration;
+}
+
+- (BOOL)startWithConfiguration:(OACApplicationConfiguration*)configuration
+                         error:(NSError**)error {
+  CHECK(NSThread.isMainThread);
+  if (_state != OACApplicationStateNotStarted) {
+    if (error) {
+      *error = OACMakeError(_state == OACApplicationStateRunning
+                                ? OACErrorAlreadyStarted
+                                : OACErrorShuttingDown,
+                            @"The engine was already started.");
+    }
+    return NO;
+  }
+  // Chromium's message pump and event handling need the app's NSApplication
+  // to be an OACBrowserApplication (README, Startup sequence step 1).
+  CHECK([NSApp isKindOfClass:[OACBrowserApplication class]])
+      << "NSPrincipalClass must be OACBrowserApplication";
+
+  _configuration = [configuration copy];
+  [NSFileManager.defaultManager
+            createDirectoryAtURL:_configuration.userDataDirectory
+      withIntermediateDirectories:YES
+                       attributes:nil
+                            error:nil];
+
+  g_engine = new EngineState();
+  NSArray<NSString*>* arguments = _configuration.arguments;
+  g_engine->arguments.push_back(
+      arguments.count ? base::SysNSStringToUTF8(arguments[0])
+                      : base::SysNSStringToUTF8(
+                            NSProcessInfo.processInfo.arguments[0]));
+  for (NSUInteger i = 1; i < arguments.count; ++i) {
+    // Only switches are forwarded; positional arguments belong to the app.
+    if ([arguments[i] hasPrefix:@"--"]) {
+      g_engine->arguments.push_back(base::SysNSStringToUTF8(arguments[i]));
+    }
+  }
+  for (NSString* extra in _configuration.additionalSwitches) {
+    g_engine->arguments.push_back(base::SysNSStringToUTF8(extra));
+  }
+  if (_configuration.remoteDebuggingPort > 0) {
+    g_engine->arguments.push_back(
+        "--remote-debugging-port=" +
+        std::to_string(_configuration.remoteDebuggingPort));
+  }
+  if (_configuration.locale.length) {
+    g_engine->arguments.push_back(
+        "--lang=" + base::SysNSStringToUTF8(_configuration.locale));
+  }
+  for (const std::string& argument : g_engine->arguments) {
+    g_engine->argv.push_back(argument.c_str());
+  }
+
+  openarc::ConfigureBundleOverrides();
+
+  g_engine->main_delegate = std::make_unique<openarc::OpenArcMainDelegate>(
+      base::apple::NSURLToFilePath(_configuration.userDataDirectory));
+  g_engine->main_runner = content::ContentMainRunner::Create();
+  content::ContentMainParams params(g_engine->main_delegate.get());
+  params.argc = static_cast<int>(g_engine->argv.size());
+  params.argv = g_engine->argv.data();
+  params.host_runs_main_loop = true;
+  const int exit_code =
+      content::RunContentProcess(std::move(params), g_engine->main_runner.get());
+  if (exit_code != 0 || !openarc::OpenArcBrowserMainParts::Get()) {
+    LOG(ERROR) << "OpenArc: engine start failed: " << exit_code;
+    // Chromium cannot be restarted in this process.
+    _state = OACApplicationStateTerminated;
+    if (error) {
+      *error = OACMakeError(OACErrorNotStarted,
+                            @"Chromium's browser process failed to start.");
+    }
+    return NO;
+  }
+
+  __weak OACApplication* weakSelf = self;
+  openarc::OpenArcBrowserMainParts::Get()->SetWillDestroyBrowserContextsCallback(
+      base::BindOnce(^{
+        [weakSelf closeAllTabs];
+      }));
+  _state = OACApplicationStateRunning;
+  return YES;
+}
+
+- (void)closeAllTabs {
+  for (OACTab* tab in _tabs.allObjects) {
+    [tab close];
+  }
+}
+
+- (void)shutdownWithCompletionHandler:(void (^)(void))completionHandler {
+  CHECK(NSThread.isMainThread);
+  if (_state != OACApplicationStateRunning) {
+    OACPostToMainThread(completionHandler);
+    return;
+  }
+  _state = OACApplicationStateShuttingDown;
+  // Run outside whatever Chromium task or AppKit callback asked for it.
+  OACPostToMainThread(^{
+    [self closeAllTabs];
+    for (OACProfile* profile in self->_profiles.allValues) {
+      [profile invalidate];
+    }
+    [self->_profiles removeAllObjects];
+    g_engine->main_delegate->ShutdownBrowser();
+    g_engine->main_runner->Shutdown();
+    delete g_engine;
+    g_engine = nullptr;
+    self->_state = OACApplicationStateTerminated;
+    completionHandler();
+  });
+}
+
+- (NSString*)chromiumVersion {
+  return base::SysUTF8ToNSString(
+      std::string(version_info::GetVersionNumber()));
+}
+
+- (NSString*)userAgent {
+  return base::SysUTF8ToNSString(embedder_support::GetUserAgent());
+}
+
+// MARK: Profiles
+
+- (NSURL*)dataDirectoryForProfile:(NSUUID*)identifier {
+  return [[_configuration.userDataDirectory URLByAppendingPathComponent:@"Profiles"
+                                                            isDirectory:YES]
+      URLByAppendingPathComponent:identifier.UUIDString
+                      isDirectory:YES];
+}
+
+- (void)loadProfileWithIdentifier:(NSUUID*)identifier
+                completionHandler:(void (^)(OACProfile*, NSError*))
+                                      completionHandler {
+  if (_state != OACApplicationStateRunning) {
+    NSError* error =
+        OACMakeError(OACErrorNotStarted, @"The engine is not running.");
+    OACPostToMainThread(^{
+      completionHandler(nil, error);
+    });
+    return;
+  }
+  OACProfile* profile = _profiles[identifier];
+  if (!profile) {
+    NSURL* directory = [self dataDirectoryForProfile:identifier];
+    // TODO(C11): create the directory on a background thread.
+    [NSFileManager.defaultManager createDirectoryAtURL:directory
+                           withIntermediateDirectories:YES
+                                            attributes:nil
+                                                 error:nil];
+    profile = [[OACProfile alloc] initWithIdentifier:identifier
+                                       dataDirectory:directory
+                                     originalProfile:nil];
+    _profiles[identifier] = profile;
+  }
+  OACPostToMainThread(^{
+    completionHandler(profile, nil);
+  });
+}
+
+- (OACProfile*)loadedProfileWithIdentifier:(NSUUID*)identifier {
+  return _profiles[identifier];
+}
+
+- (NSArray<OACProfile*>*)loadedProfiles {
+  return _profiles.allValues;
+}
+
+- (void)deleteProfileWithIdentifier:(NSUUID*)identifier
+                  completionHandler:(void (^)(NSError*))completionHandler {
+  // TODO(C11): close the context and remove its directory.
+  NSError* error = OACMakeError(OACErrorInvalidArgument,
+                                @"Deleting profiles is not implemented yet.");
+  OACPostToMainThread(^{
+    completionHandler(error);
+  });
+}
+
+// MARK: Tabs
+
+- (void)registerTab:(OACTab*)tab {
+  [_tabs addObject:tab];
+}
+
+- (void)unregisterTab:(OACTab*)tab {
+  [_tabs removeObject:tab];
+}
+
+@end
