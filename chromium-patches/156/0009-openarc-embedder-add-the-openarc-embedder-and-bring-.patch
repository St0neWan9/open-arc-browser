@@ -0,0 +1,30 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BRIDGE_OAC_APPLICATION_INTERNAL_H_
+#define OPENARC_BRIDGE_OAC_APPLICATION_INTERNAL_H_
+
+#import <OpenArcCore/OACApplication.h>
+
+// Builds an NSError in OACErrorDomain.
+NSError* OACMakeError(OACErrorCode code, NSString* description);
+
+// Runs |block| on the main thread in a later run loop turn, in every common
+// run loop mode. This is how the bridge delivers callbacks (OACDefines.h
+// threading contract). Unlike dispatch_async to the main queue, it also runs
+// while the main queue is busy with the block that spun a nested loop, for
+// example -[NSApplication terminate:] called from a dispatch block, which waits
+// for NSTerminateLater's reply inside that block.
+void OACPostToMainThread(dispatch_block_t block);
+
+@class OACTab;
+
+@interface OACApplication ()
+// Live tabs register here so that shutdown can close them before the
+// browsing contexts go away. The set holds them weakly.
+- (void)registerTab:(OACTab*)tab;
+- (void)unregisterTab:(OACTab*)tab;
+@end
+
+#endif  // OPENARC_BRIDGE_OAC_APPLICATION_INTERNAL_H_
