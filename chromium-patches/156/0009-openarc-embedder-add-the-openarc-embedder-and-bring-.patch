+// MARK: Snapshot (C8)
+
+- (void)snapshotWithMaxPixelSize:(NSInteger)maxPixelSize
+               completionHandler:(void (^)(NSData*, CGSize, NSError*))
+                                     completionHandler {
+  content::RenderWidgetHostView* view =
+      _closed ? nullptr : _webContents->GetRenderWidgetHostView();
+  if (!view || _webContents->IsCrashed() || maxPixelSize <= 0) {
+    NSError* error = OACMakeError(OACErrorSnapshotUnavailable,
+                                  @"The page has no frame to copy.");
+    OACPostToMainThread(^{
+      completionHandler(nil, CGSizeZero, error);
+    });
+    return;
+  }
+  // Scale the view's pixel size so the longer side is at most maxPixelSize.
+  const gfx::Size points = view->GetViewBounds().size();
+  const float scale = view->GetDeviceScaleFactor();
+  double width = points.width() * scale;
+  double height = points.height() * scale;
+  const double longer = std::max(width, height);
+  if (longer > maxPixelSize && longer > 0) {
+    width = width * maxPixelSize / longer;
+    height = height * maxPixelSize / longer;
+  }
+  const gfx::Size output(std::max(1, static_cast<int>(width)),
+                         std::max(1, static_cast<int>(height)));
+  void (^handler)(NSData*, CGSize, NSError*) = [completionHandler copy];
+  view->CopyFromSurface(
+      gfx::Rect(), output, base::Seconds(5),
+      base::BindOnce(^(const content::CopyFromSurfaceResult& result) {
+        NSData* png = nil;
+        CGSize size = CGSizeZero;
+        if (result.has_value() && !result->bitmap.drawsNothing()) {
+          std::optional<std::vector<uint8_t>> encoded =
+              gfx::PNGCodec::EncodeBGRASkBitmap(result->bitmap,
+                                                /*discard_transparency=*/true);
+          if (encoded) {
+            png = [NSData dataWithBytes:encoded->data()
+                                 length:encoded->size()];
+            size = CGSizeMake(result->bitmap.width(), result->bitmap.height());
+          }
+        }
+        NSError* error =
+            png ? nil
+                : OACMakeError(OACErrorSnapshotUnavailable,
+                               @"The page has no frame to copy.");
+        // The copy may complete off the main thread.
+        OACPostToMainThread(^{
+          handler(png, size, error);
+        });
+      }));
+}
