+
+#ifndef OPENARC_BROWSER_OPENARC_TAB_PREFERENCES_H_
+#define OPENARC_BROWSER_OPENARC_TAB_PREFERENCES_H_
+
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/mojom/css/preferred_color_scheme.mojom-shared.h"
+
+namespace openarc {
+
+// Per-tab web preferences the shell controls (plan C8): today the color scheme
+// a page sees through prefers-color-scheme (OACTab.preferredColorScheme, B21).
+// OpenArcContentBrowserClient::OverrideWebPreferences applies them.
+class OpenArcTabPreferences
+    : public content::WebContentsUserData<OpenArcTabPreferences> {
+ public:
+  OpenArcTabPreferences(const OpenArcTabPreferences&) = delete;
+  OpenArcTabPreferences& operator=(const OpenArcTabPreferences&) = delete;
+  ~OpenArcTabPreferences() override;
+
+  blink::mojom::PreferredColorScheme color_scheme() const {
+    return color_scheme_;
+  }
+
+  // Stores the scheme and pushes the recomputed preferences to the renderer
+  // when it changed.
+  void SetColorScheme(blink::mojom::PreferredColorScheme color_scheme);
+
+ private:
+  friend class content::WebContentsUserData<OpenArcTabPreferences>;
+  explicit OpenArcTabPreferences(content::WebContents* web_contents);
+
+  blink::mojom::PreferredColorScheme color_scheme_ =
+      blink::mojom::PreferredColorScheme::kLight;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_TAB_PREFERENCES_H_
