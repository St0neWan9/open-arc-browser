+blink::mojom::PreferredColorScheme ToBlink(OACColorScheme scheme) {
+  return scheme == OACColorSchemeDark
+             ? blink::mojom::PreferredColorScheme::kDark
+             : blink::mojom::PreferredColorScheme::kLight;
+}
