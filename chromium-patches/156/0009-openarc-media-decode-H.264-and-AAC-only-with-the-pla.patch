+  // supported only if the platform decoder reported it.
+  return GetSupplementalDecoderAudioTypeCache()->IsProfileSupported(type);
+#else
   if (type.profile != AudioCodecProfile::kXHE_AAC) {
     return true;
   }
@@ -303,6 +308,7 @@ bool IsDecoderAACSupported(const AudioType& type) {
 #else
   return false;
 #endif
+#endif  // BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
 }
 
 bool IsDecoderDolbyVisionProfileSupported(const VideoType& type) {
@@ -447,7 +453,14 @@ bool IsDefaultDecoderSupportedVideoType(const VideoType& type) {
     case VideoCodec::kTheora:
       return IsDecoderBuiltInVideoCodec(type.codec);
     case VideoCodec::kH264:
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+      // Open Arc: there is no bundled H.264 decoder, so H.264 is supported
+      // only for the profiles the platform decoder reported.
+      return GetSupplementalDecoderVideoProfileCache()->IsProfileSupported(
