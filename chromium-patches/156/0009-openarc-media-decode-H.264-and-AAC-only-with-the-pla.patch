+    case AudioCodec::kAAC:
+      if (sample_format == kUnknownSampleFormat) {
+        sample_format = kSampleFormatPlanarF32;
+      }
+      break;
+#endif
 
     default:
       break;
@@ -479,6 +489,14 @@ bool AVCodecContextToAudioDecoderConfig(const AVCodecContext* codec_context,
     }
   }
 #endif
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+  // Open Arc: FFmpeg only demuxes AAC here, so |sample_fmt| is unset and the
+  // sample format above is the platform decoder's (see the switch above).
+  if (codec == AudioCodec::kAAC &&
+      codec_context->sample_fmt == AV_SAMPLE_FMT_NONE) {
+    return true;
+  }
+#endif
 
   // Verify that AudioConfig.bytes_per_channel was calculated correctly for
   // codecs that have |sample_fmt| set by FFmpeg.
@@ -1112,7 +1130,10 @@ int32_t HashCodecName(const char* codec_name) {
 }
 
 const char* GetAllowedAudioDecoders() {
-#if BUILDFLAG(USE_PROPRIETARY_CODECS)
+  // Open Arc: with MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY, FFmpeg is built
+  // without its AAC decoder; AAC goes to the platform decoder.
+#if BUILDFLAG(USE_PROPRIETARY_CODECS) && \
+    !BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
 #define EXTRA_CODECS ",aac"
 #else
 #define EXTRA_CODECS
diff --git a/media/filters/ffmpeg_demuxer.cc b/media/filters/ffmpeg_demuxer.cc
index f9e132f98b0f..cd36ecbe3ab7 100644
--- a/media/filters/ffmpeg_demuxer.cc
+++ b/media/filters/ffmpeg_demuxer.cc
@@ -1444,6 +1444,14 @@ void FFmpegDemuxer::OnFindStreamInfoDone(int result) {
         if (stream->codecpar->format == AV_PIX_FMT_NONE)
           stream->codecpar->format = AV_PIX_FMT_YUV420P;
       }
+#endif
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+      // Open Arc: likewise for H.264, which FFmpeg only demuxes here. The
+      // platform decoder reads the real format from the avcC record.
+      if (codec_id == AV_CODEC_ID_H264 &&
+          stream->codecpar->format == AV_PIX_FMT_NONE) {
+        stream->codecpar->format = AV_PIX_FMT_YUV420P;
+      }
 #endif
     } else if (codec_type == AVMEDIA_TYPE_SUBTITLE) {
       stream->discard = AVDISCARD_ALL;
diff --git a/media/filters/mac/audio_toolbox_audio_decoder.cc b/media/filters/mac/audio_toolbox_audio_decoder.cc
index 03c8cf1b0eaa..bc012ad70e05 100644
--- a/media/filters/mac/audio_toolbox_audio_decoder.cc
+++ b/media/filters/mac/audio_toolbox_audio_decoder.cc
@@ -39,14 +39,48 @@ bool CanUseAudioToolbox(const AudioDecoderConfig& config) {
       config.codec() == AudioCodec::kAC3) {
     return true;
   }
+#endif
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+  // Open Arc: there is no bundled AAC decoder, so AudioToolbox decodes every
+  // AAC profile (LC, HE-AAC v1/v2, xHE-AAC).
+  if (config.codec() == AudioCodec::kAAC) {
+    return true;
+  }
 #endif
   // We use AudioToolbox for decoding xHE-AAC content and that's available on
   // macOS 10.15 or higher.
   return config.profile() == AudioCodecProfile::kXHE_AAC;
 }
 
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+// Returns the size of the ADTS header that starts `data`, or 0 if `data` is
+// not exactly one ADTS frame. The MP4 stream parser (MSE) prepends ADTS
+// headers to AAC samples that fit in ADTS, and the MPEG-2 TS and ADTS stream
+// parsers pass ADTS frames through; AudioToolbox wants raw access units, with
+// the AudioSpecificConfig given once as the magic cookie. Checking the frame
+// length field keeps a raw access unit from being mistaken for ADTS.
+size_t GetAdtsHeaderSize(base::span<const uint8_t> data) {
+  constexpr size_t kAdtsHeaderSize = 7;
+  if (data.size() < kAdtsHeaderSize || data[0] != 0xFF ||
+      (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t frame_length = ((data[3] & 0x03) << 11) | (data[4] << 3) |
+                              ((data[5] & 0xE0) >> 5);
+  if (frame_length != data.size()) {
+    return 0;
+  }
+  // protection_absent == 0 adds a 16-bit CRC.
+  const size_t header_size = (data[1] & 0x01) ? kAdtsHeaderSize : 9;
+  return header_size < data.size() ? header_size : 0;
+}
+#endif  // BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+
 struct InputData {
   raw_ptr<DecoderBuffer> buffer = nullptr;
+  // Bytes at the start of `buffer` that are not part of the access unit (an
+  // ADTS header).
+  size_t offset = 0;
   AudioStreamPacketDescription packet = {};
 };
 
@@ -67,11 +101,12 @@ OSStatus ProvideInputCallback(AudioConverterRef decoder,
 
   *num_packets = buffer_list->mNumberBuffers = 1;
   buffer_list->mBuffers[0].mNumberChannels = 0;
-  buffer_list->mBuffers[0].mDataByteSize = input_data->buffer->size();
+  buffer_list->mBuffers[0].mDataByteSize =
+      input_data->buffer->size() - input_data->offset;
 
   // No const version of this API unfortunately, so we need const_cast().
-  buffer_list->mBuffers[0].mData =
-      const_cast<uint8_t*>(base::span(*input_data->buffer).data());
+  buffer_list->mBuffers[0].mData = const_cast<uint8_t*>(
+      base::span(*input_data->buffer).subspan(input_data->offset).data());
 
   if (packets)
     *packets = &input_data->packet;
@@ -115,8 +150,8 @@ void AudioToolboxAudioDecoder::Initialize(const AudioDecoderConfig& config,
                                           const OutputCB& output_cb,
                                           const WaitingCB& waiting_cb) {
   if (!CanUseAudioToolbox(config)) {
-    DLOG(WARNING)
-        << "Only xHE-AAC/AC3/E-AC3 decoding is supported by this decoder.";
+    DLOG(WARNING) << "Only AAC/AC3/E-AC3 decoding is supported by this "
+                     "decoder.";
     std::move(init_cb).Run(DecoderStatus::Codes::kUnsupportedCodec);
     return;
   }
@@ -171,7 +206,12 @@ void AudioToolboxAudioDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
       return;
     }
     last_input_timestamp_ = buffer->timestamp();
-    input_data.packet.mDataByteSize = buffer->size();
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+    if (codec_ == AudioCodec::kAAC) {
+      input_data.offset = GetAdtsHeaderSize(base::span(*buffer));
+    }
+#endif
+    input_data.packet.mDataByteSize = buffer->size() - input_data.offset;
   }
 
   // Must be filled in each time in case AudioConverterFillComplexBuffer()
@@ -270,11 +310,27 @@ bool AudioToolboxAudioDecoder::CreateDecoder(const AudioDecoderConfig& config) {
   AudioStreamBasicDescription input_format = {};
   std::vector<uint8_t> magic_cookie;
 
+  codec_ = config.codec();
   switch (config.codec()) {
     case AudioCodec::kAAC: {
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+      // Open Arc: any AAC profile. The AudioSpecificConfig is required: the
+      // MP4 'esds' box, FFmpeg's demuxers and the ADTS / MPEG-2 TS stream
+      // parsers all provide it. macOS fills in the exact format (LC, HE-AAC,
+      // HE-AAC v2, USAC) from the cookie below.
+      if (config.extra_data().empty()) {
+        MEDIA_LOG(ERROR, media_log_)
+            << "AAC without an AudioSpecificConfig is not supported";
+        return false;
+      }
+      input_format.mFormatID = config.profile() == AudioCodecProfile::kXHE_AAC
+                                   ? kAudioFormatMPEGD_USAC
+                                   : kAudioFormatMPEG4AAC;
+#else
       // Input is xHE-AAC / USAC.
       CHECK_EQ(config.profile(), AudioCodecProfile::kXHE_AAC);
       input_format.mFormatID = kAudioFormatMPEGD_USAC;
+#endif
       magic_cookie = mp4::ESDescriptor::CreateEsds(config.extra_data());
 
       // Have macOS fill in the rest of the input_format for us.
@@ -424,7 +480,12 @@ bool AudioToolboxAudioDecoder::CreateDecoder(const AudioDecoderConfig& config) {
           << "AudioConverterSetProperty() failed";
       return false;
     }
+  }
 
+  // Open Arc: with MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY other AAC profiles
+  // reach this decoder too; the loudness and DRC settings stay xHE-AAC only.
+  if (config.codec() == AudioCodec::kAAC &&
+      config.profile() == AudioCodecProfile::kXHE_AAC) {
     // macOS doesn't provide a default target loudness. Use the value
     // recommended by Fraunhofer. AC3/E-AC3 doesn't support set this,
     // so limit this to xHE-AAC only.
diff --git a/media/filters/mac/audio_toolbox_audio_decoder.h b/media/filters/mac/audio_toolbox_audio_decoder.h
