 media/base/supported_types.cc                 | 13 ++++
 media/ffmpeg/ffmpeg_common.cc                 | 23 +++++-
 media/filters/ffmpeg_demuxer.cc               |  8 ++
 .../mac/audio_toolbox_audio_decoder.cc        | 73 +++++++++++++++++--
 .../filters/mac/audio_toolbox_audio_decoder.h |  3 +
 media/media_options.gni                       | 24 +++++-
 .../services/gpu_mojo_media_client_mac.cc     |  6 ++
 8 files changed, 153 insertions(+), 12 deletions(-)

diff --git a/media/BUILD.gn b/media/BUILD.gn
index 1919962dd18c..be60a9dd3b5a 100644
--- a/media/BUILD.gn
+++ b/media/BUILD.gn
@@ -39,6 +39,7 @@ buildflag_header("media_buildflags") {
     "ENABLE_PLATFORM_ENCRYPTED_DOLBY_VISION=$enable_platform_encrypted_dolby_vision",
     "ENABLE_FFMPEG=$media_use_ffmpeg",
     "ENABLE_FFMPEG_VIDEO_DECODERS=$enable_ffmpeg_video_decoders",
+    "MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY=$media_proprietary_decoders_platform_only",
     "ENABLE_PLATFORM_HEVC=$enable_platform_hevc",
     "ENABLE_HEVC_PARSER_AND_HW_DECODER=$enable_hevc_parser_and_hw_decoder",
     "ENABLE_HLS_DEMUXER=$enable_hls_demuxer",
@@ -88,9 +89,17 @@ buildflag_header("media_buildflags") {
 }
 
 if (proprietary_codecs && media_use_ffmpeg) {
-  assert(
-      ffmpeg_branding != "Chromium",
-      "proprietary codecs and ffmpeg_branding set to Chromium are incompatible")
+  if (media_proprietary_decoders_platform_only) {
+    # Open Arc: the platform decodes H.264 and AAC, so FFmpeg must be the build
+    # without those decoders.
+    assert(ffmpeg_branding == "Chromium",
+           "media_proprietary_decoders_platform_only needs ffmpeg_branding " +
+               "set to Chromium")
+  } else {
+    assert(ffmpeg_branding != "Chromium",
+           "proprietary codecs and ffmpeg_branding set to Chromium are " +
+               "incompatible")
+  }
 }
 
 # Common configuration for targets in the media directory; these must not be
diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
index efc7246c8cd3..b83f2d425341 100644
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -294,6 +294,11 @@ bool IsDecoderAV1Supported(const VideoType& type) {
 }
 
