--- a/media/filters/mac/audio_toolbox_audio_decoder.h
+++ b/media/filters/mac/audio_toolbox_audio_decoder.h
@@ -61,6 +61,9 @@ class MEDIA_EXPORT AudioToolboxAudioDecoder : public AudioDecoder {
 
   std::unique_ptr<MediaLog> media_log_;
 
+  // Codec of the current configuration.
+  AudioCodec codec_ = AudioCodec::kUnknown;
+
   // "Converter" for turning encoded samples into raw audio.
   ScopedAudioConverterRef decoder_;
 
diff --git a/media/media_options.gni b/media/media_options.gni
index f3313ea46763..c8018400a7e7 100644
--- a/media/media_options.gni
+++ b/media/media_options.gni
@@ -21,6 +21,16 @@ is_cast_media_device = is_castos || is_cast_android
 # feature is compiled.
 enable_oop_video_decoder = is_chromeos && use_linux_video_acceleration
 
+declare_args() {
+  # Open Arc: with `proprietary_codecs`, decode H.264, HEVC and AAC only with
+  # the platform's decoders (VideoToolbox and AudioToolbox on macOS) and build
+  # no bundled software decoder for them: FFmpeg keeps the "Chromium" branding
+  # (no H.264 or AAC decoders), and neither FFmpeg's H.264 video decoder path
+  # nor OpenH264 is built. Demuxing (MP4, MSE, ADTS, MPEG-2 TS) and the
+  # bitstream parsers still come from //media.
+  media_proprietary_decoders_platform_only = false
+}
+
 declare_args() {
   # Allows distributions to link pulseaudio directly (DT_NEEDED) instead of
   # using dlopen. This helps with automated detection of ABI mismatches and
@@ -56,7 +66,8 @@ declare_args() {
   # Enable usage of OpenH264 within the media library. Used for software based
   # encoding of H264 content.
   media_use_openh264 = true
-  if (is_ios || (is_android && current_cpu == "arm") || !proprietary_codecs) {
+  if (is_ios || (is_android && current_cpu == "arm") || !proprietary_codecs ||
+      media_proprietary_decoders_platform_only) {
     media_use_openh264 = false
   }
 
@@ -243,9 +254,18 @@ declare_args() {
   # hardware decoders. To do so, you will also need to update ffmpeg build files
   # in order to define which decoders to build in.
   enable_ffmpeg_video_decoders =
-      media_use_ffmpeg && (!is_android || current_cpu != "arm")
+      media_use_ffmpeg && (!is_android || current_cpu != "arm") &&
+      !media_proprietary_decoders_platform_only
 }
 
+assert(!media_proprietary_decoders_platform_only || proprietary_codecs,
+       "media_proprietary_decoders_platform_only needs proprietary_codecs")
+assert(!media_proprietary_decoders_platform_only || is_mac,
+       "media_proprietary_decoders_platform_only is only wired up on macOS")
+assert(!media_proprietary_decoders_platform_only ||
+           (!enable_ffmpeg_video_decoders && !media_use_openh264),
+       "media_proprietary_decoders_platform_only excludes software H.264")
+
 declare_args() {
   # Enables the use of library CDMs that implements the interface defined at
   # media/cdm/api/content_decryption_module.h. If true, the actually library CDM
diff --git a/media/mojo/services/gpu_mojo_media_client_mac.cc b/media/mojo/services/gpu_mojo_media_client_mac.cc
index 1d1ec8a5dbba..afd1c6bdbd9f 100644
--- a/media/mojo/services/gpu_mojo_media_client_mac.cc
+++ b/media/mojo/services/gpu_mojo_media_client_mac.cc
@@ -11,6 +11,7 @@
 #include "media/filters/mac/audio_toolbox_audio_decoder.h"
 #include "media/filters/mac/audio_toolbox_audio_encoder.h"
 #include "media/gpu/mac/video_toolbox_video_decoder.h"
+#include "media/media_buildflags.h"
 #include "media/mojo/services/gpu_mojo_media_client.h"
 
 namespace media {
@@ -32,6 +33,11 @@ class GpuMojoMediaClientMac final : public GpuMojoMediaClient {
   std::optional<SupportedAudioDecoderConfigs>
   GetPlatformSupportedAudioDecoderConfigs() final {
     SupportedAudioDecoderConfigs audio_configs;
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+    // Open Arc: AudioToolbox decodes every AAC profile (LC, HE-AAC v1/v2 map
+    // to kUnknown), since there is no bundled AAC decoder.
+    audio_configs.emplace_back(AudioCodec::kAAC, AudioCodecProfile::kUnknown);
+#endif
     audio_configs.emplace_back(AudioCodec::kAAC, AudioCodecProfile::kXHE_AAC);
 #if BUILDFLAG(ENABLE_PLATFORM_AC3_EAC3_AUDIO)
     audio_configs.emplace_back(AudioCodec::kAC3, AudioCodecProfile::kUnknown);
