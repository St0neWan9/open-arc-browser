diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
index 1eeaafafaf77..b977d5269c9d 100644
--- a/media/ffmpeg/ffmpeg_common.cc
+++ b/media/ffmpeg/ffmpeg_common.cc
@@ -409,6 +409,16 @@ bool AVCodecContextToAudioDecoderConfig(const AVCodecContext* codec_context,
       sample_format = kSampleFormatMpegHAudio;
       break;
 #endif
+#if BUILDFLAG(MEDIA_PROPRIETARY_DECODERS_PLATFORM_ONLY)
+    // Open Arc: FFmpeg has no AAC decoder in this configuration, so it only
+    // demuxes AAC and leaves |sample_fmt| unset. The platform decoder outputs
