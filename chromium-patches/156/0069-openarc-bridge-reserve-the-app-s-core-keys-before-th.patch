+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BRIDGE_OAC_RESERVED_KEYS_H_
+#define OPENARC_BRIDGE_OAC_RESERVED_KEYS_H_
+
+namespace content {
+class WebContents;
+}
+
+namespace input {
+struct NativeWebKeyboardEvent;
+}
+
+namespace openarc {
+
+// Plan B138 (decision: follow Chrome; docs/f5-review.md F5-7). The app's core
+// shortcuts are reserved: the shell gets them before the page, so a page that
+// calls preventDefault() on them cannot block them. Every other key goes to
+// the page first and reaches the shell only when the page leaves it unhandled
+// (WebContentsDelegate::HandleKeyboardEvent, -tab:handleUnhandledKeyEvent:).
+//
+// This is the one list of reserved keys. The shell binds the keys in its menus
+// (app/Sources/OpenArcShell/Settings/ShortcutCatalog.swift); a reserved key is
+// offered to the main menu (NSApp.mainMenu), and goes to the page as usual
+// when no enabled item there takes it.
+//
+//   Tabs        ⌘T  ⇧⌘T  ⌘W  ⌘D  ⌘L  ⌘1…⌘9  ⌘{  ⌘}  ⌥⌘↑  ⌥⌘↓  ⌃Tab  ⌃⇧Tab
+//   Spaces      ⌃1…⌃9  ⌥⌘←  ⌥⌘→
+//   Navigation  ⌘[  ⌘]  ⌘R  ⇧⌘R
+//   Copy URL    ⇧⌘C
+//   Windows     ⌘N  ⇧⌘N  ⇧⌘W
+//   App         ⌘,  ⌘Q
+//
+// Chrome reserves new tab / window / incognito window, close tab / window,
+// restore tab, next / previous tab and quit
+// (BrowserCommandController::IsReservedCommandOrKey). The rest are the keys an
+// Open Arc user moves around with (command bar, pin, sidebar items, Spaces,
+// back / forward, reload, copy URL, Settings). ⌃Tab / ⌃⇧Tab are Chrome's tab
+// keys; they stay with the page while no menu item of the shell binds them.
+//
+// As Chrome on macOS does with its toolbar hidden, nothing but ⌘Q is reserved
+// while the page is in HTML fullscreen. Keys a page locked with the Keyboard
+// Lock API skip this step (content never pre-handles them). As in Chrome, a
+// held-down ⌘T, ⌘N or ⇧⌘N does not repeat.
+bool IsReservedAppKey(const input::NativeWebKeyboardEvent& event);
+
+// Whether a key repeat of the reserved key |event| is dropped (⌘T, ⌘N, ⇧⌘N),
+// so a held key does not open a stream of tabs or windows.
+bool DropsReservedKeyRepeat(const input::NativeWebKeyboardEvent& event);
+
+// Whether |event| goes to the shell before |web_contents|' page: the raw
+// key-down of a reserved key, with its NSEvent, that the page did not lock.
+bool ShouldOfferKeyToShellFirst(content::WebContents* web_contents,
+                                const input::NativeWebKeyboardEvent& event);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BRIDGE_OAC_RESERVED_KEYS_H_
diff --git a/openarc/bridge/oac_reserved_keys.mm b/openarc/bridge/oac_reserved_keys.mm
new file mode 100644
index 000000000000..379e964c27d9
--- /dev/null
+++ b/openarc/bridge/oac_reserved_keys.mm
@@ -0,0 +1,117 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/bridge/oac_reserved_keys.h"
+
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace openarc {
+
+namespace {
+
+using blink::WebInputEvent;
+
+constexpr int kCommand = WebInputEvent::kMetaKey;
+constexpr int kShift = WebInputEvent::kShiftKey;
+constexpr int kControl = WebInputEvent::kControlKey;
+constexpr int kOption = WebInputEvent::kAltKey;
+// A reserved key matches these modifiers exactly; Caps Lock, Fn, keypad and
+// repeat bits do not count.
+constexpr int kModifierMask = kCommand | kShift | kControl | kOption;
+
+struct ReservedKey {
+  ui::KeyboardCode key;
+  int modifiers;
+};
+
+// The list in oac_reserved_keys.h, in the same order, except the numbered
+// keys (IsReservedAppKey). Keys are the Windows key codes content derives from
+// the NSEvent; ⌘{ and ⌘} are ⇧⌘[ and ⇧⌘].
+constexpr ReservedKey kReservedKeys[] = {
+    // Tabs.
+    {ui::VKEY_T, kCommand},               // New Tab… (command bar)
+    {ui::VKEY_T, kShift | kCommand},      // Restore Last Closed Tab
+    {ui::VKEY_W, kCommand},               // Archive Tab
+    {ui::VKEY_D, kCommand},               // Pin / Unpin Tab
+    {ui::VKEY_L, kCommand},               // Open Command Bar
+    {ui::VKEY_OEM_4, kShift | kCommand},  // ⌘{ Previous Tab
+    {ui::VKEY_OEM_6, kShift | kCommand},  // ⌘} Next Tab
+    {ui::VKEY_UP, kOption | kCommand},    // Previous Tab
+    {ui::VKEY_DOWN, kOption | kCommand},  // Next Tab
+    {ui::VKEY_TAB, kControl},             // Next Tab (Chrome's key)
+    {ui::VKEY_TAB, kShift | kControl},    // Previous Tab (Chrome's key)
+    // Spaces.
+    {ui::VKEY_LEFT, kOption | kCommand},   // Previous Space
+    {ui::VKEY_RIGHT, kOption | kCommand},  // Next Space
+    // Navigation.
+    {ui::VKEY_OEM_4, kCommand},       // ⌘[ Go Back
+    {ui::VKEY_OEM_6, kCommand},       // ⌘] Go Forward
+    {ui::VKEY_R, kCommand},           // Refresh the Page
+    {ui::VKEY_R, kShift | kCommand},  // Force Refresh
+    // Copy URL.
+    {ui::VKEY_C, kShift | kCommand},
+    // Windows.
+    {ui::VKEY_N, kCommand},           // New Window
+    {ui::VKEY_N, kShift | kCommand},  // New Incognito Window
+    {ui::VKEY_W, kShift | kCommand},  // Close Window
+    // App.
+    {ui::VKEY_OEM_COMMA, kCommand},  // Settings…
+    {ui::VKEY_Q, kCommand},          // Quit
+};
+
+int Modifiers(const input::NativeWebKeyboardEvent& event) {
+  return event.GetModifiers() & kModifierMask;
+}
+
+}  // namespace
+
+bool IsReservedAppKey(const input::NativeWebKeyboardEvent& event) {
+  const int modifiers = Modifiers(event);
+  const int key = event.windows_key_code;
+  // ⌘1…⌘9 Go to Sidebar Item, ⌃1…⌃9 Go to Space.
+  if (key >= ui::VKEY_1 && key <= ui::VKEY_9 &&
+      (modifiers == kCommand || modifiers == kControl)) {
+    return true;
+  }
+  for (const ReservedKey& reserved : kReservedKeys) {
+    if (reserved.key == key && reserved.modifiers == modifiers) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool DropsReservedKeyRepeat(const input::NativeWebKeyboardEvent& event) {
+  if (!(event.GetModifiers() & WebInputEvent::kIsAutoRepeat)) {
+    return false;
+  }
+  const int modifiers = Modifiers(event);
+  const int key = event.windows_key_code;
+  return (key == ui::VKEY_T && modifiers == kCommand) ||
+         (key == ui::VKEY_N &&
+          (modifiers == kCommand || modifiers == (kShift | kCommand)));
+}
+
+bool ShouldOfferKeyToShellFirst(content::WebContents* web_contents,
+                                const input::NativeWebKeyboardEvent& event) {
+  if (!web_contents || event.GetType() != WebInputEvent::Type::kRawKeyDown ||
+      event.skip_if_unhandled || !event.os_event) {
+    return false;
+  }
+  if (!IsReservedAppKey(event)) {
+    return false;
+  }
+  // HTML fullscreen: only Quit stays reserved (Chrome on macOS keeps only
+  // its exit and fullscreen commands while the toolbar is hidden).
+  if (web_contents->IsFullscreen()) {
+    return event.windows_key_code == ui::VKEY_Q &&
+           Modifiers(event) == kCommand;
+  }
+  return true;
+}
+
+}  // namespace openarc
