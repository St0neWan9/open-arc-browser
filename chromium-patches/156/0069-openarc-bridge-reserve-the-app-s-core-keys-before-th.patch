@@ -160,6 +161,8 @@ - (void)webContentsDidHoverURL:(const GURL&)url;
 - (void)webContentsDidRequestActivation;
 - (BOOL)webContentsHandleUnhandledKeyEvent:
     (const input::NativeWebKeyboardEvent&)event;
+- (BOOL)webContentsHandleReservedKeyEvent:
+    (const input::NativeWebKeyboardEvent&)event;
 - (void)webContentsDidReplyToFind:(int)requestId
                           matches:(int)matches
                     activeOrdinal:(int)activeOrdinal
@@ -299,12 +302,26 @@ bool HandleKeyboardEvent(
       const input::NativeWebKeyboardEvent& event) override {
     return [tab_ webContentsHandleUnhandledKeyEvent:event];
   }
-  // Plan C26: extension keyboard commands come before the page, as Chrome's
-  // FocusManager registers them at high priority.
+  // Before the page: extension keyboard commands (plan C26), as Chrome's
+  // FocusManager registers them at high priority; then the app's reserved
+  // keys (plan B138, oac_reserved_keys.h), as Chrome's BrowserView does with
+  // its reserved accelerators. A reserved key the shell does not take (no
+  // enabled menu item binds it) goes on to the page exactly as other keys.
   content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
       content::WebContents* source,
       const input::NativeWebKeyboardEvent& event) override {
-    return openarc::HandleExtensionCommandKeyEvent(source, event)
+    if (openarc::HandleExtensionCommandKeyEvent(source, event)) {
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    if (!openarc::ShouldOfferKeyToShellFirst(source, event)) {
+      return content::KeyboardEventProcessingResult::NOT_HANDLED;
+    }
+    if (openarc::DropsReservedKeyRepeat(event)) {
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    // The shell may close the tab from here (as Chrome's reserved ⌘W does);
+    // nothing of |this| is used afterwards.
+    return [tab_ webContentsHandleReservedKeyEvent:event]
                ? content::KeyboardEventProcessingResult::HANDLED
                : content::KeyboardEventProcessingResult::NOT_HANDLED;
   }
@@ -1114,15 +1131,28 @@ - (void)webContentsDidRequestActivation {
   });
 }
 
-// Unconsumed key events reach the shell synchronously, so ⌘T, ⌘L and the
-// other menu shortcuts keep working while the page has focus. The default
-// (no delegate method) offers the event to the main menu, as content_shell
-// does.
+// Unconsumed key events reach the shell synchronously, so the menu shortcuts
+// keep working while the page has focus. The default (no delegate method)
+// offers the event to the main menu, as content_shell does.
 - (BOOL)webContentsHandleUnhandledKeyEvent:
     (const input::NativeWebKeyboardEvent&)event {
   if (event.skip_if_unhandled) {
     return NO;
   }
+  return [self offerKeyEventToShell:event];
+}
+
+// Plan B138: a reserved app key (oac_reserved_keys.h), before the page sees
+// it. Same delegate method and default as an unhandled key.
+- (BOOL)webContentsHandleReservedKeyEvent:
+    (const input::NativeWebKeyboardEvent&)event {
+  if (_closed) {
+    return NO;
+  }
+  return [self offerKeyEventToShell:event];
+}
+
+- (BOOL)offerKeyEventToShell:(const input::NativeWebKeyboardEvent&)event {
   NSEvent* nsEvent = event.os_event.Get();
   if (!nsEvent || nsEvent.type != NSEventTypeKeyDown) {
     return NO;
diff --git a/openarc/bridge/public/OpenArcCore/OACTabDelegate.h b/openarc/bridge/public/OpenArcCore/OACTabDelegate.h
index 962295ad2a1f..41c4c1e9c2ca 100644
--- a/openarc/bridge/public/OpenArcCore/OACTabDelegate.h
+++ b/openarc/bridge/public/OpenArcCore/OACTabDelegate.h
@@ -174,9 +174,13 @@ NS_SWIFT_UI_ACTOR
 /// pointer leaves the link).
 - (void)tab:(OACTab *)tab didHoverLinkURL:(nullable NSURL *)url;
 
-/// A keyboard event the page did not consume. The shell returns YES when it handled it (so the
-/// app's shortcuts such as ⌘T, ⌘L, ⌘S keep working while the page has focus). The event is the
-/// `NSEvent`, typed `id` so this header stays free of AppKit.
+/// A key-down for the shell's menu shortcuts while the page has focus. The shell returns YES when
+/// it handled it. Two moments (plan B138, following Chrome's reserved keys): the app's core keys
+/// (⌘T, ⌘L, ⌘W, ⌘N, ⌘R, ⌘1…⌘9, ⌃1…⌃9 and the others listed in the bridge's
+/// oac_reserved_keys.h) come here before the page sees them, so a page cannot block them; NO hands
+/// the key on to the page. Every other key comes here only when the page did not consume it. The
+/// event is the `NSEvent`, typed `id` so this header stays free of AppKit. Without this method the
+/// bridge offers the event to `NSApp.mainMenu` at the same two moments.
 - (BOOL)tab:(OACTab *)tab handleUnhandledKeyEvent:(id)event;
 
 /// The user right-clicked the page (plan B124). The bridge draws no menu itself: `menu` holds
