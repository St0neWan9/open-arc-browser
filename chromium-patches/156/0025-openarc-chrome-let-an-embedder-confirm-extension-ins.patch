   EmbedderTabLookupCallback() = std::move(lookup);
 }
 
+// static
+void ExtensionTabUtil::SetEmbedderTabList(EmbedderTabList list) {
+  EmbedderTabListCallback() = std::move(list);
+}
+
+// static
+std::vector<ExtensionTabUtil::EmbedderTab> ExtensionTabUtil::GetEmbedderTabs(
+    content::BrowserContext* browser_context,
+    bool include_incognito) {
+  const EmbedderTabList& list = EmbedderTabListCallback();
+  if (!list || !browser_context) {
+    return {};
+  }
+  return list.Run(browser_context, include_incognito);
+}
