diff --git a/chrome/browser/extensions/api/tabs/tabs_api.cc b/chrome/browser/extensions/api/tabs/tabs_api.cc
index 2a631eb9fc79..ec24e6ac63d6 100644
--- a/chrome/browser/extensions/api/tabs/tabs_api.cc
+++ b/chrome/browser/extensions/api/tabs/tabs_api.cc
@@ -1936,9 +1936,85 @@ base::ListValue TabsQueryFunction::BuildTabList(
                         .ToValue());
     }
   }
+
+  // Open Arc: tabs of an embedder-owned UI live in no Browser window. They
+  // have no window id and no index, so a query for a given window or index
+  // never matches them.
+  if (window_id < 0 && tab_index < 0 && window_type.empty()) {
+    for (const ExtensionTabUtil::EmbedderTab& embedder_tab :
+         ExtensionTabUtil::GetEmbedderTabs(browser_context(),
+                                           include_incognito_information())) {
+      if (MatchesEmbedderTab(embedder_tab, url_patterns)) {
+        api::tabs::Tab tab_object = tabs_internal::CreateTabObjectHelper(
+            embedder_tab.contents, extension(), source_context_type(),
+            /*browser=*/nullptr, /*tab_index=*/-1);
+        tab_object.active = embedder_tab.active;
+        tab_object.selected = embedder_tab.active;
+        tab_object.highlighted = embedder_tab.active;
+        result.Append(tab_object.ToValue());
+      }
+    }
+  }
   return result;
 }
 
+bool TabsQueryFunction::MatchesEmbedderTab(
+    const ExtensionTabUtil::EmbedderTab& embedder_tab,
+    const URLPatternSet& target_url_patterns) {
+  content::WebContents* web_contents = embedder_tab.contents;
+  if (!web_contents) {
+    return false;
+  }
+  // Window properties: the embedder's tabs are in its one window list; the
+  // "current" and "last focused" window is the one the user works in.
+  if (!MatchesBool(query_info_.current_window,
+                   embedder_tab.in_current_window) ||
+      !MatchesBool(query_info_.last_focused_window,
+                   embedder_tab.in_current_window) ||
+      !MatchesBool(query_info_.active, embedder_tab.active) ||
+      !MatchesBool(query_info_.highlighted, embedder_tab.active) ||
+      !MatchesBool(query_info_.pinned, false) ||
+      !MatchesBool(query_info_.muted, web_contents->IsAudioMuted()) ||
+      !MatchesBool(query_info_.audible, web_contents->IsCurrentlyAudible()) ||
+      !MatchesBool(query_info_.discarded, false) ||
+      !MatchesBool(query_info_.frozen, false)) {
+    return false;
+  }
+  if ((query_info_.group_id && *query_info_.group_id != -1) ||
+      (query_info_.split_view_id && *query_info_.split_view_id != -1)) {
+    return false;
+  }
+  ExtensionTabUtil::ScrubTabBehavior scrub_tab_behavior =
+      ExtensionTabUtil::GetScrubTabBehavior(extension(), source_context_type(),
+                                            web_contents);
+  if (query_info_.title && !query_info_.title->empty()) {
+    if (scrub_tab_behavior.committed_info == ExtensionTabUtil::kScrubTabFully ||
+        !base::MatchPattern(web_contents->GetTitle(),
+                            base::UTF8ToUTF16(*query_info_.title))) {
+      return false;
+    }
+  }
+  if (!target_url_patterns.is_empty()) {
+    bool matches_committed =
+        scrub_tab_behavior.committed_info != ExtensionTabUtil::kScrubTabFully &&
+        target_url_patterns.MatchesURL(web_contents->GetLastCommittedURL());
+    content::NavigationEntry* pending_entry =
+        web_contents->GetController().GetPendingEntry();
+    bool matches_pending =
+        pending_entry &&
+        scrub_tab_behavior.pending_info != ExtensionTabUtil::kScrubTabFully &&
+        target_url_patterns.MatchesURL(pending_entry->GetVirtualURL());
+    if (!matches_committed && !matches_pending) {
+      return false;
+    }
+  }
+  if (query_info_.status != tabs::TabStatus::kNone &&
+      query_info_.status != ExtensionTabUtil::GetLoadingStatus(web_contents)) {
+    return false;
+  }
+  return true;
+}
