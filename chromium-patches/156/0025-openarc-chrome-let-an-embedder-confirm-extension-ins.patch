   // The implementations of this function are platform-specific.
   static ShowDialogCallback GetDefaultShowDialogCallback();
 
+  // Open Arc: an app that embeds the browser process and owns the UI
+  // (chrome::EmbedderOwnsUI() on Mac) has no Browser window to parent Chrome's
+  // Views install dialog to, and draws the confirmation itself. When set, every
