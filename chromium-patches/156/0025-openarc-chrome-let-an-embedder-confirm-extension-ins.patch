                                                     bool include_incognito)>;
   static void SetEmbedderTabLookup(EmbedderTabLookup lookup);
 
+  // Open Arc: the same embedder's tabs for chrome.tabs.query(), which lists
+  // the tab strips of Browser windows only. `active`: the tab is shown in its
+  // window (the selected tab, or a pane of a split view); `in_current_window`:
+  // its window is the one the user works in (the main window). Such a tab has
+  // no window id and no index. Not part of upstream Chromium.
+  struct EmbedderTab {
+    raw_ptr<content::WebContents> contents;
+    bool active = false;
+    bool in_current_window = false;
+  };
+  using EmbedderTabList =
+      base::RepeatingCallback<std::vector<EmbedderTab>(content::BrowserContext*,
+                                                       bool include_incognito)>;
+  static void SetEmbedderTabList(EmbedderTabList list);
+  // The embedder's live tabs in `browser_context` (and its incognito profile
+  // when `include_incognito`); empty when no embedder registered a list.
+  static std::vector<EmbedderTab> GetEmbedderTabs(
+      content::BrowserContext* browser_context,
+      bool include_incognito);
+
   // Gets the extensions-specific Group ID.
   static int GetGroupId(const tab_groups::TabGroupId& id);
 
