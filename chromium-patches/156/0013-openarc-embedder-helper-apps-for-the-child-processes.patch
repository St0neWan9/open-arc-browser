 base::FilePath OpenArcContentBrowserClient::GetChildProcessPath(int flags) {
-  // One unbundled helper for every child type until the helper apps of plan
-  // C10 exist (they will add the renderer / GPU / plugin / alerts variants).
-  return GetHelperExecutablePath();
+  // One helper app per code-signing variant (plan C10, app/helpers.gni), in
+  // the framework's Helpers/ directory, as content and //chrome would pick
+  // Chrome's own helpers. The "plugin" helper has no process type yet.
+  switch (flags) {
+    case content::ChildProcessHost::CHILD_NORMAL:
+      return GetHelperExecutablePath(kHelperSuffix_default);
+    case content::ChildProcessHost::CHILD_RENDERER:
+      return GetHelperExecutablePath(kHelperSuffix_renderer);
+    case content::ChildProcessHost::CHILD_GPU:
+      return GetHelperExecutablePath(kHelperSuffix_gpu);
+    case std::to_underlying(ChildProcessHostFlags::kChildProcessHelperAlerts):
+      return GetHelperExecutablePath(kHelperSuffix_alerts);
+  }
+  NOTREACHED() << "unknown child process flags " << flags;
 }
 
