 #include <dlfcn.h>
 #include <libgen.h>
@@ -29,14 +30,34 @@ namespace {
 
 using ChildProcessMainPtr = int (*)(int, const char**);
 
-// Relative to the helper's directory (Versions/A/Helpers).
-constexpr char kLibraryRelativePath[] = "../OpenArcCore";
+// Relative to the executable's directory
+// (Versions/A/Helpers/<helper>.app/Contents/MacOS).
+constexpr char kLibraryRelativePath[] = "../../../../OpenArcCore";
+
+// True if the command line names a process type. The browser process always
+// passes one; without it the helper was started by someone else, for example
+// by macOS when the user clicks an alert of the notification helper (Chrome
+// exits early in the same cases, chrome_main_mac.mm).
+bool HasProcessType(int argc, char* argv[]) {
+  static constexpr char kTypeSwitch[] = "--type=";
+  for (int i = 1; i < argc; ++i) {
+    if (UNSAFE_TODO(strncmp(argv[i], kTypeSwitch, sizeof(kTypeSwitch) - 1)) ==
+        0) {
+      return true;
+    }
+  }
+  return false;
+}
 
 }  // namespace
 
 int main(int argc, char* argv[]) {
   partition_alloc::EarlyMallocZoneRegistration();
 
+  if (!HasProcessType(argc, argv)) {
+    return 0;
+  }
+
   uint32_t exec_path_size = 0;
   if (_NSGetExecutablePath(nullptr, &exec_path_size) != -1) {
     fprintf(stderr, "_NSGetExecutablePath: get length failed\n");
