+// loads the OpenArcCore library and calls OACChildProcessMain. It must not
+// link //base: the library carries its own copy, and two would split the
+// allocator and globals.
 //
-// Layout (plan C8): the helper is OpenArcCore.framework/Versions/A/Helpers/
-// openarc_helper and the library is Versions/A/OpenArcCore, so the library is
