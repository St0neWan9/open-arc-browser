-# Child processes (renderer, GPU, utility). It lives in the framework's Helpers/
-# directory, loads the framework's library (../OpenArcCore) and calls
-# OACChildProcessMain. Same split as Chrome's helpers: the executable only
-# sets up the sandbox and loads the library, so //base exists once per process.
-executable("openarc_helper") {
-  sources = [ "app/openarc_helper_main.cc" ]
-  deps = [
-    # Despite its path, this does not add a //base dependency.
-    "//base/allocator:early_zone_registration_apple",
-    "//base:compiler_specific",
-    "//sandbox/mac:seatbelt",
+# The helper names as C++ constants (openarc/app/openarc_helpers.h), so the
+# browser process finds the helper apps under the names this file gives them.
+source_set("helper_names") {
+  visibility = [ ":*" ]
+  _lines = [
+    "// Generated by //openarc:helper_names from openarc/app/helpers.gni.",
+    "",
+    "#ifndef OPENARC_APP_OPENARC_HELPERS_H_",
+    "#define OPENARC_APP_OPENARC_HELPERS_H_",
+    "",
+    "namespace openarc {",
+    "",
+    "// Base name of the helper apps and their executables.",
+    "inline constexpr char kHelperName[] = \"$openarc_helper_name\";",
+    "",
+    "// Name suffix of each helper variant (kHelperSuffix_<variant>).",
+  ]
+  foreach(helper_params, openarc_mac_helpers) {
+    _lines += [ "inline constexpr char kHelperSuffix_${helper_params[0]}[] = \"${helper_params[2]}\";" ]
+  }
+  _lines += [
+    "",
+    "}  // namespace openarc",
+    "",
+    "#endif  // OPENARC_APP_OPENARC_HELPERS_H_",
+    "",
   ]
+  _file = "$root_gen_dir/openarc/app/openarc_helpers.h"
+  write_file(_file, _lines)
+  sources = [ _file ]
+}
+
+# The alerts helper's Info.plist: the common one plus the alert style.
+action("openarc_helper_alerts_plist") {
+  script = "//build/apple/plist_util.py"
+  sources = [
+    "app/helper-Info.plist",
+    "app/helper-alerts-Info.plist",
+  ]
+  outputs = [ "$target_gen_dir/helper-alerts-Info.plist" ]
+  args = [
+           "merge",
+           "-f=xml1",
+           "-o=" + rebase_path(outputs[0], root_build_dir),
+         ] + rebase_path(sources, root_build_dir)
+}
+
+# Child processes (renderer, GPU, utility, notifications): one helper app per
+# variant of openarc_mac_helpers. The executable sets up the seatbelt sandbox,
+# then loads the framework's library (Versions/A/OpenArcCore, four directories
+# up from Contents/MacOS) and calls OACChildProcessMain. Same split as
+# Chrome's helpers: the executable does not link //base, so //base exists once
+# per process. scripts/make-app.sh in the Open Arc repository signs each
+# variant with its own entitlements.
+foreach(helper_params, openarc_mac_helpers) {
+  mac_app_bundle("openarc_helper_app_${helper_params[0]}") {
+    output_name = openarc_helper_name + helper_params[2]
+    if (helper_params[0] == "alerts") {
+      info_plist_target = ":openarc_helper_alerts_plist"
+    } else {
+      info_plist = "app/helper-Info.plist"
+    }
+    extra_substitutions = [
+      "OPENARC_CHROMIUM_VERSION=$chrome_version_full",
+      "OPENARC_HELPER_BUNDLE_ID=$openarc_release_bundle_id.helper${helper_params[1]}",
+    ]
+    sources = [ "app/openarc_helper_main.cc" ]
+    deps = [
+      # Despite its path, this does not add a //base dependency.
+      "//base/allocator:early_zone_registration_apple",
+      "//base:compiler_specific",
+      "//sandbox/mac:seatbelt",
+    ]
+  }
 }
 
