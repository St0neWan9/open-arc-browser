diff --git a/openarc/app/helpers.gni b/openarc/app/helpers.gni
new file mode 100644
index 000000000000..e103af447d6d
--- /dev/null
+++ b/openarc/app/helpers.gni
@@ -0,0 +1,71 @@
+# Copyright 2026 The Open Arc Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Open Arc's helper apps (plan C10): the child-process executables, one app
+# bundle per code-signing variant, in OpenArcCore.framework/Versions/A/Helpers/.
+# Chrome's Mac helper model (//content/public/app/mac_helpers.gni plus
+# //chrome's alerts helper) with our own names. The browser process picks the
+# variant by the child flags content passes to
+# ContentBrowserClient::GetChildProcessPath() (openarc_content_browser_client.mm);
+# the names reach C++ through the generated openarc/app/openarc_helpers.h.
+#
+# The bundle ids here are the release app's (org.openarc.browser.helper…).
+# scripts/make-app.sh rewrites them to the embedding app's id, so the
+# development build's helpers are org.openarc.browser.dev.helper…, matching
+# the base bundle id every process reads from the embedding app (patch 0009).
+
+# The base name of every helper app and executable.
+openarc_helper_name = "Open Arc Helper"
+
+# The release app's placeholder bundle id (CLAUDE.md, decision Q5).
+openarc_release_bundle_id = "org.openarc.browser"
+
+# One entry per helper variant:
+#   [ target suffix, bundle id suffix (after "<app id>.helper"), name suffix ]
+# Each variant is signed with its own entitlements by scripts/make-app.sh
+# (app/Bundle/Helpers/*.entitlements in the Open Arc repository).
+openarc_mac_helpers = [
+  # Utility processes (network, storage, audio, …) and the GPU process when
+  # SwiftShader is not allowed (content's CHILD_NORMAL). No JIT.
+  [
+    "default",
+    "",
+    "",
+  ],
+
+  # Renderers and JIT-using utility processes (content's CHILD_RENDERER):
+  # V8 needs MAP_JIT.
+  [
+    "renderer",
+    ".renderer",
+    " (Renderer)",
+  ],
+
+  # The GPU process when SwiftShader may run (content's CHILD_GPU):
+  # SwiftShader's JIT. It shares the default helper's bundle id, as Chrome's
+  # GPU helper does: a bundle id of its own can break automatic graphics
+  # switching on Macs with two GPUs (https://crbug.com/40636691).
+  [
+    "gpu",
+    "",
+    " (GPU)",
+  ],
+
+  # Reserved for library CDMs signed by another team (plan C18): the only
+  # variant that may load a library with a foreign signature. No process type
+  # launches it yet.
+  [
+    "plugin",
+    ".plugin",
+    " (Plugin)",
+  ],
+
+  # Notifications shown as alerts rather than banners (//chrome's
+  # kChildProcessHelperAlerts, the Mac notification service).
+  [
+    "alerts",
+    ".alerts",
+    " (Alerts)",
+  ],
+]
