+OACContextMenuEditFlags EditFlags(int flags) {
+  OACContextMenuEditFlags result = 0;
+  if (flags & blink::kCanUndo) {
+    result |= OACContextMenuEditFlagCanUndo;
+  }
+  if (flags & blink::kCanRedo) {
