+namespace openarc {
+
+namespace {
+
+// Extension id of an extension item, from the matcher's map.
+NSString* ExtensionIdForCommand(extensions::ContextMenuMatcher& matcher,
+                                int command) {
+  auto map = matcher.extension_item_map();
+  auto found = map.find(command);
+  if (found == map.end()) {
+    return nil;
+  }
+  return base::SysUTF8ToNSString(found->second.extension_key.extension_id);
+}
+
+NSString* StripMnemonics(NSString* label) {
+  NSMutableString* result = [NSMutableString stringWithCapacity:label.length];
+  for (NSUInteger i = 0; i < label.length; ++i) {
+    unichar c = [label characterAtIndex:i];
+    if (c == '&') {
+      if (i + 1 < label.length && [label characterAtIndex:i + 1] == '&') {
+        [result appendString:@"&"];
+        ++i;
+      }
+      continue;
+    }
+    [result appendFormat:@"%C", c];
+  }
+  return result;
+}
+
+// Snapshots `model` (and its submenus). `extension_ids` names the extension of
+// an extension command, or nil.
+NSArray<OACContextMenuItem*>* SnapshotModel(
+    ui::MenuModel* model,
+    NSString* (^extension_id)(int command)) {
+  NSMutableArray<OACContextMenuItem*>* items = [NSMutableArray array];
+  for (size_t i = 0; i < model->GetItemCount(); ++i) {
+    const ui::MenuModel::ItemType type = model->GetTypeAt(i);
+    const int command = model->GetCommandIdAt(i);
+    OACContextMenuItemKind kind = OACContextMenuItemKindCommand;
+    NSArray<OACContextMenuItem*>* submenu = nil;
+    switch (type) {
+      case ui::MenuModel::TYPE_SEPARATOR:
+        kind = OACContextMenuItemKindSeparator;
+        break;
+      case ui::MenuModel::TYPE_CHECK:
+      case ui::MenuModel::TYPE_RADIO:
+        kind = OACContextMenuItemKindCheckbox;
+        break;
+      case ui::MenuModel::TYPE_SUBMENU:
+      case ui::MenuModel::TYPE_ACTIONABLE_SUBMENU:
+        kind = OACContextMenuItemKindSubmenu;
+        if (ui::MenuModel* child = model->GetSubmenuModelAt(i)) {
+          submenu = SnapshotModel(child, extension_id);
+        }
+        break;
+      case ui::MenuModel::TYPE_TITLE:
+        // Not a command; shown as a disabled row.
+        break;
+      default:
+        break;
+    }
+    const bool separator = kind == OACContextMenuItemKindSeparator;
+    OACContextMenuItemRole role =
+        separator ? OACContextMenuItemRoleOther : RoleForCommand(command);
+    NSString* extension =
+        role == OACContextMenuItemRoleExtension ? extension_id(command) : nil;
+    // Chrome's labels mark mnemonics with "&" and write a literal "&" as
+    // "&&"; AppKit menus have no mnemonics.
+    std::u16string label = separator ? std::u16string() : model->GetLabelAt(i);
+    NSString* title = StripMnemonics(base::SysUTF16ToNSString(label));
+    [items addObject:[[OACContextMenuItem alloc]
+                         initWithIdentifier:separator ? 0 : command
+                                       kind:kind
+                                       role:role
+                                      title:title
+                                    enabled:!separator && model->IsEnabledAt(i) &&
+                                            type != ui::MenuModel::TYPE_TITLE
+                                    checked:model->IsItemCheckedAt(i)
+                                    visible:model->IsVisibleAt(i)
+                        extensionIdentifier:extension
+                               submenuItems:submenu]];
+  }
+  return items;
+}
+
+// Finds `command` in `model` or its submenus.
+bool FindCommand(ui::MenuModel* model,
+                 int command,
+                 ui::MenuModel** found_model,
+                 size_t* found_index) {
+  for (size_t i = 0; i < model->GetItemCount(); ++i) {
+    if (model->GetTypeAt(i) != ui::MenuModel::TYPE_SEPARATOR &&
+        model->GetCommandIdAt(i) == command) {
+      *found_model = model;
+      *found_index = i;
+      return true;
+    }
+    if (ui::MenuModel* child = model->GetSubmenuModelAt(i);
+        child && FindCommand(child, command, found_model, found_index)) {
+      return true;
+    }
+  }
+  return false;
+}
