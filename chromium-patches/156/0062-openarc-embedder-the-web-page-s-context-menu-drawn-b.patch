+@interface OACContextMenuItem ()
+- (instancetype)initWithIdentifier:(NSInteger)identifier
+                              kind:(OACContextMenuItemKind)kind
+                              role:(OACContextMenuItemRole)role
+                             title:(NSString*)title
+                           enabled:(BOOL)enabled
+                           checked:(BOOL)checked
+                           visible:(BOOL)visible
+               extensionIdentifier:(NSString*)extensionIdentifier
+                      submenuItems:(NSArray<OACContextMenuItem*>*)submenuItems;
+@end
+
+@implementation OACContextMenuItem {
+  NSInteger _identifier;
+  OACContextMenuItemKind _kind;
+  OACContextMenuItemRole _role;
+  NSString* _title;
+  BOOL _enabled;
+  BOOL _checked;
+  BOOL _visible;
+  NSString* _extensionIdentifier;
+  NSArray<OACContextMenuItem*>* _submenuItems;
+}
+
+- (instancetype)initWithIdentifier:(NSInteger)identifier
+                              kind:(OACContextMenuItemKind)kind
+                              role:(OACContextMenuItemRole)role
+                             title:(NSString*)title
+                           enabled:(BOOL)enabled
+                           checked:(BOOL)checked
+                           visible:(BOOL)visible
+               extensionIdentifier:(NSString*)extensionIdentifier
+                      submenuItems:(NSArray<OACContextMenuItem*>*)submenuItems {
+  if ((self = [super init])) {
+    _identifier = identifier;
+    _kind = kind;
+    _role = role;
+    _title = [title copy] ?: @"";
+    _enabled = enabled;
+    _checked = checked;
+    _visible = visible;
+    _extensionIdentifier = [extensionIdentifier copy];
+    _submenuItems = [submenuItems copy] ?: @[];
+  }
+  return self;
+}
+
+- (NSInteger)identifier {
+  return _identifier;
+}
+- (OACContextMenuItemKind)kind {
+  return _kind;
+}
+- (OACContextMenuItemRole)role {
+  return _role;
+}
+- (NSString*)title {
+  return _title;
+}
+- (BOOL)isEnabled {
+  return _enabled;
+}
+- (BOOL)isChecked {
+  return _checked;
+}
+- (BOOL)isVisible {
+  return _visible;
+}
+- (NSString*)extensionIdentifier {
+  return _extensionIdentifier;
+}
+- (NSArray<OACContextMenuItem*>*)submenuItems {
+  return _submenuItems;
+}
+
+- (NSString*)description {
+  return [NSString stringWithFormat:@"<OACContextMenuItem %ld role=%ld %@%@>",
+                                    static_cast<long>(_identifier),
+                                    static_cast<long>(_role), _title,
+                                    _enabled ? @"" : @" (disabled)"];
+}
+
+@end
