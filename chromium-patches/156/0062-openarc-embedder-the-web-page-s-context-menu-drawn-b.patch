+void InspectElementAt(content::WebContents* inspected,
+                      content::RenderFrameHost* frame,
+                      int x,
+                      int y) {
+  if (!inspected || !frame) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(inspected->GetBrowserContext());
+  if (!DevToolsWindow::AllowDevToolsFor(profile, inspected)) {
+    return;
+  }
+  // As DevToolsWindow::InspectElement: the agent remembers the element, and
+  // the front end selects it once it attaches (or at once, when attached).
+  content::DevToolsAgentHost::GetOrCreateForTab(inspected)->InspectElement(
+      frame, x, y);
+  ShowDevTools(inspected, DevToolsCommand::kShowPanel, "elements");
+}
