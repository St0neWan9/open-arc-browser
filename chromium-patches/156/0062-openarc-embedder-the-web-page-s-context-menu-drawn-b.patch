+// Chromium's menu model for one right-click, never shown by Chromium.
+class PageMenuModel : public RenderViewContextMenuMac {
+ public:
+  PageMenuModel(content::RenderFrameHost& render_frame_host,
+                const content::ContextMenuParams& params,
+                bool is_paste_enabled,
+                bool is_paste_and_match_style_enabled)
+      : RenderViewContextMenuMac(render_frame_host,
+                                 params,
+                                 is_paste_enabled,
+                                 is_paste_and_match_style_enabled) {}
+  PageMenuModel(const PageMenuModel&) = delete;
+  PageMenuModel& operator=(const PageMenuModel&) = delete;
+  ~PageMenuModel() override = default;
+
+  void set_owner(OACContextMenu* owner) { owner_ = owner; }
+
+  // RenderViewContextMenuBase: the shell shows the menu.
+  void Show() override {}
+
+  ui::SimpleMenuModel* model() { return &menu_model_; }
+  extensions::ContextMenuMatcher& extension_items() { return extension_items_; }
+  const content::ContextMenuParams& menu_params() const { return params_; }
+
+  // Commands that Chrome runs through its browser window run here instead.
+  bool RunWithoutBrowserWindow(int command) {
+    content::WebContents* contents = GetWebContents();
+    if (!contents) {
+      return true;
+    }
+    switch (command) {
+      case IDC_RELOAD:
+        contents->GetController().Reload(content::ReloadType::NORMAL,
+                                         /*check_for_repost=*/true);
+        return true;
+      case IDC_PRINT:
+        // The system print panel, as File ▸ Print (OpenArc has no print
+        // preview, see openarc_page_tools.h); an image prints alone.
+        if (params_.media_type != MediaType::kNone) {
+          if (content::RenderFrameHost* rfh = GetRenderFrameHost()) {
+            printing::StartPrintNodeUnderContextMenu(
+                rfh, /*print_preview_disabled=*/true);
+          }
+        } else {
+          printing::StartPrint(contents, /*print_preview_disabled=*/true,
+                               !params_.selection_text.empty());
+        }
+        return true;
+      case IDC_CONTENT_CONTEXT_INSPECTELEMENT:
+        // Chrome docks DevTools in its window; Open Arc opens its DevTools
+        // window on the Elements panel, then points it at the element.
+        if (content::RenderFrameHost* rfh = GetRenderFrameHost()) {
+          InspectElementAt(contents, rfh, params_.x, params_.y);
+        }
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  // SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override {
+    switch (command_id) {
+      case IDC_RELOAD:
+        return true;
+      case IDC_PRINT:
+        return GetProfile()->GetPrefs()->GetBoolean(prefs::kPrintingEnabled) &&
+               (params_.media_type == MediaType::kNone ||
+                (params_.media_flags & blink::ContextMenuData::kMediaCanPrint));
+      case IDC_SAVE_PAGE:
+        return GetWebContents() &&
+               GetWebContents()->GetController().GetLastCommittedEntry();
+      default:
+        return RenderViewContextMenuMac::IsCommandIdEnabled(command_id);
+    }
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (RunWithoutBrowserWindow(command_id)) {
+      RecordUsedItem(command_id);
+      return;
+    }
+    RenderViewContextMenuMac::ExecuteCommand(command_id, event_flags);
+  }
+
+ protected:
+  // RenderViewContextMenuMac: Chromium changed an item (Copy Link to
+  // Highlight once its link is ready).
+  void UpdateToolkitMenuItem(int command_id,
+                             bool enabled,
+                             bool hidden,
+                             const std::u16string& title) override {
+    [owner_ modelDidUpdateCommand:command_id];
+  }
+
+ private:
+  __weak OACContextMenu* owner_ = nil;
+};
+
+// Owns the model and drops it when its WebContents goes away first (a tab
+// closed while its menu was open), since the model points into it.
+class PageMenuHolder : public content::WebContentsObserver {
+ public:
+  PageMenuHolder(content::WebContents* contents,
+                 std::unique_ptr<PageMenuModel> model)
+      : content::WebContentsObserver(contents), model_(std::move(model)) {}
+  PageMenuHolder(const PageMenuHolder&) = delete;
+  PageMenuHolder& operator=(const PageMenuHolder&) = delete;
+  ~PageMenuHolder() override = default;
+
+  PageMenuModel* model() { return model_.get(); }
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override { model_.reset(); }
+
+ private:
+  std::unique_ptr<PageMenuModel> model_;
+};
+
+}  // namespace openarc
+
+@implementation OACContextMenu {
+  std::unique_ptr<openarc::PageMenuHolder> _holder;
+  __weak OACTab* _tab;
+  NSArray<OACContextMenuItem*>* _items;
+  NSURL* _linkURL;
+  NSString* _linkText;
+  NSURL* _sourceURL;
+  OACContextMenuMediaKind _mediaKind;
+  BOOL _hasImageContents;
+  NSString* _selectionText;
+  BOOL _editable;
+  BOOL _isPasswordField;
+  OACContextMenuEditFlags _editFlags;
+  NSURL* _pageURL;
+  NSURL* _frameURL;
+  CGPoint _location;
+  BOOL _shown;
+  BOOL _closed;
+  BOOL _popUpUsed;
+}
+
+@synthesize itemUpdateHandler = _itemUpdateHandler;
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     holder:(std::unique_ptr<openarc::PageMenuHolder>)holder {
+  if ((self = [super init])) {
+    _tab = tab;
+    _holder = std::move(holder);
+    _holder->model()->set_owner(self);
+    const content::ContextMenuParams& params = _holder->model()->menu_params();
+    _linkURL = OptionalURL(params.link_url);
+    _linkText = base::SysUTF16ToNSString(params.link_text);
+    _sourceURL = OptionalURL(params.src_url);
+    _mediaKind = MediaKind(params.media_type);
+    _hasImageContents = params.has_image_contents;
+    _selectionText = base::SysUTF16ToNSString(params.selection_text);
+    _editable = params.is_editable;
+    _isPasswordField = params.form_control_type ==
+                       blink::mojom::FormControlType::kInputPassword;
+    _editFlags = EditFlags(params.edit_flags);
+    _pageURL = OptionalURL(params.page_url);
+    _frameURL = OptionalURL(params.frame_url);
+    _location = CGPointMake(params.x, params.y);
+    _items = [self snapshot];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  // The menu ends with its last reference; the page learns it closed.
+  openarc::PageMenuModel* model = _holder ? _holder->model() : nullptr;
+  if (model && _shown) {
+    model->MenuClosed(model->model());
+  }
+}
+
+// The model, or nullptr once closed or once its page went away.
+- (openarc::PageMenuModel*)liveModel {
+  return _holder ? _holder->model() : nullptr;
+}
+
+- (NSArray<OACContextMenuItem*>*)snapshot {
+  openarc::PageMenuModel* model = [self liveModel];
+  if (!model) {
+    return @[];
+  }
+  return openarc::SnapshotModel(model->model(), ^NSString*(int command) {
+    return openarc::ExtensionIdForCommand(model->extension_items(), command);
+  });
+}
+
+- (OACTab*)tab {
+  return _tab;
+}
+- (NSArray<OACContextMenuItem*>*)items {
+  return _items;
+}
+- (NSURL*)linkURL {
+  return _linkURL;
+}
+- (NSString*)linkText {
+  return _linkText;
+}
+- (NSURL*)sourceURL {
+  return _sourceURL;
+}
+- (OACContextMenuMediaKind)mediaKind {
+  return _mediaKind;
+}
+- (BOOL)hasImageContents {
+  return _hasImageContents;
+}
+- (NSString*)selectionText {
+  return _selectionText;
+}
+- (BOOL)isEditable {
+  return _editable;
+}
+- (BOOL)isPasswordField {
+  return _isPasswordField;
+}
+- (OACContextMenuEditFlags)editFlags {
+  return _editFlags;
+}
+- (NSURL*)pageURL {
+  return _pageURL;
+}
+- (NSURL*)frameURL {
+  return _frameURL;
+}
+- (CGPoint)location {
+  return _location;
+}
+- (BOOL)isClosed {
+  return _closed;
+}
+
+// The shell's delegate method returned YES: the menu counts as showing (the
+// page holds further right-clicks until it closes).
+- (void)markShown {
+  openarc::PageMenuModel* model = [self liveModel];
+  if (_closed || _shown || !model || !model->GetWebContents() ||
+      model->GetWebContents()->IsShowingContextMenu()) {
+    return;
+  }
+  _shown = YES;
+  model->OnMenuWillShow(model->model());
+}
+
+- (void)modelDidUpdateCommand:(int)commandID {
+  openarc::PageMenuModel* model = [self liveModel];
+  if (_closed || !model) {
+    return;
+  }
+  ui::MenuModel* found_model = nullptr;
+  size_t index = 0;
+  if (!openarc::FindCommand(model->model(), commandID, &found_model,
+                            &index)) {
+    return;
+  }
+  // The model already holds the new state (RenderViewContextMenuBase updates
+  // it before telling the toolkit); refresh the snapshot and report the item.
+  _items = [self snapshot];
+  OACContextMenuItem* updated = [self itemWithIdentifier:commandID in:_items];
+  void (^handler)(OACContextMenuItem*) = self.itemUpdateHandler;
+  if (updated && handler) {
+    handler(updated);
+  }
+}
+
+- (OACContextMenuItem*)itemWithIdentifier:(NSInteger)identifier
+                                       in:(NSArray<OACContextMenuItem*>*)items {
+  for (OACContextMenuItem* item in items) {
+    if (item.kind != OACContextMenuItemKindSeparator &&
+        item.identifier == identifier) {
+      return item;
+    }
+    if (OACContextMenuItem* found = [self itemWithIdentifier:identifier
+                                                          in:item.submenuItems]) {
+      return found;
+    }
+  }
+  return nil;
+}
+
+- (BOOL)popUpMenu:(id)menu {
+  CHECK(NSThread.isMainThread);
+  OACTab* tab = _tab;
+  NSView* view = tab.nativeView;
+  if (_closed || _popUpUsed || ![menu isKindOfClass:[NSMenu class]] || !view ||
+      !view.window || tab.isClosed) {
+    return NO;
+  }
+  _popUpUsed = YES;
+  [self markShown];
+  // The click, from the page's top-left coordinates to the view's.
+  NSPoint point = NSMakePoint(_location.x, view.isFlipped
+                                               ? _location.y
+                                               : NSHeight(view.bounds) -
+                                                     _location.y);
+  NSPoint inWindow = [view convertPoint:point toView:nil];
+  NSEvent* event =
+      ui::EventForPositioningContextMenuRelativeToWindow(inWindow, view.window);
+  // Tasks keep running while the menu shows (Copy Link to Highlight waits
+  // for the page), as in Chrome.
+  OACContextMenu* keepAlive = self;
+  ui::ShowContextMenu(static_cast<NSMenu*>(menu), event, view,
+                      /*allow_nested_tasks=*/true);
+  // AppKit sends the chosen item's action right after the menu's tracking
+  // ends; close on the next turn so that action still reaches the model.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [keepAlive close];
+  });
+  return YES;
+}
+
+- (void)performItemWithIdentifier:(NSInteger)identifier {
+  CHECK(NSThread.isMainThread);
+  openarc::PageMenuModel* model = [self liveModel];
+  if (_closed || !model) {
+    return;
+  }
+  const int command = static_cast<int>(identifier);
+  ui::MenuModel* found_model = nullptr;
+  size_t index = 0;
+  if (!openarc::FindCommand(model->model(), command, &found_model, &index) ||
+      found_model->GetTypeAt(index) == ui::MenuModel::TYPE_SUBMENU ||
+      !found_model->IsEnabledAt(index)) {
+    return;
+  }
+  [self markShown];
+  // Through the model, so submenu models (extension groups, text services)
+  // reach their own delegates.
+  found_model->ActivatedAt(index, /*event_flags=*/0);
+}
+
+- (void)close {
+  CHECK(NSThread.isMainThread);
+  if (_closed) {
+    return;
+  }
+  _closed = YES;
+  self.itemUpdateHandler = nil;
+  if (openarc::PageMenuModel* model = [self liveModel]; model && _shown) {
+    model->MenuClosed(model->model());
+  }
+  // Deleted on a later turn: -close may run from inside one of the model's
+  // own calls (an itemUpdateHandler that closes the menu).
+  if (std::unique_ptr<openarc::PageMenuHolder> holder = std::move(_holder)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(holder));
+  }
+}
+
+@end
+
+namespace openarc {
+
+OACContextMenu* MakeContextMenu(OACTab* tab,
+                                content::RenderFrameHost& render_frame_host,
+                                const content::ContextMenuParams& params,
+                                bool is_paste_enabled,
+                                bool is_paste_and_match_style_enabled) {
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(&render_frame_host);
+  if (!contents) {
+    return nil;
+  }
+  auto model = std::make_unique<PageMenuModel>(
+      render_frame_host,
+      AddContextMenuParamsPropertiesFromPreferences(contents, params),
+      is_paste_enabled, is_paste_and_match_style_enabled);
+  model->Init();
+  return [[OACContextMenu alloc]
+      initWithTab:tab
+           holder:std::make_unique<PageMenuHolder>(contents, std::move(model))];
+}
+
+void MarkContextMenuShown(OACContextMenu* menu) {
+  [menu markShown];
+}
+
+}  // namespace openarc
+
+@implementation OACTab (OACContextMenu)
+
+- (void)requestContextMenuAtPoint:(CGPoint)point {
+  CHECK(NSThread.isMainThread);
+  content::WebContents* contents = self.isClosed ? nullptr : self.webContents;
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    return;
+  }
+  // Blink opens the menu in its focused frame, as for a right-click (which
+  // focuses the page first): give the page focus.
+  contents->GetPrimaryMainFrame()->GetRenderWidgetHost()->Focus();
+  view->GetRenderWidgetHost()->ShowContextMenuAtPoint(
+      gfx::Point(static_cast<int>(point.x), static_cast<int>(point.y)),
+      ui::mojom::MenuSourceType::kMouse);
+}
+
+@end
+
+// MARK: - Extension action menu
+
+namespace {
+
+// The action menu items of one extension, for one profile.
+struct ActionMenu {
+  std::unique_ptr<ui::SimpleMenuModel> model;
+  std::unique_ptr<extensions::ContextMenuMatcher> matcher;
+};
+
+// The ContextMenuMatcher needs a SimpleMenuModel::Delegate; the items are
+// snapshot only, commands run through the matcher.
+class ActionMenuDelegate : public ui::SimpleMenuModel::Delegate {
+ public:
+  void ExecuteCommand(int command_id, int event_flags) override {}
+};
+
+ActionMenuDelegate& SharedActionMenuDelegate() {
+  static base::NoDestructor<ActionMenuDelegate> delegate;
+  return *delegate;
+}
+
+bool ItemMatchesAction(std::optional<extensions::ActionInfo::Type> type,
+                       const extensions::MenuItem* item) {
+  const extensions::MenuItem::ContextList& contexts = item->contexts();
+  if (contexts.Contains(extensions::MenuItem::ALL)) {
+    return true;
+  }
+  if (!type) {
+    return false;
+  }
+  switch (*type) {
+    case extensions::ActionInfo::Type::kAction:
+      return contexts.Contains(extensions::MenuItem::ACTION);
+    case extensions::ActionInfo::Type::kBrowser:
+      return contexts.Contains(extensions::MenuItem::BROWSER_ACTION);
+    case extensions::ActionInfo::Type::kPage:
+      return contexts.Contains(extensions::MenuItem::PAGE_ACTION);
+  }
+  return false;
+}
+
+std::optional<ActionMenu> BuildActionMenu(Profile* profile,
+                                          const std::string& extension_id) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)
+          ->enabled_extensions()
+          .GetByID(extension_id);
+  extensions::MenuManager* manager = extensions::MenuManager::Get(profile);
+  if (!extension || !manager ||
+      !manager->MenuItems(extensions::MenuItem::ExtensionKey(extension_id))) {
+    return std::nullopt;
+  }
+  extensions::ExtensionAction* action =
+      extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+          *extension);
+  std::optional<extensions::ActionInfo::Type> type =
+      action ? std::optional<extensions::ActionInfo::Type>(
+                   action->action_type())
+             : std::nullopt;
+  ActionMenu menu;
+  menu.model =
+      std::make_unique<ui::SimpleMenuModel>(&SharedActionMenuDelegate());
+  menu.matcher = std::make_unique<extensions::ContextMenuMatcher>(
+      profile, &SharedActionMenuDelegate(), menu.model.get(),
+      base::BindRepeating(&ItemMatchesAction, type));
+  int index = 0;
+  menu.matcher->AppendExtensionItems(
+      extensions::MenuItem::ExtensionKey(extension_id), std::u16string(),
+      &index, /*is_action_menu=*/true);
+  return menu;
+}
+
+}  // namespace
+
+@implementation OACProfile (OACExtensionActionMenu)
+
+- (NSArray<OACContextMenuItem*>*)
+    actionMenuItemsForExtension:(NSString*)extensionIdentifier
+                            tab:(OACTab*)tab {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.valid ? self.chromeProfile : nullptr;
+  if (!profile || extensionIdentifier.length == 0) {
+    return @[];
+  }
+  std::optional<ActionMenu> menu =
+      BuildActionMenu(profile, base::SysNSStringToUTF8(extensionIdentifier));
+  if (!menu) {
+    return @[];
+  }
+  NSString* identifier = [extensionIdentifier copy];
+  return openarc::SnapshotModel(menu->model.get(), ^NSString*(int) {
+    return identifier;
+  });
+}
+
+- (void)performActionMenuItemWithIdentifier:(NSInteger)identifier
+                                  extension:(NSString*)extensionIdentifier
+                                        tab:(OACTab*)tab {
+  CHECK(NSThread.isMainThread);
+  Profile* profile = self.valid ? self.chromeProfile : nullptr;
+  if (!profile || extensionIdentifier.length == 0) {
+    return;
+  }
+  std::optional<ActionMenu> menu =
+      BuildActionMenu(profile, base::SysNSStringToUTF8(extensionIdentifier));
+  const int command = static_cast<int>(identifier);
+  if (!menu || !extensions::ContextMenuMatcher::IsExtensionsCustomCommandId(
+                   command) ||
+      !menu->matcher->IsCommandIdEnabled(command)) {
+    return;
+  }
+  // As Chrome's action menu does: the tab, no frame, empty params.
+  content::WebContents* contents = tab && !tab.isClosed ? tab.webContents
+                                                        : nullptr;
+  menu->matcher->ExecuteCommand(command, contents, nullptr,
+                                content::ContextMenuParams());
+}
+
+@end
