+OACContextMenuItemRole RoleForCommand(int command) {
+  using TS = ui::TextServicesContextMenu;
+  if (extensions::ContextMenuMatcher::IsExtensionsCustomCommandId(command)) {
+    return OACContextMenuItemRoleExtension;
+  }
+  if ((command >= IDC_SPELLCHECK_SUGGESTION_0 &&
+       command < IDC_SPELLCHECK_LANGUAGES_FIRST) ||
+      command == IDC_SPELLCHECK_ADD_TO_DICTIONARY ||
+      command == IDC_SPELLCHECK_REMOVE_FROM_DICTIONARY ||
+      command == IDC_CONTENT_CONTEXT_NO_SPELLING_SUGGESTIONS) {
+    return OACContextMenuItemRoleSpelling;
+  }
+  switch (command) {
+    case IDC_BACK:
+      return OACContextMenuItemRoleBack;
+    case IDC_FORWARD:
+      return OACContextMenuItemRoleForward;
+    case IDC_RELOAD:
+      return OACContextMenuItemRoleReload;
+    case IDC_SAVE_PAGE:
+      return OACContextMenuItemRoleSavePage;
+    case IDC_PRINT:
+      return OACContextMenuItemRolePrint;
+    case IDC_ROUTE_MEDIA:
+      return OACContextMenuItemRoleCast;
+    case IDC_CONTENT_CONTEXT_TRANSLATE:
+    case IDC_CONTENT_CONTEXT_PARTIAL_TRANSLATE:
+      return OACContextMenuItemRoleTranslate;
+    case IDC_VIEW_SOURCE:
+      return OACContextMenuItemRoleViewSource;
+    case IDC_CONTENT_CONTEXT_INSPECTELEMENT:
+      return OACContextMenuItemRoleInspect;
+    case IDC_CONTENT_CONTEXT_OPENLINKNEWTAB:
+      return OACContextMenuItemRoleOpenLinkInNewTab;
+    case IDC_CONTENT_CONTEXT_OPENLINKNEWWINDOW:
+      return OACContextMenuItemRoleOpenLinkInNewWindow;
+    case IDC_CONTENT_CONTEXT_OPENLINKOFFTHERECORD:
+      return OACContextMenuItemRoleOpenLinkInIncognito;
+    case IDC_CONTENT_CONTEXT_SAVELINKAS:
+      return OACContextMenuItemRoleSaveLinkAs;
+    case IDC_CONTENT_CONTEXT_COPYLINKLOCATION:
+      return OACContextMenuItemRoleCopyLinkAddress;
+    case IDC_CONTENT_CONTEXT_COPY:
+      return OACContextMenuItemRoleCopy;
+    case IDC_CONTENT_CONTEXT_COPYLINKTOTEXT:
+      return OACContextMenuItemRoleCopyLinkToHighlight;
+    case IDC_CONTENT_CONTEXT_SEARCHWEBFOR:
+      return OACContextMenuItemRoleSearchWeb;
+    case IDC_CONTENT_CONTEXT_LOOK_UP:
+      return OACContextMenuItemRoleLookUp;
+    case IDC_CONTENT_CONTEXT_OPENIMAGENEWTAB:
+      return OACContextMenuItemRoleOpenImageInNewTab;
+    case IDC_CONTENT_CONTEXT_SAVEIMAGEAS:
+      return OACContextMenuItemRoleSaveImageAs;
+    case IDC_CONTENT_CONTEXT_COPYIMAGE:
+      return OACContextMenuItemRoleCopyImage;
+    case IDC_CONTENT_CONTEXT_COPYIMAGELOCATION:
+      return OACContextMenuItemRoleCopyImageAddress;
+    case IDC_CONTENT_CONTEXT_EMOJI:
+      return OACContextMenuItemRoleEmoji;
+    case IDC_CONTENT_CONTEXT_UNDO:
+      return OACContextMenuItemRoleUndo;
+    case IDC_CONTENT_CONTEXT_REDO:
+      return OACContextMenuItemRoleRedo;
+    case IDC_CONTENT_CONTEXT_CUT:
+      return OACContextMenuItemRoleCut;
+    case IDC_CONTENT_CONTEXT_PASTE:
+      return OACContextMenuItemRolePaste;
+    case IDC_CONTENT_CONTEXT_PASTE_AND_MATCH_STYLE:
+      return OACContextMenuItemRolePasteAndMatchStyle;
+    case IDC_CONTENT_CONTEXT_SELECTALL:
+      return OACContextMenuItemRoleSelectAll;
+    case IDC_CONTENT_CONTEXT_LANGUAGE_SETTINGS:
+      return OACContextMenuItemRoleLanguageSettings;
+    case IDC_CONTENT_CONTEXT_AUTOFILL_FALLBACK_PASSWORDS_IMPORT_PASSWORDS:
