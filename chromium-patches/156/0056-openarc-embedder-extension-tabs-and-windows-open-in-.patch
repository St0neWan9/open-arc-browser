+++ b/openarc/bridge/oac_extensions_internal.h
@@ -28,8 +28,10 @@ class ExtensionCommandRegistry;
 @end
 
 // Registers the bridge's hooks in //chrome's extension code (plan C14): the
-// install confirmation (ExtensionInstallPrompt's embedder dialog) and the
-// embedder tab list of chrome.tabs.query. Called once when the engine starts.
+// install confirmation (ExtensionInstallPrompt's embedder dialog), the
+// embedder tab list of chrome.tabs.query, and (plan C31) the embedder tab
+// opener of chrome.tabs.create, chrome.windows.create and
+// chrome.runtime.openOptionsPage. Called once when the engine starts.
 void OACInstallExtensionHooks();
 
 #endif  // OPENARC_BRIDGE_OAC_EXTENSIONS_INTERNAL_H_
diff --git a/openarc/bridge/public/OpenArcCore/OACApplication.h b/openarc/bridge/public/OpenArcCore/OACApplication.h
index 9a730ab993e5..69f7cd68092f 100644
--- a/openarc/bridge/public/OpenArcCore/OACApplication.h
+++ b/openarc/bridge/public/OpenArcCore/OACApplication.h
@@ -163,8 +163,11 @@ NS_SWIFT_UI_ACTOR
 @protocol OACApplicationDelegate <NSObject>
 @optional
 
-/// Something outside any tab wants a new tab: an extension (`chrome.tabs.create`), a notification
-/// click, a WebUI link. `request.opener` is nil. Maps to `EngineEvent.newTabRequested`.
+/// Something outside any tab wants a new tab: an extension (`chrome.tabs.create`,
+/// `chrome.windows.create`, `chrome.runtime.openOptionsPage`), a notification click, a WebUI link.
+/// `request.opener` is nil; `request.profile` is the profile it belongs to. Extension requests
+/// carry the tab the engine already made (`hasPendingContents`, plan C31): adopt or decline it as
+/// for a script-opened window. Maps to `EngineEvent.newTabRequested`.
 - (void)application:(OACApplication *)application didRequestNewTab:(OACNewTabRequest *)request;
 
 /// A profile's last off-the-record tab closed and its off-the-record context was destroyed
diff --git a/openarc/bridge/public/OpenArcCore/OACExtensions.h b/openarc/bridge/public/OpenArcCore/OACExtensions.h
index 362e35bbea88..36cf46095519 100644
--- a/openarc/bridge/public/OpenArcCore/OACExtensions.h
+++ b/openarc/bridge/public/OpenArcCore/OACExtensions.h
@@ -30,9 +30,15 @@
 // switch is on); chrome://extensions lists them under "Errors". `OACExtensionInfo.errorCount`
 // counts them.
 //
-// Not covered: the extension context menu, side panels, `chrome.action.openPopup()`, and APIs that
-// need a Chrome `Browser` window (`chrome.tabs.create`, `chrome.windows.*`,
-// `chrome.runtime.openOptionsPage`): they fail as in a Chrome without windows. "Manage
+// Tabs and windows (plan C31): `chrome.tabs.create`, `chrome.windows.create` and
+// `chrome.runtime.openOptionsPage` open in the shell. The engine makes the tab (the extension gets
+// its id back) and hands it to `-[OACApplicationDelegate application:didRequestNewTab:]` as a
+// request with pending contents and no opener; `windows.create` asks for a new window (or a popup).
+// Moving tabs between windows, incognito windows and window ids other than the current one are
+// errors for the extension.
+//
+// Not covered: the extension context menu, side panels, `chrome.action.openPopup()` and the rest
+// of `chrome.windows.*` (no window objects): they fail as in a Chrome without windows. "Manage
 // Extensions…" opens chrome://extensions in a tab until a native page exists.
 
 #import <OpenArcCore/OACDefines.h>
