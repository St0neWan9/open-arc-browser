+namespace {
+
+// Open Arc: window objects for an embedder that owns the UI
+// (ExtensionTabUtil::GetEmbedderWindows()), where Chrome has no Browser
+// windows and so no WindowControllers.
+
+// Whether `window` passes the windowTypes filter of a query (no filter:
+// normal and popup windows, as Chrome's default).
+bool EmbedderWindowMatchesFilter(const ExtensionTabUtil::EmbedderWindow& window,
+                                 WindowController::TypeFilter filter) {
+  if (!filter) {
+    return true;
+  }
+  const windows::WindowType type = window.popup ? windows::WindowType::kPopup
+                                                : windows::WindowType::kNormal;
+  return (filter & (1 << std::to_underlying(type))) != 0;
+}
+
+base::DictValue CreateEmbedderWindowValue(
+    const ExtensionTabUtil::EmbedderWindow& embedder_window,
+    const Extension* extension,
+    mojom::ContextType context,
+    bool populate_tabs) {
+  windows::Window window;
+  window.id = embedder_window.id;
+  window.focused = embedder_window.focused;
+  window.left = embedder_window.bounds.x();
+  window.top = embedder_window.bounds.y();
+  window.width = embedder_window.bounds.width();
+  window.height = embedder_window.bounds.height();
+  window.incognito = embedder_window.browser_context &&
+                     embedder_window.browser_context->IsOffTheRecord();
+  window.type = embedder_window.popup ? windows::WindowType::kPopup
+                                      : windows::WindowType::kNormal;
+  window.state = windows::WindowState::kNormal;
+  window.always_on_top = false;
+  if (populate_tabs) {
+    std::vector<api::tabs::Tab> tab_objects;
+    int index = 0;
+    for (const ExtensionTabUtil::EmbedderTab& embedder_tab :
+         embedder_window.tabs) {
+      if (!embedder_tab.contents) {
+        continue;
+      }
+      api::tabs::Tab tab_object = tabs_internal::CreateTabObjectHelper(
+          embedder_tab.contents, extension, context, /*browser=*/nullptr,
+          /*tab_index=*/-1);
+      tab_object.index = index++;
+      tab_object.window_id = embedder_window.id;
+      tab_object.active = embedder_tab.active;
+      tab_object.selected = embedder_tab.active;
+      tab_object.highlighted = embedder_tab.active;
+      tab_objects.push_back(std::move(tab_object));
+    }
+    window.tabs = std::move(tab_objects);
+  }
+  return window.ToValue();
+}
+
+// The embedder window a windows.get* call asks for: `window_id`; for
+// kCurrentWindowId the window of the calling tab, else the most recently
+// focused one (Chrome: the focused window, else the last one); for
+// `last_focused`, the most recently focused one. Nullopt when none matches.
+std::optional<ExtensionTabUtil::EmbedderWindow> FindEmbedderWindow(
+    ExtensionFunction* function,
+    int window_id,
+    bool last_focused,
+    WindowController::TypeFilter filter) {
+  std::vector<ExtensionTabUtil::EmbedderWindow> windows =
+      ExtensionTabUtil::GetEmbedderWindows(
+          function->browser_context(),
+          function->include_incognito_information());
+  if (!last_focused && window_id == extension_misc::kCurrentWindowId) {
+    if (content::WebContents* sender = function->GetSenderWebContents()) {
+      for (const ExtensionTabUtil::EmbedderWindow& window : windows) {
+        for (const ExtensionTabUtil::EmbedderTab& tab : window.tabs) {
+          if (tab.contents == sender &&
+              EmbedderWindowMatchesFilter(window, filter)) {
+            return window;
+          }
+        }
+      }
+    }
+  }
+  for (const ExtensionTabUtil::EmbedderWindow& window : windows) {
+    if (!EmbedderWindowMatchesFilter(window, filter)) {
+      continue;
+    }
+    if (last_focused || window_id == extension_misc::kCurrentWindowId ||
+        window.id == window_id) {
+      return window;
+    }
+  }
+  return std::nullopt;
+}
