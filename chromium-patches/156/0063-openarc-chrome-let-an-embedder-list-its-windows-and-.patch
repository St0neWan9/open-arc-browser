+ExtensionTabUtil::EmbedderWindow::EmbedderWindow() = default;
+ExtensionTabUtil::EmbedderWindow::EmbedderWindow(const EmbedderWindow&) =
+    default;
+ExtensionTabUtil::EmbedderWindow& ExtensionTabUtil::EmbedderWindow::operator=(
+    const EmbedderWindow&) = default;
+ExtensionTabUtil::EmbedderWindow::~EmbedderWindow() = default;
+
+// static
+void ExtensionTabUtil::SetEmbedderWindowList(EmbedderWindowList list) {
+  EmbedderWindowListCallback() = std::move(list);
+}
+
+// static
+bool ExtensionTabUtil::HasEmbedderWindowList() {
+  return !EmbedderWindowListCallback().is_null();
+}
+
+// static
+std::vector<ExtensionTabUtil::EmbedderWindow>
+ExtensionTabUtil::GetEmbedderWindows(content::BrowserContext* browser_context,
+                                     bool include_incognito) {
+  const EmbedderWindowList& list = EmbedderWindowListCallback();
+  if (!list || !browser_context) {
+    return {};
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  std::vector<EmbedderWindow> result;
+  for (EmbedderWindow& window : list.Run()) {
+    if (!window.browser_context) {
+      continue;
+    }
+    // As windows_util::CanOperateOnWindow(): the profile's own windows, and
+    // its incognito profile's when the extension may see incognito.
+    Profile* window_profile =
+        Profile::FromBrowserContext(window.browser_context);
+    if (window_profile == profile ||
+        (include_incognito && window_profile->IsOffTheRecord() &&
+         window_profile->GetOriginalProfile() == profile)) {
+      result.push_back(std::move(window));
+    }
+  }
+  return result;
+}
+
+// static
+void ExtensionTabUtil::SetEmbedderActionPopupOpener(
+    EmbedderActionPopupOpener opener) {
+  EmbedderActionPopupOpenerCallback() = std::move(opener);
+}
+
+// static
+bool ExtensionTabUtil::HasEmbedderActionPopupOpener() {
+  return !EmbedderActionPopupOpenerCallback().is_null();
+}
+
+// static
+bool ExtensionTabUtil::OpenEmbedderActionPopup(
+    const Extension& extension,
+    content::WebContents* contents,
+    base::OnceCallback<void(ExtensionHost*)> callback) {
+  const EmbedderActionPopupOpener& opener =
+      EmbedderActionPopupOpenerCallback();
+  if (!opener || !contents) {
+    return false;
+  }
+  return opener.Run(extension, contents, std::move(callback));
+}
+
 // static
 std::vector<ExtensionTabUtil::EmbedderTab> ExtensionTabUtil::GetEmbedderTabs(
     content::BrowserContext* browser_context,
