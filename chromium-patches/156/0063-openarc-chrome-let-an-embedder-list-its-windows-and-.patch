+ExtensionFunction::ResponseAction ActionOpenPopupFunction::RunInEmbedder(
+    int window_id) {
+  std::vector<ExtensionTabUtil::EmbedderWindow> windows =
+      ExtensionTabUtil::GetEmbedderWindows(browser_context(),
+                                           include_incognito_information());
+  // The windows come most recently focused first: the current window is the
+  // first one, and only a focused window shows a popup (as in Chrome).
+  const ExtensionTabUtil::EmbedderWindow* window = nullptr;
+  for (const ExtensionTabUtil::EmbedderWindow& candidate : windows) {
+    if (window_id == extension_misc::kCurrentWindowId ||
+        candidate.id == window_id) {
+      window = &candidate;
+      break;
+    }
+  }
+  if (!window) {
+    return RespondNow(
+        Error(window_id == extension_misc::kCurrentWindowId
+                  ? std::string(kNoActiveWindowFound)
+                  : ErrorUtils::FormatErrorMessage(
+                        ExtensionTabUtil::kWindowNotFoundError,
+                        base::NumberToString(window_id))));
+  }
+  if (!window->focused) {
+    return RespondNow(Error(kOpenPopupInactiveWindow));
+  }
+  // As OpenPopupInBrowser(): popup windows have no toolbar to show it from.
+  if (window->popup) {
+    return RespondNow(Error("Browser window has no toolbar."));
+  }
+  content::WebContents* active = nullptr;
+  for (const ExtensionTabUtil::EmbedderTab& tab : window->tabs) {
+    if (tab.active && tab.contents) {
+      active = tab.contents;
+      break;
+    }
+  }
+  if (!active) {
+    return RespondNow(Error(kNoActivePopup));
+  }
+  ExtensionAction* extension_action =
+      ExtensionActionManager::Get(browser_context())
+          ->GetExtensionAction(*extension());
+  const int tab_id = ExtensionTabUtil::GetTabId(active);
+  if (!extension_action || !extension_action->HasPopup(tab_id) ||
+      !extension_action->GetIsVisibleIgnoringDeclarative(tab_id)) {
+    return RespondNow(Error(kNoActivePopup));
+  }
+  if (!ExtensionTabUtil::OpenEmbedderActionPopup(
+          *extension(), active,
+          base::BindOnce(&ActionOpenPopupFunction::OnShowPopupComplete,
+                         this))) {
+    return RespondNow(Error(kFailedToOpenPopupGenericError));
+  }
+  // The function responds in OnShowPopupComplete().
+  return RespondLater();
+}
+
 void ActionOpenPopupFunction::OnShowPopupComplete(ExtensionHost* popup_host) {
   DCHECK(!did_respond());
 
