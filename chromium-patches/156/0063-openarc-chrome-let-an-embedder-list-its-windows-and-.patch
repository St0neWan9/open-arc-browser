+  // Open Arc: the same embedder's windows, for chrome.windows.get, getCurrent,
+  // getLastFocused and getAll and for chrome.action.openPopup(), which look
+  // for Browser windows only. `id` is a SessionID value the embedder gives the
+  // window (it also sets it as the window id of the window's tabs, so tab
+  // objects carry it); `browser_context` is the profile its tabs belong to (an
+  // incognito window: the off-the-record profile); `bounds` are in screen
+  // coordinates; `tabs` in the window's order, with `active` for the tab (or
+  // the panes) it shows. Not part of upstream Chromium.
+  struct EmbedderWindow {
+    EmbedderWindow();
+    EmbedderWindow(const EmbedderWindow&);
+    EmbedderWindow& operator=(const EmbedderWindow&);
+    ~EmbedderWindow();
+
+    int id = -1;
+    raw_ptr<content::BrowserContext> browser_context = nullptr;
+    bool focused = false;
+    bool popup = false;
+    gfx::Rect bounds;
+    std::vector<EmbedderTab> tabs;
+  };
+  // Every window of the embedder, most recently focused first.
+  using EmbedderWindowList =
+      base::RepeatingCallback<std::vector<EmbedderWindow>()>;
+  static void SetEmbedderWindowList(EmbedderWindowList list);
+  static bool HasEmbedderWindowList();
+  // The embedder's windows of `browser_context` (and of its incognito profile
+  // when `include_incognito`), most recently focused first; empty when no
+  // embedder registered a list.
+  static std::vector<EmbedderWindow> GetEmbedderWindows(
+      content::BrowserContext* browser_context,
+      bool include_incognito);
+
+  // Open Arc: the embedder shows an extension action's popup for
+  // chrome.action.openPopup() on `contents`, the active tab of its focused
+  // window. It runs `callback` with the popup's host once the popup's page
+  // loaded, or with null when it closed first; it returns false (without
+  // running `callback`) when it cannot show one. Not part of upstream
+  // Chromium.
+  using EmbedderActionPopupOpener = base::RepeatingCallback<bool(
+      const Extension& extension,
+      content::WebContents* contents,
+      base::OnceCallback<void(ExtensionHost*)> callback)>;
+  static void SetEmbedderActionPopupOpener(EmbedderActionPopupOpener opener);
+  static bool HasEmbedderActionPopupOpener();
+  // Runs the embedder's popup opener; false when none is registered.
+  static bool OpenEmbedderActionPopup(
+      const Extension& extension,
+      content::WebContents* contents,
+      base::OnceCallback<void(ExtensionHost*)> callback);
