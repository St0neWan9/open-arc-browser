 constexpr base::TimeDelta kSuggestTimeout = base::Milliseconds(1500);
 constexpr size_t kMaxSuggestBodySize = 64 * 1024;
 constexpr int kMaxHistoryCount = 100;
+// Site icons (plan B132), own values: the command bar's 16 pt glyph at 2x;
+// a favicon.ico is small, so a larger body is not an icon worth waiting for.
+constexpr int kSiteIconPixels = 32;
+constexpr base::TimeDelta kSiteIconTimeout = base::Seconds(5);
+constexpr size_t kMaxSiteIconBodySize = 256 * 1024;
+
+net::NetworkTrafficAnnotationTag SiteIconAnnotation() {
+  return net::DefineNetworkTrafficAnnotation("openarc_site_icon", R"(
+    semantics {
+      sender: "Open Arc command bar"
+      description:
+        "Loads the icon of a site the command bar suggests (a search "
+        "engine's site suggestion or a most visited page) when the browser "
+        "has no icon for it yet."
+      trigger:
+        "A site row in the command bar for a site without a stored icon."
+      data: "None: a GET of the site's /favicon.ico."
+      destination: WEBSITE
+    }
+    policy {
+      cookies_allowed: NO
+      setting: "None."
+      policy_exception_justification: "Not implemented."
+    })");
+}
+
+// `bitmap` as PNG, scaled down to fit kSiteIconPixels; nil when empty.
+NSData* SiteIconPNG(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) {
+    return nil;
+  }
+  SkBitmap fitted = bitmap;
+  const int longest = std::max(bitmap.width(), bitmap.height());
+  if (longest > kSiteIconPixels) {
+    const int width = std::max(1, bitmap.width() * kSiteIconPixels / longest);
+    const int height =
+        std::max(1, bitmap.height() * kSiteIconPixels / longest);
+    fitted = skia::ImageOperations::Resize(
+        bitmap, skia::ImageOperations::RESIZE_BEST, width, height);
+  }
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(fitted, /*discard_transparency=*/false);
+  if (!encoded || encoded->empty()) {
+    return nil;
+  }
+  return [NSData dataWithBytes:encoded->data() length:encoded->size()];
+}
 
 net::NetworkTrafficAnnotationTag SuggestAnnotation() {
   return net::DefineNetworkTrafficAnnotation("openarc_search_suggestions", R"(
@@ -129,6 +192,11 @@ - (NSInteger)typedCount {
 
 @end
 
+@interface OACAutocompleteRequest ()
+- (void)fetchFaviconFile:(const GURL&)pageURL profile:(Profile*)profile;
+- (void)decodeIcon:(std::string)bytes;
+@end
+
 // One request. Owns the history task tracker or the URL loader; dropping them
 // cancels the work. The handler runs once, from a posted task.
 @implementation OACAutocompleteRequest {
@@ -286,6 +354,96 @@ - (void)startFetch:(const GURL&)url profile:(Profile*)profile {
       kMaxSuggestBodySize);
 }
 
+// Plan B132: the stored icon of the page's site, else its /favicon.ico. The
+// handler (the suggestion slot, which also answers NSData) gets PNG or nil.
+- (void)startSiteIcon:(const GURL&)pageURL
+              profile:(Profile*)profile
+       faviconService:(favicon::FaviconService*)faviconService {
+  if (!faviconService) {
+    [self fetchFaviconFile:pageURL profile:profile];
+    return;
+  }
+  _tracker = std::make_unique<base::CancelableTaskTracker>();
+  // The profile may go away while the database answers.
+  base::WeakPtr<Profile> weakProfile = profile->GetWeakPtr();
+  OACAutocompleteRequest* request = self;
+  const GURL page = pageURL;
+  faviconService->GetRawFaviconForPageURL(
+      page,
+      {favicon_base::IconType::kFavicon, favicon_base::IconType::kTouchIcon,
+       favicon_base::IconType::kTouchPrecomposedIcon,
+       favicon_base::IconType::kWebManifestIcon},
+      kSiteIconPixels, /*fallback_to_host=*/true,
+      base::BindOnce(^(const favicon_base::FaviconRawBitmapResult& result) {
+        if (result.is_valid()) {
+          // The database stores PNG; the service already scaled it.
+          [request
+              finishWithEntries:nil
+                           body:[NSData
+                                    dataWithBytes:result.bitmap_data->front()
+                                           length:result.bitmap_data->size()]];
+          return;
+        }
+        Profile* live = weakProfile.get();
+        if (!live) {
+          [request finishWithEntries:nil body:nil];
+          return;
+        }
+        [request fetchFaviconFile:page profile:live];
+      }),
+      _tracker.get());
+}
+
+- (void)fetchFaviconFile:(const GURL&)pageURL profile:(Profile*)profile {
+  if (_finished) {
+    return;
+  }
+  auto resource = std::make_unique<network::ResourceRequest>();
+  resource->url = pageURL.GetWithEmptyPath().Resolve("/favicon.ico");
+  resource->method = "GET";
+  resource->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  resource->load_flags = net::LOAD_DO_NOT_SAVE_COOKIES;
+  _loader = network::SimpleURLLoader::Create(std::move(resource),
+                                             SiteIconAnnotation());
+  _loader->SetTimeoutDuration(kSiteIconTimeout);
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess();
+  // As for suggestions: the callback keeps the request alive until it
+  // finishes; -finish... drops the loader.
+  OACAutocompleteRequest* request = self;
+  network::SimpleURLLoader* loader = _loader.get();
+  loader->DownloadToString(
+      factory.get(),
+      base::BindOnce(^(std::optional<std::string> body) {
+        const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+        const int status =
+            head && head->headers ? head->headers->response_code() : 0;
+        if (!body || body->empty() || status < 200 || status >= 300) {
+          [request finishWithEntries:nil body:nil];
+          return;
+        }
+        [request decodeIcon:std::move(*body)];
+      }),
+      kMaxSiteIconBodySize);
+}
+
+// Decodes in the sandboxed data decoder (ICO, PNG, GIF, JPEG, WebP...); the
+// frame closest to the icon size is picked.
+- (void)decodeIcon:(std::string)bytes {
+  if (_finished) {
+    return;
+  }
+  OACAutocompleteRequest* request = self;
+  data_decoder::DecodeImageIsolated(
+      base::as_byte_span(bytes), data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/false, data_decoder::kDefaultMaxSizeInBytes,
+      gfx::Size(kSiteIconPixels, kSiteIconPixels),
+      base::BindOnce(^(const SkBitmap& bitmap) {
+        [request finishWithEntries:nil body:SiteIconPNG(bitmap)];
+      }));
+}
+
 @end
 
 @implementation OACProfile (OACAutocomplete)
@@ -358,4 +516,27 @@ @implementation OACProfile (OACAutocomplete)
   return request;
 }
 
+- (OACAutocompleteRequest*)
+    fetchSiteIconForPageURL:(NSURL*)pageURL
+          completionHandler:(void (^)(NSData*))completionHandler {
+  CHECK(NSThread.isMainThread);
+  CHECK(completionHandler);
+  OACAutocompleteRequest* request =
+      [[OACAutocompleteRequest alloc] initWithHistoryHandler:nil
+                                              suggestHandler:completionHandler];
+  Profile* profile = self.valid ? self.chromeProfile : nullptr;
+  GURL url = net::GURLWithNSURL(pageURL);
+  if (!profile || !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+      url.host().empty()) {
+    [request finishWithEntries:nil body:nil];
+    return request;
+  }
+  // Read only: an incognito window's lookups leave nothing in the on-disk
+  // profile's database.
+  favicon::FaviconService* service = FaviconServiceFactory::GetForProfile(
+      profile->GetOriginalProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  [request startSiteIcon:url profile:profile faviconService:service];
+  return request;
+}
+
 @end
