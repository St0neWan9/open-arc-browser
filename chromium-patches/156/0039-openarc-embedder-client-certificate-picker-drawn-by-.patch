diff --git a/openarc/bridge/oac_client_certificate.mm b/openarc/bridge/oac_client_certificate.mm
new file mode 100644
index 000000000000..62e15759259e
--- /dev/null
+++ b/openarc/bridge/oac_client_certificate.mm
@@ -0,0 +1,289 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The client-certificate picker drawn by the shell (plan C25). //chrome keeps
+// the policy (ChromeContentBrowserClient::SelectClientCertificate: the
+// AutoSelectCertificateForUrls setting picks a certificate without asking) and
+// calls ShowSSLClientCertificateSelector() when the user has to choose; an
+// Open Arc hook in that function hands the choice to the bridge, which turns
+// it into an OACClientCertificateRequest for the tab's dialog delegate.
+// SSLClientAuthObserver links prompts for the same host, as Chrome's dialog
+// does: answering one answers the others.
+
+#import "openarc/bridge/oac_client_certificate_internal.h"
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/ssl/ssl_client_auth_observer.h"
+#include "chrome/browser/ssl/ssl_client_certificate_selector.h"
+#include "content/public/browser/client_certificate_delegate.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "net/cert/x509_certificate.h"
+#include "net/cert/x509_util.h"
+#include "net/ssl/client_cert_identity.h"
+#include "net/ssl/ssl_cert_request_info.h"
+#include "net/ssl/ssl_private_key.h"
+#include "url/origin.h"
+
+#import "openarc/bridge/oac_requests_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+
+// MARK: - Bridge classes
+
+@implementation OACClientCertificate {
+  NSString* _subjectName;
+  NSString* _issuerName;
+  NSDate* _validUntil;
+  NSData* _DERData;
+}
+
+- (instancetype)initWithCertificate:(const net::X509Certificate&)certificate {
+  if ((self = [super init])) {
+    _subjectName =
+        base::SysUTF8ToNSString(certificate.subject().GetDisplayName());
+    _issuerName = base::SysUTF8ToNSString(certificate.issuer().GetDisplayName());
+    _validUntil = certificate.valid_expiry().ToNSDate();
+    base::span<const uint8_t> der =
+        net::x509_util::CryptoBufferAsSpan(certificate.cert_buffer());
+    _DERData = [NSData dataWithBytes:der.data() length:der.size()];
+  }
+  return self;
+}
+
+- (NSString*)subjectName {
+  return _subjectName;
+}
+- (NSString*)issuerName {
+  return _issuerName;
+}
+- (NSDate*)validUntil {
+  return _validUntil;
+}
+- (NSData*)DERData {
+  return _DERData;
+}
+
+@end
+
+@implementation OACClientCertificateRequest {
+  NSString* _hostPort;
+  NSArray<OACClientCertificate*>* _certificates;
+  // Runs with the chosen index, or -1 to continue without a certificate.
+  base::OnceCallback<void(NSInteger)> _answer;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                   hostPort:(NSString*)hostPort
+               certificates:(NSArray<OACClientCertificate*>*)certificates
+                     answer:(base::OnceCallback<void(NSInteger)>)answer {
+  if ((self = [super initWithTab:tab origin:origin isFromSubframe:NO])) {
+    _hostPort = [hostPort copy];
+    _certificates = [certificates copy];
+    _answer = std::move(answer);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self cancel];
+}
+
+- (NSString*)hostPort {
+  return _hostPort;
+}
+- (NSArray<OACClientCertificate*>*)certificates {
+  return _certificates;
+}
+
+- (void)selectCertificateAtIndex:(NSInteger)index {
+  if (![self markFinished]) {
+    return;
+  }
+  if (_answer) {
+    const bool in_range =
+        index >= 0 && static_cast<NSUInteger>(index) < _certificates.count;
+    std::move(_answer).Run(in_range ? index : -1);
+  }
+}
+
+- (void)continueWithoutCertificate {
+  [self selectCertificateAtIndex:-1];
+}
+
+- (void)cancel {
+  [self continueWithoutCertificate];
+}
+
+- (void)withdrawByEngine {
+  _answer.Reset();
+  [super withdrawByEngine];
+}
+
+@end
+
+// MARK: - Chromium side
+
+namespace openarc {
+
+namespace {
+
+// One prompt: owns Chrome's delegate (through SSLClientAuthObserver) and the
+// identities until the user answers, another prompt for the same host is
+// answered, or the tab goes away. Owns itself; deleted when finished.
+class ShellClientCertificatePrompt : public SSLClientAuthObserver,
+                                     public content::WebContentsObserver {
+ public:
+  ShellClientCertificatePrompt(
+      content::WebContents* web_contents,
+      net::SSLCertRequestInfo* cert_request_info,
+      net::ClientCertIdentityList identities,
+      std::unique_ptr<content::ClientCertificateDelegate> delegate)
+      : SSLClientAuthObserver(web_contents->GetBrowserContext(),
+                              cert_request_info,
+                              std::move(delegate)),
+        content::WebContentsObserver(web_contents),
+        identities_(std::move(identities)) {}
+
+  ShellClientCertificatePrompt(const ShellClientCertificatePrompt&) = delete;
+  ShellClientCertificatePrompt& operator=(const ShellClientCertificatePrompt&) =
+      delete;
+
+  ~ShellClientCertificatePrompt() override {
+    StopObserving();
+    [request_ withdrawByEngine];
+  }
+
+  // Hands the request to the tab's dialog delegate. Returns the cancellation
+  // callback for content (the request went away first).
+  base::OnceClosure Present(OACTab* tab) {
+    StartObserving();
+    NSMutableArray<OACClientCertificate*>* certificates =
+        [NSMutableArray arrayWithCapacity:identities_.size()];
+    for (const auto& identity : identities_) {
+      [certificates addObject:[[OACClientCertificate alloc]
+                                  initWithCertificate:*identity->certificate()]];
+    }
+    const net::HostPortPair& host_port = cert_request_info()->host_and_port;
+    base::WeakPtr<ShellClientCertificatePrompt> weak_this =
+        weak_factory_.GetWeakPtr();
+    request_ = [[OACClientCertificateRequest alloc]
+         initWithTab:tab
+              origin:OACOriginFromURLOrigin(url::Origin::Create(
+                         GURL("https://" + host_port.ToString())))
+            hostPort:base::SysUTF8ToNSString(host_port.ToString())
+        certificates:certificates
+              answer:base::BindOnce(
+                         [](base::WeakPtr<ShellClientCertificatePrompt> self,
+                            NSInteger index) {
+                           if (self) {
+                             self->Answer(index);
+                           }
+                         },
+                         weak_this)];
+    OACClientCertificateRequest* request = request_;
+    OACPresentDialogRequest(
+        tab, request, @selector(tab:selectClientCertificate:),
+        ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+          return [delegate tab:owner selectClientCertificate:request];
+        });
+    return base::BindOnce(
+        [](base::WeakPtr<ShellClientCertificatePrompt> self) {
+          // The network request went away: nothing to answer. Content also
+          // runs this while it handles our own answer (its handler goes
+          // away inside ContinueWithCertificate); the answer path owns the
+          // deletion then.
+          if (self && !self->answered_) {
+            self->CancelCertificateSelection();
+            delete self.get();
+          }
+        },
+        weak_this);
+  }
+
+ private:
+  void Answer(NSInteger index) {
+    request_ = nil;
+    answered_ = true;
+    if (index < 0) {
+      // As Chrome's dialog closed without a choice: continue without one
+      // (remembered for the host for the session by the network stack).
+      CertificateSelected(nullptr, nullptr);
+      delete this;
+      return;
+    }
+    // Stop observing before the private key arrives, as Chrome does: another
+    // prompt's answer must not delete this while the key is pending.
+    StopObserving();
+    std::unique_ptr<net::ClientCertIdentity> identity =
+        std::move(identities_[static_cast<size_t>(index)]);
+    scoped_refptr<net::X509Certificate> certificate = identity->certificate();
+    net::ClientCertIdentity::SelfOwningAcquirePrivateKey(
+        std::move(identity),
+        base::BindOnce(
+            [](base::WeakPtr<ShellClientCertificatePrompt> self,
+               scoped_refptr<net::X509Certificate> certificate,
+               scoped_refptr<net::SSLPrivateKey> private_key) {
+              if (!self) {
+                return;
+              }
+              self->CertificateSelected(certificate.get(), private_key.get());
+              delete self.get();
+            },
+            weak_factory_.GetWeakPtr(), std::move(certificate)));
+  }
+
+  // SSLClientAuthObserver: another prompt for this host was answered.
+  void OnCertSelectedByNotification() override { delete this; }
+
+  // content::WebContentsObserver: the tab closed; the request is aborted.
+  void WebContentsDestroyed() override {
+    CancelCertificateSelection();
+    if (!answered_) {
+      delete this;
+    }
+  }
+
+  net::ClientCertIdentityList identities_;
+  // Set once the user answered: from then on only the answer path deletes
+  // this (a private key may still be pending).
+  bool answered_ = false;
+  OACClientCertificateRequest* __strong request_ = nil;
+  base::WeakPtrFactory<ShellClientCertificatePrompt> weak_factory_{this};
+};
+
+// ShowSSLClientCertificateSelector()'s embedder hook. |client_certs| is not
+// empty (Chrome continues without a certificate before calling it).
+base::OnceClosure SelectClientCertificate(
+    content::WebContents* contents,
+    net::SSLCertRequestInfo* cert_request_info,
+    net::ClientCertIdentityList client_certs,
+    std::unique_ptr<content::ClientCertificateDelegate> delegate) {
+  OACTab* tab = OACTabForWebContents(contents);
+  if (!tab || tab.isClosed) {
+    // No shell tab to ask in (as Chrome without a modal dialog host): the
+    // request is aborted when |delegate| goes away.
+    return base::OnceClosure();
+  }
+  auto* prompt = new ShellClientCertificatePrompt(
+      contents, cert_request_info, std::move(client_certs),
+      std::move(delegate));
+  return prompt->Present(tab);
+}
+
+}  // namespace
+
+void InstallClientCertificateSelector() {
+  SetEmbedderClientCertificateSelector(&SelectClientCertificate);
+}
+
+}  // namespace openarc
