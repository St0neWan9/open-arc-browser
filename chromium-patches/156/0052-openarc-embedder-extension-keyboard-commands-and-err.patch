+#import "openarc/bridge/oac_tab_internal.h"
+
+namespace openarc {
+
+ExtensionCommandRegistry::ExtensionCommandRegistry(OACExtensions* owner,
+                                                   Profile* profile)
+    : ExtensionKeybindingRegistry(profile,
+                                  /*tab_list_interface=*/nullptr,
+                                  ExtensionFilter::ALL_EXTENSIONS),
+      owner_(owner) {
+  Init();
+}
+
+ExtensionCommandRegistry::~ExtensionCommandRegistry() = default;
+
+bool ExtensionCommandRegistry::HandleKeyDown(
+    content::WebContents* web_contents,
+    const input::NativeWebKeyboardEvent& event) {
+  if (shortcut_handling_suspended()) {
+    return false;
+  }
+  const ui::Accelerator accelerator =
+      ui::GetAcceleratorFromNativeWebKeyboardEvent(event);
+  if (!accelerators_.contains(accelerator)) {
+    return false;
+  }
+  if (auto it = action_accelerators_.find(accelerator);
+      it != action_accelerators_.end()) {
+    OACTab* tab = OACTabForWebContents(web_contents);
+    if (!tab) {
+      return false;
+    }
+    // As a click on the toolbar button: activeTab, then the popup or
+    // action.onClicked; the popup reaches the shell through the delegate.
+    [owner_ runActionFromKeyboardOfExtension:base::SysUTF8ToNSString(
+                                                 it->second)
+                                       onTab:tab];
+    return true;
+  }
+  active_web_contents_ = web_contents;
+  const bool handled = NotifyEventTargets(accelerator);
+  active_web_contents_ = nullptr;
+  return handled;
+}
+
+bool ExtensionCommandRegistry::PopulateCommands(
+    const extensions::Extension* extension,
+    ui::CommandMap* commands) {
+  extensions::CommandService* service =
+      extensions::CommandService::Get(browser_context());
+  const bool named = service->GetNamedCommands(
+      extension->id(), extensions::CommandService::ACTIVE,
+      extensions::CommandService::REGULAR, commands);
+  extensions::Command action;
+  const bool has_action = service->GetExtensionActionCommand(
+      extension->id(), extensions::ActionInfo::Type::kAction,
+      extensions::CommandService::ACTIVE, &action, /*active=*/nullptr);
+  if (has_action) {
+    (*commands)[action.command_name()] = action;
+  }
+  return named || has_action;
+}
+
+bool ExtensionCommandRegistry::RegisterAccelerator(
+    const ui::Accelerator& accelerator,
+    const extensions::ExtensionId& extension_id,
+    const std::string& command_name) {
+  accelerators_.insert(accelerator);
+  if (extensions::Command::IsActionRelatedCommand(command_name)) {
+    action_accelerators_[accelerator] = extension_id;
+  }
+  return true;
+}
+
+void ExtensionCommandRegistry::UnregisterAccelerator(
+    const ui::Accelerator& accelerator) {
+  accelerators_.erase(accelerator);
+  action_accelerators_.erase(accelerator);
+}
+
+bool ExtensionCommandRegistry::ShouldIgnoreCommand(
+    const std::string& command) const {
+  return false;  // Action commands are handled here too.
+}
+
+content::WebContents*
+ExtensionCommandRegistry::GetActiveWebContentsForCommand() {
+  return active_web_contents_;
+}
+
+std::unique_ptr<ExtensionCommandRegistry> CreateExtensionCommandRegistry(
+    OACExtensions* owner,
+    Profile* profile) {
+  return std::make_unique<ExtensionCommandRegistry>(owner, profile);
+}
+
+void DestroyExtensionCommandRegistry(
+    std::unique_ptr<ExtensionCommandRegistry> registry) {
+  registry.reset();
+}
+
+bool HandleExtensionCommandKeyEvent(content::WebContents* web_contents,
+                                    const input::NativeWebKeyboardEvent& event) {
+  if (!web_contents ||
+      event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+    return false;
+  }
+  OACTab* tab = OACTabForWebContents(web_contents);
+  OACProfile* profile = tab.profile;
+  if (!profile.valid) {
+    return false;
+  }
+  // Off-the-record tabs use their original profile's extensions (only those
+  // allowed in incognito have commands there: the registry's event router
+  // skips the others).
+  ExtensionCommandRegistry* registry = [profile.extensions commandRegistry];
+  return registry && registry->HandleKeyDown(tab.webContents, event);
+}
+
+}  // namespace openarc
