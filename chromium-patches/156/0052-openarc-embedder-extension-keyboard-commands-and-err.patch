+class Profile;
+
+namespace openarc {
+
+// Chrome's keybinding registry with the bridge's tabs: accelerators are kept
+// here (Chrome registers them with a Views FocusManager) and key presses come
+// from the tabs (HandleExtensionCommandKeyEvent). Like Chrome's Android
+// registry it also handles `_execute_action`, which Chrome's desktop toolbar
+// buttons own.
+class ExtensionCommandRegistry
+    : public extensions::ExtensionKeybindingRegistry {
+ public:
+  ExtensionCommandRegistry(OACExtensions* owner, Profile* profile);
+  ExtensionCommandRegistry(const ExtensionCommandRegistry&) = delete;
+  ExtensionCommandRegistry& operator=(const ExtensionCommandRegistry&) = delete;
+  ~ExtensionCommandRegistry() override;
+
+  // Returns whether a command took the key press of |web_contents|.
+  bool HandleKeyDown(content::WebContents* web_contents,
+                     const input::NativeWebKeyboardEvent& event);
+
+ private:
+  // extensions::ExtensionKeybindingRegistry:
+  bool PopulateCommands(const extensions::Extension* extension,
+                        ui::CommandMap* commands) override;
+  bool RegisterAccelerator(const ui::Accelerator& accelerator,
+                           const extensions::ExtensionId& extension_id,
+                           const std::string& command_name) override;
+  void UnregisterAccelerator(const ui::Accelerator& accelerator) override;
+  bool ShouldIgnoreCommand(const std::string& command) const override;
+  content::WebContents* GetActiveWebContentsForCommand() override;
+
+  __weak OACExtensions* owner_;
+  std::set<ui::Accelerator> accelerators_;
+  std::map<ui::Accelerator, extensions::ExtensionId> action_accelerators_;
+  // The tab of the key press being handled.
+  raw_ptr<content::WebContents> active_web_contents_ = nullptr;
+};
+
+// Plan C26: the keyboard commands of one profile's extensions (manifest
+// `commands`): named commands fire `commands.onCommand`, `_execute_action`
+// runs the extension's action on the tab (its popup through the extensions
+// delegate). Owned by the profile's OACExtensions.
+std::unique_ptr<ExtensionCommandRegistry> CreateExtensionCommandRegistry(
+    OACExtensions* owner,
+    Profile* profile);
+void DestroyExtensionCommandRegistry(
+    std::unique_ptr<ExtensionCommandRegistry> registry);
+
+// A key press in |web_contents| (before the page sees it). Returns YES when an
+// extension command of the tab's profile took it.
+bool HandleExtensionCommandKeyEvent(content::WebContents* web_contents,
+                                    const input::NativeWebKeyboardEvent& event);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BRIDGE_OAC_EXTENSION_COMMANDS_INTERNAL_H_
