+- (void)runActionFromKeyboardOfExtension:(NSString*)extensionIdentifier
+                                   onTab:(OACTab*)tab {
+  OACExtensionPopup* popup = [self runActionOfExtension:extensionIdentifier
+                                                  onTab:tab];
+  if (!popup) {
+    return;  // action.onClicked was sent (or nothing to run).
+  }
+  __weak OACExtensions* weakSelf = self;
+  __weak OACTab* weakTab = tab;
+  OACPostToMainThread(^{
+    OACExtensions* strongSelf = weakSelf;
+    OACTab* strongTab = weakTab;
+    id<OACExtensionsDelegate> delegate = strongSelf.delegate;
+    if (strongSelf && strongTab && !popup.closed &&
+        [delegate respondsToSelector:@selector(extensions:
+                                          didOpenPopup:fromKeyboardOnTab:)]) {
+      [delegate extensions:strongSelf
+                didOpenPopup:popup
+           fromKeyboardOnTab:strongTab];
+    } else {
+      [popup close];
+    }
+  });
+}
+
+- (void)errorsDidChangeForExtension:(const std::string&)extensionID {
+  NSString* identifier = ToNS(extensionID);
+  __weak OACExtensions* weakSelf = self;
+  OACPostToMainThread(^{
+    OACExtensions* strongSelf = weakSelf;
+    id<OACExtensionsDelegate> delegate = strongSelf.delegate;
+    if (strongSelf &&
+        [delegate respondsToSelector:@selector(extensions:
+                                          didChangeErrorsOfExtension:)]) {
+      [delegate extensions:strongSelf didChangeErrorsOfExtension:identifier];
+    }
+  });
+}
