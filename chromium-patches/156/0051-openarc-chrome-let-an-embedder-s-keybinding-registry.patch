From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: voidforge <voidforge@valuz.io>
Date: Tue, 27 Oct 2026 20:59:42 -0700
Subject: [PATCH] openarc: chrome: let an embedder's keybinding registry name
 the command's tab

Plan C26. ExtensionKeybindingRegistry finds the tab a command acts on (the
event's `tab`, and the tab activeTab is granted on) through the Browser's
TabListInterface, which an app that owns its tabs does not have.

GetActiveWebContentsForCommand() is now virtual (default: the
TabListInterface's active tab, as before), so an embedder's registry
subclass passes the tab that had the keyboard.
---
 .../extensions/extension_keybinding_registry.cc   | 15 +++++++++++----
 .../extensions/extension_keybinding_registry.h    |  9 ++++++++-
 2 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/extensions/extension_keybinding_registry.cc b/chrome/browser/extensions/extension_keybinding_registry.cc
index fb7152b58619..4b186d412121 100644
--- a/chrome/browser/extensions/extension_keybinding_registry.cc
+++ b/chrome/browser/extensions/extension_keybinding_registry.cc
@@ -206,6 +206,15 @@ bool ExtensionKeybindingRegistry::ShouldIgnoreCommand(
   return Command::IsActionRelatedCommand(command);
 }
 
+content::WebContents*
+ExtensionKeybindingRegistry::GetActiveWebContentsForCommand() {
+  if (!tab_list_interface_) {
+    return nullptr;
+  }
+  auto* active_tab = tab_list_interface_->GetActiveTab();
+  return active_tab ? active_tab->GetContents() : nullptr;
+}
+
 void ExtensionKeybindingRegistry::Init() {
   ExtensionRegistry* registry = ExtensionRegistry::Get(browser_context_);
   if (!registry)
@@ -241,10 +250,8 @@ void ExtensionKeybindingRegistry::CommandExecuted(
   args.Append(command);
 
   base::Value tab_value;
-  if (tab_list_interface_) {
-    auto* active_tab = tab_list_interface_->GetActiveTab();
-    content::WebContents* web_contents =
-        active_tab ? active_tab->GetContents() : nullptr;
+  {
+    content::WebContents* web_contents = GetActiveWebContentsForCommand();
     // Grant before sending the event so that the permission is granted before
     // the extension acts on the command. NOTE: The Global Commands handler does
     // not set the TabListInterface as it deals only with named commands (not
diff --git a/chrome/browser/extensions/extension_keybinding_registry.h b/chrome/browser/extensions/extension_keybinding_registry.h
index 58a01d48f0ae..81d6a1e7e68a 100644
--- a/chrome/browser/extensions/extension_keybinding_registry.h
+++ b/chrome/browser/extensions/extension_keybinding_registry.h
@@ -26,7 +26,8 @@ class TabListInterface;
 
 namespace content {
 class BrowserContext;
-}
+class WebContents;
+}  // namespace content
 
 namespace ui {
 class Accelerator;
@@ -108,6 +109,12 @@ class ExtensionKeybindingRegistry : public CommandService::Observer,
   // overridable.
   virtual bool ShouldIgnoreCommand(const std::string& command) const;
 
+  // Open Arc: the tab a command acts on (activeTab is granted to it and it is
+  // the event's `tab`). The default is the active tab of the
+  // TabListInterface; an embedder that owns its tabs and passes no
+  // TabListInterface overrides it.
+  virtual content::WebContents* GetActiveWebContentsForCommand();
+
   // Make sure all extensions registered have keybindings added.
   void Init();
 
