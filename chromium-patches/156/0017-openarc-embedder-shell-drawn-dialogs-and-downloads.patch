+// Uniform type identifiers for the `accept` attribute: MIME types
+// ("image/png", "image/*") and extensions (".pdf"). Unknown entries are
+// dropped; if nothing is left the panel accepts any file, as Chrome's does
+// when it has no file types.
+NSArray<NSString*>* TypeIdentifiersForAccept(
+    const std::vector<std::u16string>& accept_types) {
+  NSMutableOrderedSet<NSString*>* identifiers = [NSMutableOrderedSet orderedSet];
+  for (const std::u16string& accept : accept_types) {
+    NSString* value = base::SysUTF16ToNSString(accept).lowercaseString;
+    if (value.length == 0) {
+      continue;
+    }
+    if ([value hasPrefix:@"."]) {
+      UTType* type =
+          [UTType typeWithFilenameExtension:[value substringFromIndex:1]];
+      if (type) {
+        [identifiers addObject:type.identifier];
+      }
+      continue;
+    }
+    if ([value hasSuffix:@"/*"]) {
+      NSString* top = [value substringToIndex:value.length - 2];
+      UTType* type = [top isEqualToString:@"image"]   ? UTTypeImage
+                     : [top isEqualToString:@"audio"] ? UTTypeAudio
+                     : [top isEqualToString:@"video"] ? UTTypeMovie
+                     : [top isEqualToString:@"text"]  ? UTTypeText
+                                                      : nil;
+      if (type) {
+        [identifiers addObject:type.identifier];
+      }
+      continue;
+    }
+    UTType* type = [UTType typeWithMIMEType:value];
+    if (type) {
+      [identifiers addObject:type.identifier];
+      continue;
+    }
+    // A MIME type macOS does not know: its extensions, as Chrome does.
+    std::vector<base::FilePath::StringType> extensions;
+    net::GetExtensionsForMimeType(base::SysNSStringToUTF8(value), &extensions);
+    for (const auto& extension : extensions) {
+      UTType* by_extension = [UTType
+          typeWithFilenameExtension:base::SysUTF8ToNSString(extension)];
+      if (by_extension) {
+        [identifiers addObject:by_extension.identifier];
+      }
+    }
+  }
+  return identifiers.array;
+}
+
+// Hands the files the user chose (none: cancelled) to the page.
+void AnswerFileChooser(scoped_refptr<content::FileSelectListener> listener,
+                       base::WeakPtr<content::WebContents> contents,
+                       blink::mojom::FileChooserParams::Mode mode,
+                       NSArray<NSURL*>* urls) {
+  if (urls.count == 0) {
+    listener->FileSelectionCanceled();
+    return;
+  }
+  if (mode == blink::mojom::FileChooserParams::Mode::kUploadFolder) {
+    // <input webkitdirectory>: Chrome's helper lists the folder's files.
+    if (!contents) {
+      listener->FileSelectionCanceled();
+      return;
+    }
+    FileSelectHelper::EnumerateDirectory(
+        contents.get(), std::move(listener),
+        base::apple::NSURLToFilePath(urls.firstObject));
+    return;
+  }
+  std::vector<blink::mojom::FileChooserFileInfoPtr> files;
+  for (NSURL* url in urls) {
+    files.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+        blink::mojom::NativeFileInfo::New(base::apple::NSURLToFilePath(url),
+                                          std::u16string(),
+                                          std::vector<std::u16string>())));
+  }
+  listener->FileSelected(std::move(files), base::FilePath(), mode);
+}
