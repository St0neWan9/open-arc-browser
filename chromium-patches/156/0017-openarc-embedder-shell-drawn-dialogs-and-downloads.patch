+namespace {
+
+// Items the Library lists: not Save Page As internals, not transient
+// downloads (extension installs, background fetches).
+bool IsListed(const download::DownloadItem* item) {
+  return !item->IsTemporary() && !item->IsTransient() &&
+         !item->IsSavePackageDownload();
+}
+
+// Forwards the manager's item notifications to the OACDownloads.
+class DownloadsObserverBridge
+    : public download::AllDownloadItemNotifier::Observer {
+ public:
+  DownloadsObserverBridge(OACDownloads* owner, content::DownloadManager* manager)
+      : owner_(owner), notifier_(manager, this) {}
+
+  content::DownloadManager* manager() const { return notifier_.GetManager(); }
+
+  // download::AllDownloadItemNotifier::Observer:
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    [owner_ itemCreated:item];
+  }
+  void OnDownloadUpdated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    [owner_ itemUpdated:item];
+  }
+  void OnDownloadRemoved(content::DownloadManager* manager,
+                         download::DownloadItem* item) override {
+    [owner_ itemRemoved:item];
+  }
+
+ private:
+  __weak OACDownloads* owner_;
+  download::AllDownloadItemNotifier notifier_;
+};
+
+// At most this many progress updates per second and item (OACDownloads.h).
+constexpr base::TimeDelta kUpdateInterval = base::Milliseconds(250);
+
+}  // namespace
+
+@implementation OACDownloads {
+  __weak OACProfile* _profile;
+  std::unique_ptr<DownloadsObserverBridge> _bridge;
+  NSHashTable<id<OACDownloadsObserver>>* _observers;
+  // Last update sent per item, for coalescing progress.
+  NSMutableDictionary<NSString*, NSNumber*>* _lastUpdate;
+  // State last sent per item, so state changes are never coalesced away.
+  NSMutableDictionary<NSString*, NSNumber*>* _lastState;
+  NSMutableSet<NSString*>* _pendingFlush;
+}
+
+- (instancetype)initWithProfile:(OACProfile*)profile {
+  if ((self = [super init])) {
+    _profile = profile;
+    _observers = [NSHashTable weakObjectsHashTable];
+    _lastUpdate = [NSMutableDictionary dictionary];
+    _lastState = [NSMutableDictionary dictionary];
+    _pendingFlush = [NSMutableSet set];
+    Profile* chrome_profile = profile.chromeProfile;
+    if (chrome_profile) {
+      // Creates //chrome's download manager delegate (and loads the history
+      // of an on-disk profile) if no download happened yet.
+      DownloadCoreServiceFactory::GetForBrowserContext(chrome_profile)
+          ->GetDownloadManagerDelegate();
+      _bridge = std::make_unique<DownloadsObserverBridge>(
+          self, chrome_profile->GetDownloadManager());
+      // Items that exist already (history) are known: their updates are
+      // updates, not additions.
+      download::SimpleDownloadManager::DownloadVector existing;
+      chrome_profile->GetDownloadManager()->GetAllDownloads(&existing);
+      for (download::DownloadItem* item : existing) {
+        if (IsListed(item)) {
+          _lastState[base::SysUTF8ToNSString(item->GetGuid())] =
+              @([self snapshot:item].state);
+        }
+      }
+    }
+  }
+  return self;
+}
+
+- (void)invalidate {
+  _bridge.reset();
+}
+
+- (OACProfile*)profile {
+  return _profile;
+}
+
+- (Profile*)chromeProfile {
+  OACProfile* profile = _profile;
+  return profile.valid ? profile.chromeProfile : nullptr;
+}
+
+- (content::DownloadManager*)manager {
+  return _bridge ? _bridge->manager() : nullptr;
+}
+
+- (download::DownloadItem*)itemWithIdentifier:(NSString*)identifier {
+  content::DownloadManager* manager = self.manager;
+  return manager ? manager->GetDownloadByGuid(base::SysNSStringToUTF8(identifier))
+                 : nullptr;
+}
+
+- (OACDownloadItem*)snapshot:(download::DownloadItem*)item {
+  OACProfile* profile = _profile;
+  return [[OACDownloadItem alloc] initWithItem:item
+                                isOffTheRecord:profile.isOffTheRecord];
+}
+
+// MARK: Settings
+
+- (NSURL*)defaultDirectory {
+  Profile* profile = self.chromeProfile;
+  if (!profile) {
+    return nil;
+  }
+  return base::apple::FilePathToNSURL(
+      DownloadPrefs::FromBrowserContext(profile)->DownloadPath());
+}
