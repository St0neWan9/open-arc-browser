+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_DIALOG_HOST_H_
+#define OPENARC_BROWSER_OPENARC_DIALOG_HOST_H_
+
+#include <memory>
+
+#include "components/permissions/permission_prompt.h"
+#include "content/public/browser/login_delegate.h"
+
+class LoginHandler;
+
+namespace content {
+class WebContents;
+}
+
+namespace net {
+class AuthChallengeInfo;
+}
+
+namespace openarc {
+
+// Where //chrome's prompt controllers hand their prompts to the shell (plan
+// C12). Chrome draws these with Views anchored to a Browser window; we keep the
+// controllers (PermissionRequestManager, the HTTP auth flow with its
+// LoginTabHelper) and replace only the UI. The embedder cannot see the
+// Objective-C bridge (the bridge depends on it), so the bridge registers its
+// implementation here when the engine starts; each method turns the prompt
+// into an OACDialogDelegate request of the tab. (External protocol prompts go
+// to the bridge directly, through ExternalProtocolHandler's embedder hook.)
+class DialogHost {
+ public:
+  // Not owned. Set once before content starts; nullptr clears it.
+  static void Set(DialogHost* host);
+  // The registered host, or nullptr.
+  static DialogHost* Get();
+
+  // The view of a PermissionRequestManager prompt. Never returns nullptr.
+  virtual std::unique_ptr<permissions::PermissionPrompt> CreatePermissionPrompt(
+      content::WebContents* web_contents,
+      permissions::PermissionPrompt::Delegate* delegate) = 0;
+
+  // The HTTP authentication prompt (Chrome's LoginHandler with our view).
+  virtual std::unique_ptr<LoginHandler> CreateLoginHandler(
+      const net::AuthChallengeInfo& auth_info,
+      content::WebContents* web_contents,
+      content::LoginDelegate::LoginAuthRequiredCallback
+          auth_required_callback) = 0;
+
+ protected:
+  virtual ~DialogHost() = default;
+};
+
+// A permission prompt nobody sees: it dismisses the requests as soon as it is
+// shown (the page sees "denied", no decision is stored). Used when no tab of
+// the shell owns the WebContents, or for request types the shell has no
+// prompt for.
+std::unique_ptr<permissions::PermissionPrompt> CreateDismissingPermissionPrompt(
+    content::WebContents* web_contents,
+    permissions::PermissionPrompt::Delegate* delegate);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_DIALOG_HOST_H_
