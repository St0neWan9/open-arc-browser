+@interface OACDownloadItem ()
+- (instancetype)initWithItem:(download::DownloadItem*)item
+              isOffTheRecord:(BOOL)isOffTheRecord;
+@end
+
+@implementation OACDownloadItem {
+  NSString* _identifier;
+  NSURL* _sourceURL;
+  NSURL* _referrerURL;
+  NSURL* _fileURL;
+  NSString* _suggestedFilename;
+  NSString* _MIMEType;
+  OACDownloadState _state;
+  int64_t _receivedBytes;
+  int64_t _totalBytes;
+  NSDate* _startDate;
+  NSDate* _endDate;
+  BOOL _isOffTheRecord;
+  NSString* _warningText;
+}
+
+- (instancetype)initWithItem:(download::DownloadItem*)item
+              isOffTheRecord:(BOOL)isOffTheRecord {
+  if ((self = [super init])) {
+    _identifier = base::SysUTF8ToNSString(item->GetGuid());
+    _sourceURL = net::NSURLWithGURL(item->GetURL()) ?: [NSURL URLWithString:@"about:blank"];
+    _referrerURL = item->GetReferrerUrl().is_valid()
+                       ? net::NSURLWithGURL(item->GetReferrerUrl())
+                       : nil;
+    const base::FilePath& target = item->GetTargetFilePath();
+    _fileURL = target.empty() ? nil : base::apple::FilePathToNSURL(target);
+    _suggestedFilename =
+        base::SysUTF8ToNSString(item->GetFileNameToReportUser().value());
+    const std::string mime = item->GetMimeType();
+    _MIMEType = mime.empty() ? nil : base::SysUTF8ToNSString(mime);
+    DownloadItemModel model(item);
+    const bool needs_confirmation =
+        item->GetState() == download::DownloadItem::IN_PROGRESS &&
+        (item->IsDangerous() || item->IsInsecure());
+    switch (item->GetState()) {
+      case download::DownloadItem::IN_PROGRESS:
+        _state = needs_confirmation ? OACDownloadStateNeedsConfirmation
+                 : item->IsPaused() ? OACDownloadStatePaused
+                                    : OACDownloadStateInProgress;
+        break;
+      case download::DownloadItem::COMPLETE:
+        _state = OACDownloadStateComplete;
+        break;
+      case download::DownloadItem::CANCELLED:
+        _state = OACDownloadStateCancelled;
+        break;
+      case download::DownloadItem::INTERRUPTED:
+      default:
+        _state = OACDownloadStateInterrupted;
+        break;
+    }
+    if (needs_confirmation) {
+      size_t offset = 0;
+      _warningText = base::SysUTF16ToNSString(model.GetWarningText(
+          item->GetFileNameToReportUser().LossyDisplayName(), &offset));
+    }
+    _receivedBytes = item->GetReceivedBytes();
+    _totalBytes = item->GetTotalBytes() > 0 ? item->GetTotalBytes() : -1;
+    _startDate = item->GetStartTime().ToNSDate();
+    _endDate = item->IsDone() && !item->GetEndTime().is_null()
+                   ? item->GetEndTime().ToNSDate()
+                   : nil;
+    _isOffTheRecord = isOffTheRecord;
+  }
+  return self;
+}
+
