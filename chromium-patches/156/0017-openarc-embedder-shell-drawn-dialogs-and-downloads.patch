+// OACPermissionKind for a permission request type; nullopt for types the shell
+// has no prompt for.
+std::optional<OACPermissionKind> PermissionKindFor(
+    permissions::RequestType type) {
+  using permissions::RequestType;
+  switch (type) {
+    case RequestType::kCameraStream:
+      return OACPermissionKindCamera;
+    case RequestType::kMicStream:
+      return OACPermissionKindMicrophone;
+    case RequestType::kGeolocation:
+      return OACPermissionKindLocation;
+    case RequestType::kNotifications:
+      return OACPermissionKindNotifications;
+    case RequestType::kClipboard:
+      return OACPermissionKindClipboardRead;
+    case RequestType::kMidiSysex:
+      return OACPermissionKindMIDI;
+    case RequestType::kStorageAccess:
+    case RequestType::kTopLevelStorageAccess:
+      return OACPermissionKindStorageAccess;
+    case RequestType::kMultipleDownloads:
+      return OACPermissionKindMultipleDownloads;
+    case RequestType::kLocalFonts:
+      return OACPermissionKindLocalFonts;
+    case RequestType::kWindowManagement:
+      return OACPermissionKindWindowManagement;
+    case RequestType::kIdleDetection:
+      return OACPermissionKindIdleDetection;
+    default:
+      return std::nullopt;
+  }
+}
+
+// PermissionRequestManager's prompt view: one OACPermissionRequest for the
+// current group of requests (camera and microphone of one getUserMedia call
+// come together). Destroying the view (navigation, tab closed, the manager
+// re-prioritized) withdraws the request.
+class ShellPermissionPrompt : public permissions::PermissionPrompt {
+ public:
+  ShellPermissionPrompt(OACTab* tab, Delegate* delegate)
+      : delegate_(delegate->GetWeakPtr()) {
+    NSMutableArray<NSNumber*>* kinds = [NSMutableArray array];
+    bool supports_once = true;
+    for (const auto& request : delegate->Requests()) {
+      std::optional<OACPermissionKind> kind =
+          PermissionKindFor(request->request_type());
+      if (!kind) {
+        continue;
+      }
+      if (![kinds containsObject:@(*kind)]) {
+        [kinds addObject:@(*kind)];
+      }
+      std::optional<ContentSettingsType> setting =
+          permissions::RequestTypeToContentSettingsType(
+              request->request_type());
+      if (!setting ||
+          !permissions::PermissionUtil::DoesSupportTemporaryGrants(*setting)) {
+        supports_once = false;
+      }
+    }
+    const bool has_gesture =
+        !delegate->Requests().empty() &&
+        delegate->Requests()[0]->GetGestureType() ==
+            permissions::PermissionRequestGestureType::GESTURE;
+    const GURL requesting = delegate->GetRequestingOrigin();
+    const GURL embedding = delegate->GetEmbeddingOrigin();
+    base::WeakPtr<ShellPermissionPrompt> weak_this =
+        weak_factory_.GetWeakPtr();
+    if (kinds.count == 0) {
+      // Nothing the shell can ask about (for example a protocol handler
+      // registration): dismissed, as before C12.
+      Answer(PermissionAnswer::kDismiss);
+      return;
+    }
+    request_ = [[OACPermissionRequest alloc]
+                 initWithTab:tab
+                      origin:OACOriginFromURLOrigin(
+                                 url::Origin::Create(requesting))
+              isFromSubframe:url::Origin::Create(requesting) !=
+                             url::Origin::Create(embedding)
+                       kinds:kinds
+              hasUserGesture:has_gesture
+        supportsAllowingOnce:supports_once
+                      answer:base::BindOnce(
+                                 [](base::WeakPtr<ShellPermissionPrompt> self,
+                                    PermissionAnswer answer) {
+                                   if (self) {
+                                     self->Answer(answer);
+                                   }
+                                 },
+                                 weak_this)];
+    OACPermissionRequest* request = request_;
+    OACPresentDialogRequest(
+        tab, request, @selector(tab:requestPermission:),
+        ^BOOL(id<OACDialogDelegate> dialog_delegate, OACTab* owner) {
+          return [dialog_delegate tab:owner requestPermission:request];
+        });
+  }
+  ShellPermissionPrompt(const ShellPermissionPrompt&) = delete;
+  ShellPermissionPrompt& operator=(const ShellPermissionPrompt&) = delete;
+  ~ShellPermissionPrompt() override {
+    // The manager destroys its view when the requests are finalized, which
+    // includes the answer above (the request is finished by then).
+    [request_ withdrawByEngine];
+  }
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    // The shell keeps a queue per tab and shows it when the tab is shown.
+    return TabSwitchingBehavior::kKeepPromptAlive;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::ANCHORED_BUBBLE;
+  }
+  bool IsAskPrompt() const override { return false; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override {
+    return {};
+  }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+
+ private:
+  // Answers from a fresh task: the manager may destroy this view while it
+  // handles the answer, and the shell's call must return first.
+  void Answer(PermissionAnswer answer) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<Delegate> delegate, PermissionAnswer answer) {
+              if (!delegate || delegate->Requests().empty()) {
+                return;
+              }
+              switch (answer) {
+                case PermissionAnswer::kAllow:
+                  delegate->Accept(std::monostate());
+                  break;
+                case PermissionAnswer::kAllowThisTime:
+                  delegate->AcceptThisTime(std::monostate());
+                  break;
+                case PermissionAnswer::kDeny:
+                  delegate->Deny(std::monostate());
+                  break;
+                case PermissionAnswer::kDismiss:
+                  delegate->Dismiss(std::monostate());
+                  break;
+              }
+            },
+            delegate_, answer));
+  }
+
+  base::WeakPtr<Delegate> delegate_;
+  OACPermissionRequest* __strong request_ = nil;
+  base::WeakPtrFactory<ShellPermissionPrompt> weak_factory_{this};
+};
