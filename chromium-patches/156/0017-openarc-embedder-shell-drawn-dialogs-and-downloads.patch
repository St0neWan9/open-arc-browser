+// ExternalProtocolHandler's embedder dialog (an Open Arc patch to //chrome).
+void RunExternalProtocolDialog(
+    const GURL& url,
+    content::WebContents* web_contents,
+    bool has_user_gesture,
+    const std::optional<url::Origin>& initiating_origin,
+    content::WeakDocumentPtr initiator_document,
+    const std::u16string& program_name) {
+  OACTab* tab = OACTabForWebContents(web_contents);
+  if (!tab || tab.isClosed) {
+    return;  // Blocked, as when Chrome's dialog is cancelled.
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  const bool can_remember =
+      profile->GetPrefs()->GetBoolean(
+          prefs::kExternalProtocolDialogShowAlwaysOpenCheckbox) &&
+      ExternalProtocolHandler::MayRememberAllowDecisionsForThisOrigin(
+          base::OptionalToPtr(initiating_origin));
+  NSURL* ns_url = net::NSURLWithGURL(url);
+  NSURL* app_url =
+      ns_url ? [NSWorkspace.sharedWorkspace URLForApplicationToOpenURL:ns_url]
+             : nil;
+  base::WeakPtr<content::WebContents> weak_contents =
+      web_contents->GetWeakPtr();
+  OACExternalProtocolRequest* request = [[OACExternalProtocolRequest alloc]
+               initWithTab:tab
+                    origin:initiating_origin
+                               ? OACOriginFromURLOrigin(*initiating_origin)
+                               : nil
+                       URL:ns_url ?: [NSURL URLWithString:@"about:blank"]
+      handlerApplicationName:base::SysUTF16ToNSString(program_name)
+       handlerApplicationURL:app_url
+              hasUserGesture:has_user_gesture
+        canRememberForOrigin:can_remember
+                        open:base::BindOnce(
+                                 [](base::WeakPtr<content::WebContents> contents,
+                                    GURL url,
+                                    std::optional<url::Origin> origin,
+                                    content::WeakDocumentPtr document,
+                                    bool remember) {
+                                   if (!contents) {
+                                     return;
+                                   }
+                                   if (remember && origin) {
+                                     ExternalProtocolHandler::SetBlockState(
+                                         url.GetScheme(), *origin,
+                                         ExternalProtocolHandler::DONT_BLOCK,
+                                         Profile::FromBrowserContext(
+                                             contents->GetBrowserContext()));
+                                   }
+                                   ExternalProtocolHandler::
+                                       LaunchUrlWithoutSecurityCheck(
+                                           url, contents.get(),
+                                           std::move(document));
+                                 },
+                                 weak_contents, url, initiating_origin,
+                                 std::move(initiator_document))];
+  OACPresentDialogRequest(
+      tab, request, @selector(tab:openExternalProtocol:),
+      ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+        return [delegate tab:owner openExternalProtocol:request];
+      });
+}
