+// Chrome's LoginHandler (password manager hookup, "auth supplied" fan-out to
+// other prompts for the same realm) with an OACAuthenticationRequest as its
+// view.
+class ShellLoginHandler : public LoginHandler {
+ public:
+  ShellLoginHandler(
+      OACTab* tab,
+      const net::AuthChallengeInfo& auth_info,
+      content::WebContents* web_contents,
+      content::LoginDelegate::LoginAuthRequiredCallback auth_required_callback)
+      : LoginHandler(auth_info, web_contents, std::move(auth_required_callback)),
+        tab_(tab) {}
+  ShellLoginHandler(const ShellLoginHandler&) = delete;
+  ShellLoginHandler& operator=(const ShellLoginHandler&) = delete;
+  ~ShellLoginHandler() override { CloseDialog(); }
+
+ protected:
+  // LoginHandler:
+  bool BuildViewImpl(const std::u16string& authority,
+                     const std::u16string& explanation,
+                     LoginModelData* login_model_data) override {
+    OACTab* tab = tab_;
+    if (!tab || tab.isClosed) {
+      return false;
+    }
+    const net::AuthChallengeInfo& info = auth_info();
+    const GURL challenger = info.challenger.GetURL();
+    base::WeakPtr<LoginHandler> weak_this = GetWeakPtr();
+    request_ = [[OACAuthenticationRequest alloc]
+                   initWithTab:tab
+                        origin:OACOriginFromURLOrigin(
+                                   url::Origin::Create(challenger))
+                         realm:base::SysUTF8ToNSString(info.realm)
+            challengerHostPort:base::SysUTF8ToNSString(
+                                   info.challenger.port() ==
+                                           url::DefaultPortForScheme(
+                                               info.challenger.scheme())
+                                       ? info.challenger.host()
+                                       : info.challenger.host() + ":" +
+                                             base::NumberToString(
+                                                 info.challenger.port()))
+              isProxyChallenge:info.is_proxy
+          isInsecureConnection:!network::IsUrlPotentiallyTrustworthy(
+                                   challenger)
+             suggestedUsername:nil
+                       proceed:base::BindOnce(
+                                   [](base::WeakPtr<LoginHandler> handler,
+                                      NSString* username, NSString* password) {
+                                     if (handler) {
+                                       handler->SetAuth(
+                                           base::SysNSStringToUTF16(username),
+                                           base::SysNSStringToUTF16(password));
+                                     }
+                                   },
+                                   weak_this)
+                        cancel:base::BindOnce(
+                                   [](base::WeakPtr<LoginHandler> handler) {
+                                     if (handler) {
+                                       handler->CancelAuth(
+                                           /*notify_others=*/true);
+                                     }
+                                   },
+                                   weak_this)];
+    OACAuthenticationRequest* request = request_;
+    OACPresentDialogRequest(
+        tab, request, @selector(tab:requestAuthentication:),
+        ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+          return [delegate tab:owner requestAuthentication:request];
+        });
+    return true;
+  }
+
+  void CloseDialog() override {
+    // Called when the auth is handled here or elsewhere (another prompt for
+    // the same realm got credentials, the request went away).
+    [request_ withdrawByEngine];
+    request_ = nil;
+  }
+
+ private:
+  __weak OACTab* tab_;
+  OACAuthenticationRequest* __strong request_ = nil;
+};
