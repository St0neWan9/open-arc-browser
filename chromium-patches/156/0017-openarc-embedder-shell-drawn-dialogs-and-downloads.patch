+void InstallBridgeDialogHost() {
+  static BridgeDialogHost* host = new BridgeDialogHost();
+  DialogHost::Set(host);
+  ExternalProtocolHandler::SetEmbedderDialogRunner(&RunExternalProtocolDialog);
+}
+
+void RunShellFileChooser(OACTab* tab,
+                         content::RenderFrameHost* render_frame_host,
+                         scoped_refptr<content::FileSelectListener> listener,
+                         const blink::mojom::FileChooserParams& params) {
+  using Mode = blink::mojom::FileChooserParams::Mode;
+  OACFileChooserMode mode = OACFileChooserModeOpen;
+  switch (params.mode) {
+    case Mode::kOpen:
+      mode = OACFileChooserModeOpen;
+      break;
+    case Mode::kOpenMultiple:
+      mode = OACFileChooserModeOpenMultiple;
+      break;
+    case Mode::kUploadFolder:
+    case Mode::kOpenDirectory:
+      mode = OACFileChooserModeOpenFolder;
+      break;
+    case Mode::kSave:
+      mode = OACFileChooserModeSave;
+      break;
+  }
+  NSURL* default_url = nil;
+  if (!params.default_file_name.empty()) {
+    default_url = [NSURL
+        fileURLWithPath:base::apple::FilePathToNSString(params.default_file_name)];
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  base::WeakPtr<content::WebContents> weak_contents =
+      web_contents->GetWeakPtr();
+  const Mode chooser_mode = params.mode;
+  OACFileChooserRequest* request = [[OACFileChooserRequest alloc]
+                  initWithTab:tab
+                       origin:OACOriginFromURLOrigin(
+                                  render_frame_host->GetLastCommittedOrigin())
+               isFromSubframe:render_frame_host->GetParentOrOuterDocument() !=
+                              nullptr
+                         mode:mode
+      acceptedTypeIdentifiers:TypeIdentifiersForAccept(params.accept_types)
+                   defaultURL:default_url
+                 wantsCapture:params.use_media_capture
+                       select:base::BindOnce(&AnswerFileChooser,
+                                             std::move(listener), weak_contents,
+                                             chooser_mode)];
+  OACPresentDialogRequest(
+      tab, request, @selector(tab:runFileChooser:),
+      ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+        return [delegate tab:owner runFileChooser:request];
+      });
+}
+
+}  // namespace openarc
