+@implementation OACAuthenticationRequest {
+  NSString* _realm;
+  NSString* _challengerHostPort;
+  BOOL _isProxyChallenge;
+  BOOL _isInsecureConnection;
+  NSString* _suggestedUsername;
+  base::OnceCallback<void(NSString*, NSString*)> _proceed;
+  base::OnceClosure _cancel;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                      realm:(NSString*)realm
+         challengerHostPort:(NSString*)challengerHostPort
+           isProxyChallenge:(BOOL)isProxyChallenge
+       isInsecureConnection:(BOOL)isInsecureConnection
+          suggestedUsername:(NSString*)suggestedUsername
+                    proceed:(base::OnceCallback<void(NSString*, NSString*)>)
+                                proceed
+                     cancel:(base::OnceClosure)cancel {
+  if ((self = [super initWithTab:tab origin:origin isFromSubframe:NO])) {
+    _realm = [realm copy];
+    _challengerHostPort = [challengerHostPort copy];
+    _isProxyChallenge = isProxyChallenge;
+    _isInsecureConnection = isInsecureConnection;
+    _suggestedUsername = [suggestedUsername copy];
+    _proceed = std::move(proceed);
+    _cancel = std::move(cancel);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self cancel];
+}
+
+- (NSString*)realm {
+  return _realm;
+}
+- (NSString*)challengerHostPort {
+  return _challengerHostPort;
+}
+- (BOOL)isProxyChallenge {
+  return _isProxyChallenge;
+}
+- (BOOL)isInsecureConnection {
+  return _isInsecureConnection;
+}
+- (NSString*)suggestedUsername {
+  return _suggestedUsername;
+}
+
+- (void)proceedWithUsername:(NSString*)username password:(NSString*)password {
+  if (![self markFinished]) {
+    return;
+  }
+  _cancel.Reset();
+  if (_proceed) {
+    std::move(_proceed).Run(username ?: @"", password ?: @"");
+  }
+}
+
+- (void)cancel {
+  if (![self markFinished]) {
+    return;
+  }
+  _proceed.Reset();
+  if (_cancel) {
+    std::move(_cancel).Run();
+  }
+}
+
+@end
