+- (void)setPromptsForLocation:(BOOL)promptsForLocation {
+  if (Profile* profile = self.chromeProfile) {
+    profile->GetPrefs()->SetBoolean(prefs::kPromptForDownload,
+                                    promptsForLocation);
+  }
+}
+
+// MARK: Items
+
+- (NSArray<OACDownloadItem*>*)items {
+  content::DownloadManager* manager = self.manager;
+  if (!manager) {
+    return @[];
+  }
+  download::SimpleDownloadManager::DownloadVector all;
+  manager->GetAllDownloads(&all);
+  std::sort(all.begin(), all.end(), [](const auto& a, const auto& b) {
+    return a->GetStartTime() > b->GetStartTime();
+  });
+  NSMutableArray<OACDownloadItem*>* items = [NSMutableArray array];
+  for (download::DownloadItem* item : all) {
+    if (IsListed(item)) {
+      [items addObject:[self snapshot:item]];
+    }
+  }
+  return items;
+}
+
+- (void)pauseItemWithIdentifier:(NSString*)identifier {
+  if (auto* item = [self itemWithIdentifier:identifier]) {
+    item->Pause();
+  }
+}
+
+- (void)resumeItemWithIdentifier:(NSString*)identifier {
+  if (auto* item = [self itemWithIdentifier:identifier]) {
+    if (item->CanResume()) {
+      item->Resume(/*user_resume=*/true);
+    }
+  }
+}
+
+- (void)cancelItemWithIdentifier:(NSString*)identifier {
+  if (auto* item = [self itemWithIdentifier:identifier]) {
+    item->Cancel(/*user_cancel=*/true);
+  }
+}
+
+- (void)confirmItemWithIdentifier:(NSString*)identifier keep:(BOOL)keep {
+  auto* item = [self itemWithIdentifier:identifier];
+  if (!item) {
+    return;
+  }
+  if (!keep) {
+    // Discard, as Chrome's warning does: removes the partial file and the entry.
+    item->Remove();
+    return;
+  }
+  if (item->IsInsecure()) {
+    item->ValidateInsecureDownload();
+  } else if (item->IsDangerous()) {
+    item->ValidateDangerousDownload();
+  }
+}
+
+- (void)removeItemWithIdentifier:(NSString*)identifier {
+  if (auto* item = [self itemWithIdentifier:identifier]) {
+    if (!item->IsDone()) {
+      item->Cancel(/*user_cancel=*/true);
+    }
+    item->Remove();
+  }
+}
+
+- (void)downloadURL:(NSURL*)url {
+  content::DownloadManager* manager = self.manager;
+  const GURL gurl = net::GURLWithNSURL(url);
+  if (!manager || !gurl.is_valid()) {
+    return;
+  }
+  auto params = std::make_unique<download::DownloadUrlParameters>(
+      gurl, net::DefineNetworkTrafficAnnotation("openarc_download_url", R"(
+        semantics {
+          sender: "Open Arc download"
+          description: "Downloads a URL the user chose to save."
+          trigger: "The user chooses to download a link or file."
+          data: "None."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: YES
+          cookies_store: "user"
+          setting: "None."
+          policy_exception_justification: "Not implemented."
+        })"));
+  manager->DownloadUrl(std::move(params));
+}
+
+// MARK: Observers
+
+- (void)addObserver:(id<OACDownloadsObserver>)observer {
+  [_observers addObject:observer];
+}
+
+- (void)removeObserver:(id<OACDownloadsObserver>)observer {
+  [_observers removeObject:observer];
+}
+
+// Delivers from a posted task (OACDefines.h threading contract).
+- (void)notify:(void (^)(id<OACDownloadsObserver> observer))body
+      selector:(SEL)selector {
+  NSArray<id<OACDownloadsObserver>>* observers = _observers.allObjects;
+  if (observers.count == 0) {
+    return;
+  }
+  OACPostToMainThread(^{
+    for (id<OACDownloadsObserver> observer in observers) {
+      if ([observer respondsToSelector:selector]) {
+        body(observer);
+      }
+    }
+  });
+}
+
+- (void)itemCreated:(download::DownloadItem*)item {
+  if (!IsListed(item)) {
+    return;
+  }
+  OACDownloadItem* snapshot = [self snapshot:item];
+  _lastUpdate[snapshot.identifier] = @(base::TimeTicks::Now().since_origin().InMillisecondsF());
+  _lastState[snapshot.identifier] = @(snapshot.state);
+  __weak OACDownloads* weakSelf = self;
+  [self notify:^(id<OACDownloadsObserver> observer) {
+    OACDownloads* downloads = weakSelf;
+    if (downloads) {
+      [observer downloads:downloads didAddItem:snapshot];
+    }
+  }
+      selector:@selector(downloads:didAddItem:)];
+}
+
+- (void)itemUpdated:(download::DownloadItem*)item {
+  if (!IsListed(item)) {
+    return;
+  }
+  NSString* identifier = base::SysUTF8ToNSString(item->GetGuid());
+  if (!_lastState[identifier]) {
+    // Listed only now (the target was decided): an addition.
+    [self itemCreated:item];
+    return;
+  }
+  OACDownloadItem* snapshot = [self snapshot:item];
+  const double now = base::TimeTicks::Now().since_origin().InMillisecondsF();
+  const BOOL stateChanged = _lastState[identifier].integerValue != snapshot.state;
+  if (!stateChanged &&
+      now - _lastUpdate[identifier].doubleValue <
+          kUpdateInterval.InMillisecondsF()) {
+    // Coalesce: one trailing update after the interval.
+    if (![_pendingFlush containsObject:identifier]) {
+      [_pendingFlush addObject:identifier];
+      __weak OACDownloads* weakSelf = self;
+      dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                   kUpdateInterval.InNanoseconds()),
+                     dispatch_get_main_queue(), ^{
+                       OACDownloads* downloads = weakSelf;
+                       if (!downloads) {
+                         return;
+                       }
+                       [downloads->_pendingFlush removeObject:identifier];
+                       if (auto* current =
+                               [downloads itemWithIdentifier:identifier]) {
+                         [downloads sendUpdate:current];
+                       }
+                     });
+    }
+    return;
+  }
+  [self sendUpdate:item];
+}
+
+- (void)sendUpdate:(download::DownloadItem*)item {
+  OACDownloadItem* snapshot = [self snapshot:item];
+  _lastUpdate[snapshot.identifier] =
+      @(base::TimeTicks::Now().since_origin().InMillisecondsF());
+  _lastState[snapshot.identifier] = @(snapshot.state);
+  __weak OACDownloads* weakSelf = self;
+  [self notify:^(id<OACDownloadsObserver> observer) {
+    OACDownloads* downloads = weakSelf;
+    if (downloads) {
+      [observer downloads:downloads didUpdateItem:snapshot];
+    }
+  }
+      selector:@selector(downloads:didUpdateItem:)];
+}
+
+- (void)itemRemoved:(download::DownloadItem*)item {
+  NSString* identifier = base::SysUTF8ToNSString(item->GetGuid());
+  if (!_lastState[identifier]) {
+    return;
+  }
+  [_lastState removeObjectForKey:identifier];
+  [_lastUpdate removeObjectForKey:identifier];
+  __weak OACDownloads* weakSelf = self;
+  [self notify:^(id<OACDownloadsObserver> observer) {
+    OACDownloads* downloads = weakSelf;
+    if (downloads) {
+      [observer downloads:downloads didRemoveItemWithIdentifier:identifier];
+    }
+  }
+      selector:@selector(downloads:didRemoveItemWithIdentifier:)];
+}
+
+@end
