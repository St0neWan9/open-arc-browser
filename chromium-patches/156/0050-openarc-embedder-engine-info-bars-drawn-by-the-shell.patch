new file mode 100644
index 000000000000..01371c6256e3
--- /dev/null
+++ b/openarc/bridge/oac_infobars.mm
@@ -0,0 +1,340 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/bridge/oac_infobars_internal.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/string_util.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/devtools/global_confirm_info_bar.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/infobars/core/infobar_manager.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/window_open_disposition.h"
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_requests_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+
+namespace {
+
+// The message as a plain string: a template's placeholders get their
+// substitutions' text (link substitutions included; the bar's own link is
+// separate).
+NSString* MessageOf(const ConfirmInfoBarDelegate& delegate) {
+  const std::u16string format = delegate.GetMessageTextTemplate();
+  if (format.empty()) {
+    return base::SysUTF16ToNSString(delegate.GetMessageText());
+  }
+  std::vector<std::u16string> texts;
+  for (const MessageSubstitution& substitution :
+       delegate.GetMessageSubstitutions()) {
+    texts.push_back(substitution.text);
+  }
+  return base::SysUTF16ToNSString(
+      base::ReplaceStringPlaceholders(format, texts, nullptr));
+}
+
+}  // namespace
+
+// MARK: - Request
+
+@interface OACInfoBarRequest ()
+- (instancetype)initWithTab:(OACTab*)tab
+                    message:(NSString*)message
+                  linkTitle:(NSString*)linkTitle
+                    buttons:(OACInfoBarButtons)buttons
+              OKButtonTitle:(NSString*)OKButtonTitle
+          cancelButtonTitle:(NSString*)cancelButtonTitle
+                 closeable:(BOOL)closeable
+                     action:(base::RepeatingCallback<void(int)>)action;
+@end
+
+// The actions an OACInfoBarRequest sends to its bridge.
+namespace {
+enum InfoBarAction {
+  kAccept = 0,
+  kDecline = 1,
+  kClose = 2,
+  kOpenLink = 3,
+};
+}  // namespace
+
+@implementation OACInfoBarRequest {
+  NSString* _message;
+  NSString* _linkTitle;
+  OACInfoBarButtons _buttons;
+  NSString* _OKButtonTitle;
+  NSString* _cancelButtonTitle;
+  BOOL _closeable;
+  base::RepeatingCallback<void(int)> _action;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                    message:(NSString*)message
+                  linkTitle:(NSString*)linkTitle
+                    buttons:(OACInfoBarButtons)buttons
+              OKButtonTitle:(NSString*)OKButtonTitle
+          cancelButtonTitle:(NSString*)cancelButtonTitle
+                 closeable:(BOOL)closeable
+                     action:(base::RepeatingCallback<void(int)>)action {
+  if ((self = [super initWithTab:tab origin:nil isFromSubframe:NO])) {
+    _message = [message copy];
+    _linkTitle = [linkTitle copy];
+    _buttons = buttons;
+    _OKButtonTitle = [OKButtonTitle copy];
+    _cancelButtonTitle = [cancelButtonTitle copy];
+    _closeable = closeable;
+    _action = std::move(action);
+  }
+  return self;
+}
+
+- (NSString*)message {
+  return _message;
+}
+- (NSString*)linkTitle {
+  return _linkTitle;
+}
+- (OACInfoBarButtons)buttons {
+  return _buttons;
+}
+- (NSString*)OKButtonTitle {
+  return _OKButtonTitle;
+}
+- (NSString*)cancelButtonTitle {
+  return _cancelButtonTitle;
+}
+- (BOOL)isCloseable {
+  return _closeable;
+}
+
+- (void)send:(InfoBarAction)action {
+  if (![self markFinished]) {
+    return;
+  }
+  base::RepeatingCallback<void(int)> callback = std::move(_action);
+  if (callback) {
+    callback.Run(action);
+  }
+}
+
+- (void)accept {
+  [self send:kAccept];
+}
+- (void)decline {
+  [self send:kDecline];
+}
+- (void)close {
+  [self send:kClose];
+}
+- (void)openLink {
+  [self send:kOpenLink];
+}
+
+- (void)cancel {
+  // The default: the bar stays open in the engine (OACDialogDelegate.h).
+  [self markFinished];
+  _action.Reset();
+}
+
+- (void)withdrawByEngine {
+  _action.Reset();
+  [super withdrawByEngine];
+}
+
+@end
+
+// MARK: - Per-tab bridge
+
+namespace openarc {
+
+TabInfoBarBridge::TabInfoBarBridge(OACTab* tab,
+                                   infobars::ContentInfoBarManager* manager)
+    : tab_(tab), manager_(manager) {
+  observation_.Observe(manager);
+  // Bars added before the tab existed (an adopted window).
+  for (infobars::InfoBar* infobar : manager->infobars()) {
+    Present(infobar);
+  }
+}
+
+TabInfoBarBridge::~TabInfoBarBridge() {
+  for (auto& [infobar, request] : requests_) {
+    [request withdrawByEngine];
+  }
+}
+
+void TabInfoBarBridge::OnInfoBarAdded(infobars::InfoBar* infobar) {
+  Present(infobar);
+}
+
+void TabInfoBarBridge::OnInfoBarRemoved(infobars::InfoBar* infobar,
+                                        bool animate) {
+  Withdraw(infobar);
+}
+
+void TabInfoBarBridge::OnInfoBarReplaced(infobars::InfoBar* old_infobar,
+                                         infobars::InfoBar* new_infobar) {
+  Withdraw(old_infobar);
+  Present(new_infobar);
+}
+
+void TabInfoBarBridge::OnManagerWillBeDestroyed(
+    infobars::InfoBarManager* manager) {
+  observation_.Reset();
+  manager_ = nullptr;
+  for (auto& [infobar, request] : requests_) {
+    [request withdrawByEngine];
+  }
+  requests_.clear();
+}
+
+void TabInfoBarBridge::Present(infobars::InfoBar* infobar) {
+  ConfirmInfoBarDelegate* delegate =
+      infobar->delegate()->AsConfirmInfoBarDelegate();
+  // Only confirm bars have a text form; other kinds (translate, theme
+  // preview) have their own shell surfaces or none.
+  if (!delegate || requests_.contains(infobar)) {
+    return;
+  }
+  const int buttons = delegate->GetButtons();
+  OACInfoBarButtons bridge_buttons = 0;
+  if (buttons & ConfirmInfoBarDelegate::BUTTON_OK) {
+    bridge_buttons |= OACInfoBarButtonOK;
+  }
+  if (buttons & ConfirmInfoBarDelegate::BUTTON_CANCEL) {
+    bridge_buttons |= OACInfoBarButtonCancel;
+  }
+  const std::u16string link = delegate->GetLinkText();
+  base::WeakPtr<infobars::InfoBar> weak_infobar = infobar->AsWeakPtr();
+  base::WeakPtr<TabInfoBarBridge> weak_this = weak_factory_.GetWeakPtr();
+  OACInfoBarRequest* request = [[OACInfoBarRequest alloc]
+        initWithTab:tab_
+            message:MessageOf(*delegate)
+          linkTitle:link.empty() ? nil : base::SysUTF16ToNSString(link)
+            buttons:bridge_buttons
+      OKButtonTitle:(buttons & ConfirmInfoBarDelegate::BUTTON_OK)
+                        ? base::SysUTF16ToNSString(delegate->GetButtonLabel(
+                              ConfirmInfoBarDelegate::BUTTON_OK))
+                        : @""
+  cancelButtonTitle:(buttons & ConfirmInfoBarDelegate::BUTTON_CANCEL)
+                        ? base::SysUTF16ToNSString(delegate->GetButtonLabel(
+                              ConfirmInfoBarDelegate::BUTTON_CANCEL))
+                        : @""
+          closeable:delegate->IsCloseable()
+             action:base::BindRepeating(
+                        [](base::WeakPtr<TabInfoBarBridge> self,
+                           base::WeakPtr<infobars::InfoBar> bar, int action) {
+                          if (self && bar) {
+                            self->Perform(bar.get(), action);
+                          }
+                        },
+                        weak_this, weak_infobar)];
+  requests_[infobar] = request;
+  OACPresentDialogRequest(
+      tab_, request, @selector(tab:showInfoBar:),
+      ^BOOL(id<OACDialogDelegate> dialog_delegate, OACTab* owner) {
+        return [dialog_delegate tab:owner showInfoBar:request];
+      });
+}
+
+void TabInfoBarBridge::Withdraw(infobars::InfoBar* infobar) {
+  auto it = requests_.find(infobar);
+  if (it == requests_.end()) {
+    return;
+  }
+  OACInfoBarRequest* request = it->second;
+  requests_.erase(it);
+  [request withdrawByEngine];
+}
+
+// What the bar's buttons do in Chrome's views (ConfirmInfoBar,
+// InfoBarView): the delegate decides whether the bar closes. The bridge
+// never shows the bar in a views container, so a removed bar is deleted at
+// once: everything after the delegate call goes through weak pointers.
+void TabInfoBarBridge::Perform(infobars::InfoBar* infobar, int action) {
+  if (!manager_ || !infobar->owner()) {
+    return;  // Closing already.
+  }
+  // The answered request is done; a bar that stays open gets a new one.
+  requests_.erase(infobar);
+  base::WeakPtr<infobars::InfoBar> weak_infobar = infobar->AsWeakPtr();
+  base::WeakPtr<TabInfoBarBridge> weak_this = weak_factory_.GetWeakPtr();
+  ConfirmInfoBarDelegate* delegate =
+      infobar->delegate()->AsConfirmInfoBarDelegate();
+  bool remove = false;
+  switch (static_cast<InfoBarAction>(action)) {
+    case kAccept:
+      remove = delegate && delegate->Accept();
+      break;
+    case kDecline:
+      remove = delegate && delegate->Cancel();
+      break;
+    case kClose:
+      infobar->delegate()->InfoBarDismissed();
+      remove = true;
+      break;
+    case kOpenLink:
+      remove = infobar->delegate()->LinkClicked(
+          WindowOpenDisposition::NEW_FOREGROUND_TAB);
+      break;
+  }
+  // The delegate may have closed the bar (a global bar closes all its
+  // copies) or the whole tab.
+  if (!weak_infobar || !weak_infobar->owner()) {
+    return;
+  }
+  if (remove) {
+    weak_infobar->RemoveSelf();
+    return;
+  }
+  if (weak_this) {
+    Present(weak_infobar.get());
+  }
+}
+
+std::unique_ptr<TabInfoBarBridge> CreateTabInfoBarBridge(
+    OACTab* tab,
+    content::WebContents* web_contents) {
+  infobars::ContentInfoBarManager* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents);
+  if (!manager) {
+    return nullptr;
+  }
+  return std::make_unique<TabInfoBarBridge>(tab, manager);
+}
+
+void DestroyTabInfoBarBridge(std::unique_ptr<TabInfoBarBridge> bridge) {
+  bridge.reset();
+}
+
+void InstallInfoBarHooks() {
+  GlobalConfirmInfoBar::SetEmbedderTabs(base::BindRepeating([] {
+    std::vector<content::WebContents*> contents;
+    for (OACTab* tab in OACApplication.sharedApplication.liveTabsForBridge) {
+      if (content::WebContents* web_contents = tab.webContents) {
+        contents.push_back(web_contents);
+      }
+    }
+    return contents;
+  }));
+}
+
+void AddGlobalInfoBarsToTab(content::WebContents* web_contents) {
+  GlobalConfirmInfoBar::EmbedderTabAdded(web_contents);
+}
+
+}  // namespace openarc
