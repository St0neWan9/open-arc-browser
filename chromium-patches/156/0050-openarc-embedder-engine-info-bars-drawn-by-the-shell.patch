+namespace content {
+class WebContents;
+}
+
+namespace infobars {
+class ContentInfoBarManager;
+class InfoBar;
+}  // namespace infobars
+
+namespace openarc {
+
+// Observes one tab's InfoBarManager and keeps one OACInfoBarRequest per
+// confirm info bar that is open.
+class TabInfoBarBridge : public infobars::InfoBarManager::Observer {
+ public:
+  TabInfoBarBridge(OACTab* tab, infobars::ContentInfoBarManager* manager);
+  TabInfoBarBridge(const TabInfoBarBridge&) = delete;
+  TabInfoBarBridge& operator=(const TabInfoBarBridge&) = delete;
+  ~TabInfoBarBridge() override;
+
+  // infobars::InfoBarManager::Observer:
+  void OnInfoBarAdded(infobars::InfoBar* infobar) override;
+  void OnInfoBarRemoved(infobars::InfoBar* infobar, bool animate) override;
+  void OnInfoBarReplaced(infobars::InfoBar* old_infobar,
+                         infobars::InfoBar* new_infobar) override;
+  void OnManagerWillBeDestroyed(infobars::InfoBarManager* manager) override;
+
+ private:
+  void Present(infobars::InfoBar* infobar);
+  void Withdraw(infobars::InfoBar* infobar);
+  // One of the request's actions (accept, decline, close, open link).
+  void Perform(infobars::InfoBar* infobar, int action);
+
+  __weak OACTab* tab_;
+  raw_ptr<infobars::InfoBarManager> manager_;
+  base::ScopedObservation<infobars::InfoBarManager,
+                          infobars::InfoBarManager::Observer>
+      observation_{this};
+  std::map<infobars::InfoBar*, OACInfoBarRequest*> requests_;
+  base::WeakPtrFactory<TabInfoBarBridge> weak_factory_{this};
+};
+
+// Plan C23: the confirm info bars of one tab's ContentInfoBarManager, each
+// handed to the tab's dialog delegate as an OACInfoBarRequest. Owned by the
+// OACTab; destroyed before its WebContents.
+std::unique_ptr<TabInfoBarBridge> CreateTabInfoBarBridge(
+    OACTab* tab,
+    content::WebContents* web_contents);
+
+// Destroys |bridge| (withdraws its open requests).
+void DestroyTabInfoBarBridge(std::unique_ptr<TabInfoBarBridge> bridge);
+
+// //chrome's global info bars (GlobalConfirmInfoBar, shown on every tab) find
+// the bridge's tabs through this hook. Called once when the engine starts.
+void InstallInfoBarHooks();
+
+// A new tab (created or adopted) gets the global info bars that are open.
+void AddGlobalInfoBarsToTab(content::WebContents* web_contents);
+
+}  // namespace openarc
+
+#endif  // OPENARC_BRIDGE_OAC_INFOBARS_INTERNAL_H_
