--- /dev/null
+++ b/openarc/bridge/oac_webauthn_test_keychain.mm
@@ -0,0 +1,167 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Plan B130: a stand-in for macOS's iCloud Keychain passkey API, for the
+// engine conformance test only. device/fido reaches iCloud Keychain through
+// device::fido::icloud_keychain::SystemInterface, which needs Apple's
+// com.apple.developer.web-browser.public-key-credential entitlement. This file
+// replaces it so the rest of the path (the discovery and its window, the
+// mechanisms in the shell's dialog, the handover to macOS) runs without it.
+//
+// Installed only when the browser process starts with
+// --openarc-fake-icloud-keychain (OACApplication passes it on from the host's
+// switches); nothing here runs otherwise. Chromium's own fake
+// (device/fido/mac/fake_icloud_keychain_sys.mm) is testonly in GN and cannot
+// be linked into the framework.
+//
+// What it answers:
+// - available, authorized for passkey listing, not "configured for passkeys"
+//   (so Chrome lists iCloud Keychain as a method instead of jumping to it);
+// - two passkeys for any relying party, "alice@example.com" and
+//   "bob@example.com" (two different accounts, so Chrome shows a list);
+// - create(): the error macOS gives when an excluded credential matched, so
+//   the page sees InvalidStateError, which nothing else in the test produces;
+// - get(): the error macOS gives when it has no passkey for the site, so
+//   //chrome shows its "no passkeys" step in the shell's dialog again.
+
+#import "openarc/bridge/oac_webauthn_internal.h"
+
+#import <AuthenticationServices/AuthenticationServices.h>
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "device/fido/ctap_get_assertion_request.h"
+#include "device/fido/ctap_make_credential_request.h"
+#include "device/fido/mac/icloud_keychain_sys.h"
+
+// A listed passkey. AuthenticationServices offers no initializer for this
+// class, so the properties are overridden in a subclass.
+API_AVAILABLE(macos(13.3))
+@interface OpenArcTestKeychainPasskey
+    : ASAuthorizationWebBrowserPlatformPublicKeyCredential
+@property(nonatomic, copy) NSString* name;
+@property(nonatomic, copy) NSString* relyingParty;
+@property(nonatomic, copy) NSData* credentialID;
+@property(nonatomic, copy) NSData* userHandle;
+@property(nonatomic, copy) NSString* providerName;
+@end
+
+@implementation OpenArcTestKeychainPasskey
+@synthesize name = _name;
+@synthesize relyingParty = _relyingParty;
+@synthesize credentialID = _credentialID;
+@synthesize userHandle = _userHandle;
+@synthesize providerName = _providerName;
+@end
+
+namespace openarc {
+
+namespace {
+
+using device::fido::icloud_keychain::SystemInterface;
+
+class API_AVAILABLE(macos(13.3)) TestKeychain : public SystemInterface {
+ public:
+  TestKeychain() = default;
+  TestKeychain(const TestKeychain&) = delete;
+  TestKeychain& operator=(const TestKeychain&) = delete;
+
+  // SystemInterface:
+  bool IsAvailable() const override { return true; }
+
+  API_AVAILABLE(macos(26.2))
+  bool IsConfiguredForPasskeys() const override { return false; }
+
+  AuthState GetAuthState() override { return kAuthAuthorized; }
+
+  void AuthorizeAndContinue(base::OnceCallback<void()> callback) override {
+    std::move(callback).Run();
+  }
+
+  void GetPlatformCredentials(
+      const std::string& rp_id,
+      void (^handler)(
+          NSArray<ASAuthorizationWebBrowserPlatformPublicKeyCredential*>*))
+      override {
+    NSString* relying_party = base::SysUTF8ToNSString(rp_id);
+    NSMutableArray* passkeys = [NSMutableArray array];
+    uint8_t id_byte = 0;
+    for (NSString* name in @[ @"alice@example.com", @"bob@example.com" ]) {
+      // Not initialized: the class has no initializer (see above); the
+      // overridden properties are all that is read.
+      OpenArcTestKeychainPasskey* passkey = [OpenArcTestKeychainPasskey alloc];
+      ++id_byte;
+      passkey.name = name;
+      passkey.relyingParty = relying_party;
+      passkey.credentialID = [NSData dataWithBytes:&id_byte length:1];
+      passkey.userHandle = [NSData dataWithBytes:&id_byte length:1];
+      passkey.providerName = @"Open Arc Test Keychain";
+      [passkeys addObject:passkey];
+    }
+    handler(passkeys);
+  }
+
+  void MakeCredential(
+      NSWindow* window,
+      device::CtapMakeCredentialRequest request,
+      device::MakeCredentialOptions options,
+      base::OnceCallback<void(ASAuthorization*, NSError*)> callback) override {
+    LOG(INFO) << "OpenArc: test keychain: create, window "
+              << (window ? "set" : "missing");
+    // device/fido maps this error to "credential excluded".
+    Answer(std::move(callback),
+           [NSError errorWithDomain:@"WKErrorDomain" code:8 userInfo:nil]);
+  }
+
+  void GetAssertion(
+      NSWindow* window,
+      device::CtapGetAssertionRequest request,
+      LargeBlobAssertionInputs large_blob_inputs,
+      base::OnceCallback<void(ASAuthorization*, NSError*)> callback) override {
+    LOG(INFO) << "OpenArc: test keychain: get, window "
+              << (window ? "set" : "missing");
+    // device/fido maps this error to "no passkeys for this site".
+    Answer(std::move(callback),
+           [NSError errorWithDomain:ASAuthorizationErrorDomain
+                               code:1001
+                           userInfo:@{
+                             NSLocalizedDescriptionKey :
+                                 @"No credentials available for login."
+                           }]);
+  }
+
+  void Cancel() override {}
+
+ private:
+  ~TestKeychain() override = default;
+
+  // Answers later, as macOS does once its sheet closes.
+  static void Answer(
+      base::OnceCallback<void(ASAuthorization*, NSError*)> callback,
+      NSError* error) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), nil, error));
+  }
+};
+
+}  // namespace
+
+void InstallFakeICloudKeychainForTesting() {
+  LOG(WARNING) << "OpenArc: --openarc-fake-icloud-keychain: iCloud Keychain "
+                  "is simulated (tests only)";
+  // Always true (Open Arc needs macOS 14); device/fido's API is marked 13.3.
+  if (@available(macOS 13.3, *)) {
+    device::fido::icloud_keychain::SetSystemInterfaceForTesting(
+        base::MakeRefCounted<TestKeychain>());
+  }
+}
+
+}  // namespace openarc
