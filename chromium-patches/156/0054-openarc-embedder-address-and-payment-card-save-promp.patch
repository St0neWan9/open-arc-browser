+  autofill::ChromeAutofillClient::SetEmbedderAddressSavePrompt(
+      &ShowShellAddressSavePrompt);
+  autofill::payments::ChromePaymentsAutofillClient::
+      SetEmbedderLocalCardSavePrompt(&ShowShellLocalCardSavePrompt);
 }
 
