+// MARK: Address and card save prompts (C30)
+
+OACAddressFieldKind AddressFieldKindFor(autofill::FieldType type) {
+  switch (type) {
+    case autofill::NAME_FULL:
+      return OACAddressFieldKindName;
+    case autofill::EMAIL_ADDRESS:
+      return OACAddressFieldKindEmail;
+    case autofill::PHONE_HOME_WHOLE_NUMBER:
+      return OACAddressFieldKindPhone;
+    default:
+      return OACAddressFieldKindAddress;
+  }
+}
+
+OACOrigin* MainFrameOrigin(content::WebContents* web_contents) {
+  return OACOriginFromURLOrigin(
+      web_contents->GetPrimaryMainFrame()->GetLastCommittedOrigin());
+}
+
+// ChromeAutofillClient::SetEmbedderAddressSavePrompt's prompt.
+void ShowShellAddressSavePrompt(
+    content::WebContents* web_contents,
+    const autofill::AutofillProfile& profile,
+    const autofill::AutofillProfile* original_profile,
+    autofill::AutofillClient::SaveAddressBubbleType save_address_bubble_type,
+    autofill::AutofillClient::AddressProfileSavePromptCallback callback) {
+  using Decision = autofill::AutofillClient::AddressPromptUserDecision;
+  OACTab* tab = OACTabForWebContents(web_contents);
+  // Moving a saved address into the Google account (and merging account
+  // addresses) needs a signed-in Google account, which Open Arc never has:
+  // suppressed like a prompt Chrome cannot show (no strikes counted).
+  if (!tab || tab.isClosed ||
+      save_address_bubble_type !=
+          autofill::AutofillClient::SaveAddressBubbleType::kSave) {
+    std::move(callback).Run(Decision::kAutoDeclined, std::nullopt);
+    return;
+  }
+  const std::string& locale = g_browser_process->GetApplicationLocale();
+  NSMutableArray<OACAddressChange*>* changes = [NSMutableArray array];
+  if (original_profile) {
+    // The first values are the submitted ones, the second the saved ones (as
+    // Chrome's update bubble reads them).
+    for (const autofill::ProfileValueDifference& difference :
+         autofill::GetProfileDifferenceForUi(profile, *original_profile,
+                                             locale)) {
+      [changes addObject:[[OACAddressChange alloc]
+                             initWithField:AddressFieldKindFor(difference.type)
+                                  oldValue:base::SysUTF16ToNSString(
+                                               difference.second_value)
+                              updatedValue:base::SysUTF16ToNSString(
+                                               difference.first_value)]];
+    }
+  }
+  NSString* summary =
+      base::SysUTF16ToNSString(autofill::GetEnvelopeStyleAddress(
+          profile, locale, /*include_recipient=*/true,
+          /*include_country=*/true));
+  NSString* email = base::SysUTF16ToNSString(
+      profile.GetInfo(autofill::EMAIL_ADDRESS, locale));
+  NSString* phone = base::SysUTF16ToNSString(
+      autofill::i18n::GetFormattedPhoneNumberForDisplay(profile, locale));
+  auto answer = base::BindOnce(
+      [](autofill::AutofillClient::AddressProfileSavePromptCallback callback,
+         AutofillSaveAnswer answer) {
+        switch (answer) {
+          case AutofillSaveAnswer::kSave:
+            std::move(callback).Run(Decision::kAccepted, std::nullopt);
+            break;
+          case AutofillSaveAnswer::kDecline:
+            std::move(callback).Run(Decision::kDeclined, std::nullopt);
+            break;
+          case AutofillSaveAnswer::kIgnore:
+            std::move(callback).Run(Decision::kIgnored, std::nullopt);
+            break;
+        }
+      },
+      std::move(callback));
+  OACAddressSavePrompt* request = [[OACAddressSavePrompt alloc]
+         initWithTab:tab
+              origin:MainFrameOrigin(web_contents)
+                kind:original_profile ? OACAddressSavePromptKindUpdate
+                                      : OACAddressSavePromptKindSave
+      addressSummary:summary
+               email:email
+               phone:phone
+             changes:changes
+              answer:std::move(answer)];
+  OACPresentDialogRequest(
+      tab, request, @selector(tab:offerToSaveAddress:),
+      ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+        return [delegate tab:owner offerToSaveAddress:request];
+      });
+}
+
+// ChromePaymentsAutofillClient::SetEmbedderLocalCardSavePrompt's prompt.
+void ShowShellLocalCardSavePrompt(
+    content::WebContents* web_contents,
+    const autofill::CreditCard& card,
+    autofill::payments::PaymentsAutofillClient::SaveCreditCardOptions options,
+    autofill::payments::PaymentsAutofillClient::LocalSaveCardPromptCallback
+        callback) {
+  using Decision =
+      autofill::payments::PaymentsAutofillClient::SaveCardOfferUserDecision;
+  using SaveType = autofill::payments::PaymentsAutofillClient::CardSaveType;
+  OACTab* tab = OACTabForWebContents(web_contents);
+  // Without `show_prompt` (the card was refused too often) Chrome only shows
+  // its omnibox icon; Open Arc has no such icon, so the offer ends ignored.
+  if (!tab || tab.isClosed || !options.show_prompt) {
+    std::move(callback).Run(Decision::kIgnored);
+    return;
+  }
+  OACCardSavePromptKind kind = OACCardSavePromptKindCard;
+  switch (options.card_save_type) {
+    case SaveType::kCardSaveOnly:
+      kind = OACCardSavePromptKindCard;
+      break;
+    case SaveType::kCardSaveWithCvc:
+      kind = OACCardSavePromptKindCardWithSecurityCode;
+      break;
+    case SaveType::kCvcSaveOnly:
+      kind = OACCardSavePromptKindSecurityCodeOnly;
+      break;
+  }
+  const std::string& locale = g_browser_process->GetApplicationLocale();
+  NSString* expiration = @"";
+  if (card.expiration_month() > 0 && card.expiration_year() > 0) {
+    expiration = base::SysUTF16ToNSString(
+        card.Expiration2DigitMonthAsString() + u"/" +
+        card.Expiration2DigitYearAsString());
+  }
+  auto answer = base::BindOnce(
+      [](autofill::payments::PaymentsAutofillClient::LocalSaveCardPromptCallback
+             callback,
+         AutofillSaveAnswer answer) {
+        switch (answer) {
+          case AutofillSaveAnswer::kSave:
+            std::move(callback).Run(Decision::kAccepted);
+            break;
+          case AutofillSaveAnswer::kDecline:
+            std::move(callback).Run(Decision::kDeclined);
+            break;
+          case AutofillSaveAnswer::kIgnore:
+            std::move(callback).Run(Decision::kIgnored);
+            break;
+        }
+      },
+      std::move(callback));
+  OACCardSavePrompt* request = [[OACCardSavePrompt alloc]
+         initWithTab:tab
+              origin:MainFrameOrigin(web_contents)
+                kind:kind
+             network:base::SysUTF16ToNSString(card.NetworkForDisplay())
+      lastFourDigits:base::SysUTF16ToNSString(card.LastFourDigits())
+          expiration:expiration
+      cardholderName:base::SysUTF16ToNSString(
+                         card.GetInfo(autofill::CREDIT_CARD_NAME_FULL, locale))
+              answer:std::move(answer)];
+  OACPresentDialogRequest(
+      tab, request, @selector(tab:offerToSaveCard:),
+      ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+        return [delegate tab:owner offerToSaveCard:request];
+      });
+}
+
 }  // namespace
 
 void InstallBridgeAutofillHost() {
@@ -816,6 +1202,10 @@ void InstallBridgeAutofillHost() {
