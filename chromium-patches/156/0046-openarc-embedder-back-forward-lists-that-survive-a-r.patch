@@ -518,6 +519,7 @@ @implementation OACTabConfiguration {
   BOOL _startsHidden;
   CGSize _initialSize;
   OACColorScheme _preferredColorScheme;
+  NSData* _sessionHistory;
 }
 
 - (instancetype)initWithProfile:(OACProfile*)profile {
@@ -570,6 +572,12 @@ - (OACColorScheme)preferredColorScheme {
 - (void)setPreferredColorScheme:(OACColorScheme)preferredColorScheme {
   _preferredColorScheme = preferredColorScheme;
 }
+- (NSData*)sessionHistory {
+  return _sessionHistory;
+}
+- (void)setSessionHistory:(NSData*)sessionHistory {
+  _sessionHistory = [sessionHistory copy];
+}
 
 - (id)copyWithZone:(NSZone*)zone {
   OACTabConfiguration* copy =
@@ -580,6 +588,7 @@ - (id)copyWithZone:(NSZone*)zone {
   copy.startsHidden = _startsHidden;
   copy.initialSize = _initialSize;
   copy.preferredColorScheme = _preferredColorScheme;
+  copy.sessionHistory = _sessionHistory;
   return copy;
 }
 
@@ -675,7 +684,15 @@ - (instancetype)initWithIdentifier:(NSUUID*)identifier
                        profile:profile
                    colorScheme:configuration.preferredColorScheme
                           size:configuration.initialSize];
-    if (initialURL.is_valid()) {
+    // Plan C20: a saved back/forward list replaces the initial URL; data the
+    // bridge cannot read falls back to it.
+    const bool restored =
+        configuration.sessionHistory &&
+        OACRestoreSessionHistory(_webContents.get(),
+                                 configuration.sessionHistory);
+    if (restored) {
+      [self refreshState];
+    } else if (initialURL.is_valid()) {
       [self loadGURL:initialURL];
     }
   }
@@ -831,6 +848,10 @@ - (BOOL)isClosed {
   return _closed;
 }
 
+- (NSData*)sessionHistory {
+  return _closed ? nil : OACSerializeSessionHistory(_webContents.get());
+}
+
 - (NSView*)nativeView {
   return _webContents ? _webContents->GetNativeView().GetNativeNSView() : nil;
 }
diff --git a/openarc/bridge/public/OpenArcCore/OACTab.h b/openarc/bridge/public/OpenArcCore/OACTab.h
index a943778da238..e31e2f69d813 100644
--- a/openarc/bridge/public/OpenArcCore/OACTab.h
+++ b/openarc/bridge/public/OpenArcCore/OACTab.h
@@ -75,6 +75,12 @@ OAC_EXPORT
 /// Default light.
 @property (nonatomic) OACColorScheme preferredColorScheme;
 
+/// A back/forward list saved earlier with `-[OACTab sessionHistory]` (plan C20). When the bridge
+/// can read it, the tab starts with those entries and loads the selected one (with its saved
+/// scroll position and form contents), and `initialURL` is ignored; data it cannot read (another
+/// format version, truncated) is ignored and `initialURL` loads as usual. nil: a new history.
+@property (nonatomic, copy, nullable) NSData *sessionHistory;
+
 - (instancetype)initWithProfile:(OACProfile *)profile NS_DESIGNATED_INITIALIZER;
 - (instancetype)init NS_UNAVAILABLE;
 + (instancetype)new NS_UNAVAILABLE;
@@ -226,6 +232,15 @@ OAC_EXPORT NS_SWIFT_UI_ACTOR
 - (BOOL)reloadBypassingCache:(BOOL)bypassingCache error:(NSError **)error NS_SWIFT_NAME(reload(bypassingCache:));
 - (BOOL)stopLoadingWithError:(NSError **)error;
 
+// MARK: Session history (plan C20, `BrowserTab.sessionHistory`)
+
+/// The tab's back/forward list as opaque data for `OACTabConfiguration.sessionHistory`: the
+/// entries around the current one (at most 50, the renderer's own limit) with their URLs, titles
+/// and page state (scroll position, form contents). nil for a tab with no committed page and
+/// after `-close`. The format is the bridge's own and versioned; the shell stores it per device
+/// and never syncs it.
+@property (nonatomic, readonly, copy, nullable) NSData *sessionHistory;
+
 // MARK: Audio (`BrowserTab.setMuted`)
 
 - (void)setMuted:(BOOL)muted;
