diff --git a/openarc/bridge/oac_session_history.mm b/openarc/bridge/oac_session_history.mm
new file mode 100644
index 000000000000..a378a701d19f
--- /dev/null
+++ b/openarc/bridge/oac_session_history.mm
@@ -0,0 +1,127 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "openarc/bridge/oac_session_history_internal.h"
+
+#include <stdint.h>
+
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+#include "base/apple/foundation_util.h"
+#include "base/containers/span.h"
+#include "base/pickle.h"
+#include "components/sessions/content/content_serialized_navigation_builder.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/history/session_history_constants.h"
+
+namespace {
+
+// "OAsh": tells our blob from anything else a caller might pass.
+constexpr uint32_t kMagic = 0x4f417368;
+// Bump when the envelope changes; older blobs are then refused (the tab loads
+// its URL alone, as before C20).
+constexpr int kVersion = 1;
+// Bytes of URL, title and page state kept per entry. Chrome's session service
+// allows about 63 KB; a page whose state is larger loses its form contents
+// and scroll position, not its entry.
+constexpr int kMaxEntryBytes = 64 * 1024;
+
+}  // namespace
+
+NSData* OACSerializeSessionHistory(content::WebContents* web_contents) {
+  if (!web_contents) {
+    return nil;
+  }
+  content::NavigationController& controller = web_contents->GetController();
+  const int count = controller.GetEntryCount();
+  const int current = controller.GetCurrentEntryIndex();
+  if (count <= 0 || current < 0) {
+    return nil;
+  }
+  // The renderer keeps at most kMaxSessionHistoryEntries; keep a window of
+  // that size around the current entry, as many forward entries as there are.
+  const int limit = blink::kMaxSessionHistoryEntries;
+  int first = std::max(0, current - (limit - 1));
+  int last = std::min(count - 1, first + limit - 1);
+
+  std::vector<sessions::SerializedNavigationEntry> entries;
+  int selected = -1;
+  for (int i = first; i <= last; ++i) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+    // The blank entry a new tab starts with is not history.
+    if (!entry || entry->IsInitialEntry() || !entry->GetURL().is_valid()) {
+      continue;
+    }
+    if (i == current) {
+      selected = static_cast<int>(entries.size());
+    }
+    entries.push_back(
+        sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+            static_cast<int>(entries.size()), entry));
+  }
+  if (entries.empty() || selected < 0) {
+    return nil;
+  }
+
+  base::Pickle pickle;
+  pickle.WriteUInt32(kMagic);
+  pickle.WriteInt(kVersion);
+  pickle.WriteInt(selected);
+  pickle.WriteInt(static_cast<int>(entries.size()));
+  for (const sessions::SerializedNavigationEntry& entry : entries) {
+    entry.WriteToPickle(kMaxEntryBytes, &pickle);
+  }
+  base::span<const uint8_t> bytes = pickle.AsBytes();
+  NSMutableData* data = [NSMutableData dataWithLength:bytes.size()];
+  base::apple::NSMutableDataToSpan(data).copy_from(bytes);
+  return data;
+}
+
+bool OACRestoreSessionHistory(content::WebContents* web_contents,
+                              NSData* data) {
+  if (!web_contents || data.length == 0) {
+    return false;
+  }
+  // The pickle reader needs its own aligned copy.
+  base::Pickle pickle = base::Pickle::WithData(base::apple::NSDataToSpan(data));
+  base::PickleIterator iterator(pickle);
+  uint32_t magic = 0;
+  int version = 0;
+  int selected = -1;
+  int count = 0;
+  if (!iterator.ReadUInt32(&magic) || magic != kMagic ||
+      !iterator.ReadInt(&version) || version != kVersion ||
+      !iterator.ReadInt(&selected) || !iterator.ReadInt(&count) ||
+      count <= 0 || count > blink::kMaxSessionHistoryEntries || selected < 0 ||
+      selected >= count) {
+    return false;
+  }
+  std::vector<sessions::SerializedNavigationEntry> navigations(
+      static_cast<size_t>(count));
+  for (sessions::SerializedNavigationEntry& navigation : navigations) {
+    if (!navigation.ReadFromPickle(&iterator) ||
+        !navigation.virtual_url().is_valid()) {
+      return false;
+    }
+  }
+  for (size_t i = 0; i < navigations.size(); ++i) {
+    navigations[i].set_index(static_cast<int>(i));
+  }
+
+  content::NavigationController& controller = web_contents->GetController();
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          navigations, web_contents->GetBrowserContext());
+  controller.Restore(selected, content::RestoreType::kRestored, &entries);
+  // A hidden tab is not activated by content, so load the selected entry now
+  // (with its saved page state: scroll position, form contents).
+  controller.LoadIfNecessary();
+  return true;
+}
diff --git a/openarc/bridge/oac_session_history_internal.h b/openarc/bridge/oac_session_history_internal.h
new file mode 100644
index 000000000000..7c0ecf82fb73
--- /dev/null
+++ b/openarc/bridge/oac_session_history_internal.h
@@ -0,0 +1,33 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BRIDGE_OAC_SESSION_HISTORY_INTERNAL_H_
+#define OPENARC_BRIDGE_OAC_SESSION_HISTORY_INTERNAL_H_
+
+#import <Foundation/Foundation.h>
+
+namespace content {
+class WebContents;
+}
+
+// Plan C20: a tab's back/forward list as an opaque blob
+// (-[OACTab sessionHistory]) and back (OACTabConfiguration.sessionHistory).
+//
+// The blob is our own small envelope (a magic number, a format version, the
+// selected index and the entry count) around //components/sessions'
+// SerializedNavigationEntry pickles, the same per-entry encoding Chrome's
+// session service writes (URL, title, page state with scroll position and
+// form contents, referrer, transition, timestamps).
+
+// The navigation list of |web_contents| (at most 50 entries, the renderer's
+// session history limit, kept around the current one); nil when there is no
+// committed page yet.
+NSData* OACSerializeSessionHistory(content::WebContents* web_contents);
+
+// Restores |data| into the fresh navigation controller of |web_contents| and
+// starts loading the selected entry. Returns false (and changes nothing) for
+// data it cannot read: another envelope version, truncated or empty data.
+bool OACRestoreSessionHistory(content::WebContents* web_contents, NSData* data);
+
+#endif  // OPENARC_BRIDGE_OAC_SESSION_HISTORY_INTERNAL_H_
