index f9a75957d5e1..59f42ff75d8b 100644
--- a/openarc/bridge/oac_tab.mm
+++ b/openarc/bridge/oac_tab.mm
@@ -83,6 +83,7 @@
 #import "openarc/bridge/oac_dialog_requests_internal.h"
 #import "openarc/bridge/oac_profile_internal.h"
 #import "openarc/bridge/oac_requests_internal.h"
+#import "openarc/bridge/oac_session_history_internal.h"
 #import "openarc/bridge/oac_tab_internal.h"
 #import "openarc/bridge/oac_translation_internal.h"
