diff --git a/openarc/browser/openarc_link_preview.cc b/openarc/browser/openarc_link_preview.cc
new file mode 100644
index 000000000000..76828ddea511
--- /dev/null
+++ b/openarc/browser/openarc_link_preview.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_link_preview.h"
+
+#include <utility>
+
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/origin.h"
+#include "url/url_constants.h"
+
+namespace openarc {
+
+namespace {
+
+// Only web links are previewed (inferred: the spec's links are http(s)
+// pages; mailto:, javascript: and app schemes keep their usual handling).
+bool IsWebURL(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+}  // namespace
+
+LinkPreviewPolicy::LinkPreviewPolicy(content::WebContents* web_contents)
+    : content::WebContentsUserData<LinkPreviewPolicy>(*web_contents) {}
+
+LinkPreviewPolicy::~LinkPreviewPolicy() = default;
+
+void LinkPreviewPolicy::Report(const GURL& url, LinkPreviewTrigger trigger) {
+  if (callback_) {
+    callback_.Run(url, trigger);
+  }
+}
+
+// static
+bool LinkPreviewPolicy::MaybeInterceptOpenURL(
+    content::WebContents* source,
+    const content::OpenURLParams& params) {
+  LinkPreviewPolicy* policy = source ? FromWebContents(source) : nullptr;
+  if (!policy || !(policy->triggers() & kLinkPreviewTriggerShiftClick)) {
+    return false;
+  }
+  // [06 §22.1] observed: Shift-click on a link opens the preview. Blink turns
+  // a Shift-click into NEW_WINDOW; ⌘-click (background tab) and ⌘⇧-click
+  // (foreground tab) keep their meaning ([06 §22.1] observed for ⌘-click).
+  if (params.disposition != WindowOpenDisposition::NEW_WINDOW ||
+      !params.is_renderer_initiated || !params.user_gesture ||
+      params.post_data ||
+      !ui::PageTransitionCoreTypeIs(params.transition,
+                                    ui::PAGE_TRANSITION_LINK) ||
+      !IsWebURL(params.url)) {
+    return false;
+  }
+  policy->Report(params.url, kLinkPreviewTriggerShiftClick);
+  return true;
+}
+
+// static
+void LinkPreviewPolicy::MaybeAddThrottle(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.IsInPrimaryMainFrame()) {
+    return;
+  }
+  LinkPreviewPolicy* policy = FromWebContents(handle.GetWebContents());
+  if (!policy || !(policy->triggers() & kLinkPreviewTriggerOtherSite)) {
+    return;
+  }
+  registry.AddThrottle(
+      std::make_unique<LinkPreviewNavigationThrottle>(registry));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LinkPreviewPolicy);
+
+LinkPreviewNavigationThrottle::LinkPreviewNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+LinkPreviewNavigationThrottle::~LinkPreviewNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+LinkPreviewNavigationThrottle::WillStartRequest() {
+  content::NavigationHandle* handle = navigation_handle();
+  content::WebContents* contents = handle->GetWebContents();
+  LinkPreviewPolicy* policy =
+      contents ? LinkPreviewPolicy::FromWebContents(contents) : nullptr;
+  // The policy may have changed since the throttle was added.
+  if (!policy || !(policy->triggers() & kLinkPreviewTriggerOtherSite)) {
+    return PROCEED;
+  }
+  // A plain click by the user on a link that would replace this page.
+  // Scripted navigations, form posts, redirects, reloads and history
+  // navigations keep navigating the tab (inferred: [06 §22.1] only records
+  // link clicks).
+  if (!handle->IsRendererInitiated() || !handle->WasInitiatedByLinkClick() ||
+      !handle->HasUserGesture() || handle->IsPost() ||
+      !ui::PageTransitionCoreTypeIs(handle->GetPageTransition(),
+                                    ui::PAGE_TRANSITION_LINK) ||
+      !IsWebURL(handle->GetURL())) {
+    return PROCEED;
+  }
+  const url::Origin& current =
+      contents->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  if (current.opaque() || !(current.scheme() == url::kHttpScheme ||
+                            current.scheme() == url::kHttpsScheme)) {
+    return PROCEED;
+  }
+  // [06 §22.1] observed: a same-site link navigates the favorite itself; a
+  // link to another site opens the preview. "Site" is the registrable domain
+  // (inferred: Chromium's site notion; the spec's test used example.org and
+  // iana.org from a page on another domain).
+  if (net::registry_controlled_domains::SameDomainOrHost(
+          handle->GetURL(), current,
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)) {
+    return PROCEED;
+  }
+  policy->Report(handle->GetURL(), kLinkPreviewTriggerOtherSite);
+  // No error page and no history entry: the page stays as it was.
+  return CANCEL_AND_IGNORE;
+}
+
+const char* LinkPreviewNavigationThrottle::GetNameForLogging() {
+  return "OpenArcLinkPreviewNavigationThrottle";
+}
+
+}  // namespace openarc
diff --git a/openarc/browser/openarc_link_preview.h b/openarc/browser/openarc_link_preview.h
new file mode 100644
index 000000000000..d115852c0db9
--- /dev/null
+++ b/openarc/browser/openarc_link_preview.h
@@ -0,0 +1,89 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef OPENARC_BROWSER_OPENARC_LINK_PREVIEW_H_
+#define OPENARC_BROWSER_OPENARC_LINK_PREVIEW_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace content {
+struct OpenURLParams;
+class NavigationThrottleRegistry;
+class WebContents;
+}  // namespace content
+
+namespace openarc {
+
+// Which link clicks of a tab the shell previews instead of letting them
+// navigate (plan B49, docs/arc-spec/06-flows.md §22.1). Bit values match
+// OACLinkPreviewTriggers (OACLinkPreview.h).
+enum LinkPreviewTrigger : unsigned {
+  kLinkPreviewTriggerNone = 0,
+  // A plain click on a link to another site (registrable domain) that would
+  // navigate the tab itself.
+  kLinkPreviewTriggerOtherSite = 1u << 0,
+  // A Shift-click on a link (Chromium's NEW_WINDOW disposition).
+  kLinkPreviewTriggerShiftClick = 1u << 1,
+};
+
+// The shell's link preview policy of one tab, and where intercepted clicks go.
+// The tab's link stays where it was: the click is dropped and reported.
+class LinkPreviewPolicy
+    : public content::WebContentsUserData<LinkPreviewPolicy> {
+ public:
+  // Called with the link's URL and the single trigger that matched.
+  using Callback = base::RepeatingCallback<void(const GURL&, LinkPreviewTrigger)>;
+
+  LinkPreviewPolicy(const LinkPreviewPolicy&) = delete;
+  LinkPreviewPolicy& operator=(const LinkPreviewPolicy&) = delete;
+  ~LinkPreviewPolicy() override;
+
+  unsigned triggers() const { return triggers_; }
+  void set_triggers(unsigned triggers) { triggers_ = triggers; }
+  void set_callback(Callback callback) { callback_ = std::move(callback); }
+
+  // OpenURLFromTab hook: a Shift-click on a link with the Shift-click trigger
+  // set is reported and must not open anything. Returns true when it was.
+  static bool MaybeInterceptOpenURL(content::WebContents* source,
+                                    const content::OpenURLParams& params);
+
+  // Adds the throttle that intercepts other-site link clicks to navigations
+  // of tabs with that trigger set (OpenArcContentBrowserClient).
+  static void MaybeAddThrottle(content::NavigationThrottleRegistry& registry);
+
+  void Report(const GURL& url, LinkPreviewTrigger trigger);
+
+ private:
+  friend class content::WebContentsUserData<LinkPreviewPolicy>;
+  explicit LinkPreviewPolicy(content::WebContents* web_contents);
+
+  unsigned triggers_ = kLinkPreviewTriggerNone;
+  Callback callback_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Cancels a main-frame link-click navigation to another site of a tab whose
+// policy has kLinkPreviewTriggerOtherSite, before any request is made, and
+// reports it. The page stays as it was ([06 §22.3] observed: closing the
+// preview shows the unchanged source page).
+class LinkPreviewNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit LinkPreviewNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~LinkPreviewNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_LINK_PREVIEW_H_
