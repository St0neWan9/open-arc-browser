diff --git a/openarc/bridge/oac_link_preview.mm b/openarc/bridge/oac_link_preview.mm
new file mode 100644
index 000000000000..aa3ae147079a
--- /dev/null
+++ b/openarc/bridge/oac_link_preview.mm
@@ -0,0 +1,72 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Plan B49: the link preview policy of a tab (OACLinkPreview.h). The policy
+// lives on the WebContents (openarc::LinkPreviewPolicy), so the navigation
+// throttle and OpenURLFromTab can read it without the bridge.
+
+#import <OpenArcCore/OACLinkPreview.h>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/apple/url_conversions.h"
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+#include "openarc/browser/openarc_link_preview.h"
+
+static_assert(static_cast<unsigned>(OACLinkPreviewTriggersOtherSiteLink) ==
+                  static_cast<unsigned>(openarc::kLinkPreviewTriggerOtherSite),
+              "OACLinkPreviewTriggers must match openarc::LinkPreviewTrigger");
+static_assert(static_cast<unsigned>(OACLinkPreviewTriggersShiftClick) ==
+                  static_cast<unsigned>(openarc::kLinkPreviewTriggerShiftClick),
+              "OACLinkPreviewTriggers must match openarc::LinkPreviewTrigger");
+
+@implementation OACTab (OACLinkPreview)
+
+- (OACLinkPreviewTriggers)linkPreviewTriggers {
+  content::WebContents* contents = self.webContents;
+  openarc::LinkPreviewPolicy* policy =
+      contents ? openarc::LinkPreviewPolicy::FromWebContents(contents)
+               : nullptr;
+  return policy ? policy->triggers() : OACLinkPreviewTriggersNone;
+}
+
+- (void)setLinkPreviewTriggers:(OACLinkPreviewTriggers)triggers {
+  CHECK(NSThread.isMainThread);
+  content::WebContents* contents = self.webContents;
+  if (!contents) {
+    return;
+  }
+  openarc::LinkPreviewPolicy* policy =
+      openarc::LinkPreviewPolicy::FromWebContents(contents);
+  if (!policy) {
+    openarc::LinkPreviewPolicy::CreateForWebContents(contents);
+    policy = openarc::LinkPreviewPolicy::FromWebContents(contents);
+    __weak OACTab* weakSelf = self;
+    // Called from inside Chromium's navigation code: the delegate hears of
+    // the click from a posted task (OACDefines.h, no re-entrant callbacks).
+    policy->set_callback(base::BindRepeating(
+        ^(const GURL& url, openarc::LinkPreviewTrigger trigger) {
+          NSURL* link = net::NSURLWithGURL(url);
+          OACLinkPreviewTriggers matched =
+              static_cast<OACLinkPreviewTriggers>(trigger);
+          OACPostToMainThread(^{
+            OACTab* tab = weakSelf;
+            id<OACTabDelegate> delegate = tab.delegate;
+            if (tab && !tab.isClosed && link &&
+                [delegate respondsToSelector:@selector
+                          (tab:didInterceptLinkToURL:trigger:)]) {
+              [(id<OACLinkPreviewDelegate>)delegate tab:tab
+                                  didInterceptLinkToURL:link
+                                                trigger:matched];
+            }
+          });
+        }));
+  }
+  policy->set_triggers(triggers & (OACLinkPreviewTriggersOtherSiteLink |
+                                   OACLinkPreviewTriggersShiftClick));
+}
+
+@end
