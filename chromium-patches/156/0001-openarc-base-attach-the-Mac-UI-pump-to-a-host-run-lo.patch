 class SingleThreadTaskRunner;
 
 // Helper class to run the RunLoop::Delegate associated with the current thread.
@@ -276,6 +280,13 @@ class BASE_EXPORT RunLoop {
   friend class MessagePumpUIApplication;
 #endif
 
+#if BUILDFLAG(IS_MAC)
+  // Open Arc: when Chromium is embedded in an app whose NSApplication already
+  // runs the main run loop, the UI pump is attached to that loop instead of
+  // being Run(), so it calls BeforeRun and AfterRun directly like iOS.
+  friend class MessagePumpNSApplication;
+#endif
+
   // Support for //base/test/scoped_run_loop_timeout.h.
   friend class test::ScopedRunLoopTimeout;
   friend class test::ScopedDisableRunLoopTimeout;
