+  attached_to_message_pump_ = true;
+#endif
 }
 
 void ThreadControllerWithMessagePumpImpl::DetachFromMessagePump() {
+#if BUILDFLAG(IS_MAC)
+  // On Mac only an explicitly attached pump (Open Arc) is detached; a UI pump
+  // that was Run() as usual, or a test pump, is left alone.
+  if (!attached_to_message_pump_) {
+    return;
+  }
+  attached_to_message_pump_ = false;
+#endif
   static_cast<MessagePumpCFRunLoopBase*>(pump_.get())->Detach();
 }
 #elif BUILDFLAG(IS_ANDROID)
