diff --git a/base/message_loop/message_pump_apple.h b/base/message_loop/message_pump_apple.h
index b9c32f7ddd5c..26237bbae026 100644
--- a/base/message_loop/message_pump_apple.h
+++ b/base/message_loop/message_pump_apple.h
@@ -79,14 +79,18 @@ class BASE_EXPORT MessagePumpCFRunLoopBase : public MessagePump {
                                  TimeTicks run_time,
                                  TimeTicks latest_time) override;
 
-#if BUILDFLAG(IS_IOS)
+#if BUILDFLAG(IS_APPLE)
   // Some iOS message pumps do not support calling |Run()| to spin the main
   // message loop directly.  Instead, call |Attach()| to set up a delegate, then
   // |Detach()| before destroying the message pump.  These methods do nothing if
   // the message pump supports calling |Run()| and |Quit()|.
+  //
+  // On Mac, MessagePumpNSApplication supports both: an app that embeds the
+  // browser process (Open Arc) runs -[NSApplication run] itself and attaches
+  // the UI pump to it instead of calling |Run()|.
   virtual void Attach(Delegate* delegate);
   virtual void Detach();
-#endif  // BUILDFLAG(IS_IOS)
+#endif  // BUILDFLAG(IS_APPLE)
 
  protected:
   // Needs access to CreateAutoreleasePool.
@@ -122,6 +126,13 @@ class BASE_EXPORT MessagePumpCFRunLoopBase : public MessagePump {
   void OnDetach();
 #endif
 
+#if BUILDFLAG(IS_MAC)
+  // Called when the pump is attached to a run loop that the embedding app
+  // already runs. Accounts for a CFRunLoop run that may be on the stack at
+  // that moment, so the enter/exit observer stays balanced when it exits.
+  void OnAttachToHostRunLoop();
+#endif
+
   // Sets this pump's delegate.  Signals the appropriate sources if
   // |delegateless_work_| is true.  |delegate| can be NULL.
   void SetDelegate(Delegate* delegate);
@@ -355,9 +366,18 @@ class MessagePumpNSApplication : public MessagePumpCFRunLoopBase {
   void DoRun(Delegate* delegate) override;
   bool DoQuit() override;
 
+  // Attaches to the NSApplication run loop of an embedding app instead of
+  // running it (Open Arc). Nested RunLoops still work through DoRun().
+  void Attach(Delegate* delegate) override;
+  void Detach() override;
+
  private:
   void EnterExitRunLoop(CFRunLoopActivity activity) override;
 
+  // The outermost RunLoop while attached to the embedding app's run loop. It is
+  // never Run(); it only marks the thread as running a loop, as on iOS.
+  std::optional<RunLoop> attached_run_loop_;
+
   // True if DoRun is managing its own run loop as opposed to letting
   // -[NSApplication run] handle it.  The outermost run loop in the application
   // is managed by -[NSApplication run], inner run loops are handled by a loop
diff --git a/base/message_loop/message_pump_apple.mm b/base/message_loop/message_pump_apple.mm
index 3f3d7b8e8377..522c1ef99b53 100644
--- a/base/message_loop/message_pump_apple.mm
+++ b/base/message_loop/message_pump_apple.mm
@@ -173,11 +173,11 @@ explicit OptionalAutoreleasePool(MessagePumpCFRunLoopBase* pump) {
                                            latest_time);
 }
 
-#if BUILDFLAG(IS_IOS)
+#if BUILDFLAG(IS_APPLE)
 void MessagePumpCFRunLoopBase::Attach(Delegate* delegate) {}
 
 void MessagePumpCFRunLoopBase::Detach() {}
-#endif  // BUILDFLAG(IS_IOS)
+#endif  // BUILDFLAG(IS_APPLE)
 
 // Must be called on the run loop thread.
 MessagePumpCFRunLoopBase::MessagePumpCFRunLoopBase() {
@@ -336,6 +336,23 @@ explicit OptionalAutoreleasePool(MessagePumpCFRunLoopBase* pump) {
 }
 #endif  // BUILDFLAG(IS_IOS)
 
+#if BUILDFLAG(IS_MAC)
+void MessagePumpCFRunLoopBase::OnAttachToHostRunLoop() {
+  CHECK_EQ(nesting_level_, 0);
+  // The observers were added while the embedding app was inside its own code.
+  // If that code runs inside a CFRunLoop run (a timer, a main dispatch queue
+  // block), that run's exit is observed later, so count it now. Deeper native
+  // nesting at attach time cannot be detected and is not supported.
+  apple::ScopedCFTypeRef<CFStringRef> mode(
+      CFRunLoopCopyCurrentMode(run_loop_.get()));
+  if (mode) {
+    ++nesting_level_;
+    PushWorkItemScope();
+    deepest_nesting_level_ = nesting_level_;
+  }
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 void MessagePumpCFRunLoopBase::SetDelegate(Delegate* delegate) {
   delegate_ = delegate;
 
@@ -803,7 +820,35 @@ explicit OptionalAutoreleasePool(MessagePumpCFRunLoopBase* pump) {
   running_own_loop_ = last_running_own_loop;
 }
 
+void MessagePumpNSApplication::Attach(Delegate* delegate) {
+  CHECK(!attached_run_loop_);
+  CHECK(NSApp);
+  attached_run_loop_.emplace();
+  CHECK(attached_run_loop_->BeforeRun());
+  SetDelegate(delegate);
+  OnAttachToHostRunLoop();
+  ScheduleWork();
+}
+
+void MessagePumpNSApplication::Detach() {
+  if (!attached_run_loop_) {
+    return;
+  }
+  attached_run_loop_->AfterRun();
+  SetDelegate(nullptr);
+  attached_run_loop_.reset();
+}
+
 bool MessagePumpNSApplication::DoQuit() {
+  // While attached to the embedding app's run loop, the outermost level is not
+  // ours to stop: the app quits through NSApplication. Ignore such a quit
+  // (nobody holds the attached RunLoop, so it can only come from
+  // RunLoop::QuitCurrent*-style calls) instead of stopping NSApp.
+  if (attached_run_loop_ && run_nesting_level() == 0) {
+    DLOG(WARNING) << "Quit of the attached UI run loop ignored";
+    return false;
+  }
+
   // If the app is displaying a modal window in a native run loop, we can only
   // quit our run loop after the window is closed. Otherwise the [NSApplication
   // stop] below will apply to the modal window run loop instead. To work around
diff --git a/base/run_loop.h b/base/run_loop.h
