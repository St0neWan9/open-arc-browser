diff --git a/openarc/browser/openarc_web_store_branding.cc b/openarc/browser/openarc_web_store_branding.cc
new file mode 100644
index 000000000000..61879835e17e
--- /dev/null
+++ b/openarc/browser/openarc_web_store_branding.cc
@@ -0,0 +1,111 @@
+// Copyright 2026 The Open Arc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "openarc/browser/openarc_web_store_branding.h"
+
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/common/extension_urls.h"
+
+namespace openarc {
+
+namespace {
+
+// Runs once per document in an isolated world. Texts are matched whole, so a
+// store string that merely mentions Chrome stays as it is.
+constexpr char16_t kBrandingScript[] = uR"JS((() => {
+  if (window.__openArcWebStoreBranding) return;
+  window.__openArcWebStoreBranding = true;
+  const LABELS = new Map([
+    ['Add to Chrome', 'Add to Open Arc'],
+    ['Remove from Chrome', 'Remove from Open Arc'],
+  ]);
+  const BANNER = 'Switch to Chrome to install extensions and themes';
+  const PROMPT = 'Switch to Chrome?';
+  const hide = (el) => {
+    if (el && el !== document.body && el !== document.documentElement) {
+      el.style.setProperty('display', 'none', 'important');
+    }
+  };
+  const fixText = (node) => {
+    const text = node.data.trim();
+    const label = LABELS.get(text);
+    if (label) {
+      node.data = node.data.replace(text, label);
+      return;
+    }
+    const owner = node.parentElement;
+    if (!owner) return;
+    if (text === BANNER) {
+      // The banner's own component: the nearest controlled element that
+      // holds little more than the banner (its text and button).
+      const box = owner.closest('[jscontroller]');
+      if (box && box.textContent.length < 400) hide(box);
+    } else if (text === PROMPT) {
+      hide(owner.closest('[role=dialog]'));
+    }
+  };
+  const fixLabels = (root) => {
+    for (const el of root.querySelectorAll('[aria-label]')) {
+      let value = el.getAttribute('aria-label');
+      for (const [from, to] of LABELS) value = value.split(from).join(to);
+      if (value !== el.getAttribute('aria-label')) {
+        el.setAttribute('aria-label', value);
+      }
+    }
+  };
+  const scan = (root) => {
+    if (root.nodeType === Node.TEXT_NODE) {
+      fixText(root);
+      return;
+    }
+    if (root.nodeType !== Node.ELEMENT_NODE) return;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+      fixText(node);
+    }
+    fixLabels(root);
+  };
+  scan(document.documentElement);
+  new MutationObserver((records) => {
+    for (const record of records) {
+      if (record.type === 'characterData') {
+        fixText(record.target);
+      } else {
+        for (const node of record.addedNodes) scan(node);
+      }
+    }
+  }).observe(document.documentElement,
+             {childList: true, subtree: true, characterData: true});
+})())JS";
+
+}  // namespace
+
+WebStoreBranding::WebStoreBranding(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<WebStoreBranding>(*web_contents) {}
+
+WebStoreBranding::~WebStoreBranding() = default;
+
+// static
+bool WebStoreBranding::IsWebStorePage(const GURL& url) {
+  return url.SchemeIs(url::kHttpsScheme) &&
+         extension_urls::IsWebstoreDomain(url);
+}
+
+void WebStoreBranding::PrimaryMainDocumentElementAvailable() {
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive() ||
+      !IsWebStorePage(frame->GetLastCommittedURL())) {
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      kBrandingScript, base::NullCallback(),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(WebStoreBranding);
+
+}  // namespace openarc
