+#ifndef OPENARC_BROWSER_OPENARC_WEB_STORE_BRANDING_H_
+#define OPENARC_BROWSER_OPENARC_WEB_STORE_BRANDING_H_
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace openarc {
+
+// Makes the Chrome Web Store name this browser (plan B61,
+// docs/arc-spec/06-flows.md §18.2 / §18.3). The store serves every browser
+// that is not Google Chrome a "Switch to Chrome?" prompt, a "Switch to Chrome
+// to install extensions and themes" banner and an "Add to Chrome" button; the
+// server decides from data of its own, not from the UA or the brands (§18.3:
+// with the same UA and brands as plain Chromium, Arc's store page shows the
+// install button named after the browser and neither the prompt nor the
+// banner, rewritten in the page after load). Installing works either way:
+// the button drives chrome.webstorePrivate, which our profiles have (C14).
+//
+// What we do: on every document of the store's origin in the primary main
+// frame, a script in an isolated world (the page's own scripts cannot see or
+// undo it) renames "Add to Chrome" / "Remove from Chrome" to
+// "… Open Arc", hides the banner and the prompt, and keeps doing so for nodes
+// the store's single-page app adds later (MutationObserver). The store's
+// markup is not an API: if Google changes the strings, the page simply shows
+// Chrome's wording again.
+class WebStoreBranding
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<WebStoreBranding> {
+ public:
+  WebStoreBranding(const WebStoreBranding&) = delete;
+  WebStoreBranding& operator=(const WebStoreBranding&) = delete;
+  ~WebStoreBranding() override;
+
+  // Whether `url` is a Chrome Web Store page the script runs on.
+  static bool IsWebStorePage(const GURL& url);
+
+  // content::WebContentsObserver:
+  void PrimaryMainDocumentElementAvailable() override;
+
+ private:
+  friend class content::WebContentsUserData<WebStoreBranding>;
+  explicit WebStoreBranding(content::WebContents* web_contents);
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace openarc
+
+#endif  // OPENARC_BROWSER_OPENARC_WEB_STORE_BRANDING_H_
