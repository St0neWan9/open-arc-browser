+// The WebAuthn dialog drawn by the shell (plan C21, OACWebAuthn.h). //chrome's
+// request flow (ChromeAuthenticatorRequestDelegate and its dialog controller)
+// stays in charge; its model asks AuthenticatorRequestDialogViewController to
+// create a view when a step needs a dialog. An Open Arc hook returns the
+// bridge's controller here, which describes the model's current step as an
+// OACWebAuthnDialog for the tab's dialog delegate and forwards the user's
+// choices as model events, the way Chrome's sheets do.
+
+#import "openarc/bridge/oac_webauthn_internal.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/webauthn/authenticator_request_dialog_view_controller.h"
+#include "chrome/browser/webauthn/authenticator_request_dialog_model.h"
+#include "chrome/browser/webauthn/chrome_web_authentication_delegate.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "device/fido/pin.h"
+#include "device/fido/public/fido_transport_protocol.h"
+#include "device/fido/public/fido_types.h"
+
+#import "openarc/bridge/oac_application_internal.h"
+#import "openarc/bridge/oac_requests_internal.h"
+#import "openarc/bridge/oac_tab_internal.h"
+
+using Step = AuthenticatorRequestDialogModel::Step;
+using Mechanism = AuthenticatorRequestDialogModel::Mechanism;
+
+// MARK: - Value classes
+
+@implementation OACWebAuthnMechanism {
+  OACWebAuthnMechanismKind _kind;
+  NSString* _title;
+  NSString* _subtitle;
+}
+
+- (instancetype)initWithKind:(OACWebAuthnMechanismKind)kind
+                       title:(NSString*)title
+                    subtitle:(NSString*)subtitle {
+  if ((self = [super init])) {
+    _kind = kind;
+    _title = [title copy];
+    _subtitle = [subtitle copy];
+  }
+  return self;
+}
+
+- (OACWebAuthnMechanismKind)kind {
+  return _kind;
+}
+- (NSString*)title {
+  return _title;
+}
+- (NSString*)subtitle {
+  return _subtitle;
+}
+
+@end
+
+@implementation OACWebAuthnAccount {
+  NSString* _name;
+  NSString* _displayName;
+}
+
+- (instancetype)initWithName:(NSString*)name displayName:(NSString*)displayName {
+  if ((self = [super init])) {
+    _name = [name copy];
+    _displayName = [displayName copy];
+  }
+  return self;
+}
+
+- (NSString*)name {
+  return _name;
+}
+- (NSString*)displayName {
+  return _displayName;
+}
+
+@end
