+// MARK: - The dialog request
+
+// What the dialog asks the controller to do; runs on the UI thread.
+enum class WebAuthnAction {
+  kAccept,
+  kSelectMechanism,
+  kSelectAccount,
+  kProvidePIN,
+  kChooseAnotherMethod,
+  kCancel,
+};
+
+@interface OACWebAuthnDialog ()
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                    handler:(base::RepeatingCallback<
+                                void(WebAuthnAction, NSInteger, NSString*)>)
+                                handler;
+- (void)updateOperation:(OACWebAuthnOperation)operation
+          relyingPartyID:(NSString*)relyingPartyID
+                userName:(NSString*)userName
+                    step:(OACWebAuthnStep)step
+              mechanisms:(NSArray<OACWebAuthnMechanism*>*)mechanisms
+          priorityIndex:(NSInteger)priorityIndex
+                accounts:(NSArray<OACWebAuthnAccount*>*)accounts
+  canChooseAnotherMethod:(BOOL)canChooseAnotherMethod
+               errorKind:(OACWebAuthnErrorKind)errorKind
+                canRetry:(BOOL)canRetry
+                pinError:(OACWebAuthnPINError)pinError
+    pinAttemptsRemaining:(NSInteger)pinAttemptsRemaining
+        minimumPINLength:(NSInteger)minimumPINLength
+     bioSamplesRemaining:(NSInteger)bioSamplesRemaining
+         bioSamplesTotal:(NSInteger)bioSamplesTotal
+                  isBusy:(BOOL)isBusy;
+@end
+
+@implementation OACWebAuthnDialog {
+  OACWebAuthnOperation _operation;
+  NSString* _relyingPartyID;
+  NSString* _userName;
+  OACWebAuthnStep _step;
+  NSArray<OACWebAuthnMechanism*>* _mechanisms;
+  NSInteger _priorityMechanismIndex;
+  NSArray<OACWebAuthnAccount*>* _accounts;
+  BOOL _canChooseAnotherMethod;
+  OACWebAuthnErrorKind _errorKind;
+  BOOL _canRetry;
+  OACWebAuthnPINError _pinError;
+  NSInteger _pinAttemptsRemaining;
+  NSInteger _minimumPINLength;
+  NSInteger _bioSamplesRemaining;
+  NSInteger _bioSamplesTotal;
+  BOOL _isBusy;
+  base::RepeatingCallback<void(WebAuthnAction, NSInteger, NSString*)> _handler;
+}
+
+- (instancetype)initWithTab:(OACTab*)tab
+                     origin:(OACOrigin*)origin
+                    handler:(base::RepeatingCallback<
+                                void(WebAuthnAction, NSInteger, NSString*)>)
+                                handler {
+  if ((self = [super initWithTab:tab origin:origin isFromSubframe:NO])) {
+    _handler = std::move(handler);
+    _relyingPartyID = @"";
+    _userName = @"";
+    _mechanisms = @[];
+    _accounts = @[];
+    _priorityMechanismIndex = -1;
+    _pinAttemptsRemaining = -1;
+    _bioSamplesRemaining = -1;
+    _bioSamplesTotal = -1;
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self cancel];
+}
+
+- (void)updateOperation:(OACWebAuthnOperation)operation
+          relyingPartyID:(NSString*)relyingPartyID
+                userName:(NSString*)userName
+                    step:(OACWebAuthnStep)step
+              mechanisms:(NSArray<OACWebAuthnMechanism*>*)mechanisms
+          priorityIndex:(NSInteger)priorityIndex
+                accounts:(NSArray<OACWebAuthnAccount*>*)accounts
+  canChooseAnotherMethod:(BOOL)canChooseAnotherMethod
+               errorKind:(OACWebAuthnErrorKind)errorKind
+                canRetry:(BOOL)canRetry
+                pinError:(OACWebAuthnPINError)pinError
+    pinAttemptsRemaining:(NSInteger)pinAttemptsRemaining
+        minimumPINLength:(NSInteger)minimumPINLength
+     bioSamplesRemaining:(NSInteger)bioSamplesRemaining
+         bioSamplesTotal:(NSInteger)bioSamplesTotal
+                  isBusy:(BOOL)isBusy {
+  _operation = operation;
+  _relyingPartyID = [relyingPartyID copy];
+  _userName = [userName copy];
+  _step = step;
+  _mechanisms = [mechanisms copy];
+  _priorityMechanismIndex = priorityIndex;
+  _accounts = [accounts copy];
+  _canChooseAnotherMethod = canChooseAnotherMethod;
+  _errorKind = errorKind;
+  _canRetry = canRetry;
+  _pinError = pinError;
+  _pinAttemptsRemaining = pinAttemptsRemaining;
+  _minimumPINLength = minimumPINLength;
+  _bioSamplesRemaining = bioSamplesRemaining;
+  _bioSamplesTotal = bioSamplesTotal;
+  _isBusy = isBusy;
+}
+
+- (OACWebAuthnOperation)operation {
+  return _operation;
+}
+- (NSString*)relyingPartyID {
+  return _relyingPartyID;
+}
+- (NSString*)userName {
+  return _userName;
+}
+- (OACWebAuthnStep)step {
+  return _step;
+}
+- (NSArray<OACWebAuthnMechanism*>*)mechanisms {
+  return _mechanisms;
+}
+- (NSInteger)priorityMechanismIndex {
+  return _priorityMechanismIndex;
+}
+- (NSArray<OACWebAuthnAccount*>*)accounts {
+  return _accounts;
+}
+- (BOOL)canChooseAnotherMethod {
+  return _canChooseAnotherMethod;
+}
+- (OACWebAuthnErrorKind)errorKind {
+  return _errorKind;
+}
+- (BOOL)canRetry {
+  return _canRetry;
+}
+- (OACWebAuthnPINError)pinError {
+  return _pinError;
+}
+- (NSInteger)pinAttemptsRemaining {
+  return _pinAttemptsRemaining;
+}
+- (NSInteger)minimumPINLength {
+  return _minimumPINLength;
+}
+- (NSInteger)bioSamplesRemaining {
+  return _bioSamplesRemaining;
+}
+- (NSInteger)bioSamplesTotal {
+  return _bioSamplesTotal;
+}
+- (BOOL)isBusy {
+  return _isBusy;
+}
+
+- (void)send:(WebAuthnAction)action index:(NSInteger)index text:(NSString*)text {
+  if (self.isFinished || !_handler) {
+    return;
+  }
+  _handler.Run(action, index, text);
+}
+
+- (void)accept {
+  [self send:WebAuthnAction::kAccept index:-1 text:nil];
+}
+- (void)selectMechanismAtIndex:(NSInteger)index {
+  [self send:WebAuthnAction::kSelectMechanism index:index text:nil];
+}
+- (void)selectAccountAtIndex:(NSInteger)index {
+  [self send:WebAuthnAction::kSelectAccount index:index text:nil];
+}
+- (void)providePIN:(NSString*)PIN {
+  [self send:WebAuthnAction::kProvidePIN index:-1 text:PIN ?: @""];
+}
+- (void)chooseAnotherMethod {
+  [self send:WebAuthnAction::kChooseAnotherMethod index:-1 text:nil];
+}
+
+- (void)cancel {
+  if (![self markFinished]) {
+    return;
+  }
+  auto handler = std::move(_handler);
+  if (handler) {
+    handler.Run(WebAuthnAction::kCancel, -1, nil);
+  }
+}
+
+- (void)withdrawByEngine {
+  _handler.Reset();
+  [super withdrawByEngine];
+}
+
+@end
+
+// MARK: - The view controller
+
+namespace openarc {
+
+namespace {
+
+OACWebAuthnPINError PINErrorFor(device::pin::PINEntryError error) {
+  switch (error) {
+    case device::pin::PINEntryError::kNoError:
+      return OACWebAuthnPINErrorNone;
+    case device::pin::PINEntryError::kInternalUvLocked:
+      return OACWebAuthnPINErrorFingerprintLocked;
+    case device::pin::PINEntryError::kWrongPIN:
+      return OACWebAuthnPINErrorWrongPIN;
+    case device::pin::PINEntryError::kTooShort:
+      return OACWebAuthnPINErrorTooShort;
+    case device::pin::PINEntryError::kInvalidCharacters:
+      return OACWebAuthnPINErrorInvalidCharacters;
+    case device::pin::PINEntryError::kSameAsCurrentPIN:
+      return OACWebAuthnPINErrorSameAsCurrent;
+  }
+  return OACWebAuthnPINErrorNone;
+}
+
+// Our step and error for Chrome's step. nullopt: a step this embedder has no
+// view for (Google Password Manager, phones); it shows as an "unsupported"
+// error the user can back out of.
+struct StepDescription {
+  OACWebAuthnStep step;
+  OACWebAuthnErrorKind error = OACWebAuthnErrorKindNone;
+  // The error offers "Try again" (when the model allows it).
+  bool retry = false;
+};
+
+StepDescription DescribeStep(Step step) {
+  switch (step) {
+    case Step::kMechanismSelection:
+      return {OACWebAuthnStepChooseMethod};
+    case Step::kSelectPriorityMechanism:
+      return {OACWebAuthnStepConfirmMethod};
+    case Step::kUsbInsertAndActivate:
+      return {OACWebAuthnStepSecurityKey};
+    case Step::kClientPinEntry:
+      return {OACWebAuthnStepEnterPIN};
+    case Step::kClientPinSetup:
+      return {OACWebAuthnStepSetPIN};
+    case Step::kClientPinChange:
+      return {OACWebAuthnStepChangePIN};
+    case Step::kClientPinTapAgain:
+      return {OACWebAuthnStepTouchAgain};
+    case Step::kInlineBioEnrollment:
+      return {OACWebAuthnStepFingerprintEnrollment};
+    case Step::kRetryInternalUserVerification:
+      return {OACWebAuthnStepRetryVerification};
+    case Step::kResidentCredentialConfirmation:
+      return {OACWebAuthnStepConfirmSecurityKeyStorage};
+    case Step::kSelectAccount:
+    case Step::kPreSelectAccount:
+      return {OACWebAuthnStepChooseAccount};
+    case Step::kChromeProfileCreatePasskey:
+      return {OACWebAuthnStepCreatePasskey};
+    case Step::kOffTheRecordInterstitial:
+      return {OACWebAuthnStepPrivateWindowWarning};
+    case Step::kTimedOut:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindTimedOut};
+    case Step::kKeyNotRegistered:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindKeyNotRegistered,
+              true};
+    case Step::kKeyAlreadyRegistered:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindKeyAlreadyRegistered,
+              true};
+    case Step::kErrorNoPasskeys:
+    case Step::kErrorInternalUnrecognized:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindNoPasskeys,
+              step == Step::kErrorInternalUnrecognized};
+    case Step::kErrorNoAvailableTransports:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindNoMethods};
+    case Step::kClientPinErrorSoftBlock:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindPINTemporarilyLocked,
+              true};
+    case Step::kClientPinErrorHardBlock:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindPINLocked, true};
+    case Step::kClientPinErrorAuthenticatorRemoved:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindKeyRemoved, true};
+    case Step::kMissingCapability:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindMissingCapability,
+              true};
+    case Step::kStorageFull:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindStorageFull, true};
+    default:
+      return {OACWebAuthnStepError, OACWebAuthnErrorKindUnsupported, true};
+  }
+}
+
+// Methods the shell can offer. Phones (hybrid), Apple's and Google's password
+// managers need entitlements, Bluetooth or a Google account this embedder does
+// not have, so they are left out.
+std::optional<OACWebAuthnMechanismKind> MechanismKindFor(
+    const Mechanism& mechanism) {
+  if (const auto* credential =
+          std::get_if<Mechanism::Credential>(&mechanism.type)) {
+    return credential->value().source == device::AuthenticatorType::kTouchID
+               ? std::optional(OACWebAuthnMechanismKindPasskeyOnThisMac)
+               : std::nullopt;
+  }
+  if (const auto* transport =
+          std::get_if<Mechanism::Transport>(&mechanism.type)) {
+    switch (transport->value()) {
+      case device::FidoTransportProtocol::kInternal:
+        return OACWebAuthnMechanismKindThisMac;
+      case device::FidoTransportProtocol::kUsbHumanInterfaceDevice:
+        return OACWebAuthnMechanismKindSecurityKey;
+      default:
+        return std::nullopt;
+    }
+  }
+  return std::nullopt;
+}
+
+class ShellWebAuthnDialogController
+    : public AuthenticatorRequestDialogViewController,
+      public AuthenticatorRequestDialogModel::Observer {
+ public:
+  ShellWebAuthnDialogController(content::WebContents* web_contents,
+                                AuthenticatorRequestDialogModel* model)
+      : model_(model), tab_(OACTabForWebContents(web_contents)) {
+    observation_.Observe(model_);
+    OACTab* tab = tab_;
+    base::WeakPtr<ShellWebAuthnDialogController> weak_this =
+        weak_factory_.GetWeakPtr();
+    dialog_ = [[OACWebAuthnDialog alloc]
+        initWithTab:tab
+             origin:OACOriginFromURLOrigin(web_contents->GetPrimaryMainFrame()
+                                                ->GetLastCommittedOrigin())
+            handler:base::BindRepeating(
+                        [](base::WeakPtr<ShellWebAuthnDialogController> self,
+                           WebAuthnAction action, NSInteger index,
+                           NSString* text) {
+                          // Answer from a fresh task: the model may destroy
+                          // this controller while it handles the event.
+                          base::SingleThreadTaskRunner::GetCurrentDefault()
+                              ->PostTask(
+                                  FROM_HERE,
+                                  base::BindOnce(
+                                      &ShellWebAuthnDialogController::Perform,
+                                      self, action, index,
+                                      base::SysNSStringToUTF16(text ?: @"")));
+                        },
+                        weak_this)];
+    Describe();
+    if (!tab || tab.isClosed) {
+      // No shell tab: cancel, as Chrome does for contents without a modal
+      // dialog host (the request would otherwise wait for its timeout).
+      [dialog_ cancel];
+      return;
+    }
+    OACWebAuthnDialog* dialog = dialog_;
+    OACPresentDialogRequest(
+        tab, dialog, @selector(tab:showWebAuthnDialog:),
+        ^BOOL(id<OACDialogDelegate> delegate, OACTab* owner) {
+          return [delegate tab:owner showWebAuthnDialog:dialog];
+        });
+  }
+
+  ShellWebAuthnDialogController(const ShellWebAuthnDialogController&) = delete;
+  ShellWebAuthnDialogController& operator=(
+      const ShellWebAuthnDialogController&) = delete;
+
+  ~ShellWebAuthnDialogController() override {
+    // The model closes the dialog (request done, macOS took over, another
+    // UI style) by destroying its view controller.
+    [dialog_ withdrawByEngine];
+  }
+
+  // AuthenticatorRequestDialogModel::Observer:
+  void OnStepTransition() override { Update(); }
+  void OnSheetModelChanged() override { Update(); }
+  void OnButtonsStateChanged() override { Update(); }
+  void OnModelDestroyed(AuthenticatorRequestDialogModel* model) override {
+    observation_.Reset();
+    model_ = nullptr;
+  }
+
+ private:
+  void Update() {
+    if (!model_ || model_->should_dialog_be_closed()) {
+      return;  // The model resets this controller next.
+    }
+    Describe();
+    OACTab* tab = tab_;
+    OACWebAuthnDialog* dialog = dialog_;
+    OACPostToMainThread(^{
+      id<OACDialogDelegate> delegate = tab.dialogDelegate;
+      if (tab && !tab.isClosed && !dialog.isFinished &&
+          [delegate respondsToSelector:@selector(tab:didUpdateWebAuthnDialog:)]) {
+        [delegate tab:tab didUpdateWebAuthnDialog:dialog];
+      }
+    });
+  }
+
+  // Copies the model's current step into |dialog_|.
+  void Describe() {
+    if (!model_) {
+      return;
+    }
+    StepDescription description = DescribeStep(model_->step());
+    // Mechanisms the shell can offer, and their indices in the model.
+    NSMutableArray<OACWebAuthnMechanism*>* mechanisms = [NSMutableArray array];
+    mechanism_indices_.clear();
+    NSInteger priority = -1;
+    for (size_t i = 0; i < model_->mechanisms.size(); ++i) {
+      const Mechanism& mechanism = model_->mechanisms[i];
+      std::optional<OACWebAuthnMechanismKind> kind = MechanismKindFor(mechanism);
+      if (!kind) {
+        continue;
+      }
+      if (model_->priority_mechanism_index == i) {
+        priority = static_cast<NSInteger>(mechanism_indices_.size());
+      }
+      mechanism_indices_.push_back(i);
+      const bool is_passkey = *kind == OACWebAuthnMechanismKindPasskeyOnThisMac;
+      [mechanisms
+          addObject:[[OACWebAuthnMechanism alloc]
+                        initWithKind:*kind
+                               title:is_passkey
+                                         ? base::SysUTF16ToNSString(
+                                               mechanism.name)
+                                         : @""
+                            subtitle:is_passkey ? base::SysUTF16ToNSString(
+                                                      mechanism.display_name)
+                                                : @""]];
+    }
+    if (description.step == OACWebAuthnStepConfirmMethod && priority < 0) {
+      // The priority method is one we do not offer: show the list instead.
+      description = {OACWebAuthnStepChooseMethod};
+    }
+    NSMutableArray<OACWebAuthnAccount*>* accounts = [NSMutableArray array];
+    for (const auto& credential : model_->creds) {
+      [accounts addObject:[[OACWebAuthnAccount alloc]
+                              initWithName:base::SysUTF8ToNSString(
+                                               credential.user.name.value_or(
+                                                   ""))
+                               displayName:base::SysUTF8ToNSString(
+                                               credential.user.display_name
+                                                   .value_or(""))]];
+    }
+    NSInteger bio_total = model_->max_bio_samples.value_or(-1);
+    NSInteger bio_remaining = model_->bio_samples_remaining.value_or(-1);
+    [dialog_
+            updateOperation:model_->request_type ==
+                                    device::FidoRequestType::kMakeCredential
+                                ? OACWebAuthnOperationCreate
+                                : OACWebAuthnOperationSignIn
+             relyingPartyID:base::SysUTF8ToNSString(model_->relying_party_id)
+                   userName:base::SysUTF8ToNSString(
+                                model_->user_entity.name.value_or(""))
+                       step:description.step
+                 mechanisms:mechanisms
+              priorityIndex:priority
+                   accounts:accounts
+     canChooseAnotherMethod:mechanisms.count > 1 &&
+                            description.step != OACWebAuthnStepChooseMethod
+                  errorKind:description.error
+                   canRetry:description.retry && model_->offer_try_again_in_ui
+                   pinError:PINErrorFor(model_->pin_error)
+       pinAttemptsRemaining:model_->pin_attempts.value_or(-1)
+           minimumPINLength:model_->min_pin_length
+        bioSamplesRemaining:bio_remaining
+            bioSamplesTotal:bio_total
+                     isBusy:model_->ui_disabled_];
+  }
+
+  // The user's choice, as Chrome's sheets turn button presses into events.
+  void Perform(WebAuthnAction action, NSInteger index, std::u16string text) {
+    if (!model_) {
+      return;
+    }
+    const Step step = model_->step();
+    switch (action) {
+      case WebAuthnAction::kCancel:
+        model_->CancelAuthenticatorRequest();
+        return;
+      case WebAuthnAction::kChooseAnotherMethod:
+        model_->StartOver();
+        return;
+      case WebAuthnAction::kProvidePIN:
+        if (step == Step::kClientPinEntry || step == Step::kClientPinSetup ||
+            step == Step::kClientPinChange) {
+          model_->OnHavePIN(std::move(text));
+        }
+        return;
+      case WebAuthnAction::kSelectMechanism:
+        if (index >= 0 &&
+            static_cast<size_t>(index) < mechanism_indices_.size()) {
+          const size_t model_index = mechanism_indices_[index];
+          if (model_index < model_->mechanisms.size()) {
+            model_->mechanisms[model_index].callback.Run();
+          }
+        }
+        return;
+      case WebAuthnAction::kSelectAccount:
+        if (index < 0 || static_cast<size_t>(index) >= model_->creds.size()) {
+          return;
+        }
+        if (step == Step::kPreSelectAccount) {
+          model_->OnAccountPreselectedIndex(index);
+        } else if (step == Step::kSelectAccount) {
+          model_->OnAccountSelected(index);
+        }
+        return;
+      case WebAuthnAction::kAccept:
+        Accept(step);
+        return;
+    }
+  }
+
+  void Accept(Step step) {
+    switch (step) {
+      case Step::kSelectPriorityMechanism:
+        model_->OnUserConfirmedPriorityMechanism();
+        return;
+      case Step::kChromeProfileCreatePasskey:
+        model_->OnChromeProfileCreatePasskeyAccepted();
+        return;
+      case Step::kOffTheRecordInterstitial:
+        model_->OnOffTheRecordInterstitialAccepted();
+        return;
+      case Step::kResidentCredentialConfirmation:
+        model_->OnResidentCredentialConfirmed();
+        return;
+      case Step::kInlineBioEnrollment:
+        model_->OnBioEnrollmentDone();
+        return;
+      case Step::kSelectAccount:
+      case Step::kPreSelectAccount:
+        // A single account is chosen with the main button.
+        if (model_->creds.size() == 1) {
+          if (step == Step::kPreSelectAccount) {
+            model_->OnAccountPreselectedIndex(0);
+          } else {
+            model_->OnAccountSelected(0);
+          }
+        }
+        return;
+      default:
+        if (DescribeStep(step).retry && model_->offer_try_again_in_ui) {
+          model_->StartOver();
+        }
+        return;
+    }
+  }
+
+  raw_ptr<AuthenticatorRequestDialogModel> model_;  // Owns us.
+  __weak OACTab* tab_;
+  OACWebAuthnDialog* __strong dialog_ = nil;
+  // dialog_.mechanisms[i] is model_->mechanisms[mechanism_indices_[i]].
+  std::vector<size_t> mechanism_indices_;
+  base::ScopedObservation<AuthenticatorRequestDialogModel,
+                          AuthenticatorRequestDialogModel::Observer>
+      observation_{this};
+  base::WeakPtrFactory<ShellWebAuthnDialogController> weak_factory_{this};
+};
+
+std::unique_ptr<AuthenticatorRequestDialogViewController> CreateDialog(
+    content::WebContents* web_contents,
+    AuthenticatorRequestDialogModel* model) {
+  return std::make_unique<ShellWebAuthnDialogController>(web_contents, model);
+}
+
+}  // namespace
+
+void InstallWebAuthnDialog(const std::string& keychain_access_group) {
+  AuthenticatorRequestDialogViewController::SetEmbedderFactory(&CreateDialog);
+  ChromeWebAuthenticationDelegate::SetKeychainAccessGroupOverride(
+      keychain_access_group);
+}
+
+}  // namespace openarc
