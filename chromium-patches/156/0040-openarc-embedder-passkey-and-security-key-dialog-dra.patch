+// Plan C21: the keychain access group of passkeys stored on this Mac,
+// "<team id>.<app bundle id>.webauthn" for the running app's signature. Empty
+// for an ad-hoc signed app (no team): Chrome's default group then applies,
+// which no build of ours is entitled to, so only security keys are offered.
+// The group is usable only when the app is signed with it in
+// keychain-access-groups (a Developer ID build with a matching provisioning
+// profile, scripts/make-app.sh); device/fido checks that itself.
+std::string WebAuthnKeychainAccessGroup() {
+  NSString* bundle_id = NSBundle.mainBundle.bundleIdentifier;
+  SecCodeRef code = nullptr;
+  if (!bundle_id.length ||
+      SecCodeCopySelf(kSecCSDefaultFlags, &code) != errSecSuccess) {
+    return std::string();
+  }
+  base::apple::ScopedCFTypeRef<SecCodeRef> scoped_code(code);
+  SecStaticCodeRef static_code = nullptr;
+  if (SecCodeCopyStaticCode(code, kSecCSDefaultFlags, &static_code) !=
+      errSecSuccess) {
+    return std::string();
+  }
+  base::apple::ScopedCFTypeRef<SecStaticCodeRef> scoped_static(static_code);
+  CFDictionaryRef info = nullptr;
+  if (SecCodeCopySigningInformation(static_code, kSecCSSigningInformation,
+                                    &info) != errSecSuccess) {
+    return std::string();
+  }
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> scoped_info(info);
+  CFStringRef team = base::apple::GetValueFromDictionary<CFStringRef>(
+      info, kSecCodeInfoTeamIdentifier);
+  if (!team || CFStringGetLength(team) == 0) {
+    return std::string();
+  }
+  return base::SysCFStringRefToUTF8(team) + "." +
+         base::SysNSStringToUTF8(bundle_id) + ".webauthn";
+}
+
 // The browser process's content objects. They live from start to shutdown and
 // are destroyed on the main thread at the end of shutdown.
 struct EngineState {
