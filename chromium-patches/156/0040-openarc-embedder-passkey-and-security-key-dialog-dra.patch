   openarc::InstallClientCertificateSelector();
+  // WebAuthn dialog and the keychain group of passkeys on this Mac (C21).
+  openarc::InstallWebAuthnDialog(WebAuthnKeychainAccessGroup());
   // Page translation (plan B47): Chrome's translate bubble steps go to the
   // tab's translate helper; no Google API key gate.
   openarc::InstallTranslateHooks();
