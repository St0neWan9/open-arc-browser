<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of "Open Arc Helper (Renderer).app" (plan C10), used by scripts/make-app.sh:
  renderers and JIT-using utility processes.
  - com.apple.security.cs.allow-jit: V8 maps its code with MAP_JIT. This is the only key of
    Chromium's helper-renderer-entitlements.plist; allow-unsigned-executable-memory is not needed
    (V8 uses MAP_JIT, verified in C10: pages render and run script under the hardened runtime).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!--
    Ad-hoc signing only: ad-hoc signatures carry no Team ID, so the hardened runtime's library
    validation refuses the framework library the helper dlopen()s (../../../../OpenArcCore:
    "mapping process and mapped file (non-platform) have different Team IDs", seen in C10). Remove
    once D6 signs the app, the framework and the helpers with one Developer ID team.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
