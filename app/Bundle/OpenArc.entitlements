<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for "Open Arc.app", used by scripts/make-app.sh (ad-hoc signing,
  hardened runtime).

  Intentionally minimal:
  - No App Sandbox (com.apple.security.app-sandbox), settled in C10: like Chrome, the app (the
    browser process) is unsandboxed, and Chromium's helper apps in OpenArcCore.framework run
    under Chromium's own Seatbelt sandbox. Their entitlements are app/Bundle/Helpers/*.
  - No JIT or unsigned-executable-memory exceptions: the browser process runs no V8 code of
    web pages; the renderer and GPU helpers carry allow-jit.
  - No device entitlements yet. When web permissions land, the hardened runtime
    needs com.apple.security.device.camera, com.apple.security.device.audio-input
    and com.apple.security.personal-information.location alongside the usage
    strings in Info.plist.

  iCloud (task D4): CKSyncEngine needs these keys, and they only work with a real
  team signature plus a provisioning profile (not with ad-hoc signing):
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.org.openarc.browser</string></array>
    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudKit</string></array>
  The container id matches CloudKitSyncStore's default containerIdentifier.
-->
<plist version="1.0">
<dict>
  <!--
    Ad-hoc signatures carry no Team ID, so with the hardened runtime the default
    library validation refuses to load the embedded Sparkle.framework ("different
    Team IDs"; found when launching the bundle in task B19). Turn library validation
    off until D6 signs the app and its frameworks with one Developer ID team; then
    remove this key.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
